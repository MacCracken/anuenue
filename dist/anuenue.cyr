# --- hsv.cyr ---

# hsv.cyr — anuenue's HSV phase model.
#
# Pulled out of filter.cyr at v0.9.0 (the M0-anticipated split that
# the prior cuts kept deferring "until a second consumer surfaces").
# The audit + fuzz harness work was that surface — the M5 phase cache
# in filter.cyr is one consumer, the M6 colour-mode quantizers in
# color.cyr would benefit from referencing the geometry next to its
# definition, and the new fuzz/emit-phase-esc.fcyr harness wants a
# clean target boundary.
#
# Contents:
#   - ANUENUE_PHASE_MOD constant (the 6×255 hue-space modulus)
#   - hsv_rainbow(phase, out_rgb) — integer 6-sector HSV→RGB at S=V=1
#
# Not in here:
#   - ANUENUE_PHASE_STEP / _PHASE_START — runtime mutables driven by
#     the CLI flags; they belong with the filter loop in filter.cyr
#   - The phase-cached escape table (_phase_esc_init / _emit_phase_esc /
#     _PHASE_ESC_TABLE) — it's M5 perf machinery tightly coupled to
#     darshana's ANSI emit functions, lives in filter.cyr
#
# ADR 0002 (HSV inline, not abaco) documents the design rationale.

# ---- phase space modulus ------------------------------------------
#
# Phase space is `[0, 1530)` — 6 hue sectors × 255 sub-steps each. The
# 1530-unit choice avoids floating-point: at sector boundaries the
# canonical pure hues fall exactly on integer (R,G,B) without a
# round-to-255 step. See `hsv_rainbow` below.
var ANUENUE_PHASE_MOD = 1530;

# ---- hsv_rainbow ---------------------------------------------------
#
# Integer-only HSV → RGB for full-saturation full-value (S=V=1) rainbow.
# This is the entire color model anuenue ships at v1.0 — no palettes,
# no themes; the brand IS the rainbow. See [ADR 0002](../docs/adr/0002-hsv-inline-not-abaco.md)
# for the why; CLAUDE.md flags this as "Own the HSV phase model".
#
# Geometry: hue space is split into 6 sectors of 255 sub-steps each.
# Within a sector one channel is at 255, one is at 0, and one is the
# linear ramp `t` (rising) or `255 - t` (falling). At sector
# boundaries the canonical pure hues are exact integers:
#
#   phase=   0 → ( 255,   0,   0 )   red
#   phase= 255 → ( 255, 255,   0 )   yellow
#   phase= 510 → (   0, 255,   0 )   green
#   phase= 765 → (   0, 255, 255 )   cyan
#   phase=1020 → (   0,   0, 255 )   blue
#   phase=1275 → ( 255,   0, 255 )   magenta
#   phase=1530 = 0 (mod 1530), wraps back to red.
#
# `out_rgb` is a 24-byte buffer (3 × i64 slots) the caller has
# stack-allocated. We write r at offset 0, g at offset 8, b at
# offset 16. i64 slots (not u8) match Cyrius's "every struct field
# is 8 bytes, accessed via load64 / store64" convention from
# CLAUDE.md, and lets the downstream `tty_fg_rgb_buf` consume them
# directly without a widening load.
fn hsv_rainbow(phase, out_rgb): i64 {
    # Normalize phase into `[0, ANUENUE_PHASE_MOD)`. Negative and
    # wrapped inputs are both real, not hypothetical: `-s` / `-F` take
    # arbitrary i64 from argv and are summed into ANUENUE_PHASE_START,
    # and the per-cluster `phase + ANUENUE_PHASE_STEP` walk wraps at
    # i64 with a large `-p`. This two-step (mod, then correct a
    # negative remainder) is what keeps the caller's table index in
    # range for every one of those; `_emit_phase_esc` repeats it for
    # the same reason. Covered by the i64-extreme sweep in
    # scripts/robustness-check.sh.
    phase = phase % ANUENUE_PHASE_MOD;
    if (phase < 0) { phase = phase + ANUENUE_PHASE_MOD; }
    var sector = phase / 255;
    var t = phase % 255;
    # Six sectors, one per edge of the RGB colour cube. Written as a
    # flat run of early returns rather than a nested else-if chain:
    # the six rows ARE the table, and reading them side by side is how
    # you check the ramp is continuous (each row's varying channel
    # picks up where the previous row's left off). The nested form this
    # replaces at v1.2.2 cascaded to 24 columns of indent by sector 5
    # and hid exactly that structure — `cyrius fmt` indents each
    # `} else { if (...) {` one level deeper, which is correct for a
    # real nest and wrong for a dispatch table. Early returns are flat,
    # format-stable, and drop the trailing `} } } } }` entirely.
    #
    # Emitted bytes are unchanged — the six golden fixtures are
    # byte-identical across this refactor.
    if (sector == 0) {
        store64(out_rgb + 0,  255);
        store64(out_rgb + 8,  t);
        store64(out_rgb + 16, 0);
        return 0;
    }
    if (sector == 1) {
        store64(out_rgb + 0,  255 - t);
        store64(out_rgb + 8,  255);
        store64(out_rgb + 16, 0);
        return 0;
    }
    if (sector == 2) {
        store64(out_rgb + 0,  0);
        store64(out_rgb + 8,  255);
        store64(out_rgb + 16, t);
        return 0;
    }
    if (sector == 3) {
        store64(out_rgb + 0,  0);
        store64(out_rgb + 8,  255 - t);
        store64(out_rgb + 16, 255);
        return 0;
    }
    if (sector == 4) {
        store64(out_rgb + 0,  t);
        store64(out_rgb + 8,  0);
        store64(out_rgb + 16, 255);
        return 0;
    }
    # sector 5 — the only remaining case (phase / 255 is in [0, 5]
    # because phase was normalised into [0, ANUENUE_PHASE_MOD) above
    # and ANUENUE_PHASE_MOD is 6 * 255).
    store64(out_rgb + 0,  255);
    store64(out_rgb + 8,  0);
    store64(out_rgb + 16, 255 - t);
    return 0;
}
