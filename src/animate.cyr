# animate.cyr — M4 (v0.5.0) animation surface.
#
# anuenue's filter loop (M1–M3) is a pure pipe — read a line, tint
# it, write it, repeat. Animation is a deliberate deviation: we
# buffer the entire input first, then repaint it many times with the
# rainbow's phase shifted per frame. The user's terminal becomes a
# "scrolling rainbow" view of the same N lines.
#
# Capability surface delta vs the filter (x86_64 Linux numbers):
#
#   - rt_sigprocmask(14)  — block SIGHUP/SIGINT/SIGTERM so they queue
#                            on a signalfd instead of killing the
#                            process mid-frame, and unblock them at
#                            teardown (darshana tty_open_signalfd /
#                            tty_close_signalfd)
#   - signalfd4(289)       — the exit-signal fd, close-on-exec
#   - fcntl(72)            — F_GETFL + F_SETFL, making that fd
#                            non-blocking (stdlib fd_set_nonblocking)
#   - close(3)             — the fd, at teardown
#   - poll(7)              — frame interval (chrono.sleep_ms is
#                            `poll(NULL, 0, ms)`)
#   - clock_gettime(228)   — deadline math (via chrono.clock_now_ns)
#
# Pipe-purity caveat: animation mode is the v1.0 exception to the
# "no buffering beyond a line" rule from CLAUDE.md. The byte stream
# is bounded (ANUENUE_ANIMATE_INPUT_MAX) and pre-tagged once before
# the frame loop runs — per-frame cost is O(clusters), not O(UTF-8
# decode). Documented in the M7 ADR 0001 (pipe-purity) carry-forward.
#
# Library surface (anuenue_animate, _pretag_clusters, etc.) lives in
# THIS file; main.cyr's M2 flag dispatcher routes -a invocations
# here. The filter loop (anuenue_filter) is untouched.

# ---- module-level constants ---------------------------------------

# Input buffer ceiling for animation mode. 64 KB covers a generous
# screen-of-text — ~10 lines × 200 chars × 4-byte worst-case codepoints
# leaves headroom. Reads beyond this are dropped (graceful degradation:
# render what fit; don't OOM). Heap-allocated per CLAUDE.md.
var ANUENUE_ANIMATE_INPUT_MAX = 65536;

# Maximum cluster count anuenue will index in a single animation
# invocation. 8 192 clusters @ 8 bytes per slot = 64 KB. Sized to
# match the input-byte ceiling at ~8 bytes per cluster average (the
# all-ASCII worst case is 1 byte/cluster, but realistic mixed input
# trends higher).
var ANUENUE_ANIMATE_CLUSTER_MAX = 8192;

# Frame interval. 16 ms ≈ 60 fps — the roadmap target. Mutable so the
# -i / --interval flag (v1.3.0) can override it without touching the
# frame loop; main.cyr writes this var, the same shape as
# ANUENUE_PHASE_STEP / _START.
var ANUENUE_FRAME_MS = 16;

# Upper bound for -i / --interval.
#
# Set at v1.3.0 as a correctness bound. `sleep_ms(ms)` on Linux and
# macOS is `poll(NULL, 0, ms)`, poll(2)'s timeout is a 32-bit **int**,
# and through cyrius 6.6.19 the stdlib passed the i64 straight through,
# so the truncation was non-monotonic. Measured on cyrius 6.5.35:
#
#   sleep_ms(2147483647)  -> blocks ~24.8 days   (int32 max; honest)
#   sleep_ms(2147483648)  -> truncates to -2^31  -> BLOCKS FOREVER
#   sleep_ms(4294967296)  -> truncates to 0      -> returns instantly
#   sleep_ms(4294967396)  -> truncates to 100    -> sleeps 100 ms
#   sleep_ms(i64::MAX)    -> truncates to -1     -> BLOCKS FOREVER
#
# cyrius 6.6.20 fixed that in the stdlib: `sleep_ms` now clamps a
# negative `ms` to 0 and anything above INT_MAX to INT_MAX. Re-measured
# on 6.7.9 (v1.4.0): every value above INT_MAX blocks, and -1 returns
# at once — monotonic. And `_frame_wait` never hands `sleep_ms` more
# than ANUENUE_TICK_MS anyway (B-02), so neither the old truncation nor
# the new clamp is reachable from the frame loop.
#
# The bound stays because it is user-visible behaviour, not because
# the primitive still needs it: `-i` above one hour is clamped to one
# hour and says so under -v (signal-check.sh asserts both). 3 600 000
# ms is already so far past useful that anything above it is a typo
# rather than an intent. Clamped and warned rather than rejected,
# matching -d. See docs/architecture/005.
var ANUENUE_MAX_INTERVAL_MS = 3600000;

# Default animation duration when -d isn't passed. 5 seconds is enough
# to read the rainbow scrolling across a short fortune / motd line
# without forcing the user to Ctrl-C every invocation. -d 0 means
# "run until SIGINT" (mirrors lolcat's behaviour).
var ANUENUE_DEFAULT_DURATION_S = 5;

# Phase units advanced per frame, default. -S overrides. Matches the
# v0.3.0 -p (PHASE_STEP) magnitude — a -S of 1 produces a visibly
# scrolling rainbow without strobing.
var ANUENUE_DEFAULT_SPEED = 1;

# Largest -d value that survives conversion to nanoseconds.
#
# A-02 (2026-08-25 audit): `deadline_ns = start_ns + duration_secs *
# 1000000000` overflows i64 for duration_secs above ~9.22e9. At
# i64::MAX the product wraps to exactly -1e9, so the deadline landed
# ONE SECOND IN THE PAST and `anuenue -a -d 9223372036854775807`
# exited after a single frame instead of running for ~292 years —
# the precise opposite of what was asked for.
#
# 4e9 seconds is ~127 years. The bound is deliberately well under the
# arithmetic maximum (~9.22e9 s) so the sum stays safe under EITHER
# clock base: `clock_now_ns()` is CLOCK_MONOTONIC today (boot-relative,
# ~1e14 ns on a day-old host, and uptime_ms * 1e6 on agnos), but a
# future epoch-relative reading would be ~1.79e18 ns. 4e18 + 1.79e18 =
# 5.79e18, still comfortably inside i64::MAX (9.22e18). Picking the
# tightest arithmetically-valid clamp instead would have made this
# constant silently depend on which clock the stdlib returns.
#
# Values above the bound are clamped rather than rejected: asking for
# a duration past the heat death of the terminal session means "keep
# going", and clamping honours that where overflowing inverted it.
var ANUENUE_MAX_DURATION_S = 4000000000;

# What signals does animation mask? Exactly darshana's
# TTY_SIGMASK_EXIT: HUP|INT|TERM = bits 0,1,14 = 0x4003 on Linux. The
# private ANUENUE_SFD_NONBLOCK (2048) that sat here through v1.3.6 is
# gone with the hand-rolled signalfd it fed — see _open_exit_signalfd.

# ---- input buffering ----------------------------------------------
#
# Read stdin into `buf` (max `cap` bytes) until EOF or capacity.
# Returns bytes read (>= 0) on success, negative on read(2) error.
# Multiple read() calls are required for pipes — the kernel may
# return early once a single packet arrives, even if more is coming.
fn _animate_slurp_stdin(buf, cap): i64 {
    var total = 0;
    var go = 1;
    while (go == 1) {
        var room = cap - total;
        if (room <= 0) { go = 0; continue; }
        var n = anuenue_read_some(buf + total, room);
        if (n < 0) { return n; }
        if (n == 0) { go = 0; continue; }
        total = total + n;
    }
    return total;
}

# ---- cluster pre-tagging ------------------------------------------
#
# Walk the input once and record cluster start offsets in `ctab` —
# one i64 per cluster (start_byte). Cluster length is derived per-
# frame from `ctab[i+1] - ctab[i]`; the entry at index n_clusters
# holds `n_bytes` as a sentinel so the last cluster's length math
# works without a special case.
#
# The cluster boundary logic mirrors anuenue_filter (filter.cyr M3
# state machine): non-extending codepoints OR LF start a new
# cluster; combining marks / ZWJ-extension / RI second-half fold
# into the prior cluster. Invalid UTF-8 → single-byte cluster
# (graceful degradation). Truncated UTF-8 at EOF → single-byte
# clusters for each trailing byte (the animation buffer is finite,
# so we never carry across chunks — the truncation case here means
# the input itself ended mid-sequence, same fallback the M3 EOF
# path uses).
#
# Returns the number of clusters tagged (≤ max_clusters). On
# overflow, returns max_clusters and silently truncates input —
# the frame renderer never reads past `ctab[max_clusters]`, so the
# tail bytes simply don't animate.
fn _pretag_clusters(buf, n_bytes, ctab, max_clusters): i64 {
    var n_clusters = 0;
    var prev_unpaired_ri = 0;
    var prev_was_zwj = 0;
    var saw_any = 0;

    var i = 0;
    while (i < n_bytes && n_clusters < max_clusters) {
        var b = load8(buf + i);

        if (b == 10) {
            # LF is always its own cluster — open the entry and bump.
            store64(ctab + n_clusters * 8, i);
            n_clusters = n_clusters + 1;
            prev_unpaired_ri = 0;
            prev_was_zwj = 0;
            saw_any = 1;
            i = i + 1;
            continue;
        }

        # ASCII short-circuit (M5 — mirror of anuenue_filter's fast
        # path). ASCII bytes are always 1-byte clusters; never
        # combining; never RI. Only "extending" if the prior cluster
        # ended on a ZWJ. Skips utf8_seq_len / utf8_decode /
        # cp_is_extending / cp_is_regional_indicator on every ASCII
        # byte — same shape change as the filter loop, applied here
        # so the animation pre-tag walk benefits identically.
        if (b < 0x80) {
            var ascii_extending = prev_was_zwj;
            if (ascii_extending == 0) {
                store64(ctab + n_clusters * 8, i);
                n_clusters = n_clusters + 1;
            }
            prev_was_zwj = 0;
            if (ascii_extending == 0) { prev_unpaired_ri = 0; }
            saw_any = 1;
            i = i + 1;
            continue;
        }

        var seqlen = utf8_seq_len(buf, i, n_bytes);
        if (seqlen == 0) {
            # Truncated sequence at input EOF (no next chunk in
            # animation mode). Treat the remaining bytes as singleton
            # clusters — graceful degradation.
            seqlen = 1;
        }

        var cp = utf8_decode(buf, i, seqlen);

        var extending = 0;
        if (cp_is_extending(cp) == 1) { extending = 1; }
        if (prev_was_zwj == 1) { extending = 1; }
        if (cp_is_regional_indicator(cp) == 1) {
            if (prev_unpaired_ri == 1) { extending = 1; }
        }

        if (extending == 0) {
            store64(ctab + n_clusters * 8, i);
            n_clusters = n_clusters + 1;
        }

        prev_was_zwj = 0;
        if (cp == 0x200D) { prev_was_zwj = 1; }

        if (cp_is_regional_indicator(cp) == 1) {
            if (prev_unpaired_ri == 1) {
                prev_unpaired_ri = 0;
            } else {
                prev_unpaired_ri = 1;
            }
        } else {
            if (extending == 0) { prev_unpaired_ri = 0; }
        }

        saw_any = 1;
        i = i + seqlen;
    }

    # Sentinel: ctab[n_clusters] = byte count consumed. Lets the
    # renderer compute the last cluster's length as ctab[n_clusters]
    # - ctab[n_clusters-1] without a branch.
    store64(ctab + n_clusters * 8, i);
    return n_clusters;
}

# Count line-feeds in the tagged cluster table. This is the row-
# count the renderer needs for tty_cursor_up between frames — each
# LF advances the cursor by one row; the count is the re-anchor
# distance.
fn _count_lf_clusters(buf, ctab, n_clusters): i64 {
    var lfs = 0;
    var i = 0;
    while (i < n_clusters) {
        var off = load64(ctab + i * 8);
        if (load8(buf + off) == 10) { lfs = lfs + 1; }
        i = i + 1;
    }
    return lfs;
}

# Returns 1 if the last byte of the input (or the last byte of the
# last fully-indexed cluster) is LF. The renderer uses this to
# decide whether to emit a trailing CR after the last cluster so
# the cursor lands at column 1 for the next frame's re-anchor.
fn _input_ends_with_lf(buf, ctab, n_clusters): i64 {
    if (n_clusters == 0) { return 0; }
    var last_byte_idx = load64(ctab + n_clusters * 8) - 1;
    if (last_byte_idx < 0) { return 0; }
    if (load8(buf + last_byte_idx) == 10) { return 1; }
    return 0;
}

# ---- per-frame render ---------------------------------------------
#
# Walk the cluster table once, emitting fg-escape + cluster bytes
# into `line_buf`, flushing on LF / near-full / EOF. Functionally
# the same shape as anuenue_filter's inner walk, minus the UTF-8
# decode (already done at pre-tag time).
#
# `phase_base` is the starting phase for cluster 0; cluster i lands
# at `phase_base + i * ANUENUE_PHASE_STEP`. Caller adjusts
# phase_base per frame to scroll the rainbow.
#
# After the last cluster, if the input doesn't end in LF, we emit a
# trailing CR (0x0d) so the cursor returns to column 1 — without
# this, a partial-line input ("hello") would leave the cursor at
# column 6 and tty_cursor_up wouldn't re-anchor at column 1.
fn _render_frame(buf, ctab, n_clusters, phase_base, line_buf, input_ends_with_lf): i64 {
    var pos = 0;
    var phase = phase_base;

    var i = 0;
    while (i < n_clusters) {
        var off = load64(ctab + i * 8);
        var next_off = load64(ctab + (i + 1) * 8);
        var clen = next_off - off;

        if (load8(buf + off) == 10) {
            # LF cluster — reset SGR + emit LF + flush line. Same
            # discipline as anuenue_filter: terminal returns to
            # default colour at end of every rendered line.
            pos = tty_sgr_reset_buf(line_buf, pos);
            store8(line_buf + pos, 10);
            pos = pos + 1;
            if (anuenue_write_all(line_buf, pos) != 0) { return 0 - 1; }
            pos = 0;
            phase = phase + ANUENUE_PHASE_STEP;
            i = i + 1;
            continue;
        }

        # Emit fg escape + cluster bytes under one colour. M5 (v0.6.0)
        # routes through the phase-cached escape table — same shape
        # as the filter loop's hot path.
        #
        # M8 (audit 2026-05-22) — mid-cluster flush guard. Grapheme
        # clusters in anuenue's practical-subset classifier are
        # unbounded in byte length (base + N combining marks / ZWJ
        # chains / RI pairs). The animation input cap is 64 KB but
        # the line buffer is 32 KB, so a single pathological cluster
        # can exceed the line buffer. The pre-fix code checked
        # FLUSH_RESERVE only AFTER the cluster write, which is too
        # late. The guard below checks per-byte and splits the
        # cluster across multiple flushes when needed, re-emitting
        # the same phase escape after each flush so visible colour
        # stays consistent.
        pos = _emit_phase_esc(line_buf, pos, phase);
        var k = 0;
        while (k < clen) {
            if (pos + ANUENUE_FLUSH_RESERVE > ANUENUE_LINE_BUF) {
                pos = tty_sgr_reset_buf(line_buf, pos);
                if (anuenue_write_all(line_buf, pos) != 0) { return 0 - 1; }
                pos = 0;
                pos = _emit_phase_esc(line_buf, pos, phase);
            }
            store8(line_buf + pos, load8(buf + off + k));
            pos = pos + 1;
            k = k + 1;
        }

        if (pos + ANUENUE_FLUSH_RESERVE > ANUENUE_LINE_BUF) {
            pos = tty_sgr_reset_buf(line_buf, pos);
            if (anuenue_write_all(line_buf, pos) != 0) { return 0 - 1; }
            pos = 0;
        }

        phase = phase + ANUENUE_PHASE_STEP;
        i = i + 1;
    }

    # Tail: reset SGR, plus a trailing CR if needed so the cursor
    # ends at column 1 of the row immediately below the last LF (or
    # of the partial-line row, when input has no trailing LF).
    pos = tty_sgr_reset_buf(line_buf, pos);
    if (input_ends_with_lf == 0) {
        store8(line_buf + pos, 13);          # CR
        pos = pos + 1;
    }
    if (pos > 0) {
        if (anuenue_write_all(line_buf, pos) != 0) { return 0 - 1; }
    }
    return 0;
}

# Longest single sleep the frame loop will take before it re-checks
# for a signal and for the duration deadline.
#
# B-02 / B-03 (v1.3.0). The loop used to sleep the entire frame
# interval in one call and check afterwards. With ANUENUE_FRAME_MS
# fixed at 16 that window was invisible. `-i` makes it user-supplied,
# and two things break at the top of its range:
#
#   * SIGINT / SIGTERM are BLOCKED for the whole animation (they are
#     drained through the signalfd instead), so a long sleep does not
#     merely delay the reaction — the default disposition never fires
#     either. Measured with `-i 3600000`: `timeout` could not kill the
#     process at all. Only SIGKILL worked.
#   * `-d` overshoots by up to one full interval, so `-i 3600000 -d 1`
#     asks for one second and takes an hour.
#
# Slicing the wait fixes both without changing the visible frame rate:
# the total sleep per frame is unchanged, only the granularity at
# which we look up from it. 16 ms keeps Ctrl-C feeling instant and
# costs one extra clock read per slice on a path that is already
# sleeping.
var ANUENUE_TICK_MS = 16;

# ---- signal handling ----------------------------------------------
#
# v1.4.0: the exit-signal fd is darshana's. Through v1.3.6 anuenue
# hand-rolled it (sys_sigprocmask + sys_signalfd with a private
# SFD_NONBLOCK), because darshana's tty_open_signalfd returns a
# BLOCKING fd and the frame loop needs to probe without waiting. The
# copy had drifted behind darshana twice, and both were reproduced on
# the v1.3.6 code before this change (probe: SIGHUP pre-blocked, then
# a forced signalfd failure under `prlimit --nofile=3`):
#
#   * its failure rollback unblocked the WHOLE mask, so a signal that
#     was blocked before animation started came back UNBLOCKED
#     (`hup_blocked=0`). darshana fixed exactly this at 1.0.2 by
#     unblocking only `sigmask & ~prev`;
#   * the fd had no SFD_CLOEXEC (`cloexec=0`), so it would have been
#     inherited across an execve. anuenue never execs, so that one was
#     latent — but it is darshana's discipline and now it is ours.
#
# darshana documents the non-blocking route itself: open with
# tty_open_signalfd, then the stdlib's fd_set_nonblocking (cyrius
# 6.6.8+). Reading goes through tty_read_signal, which answers 0 for
# "nothing pending" on a non-blocking fd, and closing through
# tty_close_signalfd. Nothing here touches a signalfd directly any more.

# The bits of TTY_SIGMASK_EXIT that _open_exit_signalfd itself added to
# the thread's blocked set — the ones that were NOT already blocked
# when animation started. _close_exit_signalfd unblocks exactly these,
# so the mask anuenue leaves behind is the mask it inherited (the same
# `sigmask & ~prev` rule darshana's open applies to its own rollback).
var _ANUENUE_SIG_ADDED = 0;

# The thread's current blocked-signal set, as a Linux sigset_t word.
# SIG_BLOCK with an EMPTY set changes nothing and returns the mask
# through `oldset` — a pure query that needs no descriptor, which is
# what lets tests/probes/sigmask-probe.cyr run under --nofile=3.
# Returns 0 if the query itself fails; the caller then treats every
# exit signal as one it added, the direction that never leaves a signal
# blocked behind it.
fn _sig_blocked_now(): i64 {
    var empty[8];
    var cur[8];
    store64(&empty, 0);
    store64(&cur, 0);
    if (sys_sigprocmask(SIG_BLOCK, &empty, &cur) < 0) { return 0; }
    return load64(&cur);
}

# Open the non-blocking exit-signal fd: SIGHUP / SIGINT / SIGTERM
# (darshana's TTY_SIGMASK_EXIT) blocked and routed to a close-on-exec
# signalfd that the frame loop probes between slices.
#
# Returns the fd on success, -1 on failure. On -1 nothing is left
# behind — no fd, and the signal mask exactly as it was — so the caller
# falls back to no-signal handling: Ctrl-C still kills the process
# normally, just without the cursor-restore tidy-up.
fn _open_exit_signalfd(): i64 {
    #ifndef CYRIUS_TARGET_AGNOS
    var prev = _sig_blocked_now();
    var fd = tty_open_signalfd(TTY_SIGMASK_EXIT);
    if (fd < 0) {
        # B-01 (v1.3.0) was the leak on this path: a failed signalfd(2)
        # left HUP/INT/TERM blocked with no fd to drain them, so Ctrl-C,
        # `kill` and hangup were all inert. darshana rolls its own block
        # back on failure — and, since 1.0.2, only the bits it added —
        # so the -1 needs no cleanup here.
        #
        # Degrading is legitimate, but it was silent through v1.3.0, so a
        # terminal left cursorless after Ctrl-C had no explanation
        # anywhere (same discoverability lesson as A-05). darshana
        # normalises the failure to -1, so there is no errno to report.
        anuenue_log_kv_str(SK_WARN, "signalfd unavailable; animation runs without signal-driven cursor restore",
          "open", "tty_open_signalfd failed");
        return 0 - 1;
    }
    _ANUENUE_SIG_ADDED = TTY_SIGMASK_EXIT & ~prev;
    var fl = fd_set_nonblocking(fd);
    if (fl < 0) {
        # A blocking fd would park the frame loop in read(2) until a
        # signal arrived — the animation would freeze on its first
        # frame. Give the fd back and unblock exactly what we added.
        #
        # ⚠ Unproven, in the cmdit 1.2.4 sense: F_GETFL / F_SETFL on a
        # signalfd this process just opened has no failure anything
        # outside can provoke, so no test reaches this branch. The
        # rollback it uses is the same one _close_exit_signalfd's tests
        # cover.
        tty_close_signalfd(fd, _ANUENUE_SIG_ADDED);
        _ANUENUE_SIG_ADDED = 0;
        anuenue_log_kv_int(SK_WARN,
          "signalfd not made non-blocking; animation runs without signal-driven cursor restore",
          "errno", 0 - fl);
        return 0 - 1;
    }
    return fd;
    #endif
    # agnos: no terminal-signal generation yet (no Ctrl-C → SIGINT), and
    # no fcntl — the stdlib's agnos fd_set_nonblocking answers -ENOSYS —
    # so the non-blocking fd the frame loop needs cannot be made there.
    # Return -1, the documented "fall back to plain exit" contract.
    # (darshana has had an AGNOS tty_open_signalfd and TTY_SIGMASK_EXIT
    # since 0.9.0; the gate is about fcntl, not about darshana.)
    return 0 - 1;
}

# Non-blocking probe: 1 if an exit signal was pending on `sigfd` (it is
# consumed), 0 otherwise — including when `sigfd` is the -1 fallback
# and when the read fails. tty_read_signal answers 0 for "nothing
# pending" on a non-blocking fd, so this never waits.
fn _signal_pending(sigfd): i64 {
    if (sigfd < 0) { return 0; }
    if (tty_read_signal(sigfd) > 0) { return 1; }
    return 0;
}

# Most exit signals _close_exit_signalfd will drain before it unblocks.
# Three can be pending at once (HUP, INT, TERM — standard signals do not
# queue), so 8 always empties the fd, and the cap means a sender in a
# tight `kill` loop cannot hold the teardown in this loop. An enum, not
# an initialized global, per the CLAUDE.md convention.
enum AnuenueSigDrain {
    ANUENUE_SIG_DRAIN_MAX = 8;
}

# Teardown counterpart to _open_exit_signalfd: drain the fd, close it,
# and unblock exactly the signals the open added. Returns 0, or -1 if
# the unblock failed. A no-op returning 0 for the -1 fallback fd.
#
# ⚠ ORDER. This is the LAST step of animation's exit path, after the
# SGR reset, the cursor show and the final newline — darshana's
# teardown order (its ADR 0002, amended at 1.1.4): closing does not
# discard a signal that arrived but was never read, and the unblock
# delivers it at once with its default action, which for HUP/INT/TERM
# terminates the process. Done last, the terminal is already restored.
#
# The drain is anuenue's addition, and it keeps the v1.x exit contract:
# "SIGINT caught → exit 0". The frame loop reads ONE signal per probe,
# so with SIGINT and SIGTERM both pending the second would otherwise be
# delivered here and turn exit 0 into death-by-SIGTERM (143). Through
# v1.3.6 the fd was never closed and the mask never restored, so a
# pending signal simply died with the process; draining first keeps
# that outcome while the mask is now put back as it was found.
fn _close_exit_signalfd(sigfd): i64 {
    if (sigfd < 0) { return 0; }
    var n = 0;
    while (n < ANUENUE_SIG_DRAIN_MAX) {
        if (tty_read_signal(sigfd) > 0) {
            n = n + 1;
        } else {
            n = ANUENUE_SIG_DRAIN_MAX;
        }
    }
    var rc = tty_close_signalfd(sigfd, _ANUENUE_SIG_ADDED);
    _ANUENUE_SIG_ADDED = 0;
    return rc;
}

# ---- _frame_wait --------------------------------------------------
#
# Wait one frame interval, in slices no longer than ANUENUE_TICK_MS,
# checking for an exit signal and for the duration deadline between
# slices. Returns 1 if the frame loop should stop (signal arrived, or
# the deadline passed), 0 to keep animating.
#
# The total sleep is ANUENUE_FRAME_MS either way — this changes the
# granularity at which the loop looks up, not the frame rate. See
# ANUENUE_TICK_MS for why that matters once -i is user-supplied.
#
# `remaining = 0; continue;` rather than `break`: cyrius `break` is
# unreliable in a while loop that declares a `var` in its body
# (CLAUDE.md), and this one declares `slice`.
fn _frame_wait(sigfd, deadline_ns): i64 {
    var remaining = ANUENUE_FRAME_MS;
    var stop = 0;
    while (remaining > 0) {
        var slice = remaining;
        if (slice > ANUENUE_TICK_MS) { slice = ANUENUE_TICK_MS; }
        # Structural guard on the loop's only termination condition.
        # `remaining` decreases by `slice` each pass, so a zero slice
        # is an infinite spin — and unlike every other loop here, this
        # one holds the process inside animation with the exit signals
        # blocked. ANUENUE_TICK_MS is a module constant no public flag
        # can reach and a unit test pins it positive, so this line is
        # defence-in-depth with no failing test behind it: deleting it
        # keeps the suite green. It is one comparison on a path that
        # is about to sleep, against a failure mode that needs SIGKILL.
        if (slice <= 0) { slice = 1; }
        sleep_ms(slice);
        remaining = remaining - slice;

        if (_signal_pending(sigfd) == 1) {
            stop = 1;
            remaining = 0;
            continue;
        }
        if (deadline_ns > 0) {
            if (clock_now_ns() >= deadline_ns) {
                stop = 1;
                remaining = 0;
                continue;
            }
        }
    }
    return stop;
}

# ---- main animate driver ------------------------------------------
#
# Orchestrates input slurp → cluster tag → frame loop. Returns:
#   0 — clean exit (duration elapsed, or SIGINT caught)
#   1 — runtime error (alloc fail, input read error, empty input)
fn anuenue_animate(duration_secs, speed): i64 {
    var in_buf      = alloc(ANUENUE_ANIMATE_INPUT_MAX);
    # +1 slot for the sentinel ctab[n_clusters] = total_bytes
    var ctab        = alloc((ANUENUE_ANIMATE_CLUSTER_MAX + 1) * 8);
    var line_buf    = alloc(ANUENUE_LINE_BUF);
    if (in_buf == 0 || ctab == 0 || line_buf == 0) {
        # A-06 (2026-08-25 audit): v1.2.1 routed the filter and
        # passthrough failures through anuenue_fail but missed the
        # animate path, which kept returning a bare 1 with no message
        # on any fd. Exit codes are unchanged; the failure is now named.
        return anuenue_fail(STIK_ERR_RESOURCE_EXHAUSTED, "animation buffer allocation failed");
    }
    # M5 phase-cached escape table — shared with the filter path.
    if (_phase_esc_init() != 0) {
        return anuenue_fail(STIK_ERR_RESOURCE_EXHAUSTED, "phase escape table allocation failed");
    }

    var n_bytes = _animate_slurp_stdin(in_buf, ANUENUE_ANIMATE_INPUT_MAX);
    if (n_bytes < 0) {
        return anuenue_fail(STIK_ERR_IO, "read from stdin failed");
    }
    ANUENUE_BYTES_IN = ANUENUE_BYTES_IN + n_bytes;
    if (n_bytes == 0) {
        # No input to animate. Quietly exit 0 — same shape as
        # `cat /dev/null | anuenue` (which exits 0 from the filter
        # path too). Animation requires something to colour.
        return 0;
    }

    # A-05 (2026-08-25 audit): both animation caps drop input rather
    # than merely leaving it uncoloured — `_pretag_clusters` writes its
    # sentinel at the byte offset where it stopped, so everything past
    # that offset is never rendered. The caps are deliberate (M4:
    # "render what fit; don't OOM"), but they were undiscoverable: a
    # 200 KB file animated as its first 8 192 clusters with nothing
    # said. Warn on both, so `-v` / `--log-level=warn` explains the
    # missing text instead of leaving the user to guess.
    if (n_bytes >= ANUENUE_ANIMATE_INPUT_MAX) {
        anuenue_log_kv_int(SK_WARN, "animation input truncated at the byte cap; text beyond it is not rendered",
          "byte-cap", ANUENUE_ANIMATE_INPUT_MAX);
    }

    var n_clusters = _pretag_clusters(in_buf, n_bytes, ctab,
      ANUENUE_ANIMATE_CLUSTER_MAX);
    if (n_clusters == 0) { return 0; }
    if (n_clusters >= ANUENUE_ANIMATE_CLUSTER_MAX) {
        anuenue_log_kv_int(SK_WARN, "animation input truncated at the cluster cap; text beyond it is not rendered",
          "cluster-cap", ANUENUE_ANIMATE_CLUSTER_MAX);
    }

    var n_lf = _count_lf_clusters(in_buf, ctab, n_clusters);
    var ends_lf = _input_ends_with_lf(in_buf, ctab, n_clusters);

    # Re-anchor distance: tty_cursor_up steps. Equals LF count when
    # the input ends with LF (cursor lands at the empty row below
    # the last LF, so we need to climb back over every LF). When the
    # input doesn't end with LF, the final partial line doesn't
    # contribute a row to climb over — the trailing CR puts the
    # cursor at col 1 of that same row.
    var rows_to_climb = n_lf;

    var sigfd = _open_exit_signalfd();
    # Hide the cursor for the duration of the animation — without
    # this it flickers visibly between renders. We always pair it
    # with tty_cursor_show on exit (both clean-exit and signal
    # paths) so the user's shell prompt isn't left cursorless.
    tty_cursor_hide();

    var phase_base = ANUENUE_PHASE_START;
    var start_ns = clock_now_ns();
    var deadline_ns = 0;
    var dur = duration_secs;
    if (dur > ANUENUE_MAX_DURATION_S) { dur = ANUENUE_MAX_DURATION_S; }
    if (dur > 0) {
        deadline_ns = start_ns + dur * 1000000000;
    }

    var first_frame = 1;
    var go = 1;
    while (go == 1) {
        if (first_frame == 0) { tty_cursor_up(rows_to_climb); }
        first_frame = 0;

        # E-01: a failed stdout write ends the animation, but the
        # cursor has to come back first or we leave the terminal
        # cursorless — the exact regression the M4 acceptance guards
        # against, reached by a different route than SIGINT.
        if (_render_frame(in_buf, ctab, n_clusters, phase_base, line_buf, ends_lf) != 0) {
            tty_sgr_reset();
            tty_cursor_show();
            # Report before the close: the close is the one step that
            # can deliver a signal (see _close_exit_signalfd), and the
            # message must not depend on surviving it.
            var frc = anuenue_write_failed();
            _close_exit_signalfd(sigfd);
            return frc;
        }

        if (_frame_wait(sigfd, deadline_ns) == 1) { go = 0; continue; }

        phase_base = phase_base + speed;
    }

    # Restore cursor + colour. If we exited mid-frame on a partial
    # line (no trailing LF in input), the cursor sits at col 1 of
    # the last rendered row; emit one LF so the shell prompt opens
    # below the animated block. If the input ended in LF, the
    # cursor's already on a fresh row.
    #
    # The signalfd closes LAST, after every terminal write — darshana's
    # teardown order. Its unblock is the only step that can deliver a
    # signal with its default action, so nothing that restores the
    # terminal may come after it. See _close_exit_signalfd.
    tty_sgr_reset();
    tty_cursor_show();
    var rc = 0;
    if (ends_lf == 0) {
        if (anuenue_write_all("\n", 1) != 0) { rc = anuenue_write_failed(); }
    }
    _close_exit_signalfd(sigfd);
    return rc;
}
