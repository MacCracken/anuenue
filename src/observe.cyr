# src/observe.cyr — observability wiring: sakshi tracing + agnostik
# error shapes. Added at v1.2.1.
#
# WHY THIS FILE EXISTS
#
# sakshi and agnostik have been declared deps since the M0 scaffold
# but no anuenue source file referenced a single symbol from either.
# They were linked in and never called — which is not "a dep we don't
# need", it is "a dep we never wired up". first-party-standards makes
# sakshi the canonical error/tracing crate and agnostik the shared
# Result/Error shapes; anuenue is an AGNOS first-party tool and uses
# them like one. This module is that wiring.
#
# PIPE-PURITY IS NOT NEGOTIABLE (ADR 0001)
#
# Every byte this module can ever emit goes to **fd 2 (stderr)**.
# stdout carries the rainbow and nothing else, in every mode, at
# every verbosity. Two mechanisms enforce it:
#
#   1. `anuenue_observe_init` pins sakshi's output target to
#      `sakshi_set_output_fd(2)`. The file (SK_OUT_FILE) and UDP
#      (SK_OUT_UDP) targets are never selected — that would breach
#      the capability bound in CLAUDE.md ("no file I/O, no network").
#      anuenue's syscall surface stays read/write/brk/exit.
#   2. Logging is OFF by default. sakshi's own default is SK_INFO,
#      which would put info lines on the stderr of every `iam |
#      anuenue` in an MOTD. `anuenue_observe_init` drops the level
#      to ANUENUE-off (below SK_FATAL) unless the user asked for
#      output. A pipe filter is silent until told otherwise.
#
# WHAT LIVES HERE VS IN color.cyr
#
# This module depends on nothing from anuenue — only on sakshi,
# agnostik and the stdlib — so it can be included first and every
# other module can call `anuenue_fail`. The colour-decision reason
# codes (`ANUENUE_CR_*`, `ANUENUE_COLOR_REASON`,
# `anuenue_color_reason_name`) live in src/color.cyr instead: they
# need `ANUENUE_COLOR_*`, and putting them here would make the two
# files mutually dependent.
#
# HOT-PATH DISCIPLINE
#
# Nothing here is called per byte or per cluster. The call sites are
# startup, dispatch, teardown and the error paths — O(1) per process,
# not O(n) per input byte. The v1.2.1 benchmark confirms the filter
# loop is unchanged (see docs/benchmarks.md).

# ---- exit codes ---------------------------------------------------
#
# Moved here from src/main.cyr at v1.2.1 and converted from three
# initialized globals to an enum, per the CLAUDE.md convention
# ("Enum values for constants — don't consume gvar_toks slots").
# Values are unchanged; these are the v1.x public contract.
#
# 0 = normal exit (incl. --help / --version paths)
# 1 = filter runtime error (alloc fail, read error)
# 2 = usage error (unknown flag, missing required value, bad int)
enum AnuenueExit {
    ANUENUE_EXIT_OK    = 0;
    ANUENUE_EXIT_RUN   = 1;
    ANUENUE_EXIT_USAGE = 2;
}

# ---- log-level parse ----------------------------------------------
#
# anuenue's own level scale, one above sakshi's so that "off" has a
# non-negative name (cyrius has no negative literals). The sakshi
# level is always `parse_value - 1`, which lands OFF on (0 - 1) —
# below SK_FATAL (0), so `_sk_log`'s `level > _sk_log_level` test
# suppresses every level including fatal.
enum AnuenueLogParse {
    ANUENUE_LOG_P_OFF   = 0;
    ANUENUE_LOG_P_FATAL = 1;
    ANUENUE_LOG_P_ERROR = 2;
    ANUENUE_LOG_P_WARN  = 3;
    ANUENUE_LOG_P_INFO  = 4;
    ANUENUE_LOG_P_DEBUG = 5;
    ANUENUE_LOG_P_TRACE = 6;
    ANUENUE_LOG_P_BAD   = 7;
}

# ---- module state -------------------------------------------------

# 1 when any log level is active. Gates the span calls, which sakshi
# does NOT level-gate — `sakshi_span_enter` emits unconditionally, so
# calling it while "off" would print ENTER/EXIT lines to the stderr of
# every silent run.
var ANUENUE_VERBOSE = 0;

# Total bytes read from stdin. Accumulated once per read(2), not per
# byte — a few dozen additions across a multi-megabyte stream.
var ANUENUE_BYTES_IN = 0;

# Set when a stdout write returned EPIPE — the consumer closed the pipe.
# Distinguishes "the downstream is done" (a normal pipeline ending) from
# "the write failed" (a real error). See the EPIPE branch in
# anuenue_write_all and the dispatch in anuenue_write_failed.
var ANUENUE_STDOUT_EPIPE = 0;

# ---- _eprint ------------------------------------------------------
#
# Write a null-terminated string to fd 2 using runtime strlen —
# avoids hardcoded byte counts for UTF-8-bearing strings (the brand
# intro carries em-dash + right-arrow + macron-a, each 2–3 bytes).
# Moved here from src/main.cyr at v1.2.1 so the error helpers below
# can reach it; main.cyr's help/usage output still calls it.
fn _eprint(s): i64 {
    var len = strlen(s);
    syscall(1, 2, s, len);
    return 0;
}

# ---- anuenue_write_all ---------------------------------------------
#
# Write `len` bytes from `buf` to stdout, completely. Returns 0 on
# success, -1 if the stream could not be written.
#
# E-01 (2026-08-25 P-1 sweep). This exists because `file_write` is a
# bare `sys_write` — it does not loop on a partial write — and every
# one of anuenue's seventeen stdout writes discarded its return value.
# Two independent, measured consequences, both of which reported
# SUCCESS:
#
#   anuenue < in > /dev/full          -> 100%  of output lost, exit 0
#   anuenue < in > <nonblocking pipe> ->  99.3% of output lost, exit 0
#
# For a filter whose entire contract is "colour the stream without
# altering it", losing the stream and exiting 0 is the worst available
# failure mode. `cat > /dev/full` exits 1 and says why; anuenue is the
# AGNOS-side lolcat and has to hold the same line.
#
# Lives in observe.cyr because src/color.cyr's passthrough needs it and
# color.cyr is included before filter.cyr — observe.cyr is the only
# module every other one can reach (architecture note 004). It also
# sits naturally beside `_eprint` and `anuenue_fail`: this file owns
# the I/O that can fail and must be reported.
#
# Retry policy — the two transient errnos are retried, everything else
# is fatal:
#
#   EINTR  (-4)  a signal interrupted the write before any byte moved.
#                Retry immediately.
#   EAGAIN (-11) stdout is O_NONBLOCK and the consumer has not drained
#                it. anuenue does not own that flag — a caller set it —
#                and the correct response to backpressure is to wait,
#                exactly as a blocking write would. Sleep 1 ms so the
#                retry is not a spin. There is no attempt cap on
#                purpose: a consumer that is alive but slow deserves
#                backpressure, and a consumer that is GONE yields
#                EPIPE, not EAGAIN, which exits below.
fn anuenue_write_all(buf, len): i64 {
    var off = 0;
    while (off < len) {
        var n = file_write(STDOUT, buf + off, len - off);
        if (n > 0) {
            off = off + n;
            continue;
        }
        if (n == (0 - 4)) { continue; }          # EINTR — retry at once
        if (n == (0 - 11)) {                      # EAGAIN — backpressure
            sleep_ms(1);
            continue;
        }
        if (n == (0 - 32)) {                      # EPIPE — consumer closed
            # E-03 (v1.3.4). The downstream is gone. That is the normal
            # end of `anuenue | head -1`, not a failure, and it must
            # look the same whether SIGPIPE is default or ignored.
            #
            # When SIGPIPE has its default disposition the kernel kills
            # us before write(2) ever returns, so this branch is
            # unreachable and the process exits 141 in silence. When a
            # parent has set SIGPIPE to SIG_IGN — which a CI runner
            # does, and which children inherit — write(2) returns
            # -EPIPE instead and this branch is the only thing standing
            # between a routine truncated pipeline and a spurious error.
            #
            # v1.3.3 shipped without it: E-01 classed EPIPE as fatal on
            # the strength of `anuenue | head -1` behaving correctly in
            # a shell where SIGPIPE was default — i.e. for a reason that
            # had nothing to do with the code under test. CI, running
            # with SIGPIPE ignored, executed the branch for the first
            # time and failed.
            ANUENUE_STDOUT_EPIPE = 1;
            return 0 - 1;
        }
        # n == 0 for a non-zero length would mean no progress and no
        # error; treat it as fatal rather than looping forever.
        return 0 - 1;
    }
    return 0;
}

# ---- anuenue_read_some ---------------------------------------------
#
# Read up to `len` bytes from stdin into `buf`. Returns the byte count
# (> 0), 0 on clean EOF, or -1 on a real error.
#
# F-01 (2026-08-26 sweep). The read side is the mirror of E-01, and it
# had the mirror defect: `file_read` is a bare `sys_read` and all three
# stdin call sites classed **any** negative return as fatal. But two
# negatives are transient — they say the data has not arrived, not that
# the stream is broken:
#
#   EAGAIN (-11) stdin is O_NONBLOCK and no data has arrived. Measured
#                before this fix: a slow writer on a non-blocking pipe
#                made anuenue render 64 of 6 500 bytes and exit 1 with
#                "read from stdin failed" — a spurious failure on a
#                perfectly good stream. All three paths (filter,
#                passthrough, animation slurp) did it.
#   EINTR  (-4)  a signal interrupted the read before any byte arrived.
#
# The retry policy matches the write side deliberately: the two sides
# of a filter should not disagree about what counts as an error. EAGAIN
# sleeps 1 ms so the retry is not a spin, with no attempt cap — a
# writer that is slow deserves to be waited for, and a writer that is
# GONE closes the pipe, which is EOF (0), not EAGAIN.
#
# ⚠ The EINTR branch is **unproven**, in the cmdit 1.2.4 sense: anuenue
# installs no signal handlers, and signals at their default disposition
# do not interrupt a blocking read. Verified by driving SIGSTOP,
# SIGCONT, SIGWINCH, SIGCHLD and SIGURG at a process blocked in read —
# none produced EINTR. It is one comparison, it matches the write side,
# and a future consumer that execs anuenue with an inherited handler
# would reach it.
fn anuenue_read_some(buf, len): i64 {
    var go = 1;
    while (go == 1) {
        var n = file_read(STDIN, buf, len);
        if (n >= 0) { return n; }
        if (n == (0 - 4)) { continue; }          # EINTR — retry at once
        if (n == (0 - 11)) {                      # EAGAIN — data has not arrived
            sleep_ms(1);
            continue;
        }
        return 0 - 1;
    }
    return 0 - 1;
}

# Report a failed stdout write and return the process exit code.
# Separate from anuenue_write_all so the hot path stays a bare
# comparison at each call site and the message lives in one place.
#
# Two outcomes share the -1 return from anuenue_write_all, and they are
# not the same event:
#
#   EPIPE  — the consumer closed the pipe. `anuenue | head -1` is the
#            canonical case. Nothing is wrong: stop, say nothing, exit
#            0. This mirrors what the process does when SIGPIPE has its
#            default disposition, where the kernel kills it silently
#            before write(2) returns at all.
#   others — ENOSPC, EBADF, EIO. The stream was lost and the caller has
#            to be told, or anuenue reports success while discarding
#            output (E-01).
fn anuenue_write_failed(): i64 {
    if (ANUENUE_STDOUT_EPIPE == 1) {
        return ANUENUE_EXIT_OK;
    }
    return anuenue_fail(STIK_ERR_IO, "write to stdout failed");
}

# ---- anuenue_log_parse --------------------------------------------
#
# Map a --log-level string to an AnuenueLogParse value. Exact match,
# lowercase only — an unrecognised name returns ANUENUE_LOG_P_BAD
# rather than silently defaulting, because the failure mode of a
# silent default here is a user who asked for debug output, got
# none, and concludes the tool is broken.
fn anuenue_log_parse(s): i64 {
    if (s == 0)                { return ANUENUE_LOG_P_BAD; }
    if (streq(s, "off"))       { return ANUENUE_LOG_P_OFF; }
    if (streq(s, "fatal"))     { return ANUENUE_LOG_P_FATAL; }
    if (streq(s, "error"))     { return ANUENUE_LOG_P_ERROR; }
    if (streq(s, "warn"))      { return ANUENUE_LOG_P_WARN; }
    if (streq(s, "info"))      { return ANUENUE_LOG_P_INFO; }
    if (streq(s, "debug"))     { return ANUENUE_LOG_P_DEBUG; }
    if (streq(s, "trace"))     { return ANUENUE_LOG_P_TRACE; }
    return ANUENUE_LOG_P_BAD;
}

# Human name for an AnuenueLogParse value — used in help text and in
# the bad-value error message.
fn anuenue_log_parse_name(p): i64 {
    if (p == ANUENUE_LOG_P_OFF)   { return "off"; }
    if (p == ANUENUE_LOG_P_FATAL) { return "fatal"; }
    if (p == ANUENUE_LOG_P_ERROR) { return "error"; }
    if (p == ANUENUE_LOG_P_WARN)  { return "warn"; }
    if (p == ANUENUE_LOG_P_INFO)  { return "info"; }
    if (p == ANUENUE_LOG_P_DEBUG) { return "debug"; }
    if (p == ANUENUE_LOG_P_TRACE) { return "trace"; }
    return "invalid";
}

# ---- anuenue_observe_init -----------------------------------------
#
# Resolve the effective verbosity and configure sakshi. Called once
# from main() before any dispatch.
#
#   verbose_flag: 1 if -v / --verbose was passed (shorthand for debug)
#   level_parse:  anuenue_log_parse(--log-level), or ANUENUE_LOG_P_OFF
#                 when the flag was not given
#
# --log-level wins over -v when both are present, so a script can
# say `-v --log-level=trace` and get trace. Returns the resolved
# AnuenueLogParse value.
fn anuenue_observe_init(verbose_flag, level_parse): i64 {
    var p = level_parse;
    if (p == ANUENUE_LOG_P_OFF) {
        if (verbose_flag == 1) { p = ANUENUE_LOG_P_DEBUG; }
    }

    # Pin the sink to stderr before setting any level, so no line can
    # reach a different target even transiently. This is the whole of
    # anuenue's sakshi output configuration — SK_OUT_FILE / SK_OUT_UDP
    # would breach the capability bound and are never selected.
    sakshi_set_output_fd(2);
    sakshi_set_level(p - 1);

    ANUENUE_VERBOSE = 0;
    if (p > ANUENUE_LOG_P_OFF) { ANUENUE_VERBOSE = 1; }
    return p;
}

# ---- gated span helpers -------------------------------------------
#
# sakshi_span_enter / _exit are NOT level-gated inside sakshi — they
# emit whenever they are called. Two consequences anuenue has to
# handle, and both are gates, not one:
#
#   1. A silent run must stay byte-silent, so calling them at all
#      requires logging to be on.
#   2. A span is a *debugging* aid, not a record at every level. A
#      user who asks for `--log-level=error` wants errors; emitting
#      ENTER/EXIT around them is noise that no level would suppress,
#      because sakshi never consults the level for spans.
#
# So spans are gated at debug-or-finer. `--log-level=warn` yields
# exactly the warn-and-above records and nothing else; `-v` (debug)
# and `--log-level=trace` get the span with its elapsed time.
fn anuenue_span_enter(name): i64 {
    if (ANUENUE_VERBOSE == 0) { return 0; }
    if (sakshi_get_level() < SK_DEBUG) { return 0; }
    sakshi_span_enter(name, strlen(name));
    return 0;
}

# Close the innermost open span, emitting its elapsed time. Gated
# identically to anuenue_span_enter — see that function for why both
# gates are needed. Always returns 0.
fn anuenue_span_exit(): i64 {
    if (ANUENUE_VERBOSE == 0) { return 0; }
    if (sakshi_get_level() < SK_DEBUG) { return 0; }
    sakshi_span_exit();
    return 0;
}

# ---- keyed logging ------------------------------------------------
#
# Thin wrappers over sakshi_log_kv that take null-terminated strings
# (anuenue's string shape) instead of explicit byte counts, and an
# i64 value variant that formats through fmt_int_buf. Both return
# early when logging is off so the strlen calls don't run either.

# Emit one keyed record whose value is a null-terminated string.
# Thin wrapper over sakshi_log_kv taking cstrs (anuenue's string
# shape) instead of explicit byte counts. Returns 0 without calling
# strlen when logging is off, so an off run pays nothing for the
# argument expressions it would otherwise measure.
fn anuenue_log_kv_str(level, msg, key, val): i64 {
    if (ANUENUE_VERBOSE == 0) { return 0; }
    sakshi_log_kv(level, msg, strlen(msg), key, strlen(key), val, strlen(val));
    return 0;
}

# Emit one keyed record whose value is an i64, formatted through
# fmt_int_buf into a 24-byte stack scratch (19 digits + sign + NUL,
# the documented requirement). Same off-path short-circuit as
# anuenue_log_kv_str. Always returns 0.
fn anuenue_log_kv_int(level, msg, key, n): i64 {
    if (ANUENUE_VERBOSE == 0) { return 0; }
    var nbuf[24];                            # fmt_int_buf needs 24 bytes: 19 digits + sign + NUL
    var nlen = fmt_int_buf(n, &nbuf);
    sakshi_log_kv(level, msg, strlen(msg), key, strlen(key), &nbuf, nlen);
    return 0;
}

# ---- anuenue_log_version ------------------------------------------
#
# The autogenerated `_VERSION_STR_ANUENUE` carries a trailing LF (it
# is the literal `--version` writes to stdout verbatim). Trim it here
# so the record stays on one line rather than splitting the log.
fn anuenue_log_version(vstr, vlen): i64 {
    if (ANUENUE_VERBOSE == 0) { return 0; }
    sakshi_log_kv(SK_DEBUG, "anuenue", 7, "version", 7, vstr, vlen - 1);
    return 0;
}

# ---- anuenue_fail -------------------------------------------------
#
# The single failure path. Builds an agnostik error for the shared
# kind/code taxonomy, logs it through sakshi (silent unless the user
# asked for output), prints the human-facing line to stderr (always —
# a failing filter must say so even at default verbosity), and
# returns the anuenue exit code that kind maps to.
#
# Exit-code mapping is the v1.x contract, unchanged by this wiring:
#   STIK_ERR_INVALID_ARGUMENT -> 2 (usage)
#   everything else           -> 1 (runtime)
#
# `msg` is an ordinary null-terminated cstr — anuenue's string shape
# everywhere else — and is converted to a `Str` HERE, explicitly.
#
# Why not just declare the parameter `msg: Str` and let the compiler
# coerce the literal at the call site? Because that coercion is not
# reliable in every call position. Measured on cyrius 6.5.35:
#
#     anuenue_fail(KIND, "literal");           # statement  -> coerced, prints
#     return anuenue_fail(KIND, "literal");    # return expr -> NOT coerced
#
# Same function, same literal, same signature — only the position
# differs. Uncoerced, the cstr reaches `agnostik_err_print`, which
# reads it back with `str_data` / `str_len`; `str_data` loads the
# first eight characters AS a pointer and every error prints its
# kind with an empty message:
#
#     anuenue: invalid argument:
#
# Every anuenue call site is a `return anuenue_fail(...)`, so all of
# them were in the broken position. `str_new` costs one 16-byte
# header allocation on a path that is about to exit anyway.
fn anuenue_fail(kind, msg): i64 {
    var mlen = strlen(msg);
    var m    = str_new(msg, mlen);
    if (m == 0) {
        # str_new OOM. Nothing left to allocate with — report bare and
        # bail rather than dereferencing a null Str in err_print.
        _eprint("anuenue: ");
        _eprint(msg);
        _eprint("\n");
        if (kind == STIK_ERR_INVALID_ARGUMENT) { return ANUENUE_EXIT_USAGE; }
        return ANUENUE_EXIT_RUN;
    }
    var e = agnostik_err_new(kind, m);

    # Structured record first — carries the numeric agnostik code, which
    # is the stable machine-readable identity (CODE_IO = 1010 etc.).
    if (ANUENUE_VERBOSE == 1) {
        var nbuf[24];                        # fmt_int_buf needs 24 bytes
        var nlen = fmt_int_buf(agnostik_err_code(e), &nbuf);
        sakshi_log_kv(SK_ERROR, msg, mlen, "code", 4, &nbuf, nlen);
    }

    _eprint("anuenue: ");
    agnostik_err_print(e);
    _eprint("\n");

    if (kind == STIK_ERR_INVALID_ARGUMENT) { return ANUENUE_EXIT_USAGE; }
    return ANUENUE_EXIT_RUN;
}
