# --- termios.cyr ---

# =====================================================================
# darshana — public surface conventions (frozen at v1.0)
# =====================================================================
#
# This header leads `dist/darshana.cyr`, the single-file bundle consumers
# include. It documents the whole library surface, not just this module.
# Per-module and per-function detail follows each symbol below.
#
# Naming conventions (frozen at v1.0):
#   tty_*  public functions        tio_*  termios LE field codec
#   TIO_*  termios bit flags        TTY_*  darshana-defined constants
#   TIOC*  raw kernel ioctl nums    _*     private-by-convention
#                                          (in the bundle, not the API)
#
# Return conventions. Every public fn falls in exactly one of these
# five buckets. (Four through v1.0.1 — which left `tio_load32`,
# `tio_store32` and `tty_close_signalfd` in none of them while the
# sentence claimed all 29 were covered. The codec bucket is the fix.)
#   • validating side-effecting ops — tty_raw, tty_cooked,
#     tty_winsize, tty_move, tty_sgr, tty_fg_rgb, tty_bg_rgb — 0 on
#     success, -1 on failure or out-of-range reject (rejected before
#     any byte reaches fd 1).
#   • unconditional emitters — tty_alt_enter/leave, tty_clear,
#     tty_clear_to_eol/eos, tty_cursor_hide/show/home, tty_sgr_reset,
#     tty_cursor_up/down — ALWAYS 0. The write(2) result is not
#     checked (rationale in ansi.cyr's header). `n <= 0` on
#     tty_cursor_up/down is a documented no-op, not a reject: these
#     never return -1.
#   • `_buf` composers (tty_dec_buf, tty_sgr_buf, tty_sgr_reset_buf,
#     tty_fg_rgb_buf, tty_bg_rgb_buf, tty_fg_256_buf) — the new write
#     position, or -1 on out-of-range input OR on a negative incoming
#     `pos` — so a -1 from an earlier link poisons the rest of the
#     chain rather than being laundered into a write below the buffer.
#     tty_dec_buf additionally clamps `val <= 0` to a single '0'.
#     Each composer documents its own byte budget; none takes a
#     capacity argument, so sizing the buffer is the caller's job.
#   • predicates / fd openers — tty_isatty returns 1/0;
#     tty_open_signalfd returns an fd (>= 0) or exactly -1, never a
#     raw -errno. tty_close_signalfd is the teardown counterpart:
#     0 on success, exactly -1 on failure (also never a raw -errno —
#     normalized in v1.0.2; see its docstring).
#   • termios field codec — tio_load32 returns the zero-extended
#     32-bit field at `off` (never negative, never a failure code);
#     tio_store32 always returns 0. Neither bounds-checks: `buf` and
#     `off` are the caller's contract, deliberately (ADR 0003 records
#     this as knowingly frozen in). They are the only two public fns
#     with no failure mode at all.
#
# Modules in this bundle, by concern:
#   termios.cyr  — termios raw/cooked, winsize, isatty, signalfd, TIO_*
#   ansi.cyr     — alt-screen / clear / cursor-visibility / SGR color
#   cursor.cyr   — tty_dec_buf (decimal formatter), cursor positioning
#
# Symbols prefixed `_` are private by convention — they ship in this
# bundle because it is one compilation unit, but they are NOT public
# surface and may change without a major bump. The authoritative public
# list is `scripts/smoke.sh` (`required_syms` / `required_flags`), which
# CI checks against this bundle in both directions.
#
# =====================================================================

# termios.cyr — Linux raw-mode TTY (TCGETS/TCSETS via ioctl).
#
# Donor port from cyim/src/tty.cyr — verbatim functional behavior, split
# into this file (termios) + ansi.cyr + cursor.cyr per darshana's M1 plan.
# Preserves cyim's public symbol names (tty_raw, tty_cooked, ...) so the
# Phase 4 cyim migration is just a manifest change, not a rename.
#
# Linux kernel termios layout (sizeof = 60 with trailing pad; 36 active
# bytes used). x86_64 and aarch64 Linux share this layout via
# asm-generic/termbits.h:
#
#   off  0  c_iflag   i32   input modes
#   off  4  c_oflag   i32   output modes
#   off  8  c_cflag   i32   control modes
#   off 12  c_lflag   i32   local modes
#   off 16  c_line     u8   line discipline
#   off 17  c_cc[19]   u8   special chars (VTIME @ 22, VMIN @ 23)
#
# macOS (BSD) termios is a different struct and is deliberately out of
# scope (CLAUDE.md domain rules; roadmap.md §"Out of scope") — add it
# when a real consumer needs it, not before.
# The ioctl wrappers below gate to CYRIUS_TARGET_LINUX. ANSI / cursor
# helpers (in ansi.cyr / cursor.cyr) work on any vt100-compatible
# terminal, so the platform gate sits at the syscall boundary, not at
# darshana's surface.

# Termios bit flags (asm-generic/termbits.h; matches x86_64 and aarch64 Linux).
var TIO_ECHO   = 0x008;
var TIO_ICANON = 0x002;
var TIO_ISIG   = 0x001;
var TIO_IEXTEN = 0x8000;
var TIO_ICRNL  = 0x100;
var TIO_IXON   = 0x400;
var TIO_OPOST  = 0x001;
var TIO_CSIZE  = 0x030;
var TIO_CS8    = 0x030;
var TIO_BRKINT = 0x002;
var TIO_INPCK  = 0x010;
var TIO_ISTRIP = 0x020;

# Special-char indices into c_cc[] (relative to start of c_cc, which sits at offset 17).
var TIO_CC_BASE  = 17;
var TIO_VTIME    = 5;
var TIO_VMIN     = 6;

# Termios buffer size. The kernel struct is 36 bytes active, but the ioctl
# write tolerates any size >= 36; 60 covers the historically padded variants
# without straddling a stack red-zone.
#
# Exposed as the canonical name for callers ioctling TCGETS/TCSETS directly
# (e.g., a consumer that wants to read termios state without taking it raw).
# Cyrius requires array sizes to be literals or enum constants, not `var`
# constants, so the internal `_tty_saved[60]` and `work[60]` declarations
# below use the matching literal; if this value ever changes, both sites
# (this constant + the array declarations) must move together.
var TIO_BUF_SIZE = 60;

# Read the 32-bit little-endian field at byte offset `off` inside the
# termios buffer `buf`. Returns the field value as a non-negative
# integer in [0, 0xFFFFFFFF] — the four bytes are zero-extended, never
# sign-extended, so a flag word with the top bit set reads as a large
# positive number rather than a negative one.
#
# Public because a consumer may want to read termios state without
# taking the terminal raw: ioctl `TCGETS` into a `TIO_BUF_SIZE` buffer
# and pull fields out with this. Offsets are the kernel struct's —
# c_iflag 0, c_oflag 4, c_cflag 8, c_lflag 12 (layout table at the top
# of this file).
#
# NO bounds check: `buf` and `off` are the caller's contract. Reading at
# an `off` beyond the buffer reads adjacent memory.
fn tio_load32(buf, off) {
    var b0 = load8(buf + off);
    var b1 = load8(buf + off + 1);
    var b2 = load8(buf + off + 2);
    var b3 = load8(buf + off + 3);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

# Write `val` as a 32-bit little-endian field at byte offset `off`
# inside the termios buffer `buf`. Only the low 32 bits of `val` are
# stored; higher bits are discarded, not an error. Always returns 0 —
# there is no failure mode.
#
# Same caller contract as `tio_load32`: NO bounds check, so an `off`
# beyond the buffer corrupts adjacent memory. Pair it with `tio_load32`
# for a read-modify-write against a `TCGETS` snapshot.
fn tio_store32(buf, off, val) {
    store8(buf + off,     val & 0xFF);
    store8(buf + off + 1, (val >> 8) & 0xFF);
    store8(buf + off + 2, (val >> 16) & 0xFF);
    store8(buf + off + 3, (val >> 24) & 0xFF);
    return 0;
}

# Apply darshana's raw-mode flag mask in place to a 60-byte termios buffer.
# The bit-twiddling half of `tty_raw` extracted as a pure function so it
# can be unit-tested without owning a real TTY fd.
#
# Private (`_`-prefixed) — internal to `tty_raw`, NOT part of darshana's
# public surface. Privatized in v0.7.0: it bakes in darshana's specific
# raw-mode mask, so no consumer has a reason to call it directly, and a
# same-compilation-unit test can still reach it. The pure-function
# split exists for testability, not for the API.
#
# Cleared:
#   c_iflag: BRKINT | ICRNL | INPCK | ISTRIP | IXON
#   c_oflag: OPOST              (post-processing off — \n stays \n)
#   c_lflag: ECHO | ICANON | IEXTEN | ISIG    (key-by-key, no signals)
# Set:
#   c_cflag: CS8                 (8-bit chars; CSIZE cleared first)
#   c_cc[VMIN]  = 1              (read returns after one byte)
#   c_cc[VTIME] = 0              (no read timeout)
#
# ISIG is cleared so Ctrl-C / Ctrl-Z reach the consumer as bytes —
# matches vim convention. Consumers that want kernel signal handling
# (chakshu's render loop is not one of them yet) should clone the
# saved cooked-mode termios and patch c_lflag themselves.
fn _tty_apply_raw_flags(buf) {
    var iflag = tio_load32(buf, 0);
    iflag = iflag & ~(TIO_BRKINT | TIO_ICRNL | TIO_INPCK | TIO_ISTRIP | TIO_IXON);
    tio_store32(buf, 0, iflag);

    var oflag = tio_load32(buf, 4);
    oflag = oflag & ~TIO_OPOST;
    tio_store32(buf, 4, oflag);

    var cflag = tio_load32(buf, 8);
    cflag = (cflag & ~TIO_CSIZE) | TIO_CS8;
    tio_store32(buf, 8, cflag);

    var lflag = tio_load32(buf, 12);
    lflag = lflag & ~(TIO_ECHO | TIO_ICANON | TIO_IEXTEN | TIO_ISIG);
    tio_store32(buf, 12, lflag);

    store8(buf + TIO_CC_BASE + TIO_VMIN, 1);
    store8(buf + TIO_CC_BASE + TIO_VTIME, 0);
    return 0;
}

#ifdef CYRIUS_TARGET_LINUX

# `SYS_IOCTL` is deliberately NOT defined here — it comes from the stdlib
# (`lib/syscalls.cyr` → the per-arch peer), which is arch-aware: 16 on
# x86_64, 29 on aarch64. This gate is `CYRIUS_TARGET_LINUX`, which is
# arch-BLIND, so a local `var SYS_IOCTL = 16` shadowed the stdlib's value
# on aarch64 (last definition wins) and every ioctl below issued 16 —
# which on aarch64-Linux is `fremovexattr`, not `ioctl`. The ELF aarch64
# backend's ESYSXLAT chain has no 16→29 row (its documented cases are
# Mach-O and the fsync/fdatasync pair), and its "syscall not routed"
# warning is Mach-O-only, so the wrong number passed through silently.
# Fixed in v0.9.2. Do not reintroduce a local definition.
#
# The ioctl *request* codes below stay local: they are arch-stable across
# both Linux targets (asm-generic/ioctls.h — x86_64's asm/ioctls.h is a
# bare include of it) and the stdlib does not define them.
# ioctl request codes for reading and writing termios. Public surface:
# a consumer that wants termios state without going raw does
# `syscall(SYS_IOCTL, fd, TCGETS, &buf)` with a `TIO_BUF_SIZE` buffer,
# and can write it back with `TCSETS`. Arch-stable across both Linux
# targets (asm-generic/ioctls.h).
#
# Writing termios yourself is outside darshana's state-restore model:
# `tty_cooked()` restores only what `tty_raw` saved, so a consumer that
# TCSETS behind darshana's back owns undoing it. See ADR 0002.
var TCGETS = 0x5401;
var TCSETS = 0x5402;

# Window-size query — `struct winsize { u16 row, u16 col, u16 xpix, u16 ypix } = 8 bytes`.
# v0.3.0 — added for chakshu's M2 Slice D dynamic resize.
var TIOCGWINSZ = 0x5413;

# Common signal masks for `tty_open_signalfd` — Linux sigset_t is one
# u64 with bit (signum - 1) set per signal in the mask.
#   TTY_SIGMASK_EXIT  = SIGHUP(1) | SIGINT(2) | SIGTERM(15) → bits 0,1,14 → 0x4003
#   TTY_SIGMASK_WINCH = SIGWINCH(28)                         → bit  27     → 0x08000000
# Callers can OR these or build custom masks; the primitive itself is
# mask-agnostic. v0.3.0 — promoted from chakshu's _tui_open_exit_signalfd.
var TTY_SIGMASK_EXIT  = 0x4003;
var TTY_SIGMASK_WINCH = 0x08000000;

# Saved cooked-mode termios. Populated on `tty_raw`; consumed by `tty_cooked`.
# Module-global rather than caller-owned so any exit path (including
# signal handlers and panic paths) can reach it for cleanup without
# threading state. The literal `60` mirrors `TIO_BUF_SIZE` — see that
# constant's docstring for why the duplication exists.
var _tty_saved[60];
var _tty_in_raw = 0;
# The fd `tty_raw` saved state for. There is exactly one saved-state
# slot (`_tty_saved`), so darshana tracks exactly one raw fd at a time;
# `tty_cooked()` restores onto this fd. v0.7.0 — added so `tty_cooked`
# could drop its (previously misleading) fd parameter.
var _tty_raw_fd = 0;

# Enter raw mode on `fd`. Saves the current termios so `tty_cooked()`
# can restore it, and records `fd` as the owning raw fd. Returns 0 on
# success, -1 on ioctl failure (most often: fd is not a TTY).
#
# Single-raw-fd model: there is one saved-state slot, so only one fd
# can be raw at a time. A second call while already raw on the SAME fd
# is an idempotent no-op success; a call on a DIFFERENT fd while still
# raw is REFUSED with -1 (v0.7.0) rather than silently overwriting the
# saved state — overwriting would strand the first fd in raw mode with
# no way to restore it. Call `tty_cooked()` first to release the fd.
fn tty_raw(fd) {
    if (_tty_in_raw == 1) {
        if (fd == _tty_raw_fd) { return 0; }
        return 0 - 1;
    }
    var rc = syscall(SYS_IOCTL, fd, TCGETS, &_tty_saved);
    if (rc < 0) { return 0 - 1; }

    var work[60];                       # size mirrors TIO_BUF_SIZE
    var i = 0;
    while (i < 60) {
        store8(&work + i, load8(&_tty_saved + i));
        i = i + 1;
    }
    _tty_apply_raw_flags(&work);

    var rc2 = syscall(SYS_IOCTL, fd, TCSETS, &work);
    if (rc2 < 0) { return 0 - 1; }
    _tty_raw_fd = fd;
    _tty_in_raw = 1;
    return 0;
}

# Restore cooked mode onto the fd `tty_raw` saved (`_tty_raw_fd`).
# Zero-arg as of v0.7.0: the previous `tty_cooked(fd)` signature
# implied a per-fd restore the single saved-state slot can't deliver
# (tty_raw(A) + tty_cooked(B) would have written A's state onto B), so
# the parameter was dropped. Idempotent: a no-op success when not raw.
#
# On TCSETS failure returns -1 and leaves `_tty_in_raw` set, so the
# caller may retry; until a restore succeeds the terminal is left in
# raw mode (state unspecified from the user's point of view).
#
# A PERMANENTLY failing restore (EBADF once the raw fd is closed,
# ENOTTY after a hangup) strands the slot: `_tty_in_raw` stays 1, so
# `tty_raw` on a DIFFERENT fd is refused for the rest of the process.
# No public reset exists, by design — every consumer's answer to a
# failed restore is to exit. Do NOT retry `tty_cooked()` after the
# original fd number has been closed and reissued: the retry would
# write the dead terminal's saved 60 bytes onto whatever now owns
# that descriptor.
fn tty_cooked() {
    if (_tty_in_raw == 0) { return 0; }
    var rc = syscall(SYS_IOCTL, _tty_raw_fd, TCSETS, &_tty_saved);
    if (rc < 0) { return 0 - 1; }
    _tty_in_raw = 0;
    return 0;
}

# Query terminal dimensions via TIOCGWINSZ. Writes rows + cols into
# the caller's out-pointers. Returns 0 on success, -1 on ioctl
# failure (most often: fd is not a TTY).
#
# Out-pointer contract: `out_rows` and `out_cols` each receive an
# i64 (8 bytes) via `store64`. This is the only darshana primitive
# that writes a fixed-width value through an OUT-PARAMETER — a pointer
# whose only purpose is to receive a result. (`tio_store32` also writes
# a fixed width — 4 bytes — through a caller pointer, but that pointer
# is the termios buffer the caller is editing, not an out-param; the
# corrected wording lands in v1.0.2, which found the older "the only
# darshana primitive that writes a FIXED-WIDTH value through
# caller-supplied pointers" simply false.)
# The six `_buf` composers — tty_dec_buf (cursor.cyr) and tty_sgr_buf
# / tty_sgr_reset_buf / tty_fg_rgb_buf / tty_bg_rgb_buf /
# tty_fg_256_buf (ansi.cyr) — also write through a caller pointer, but
# a VARIABLE number of bytes at `buf + pos`, and none takes a capacity
# argument; each documents its own byte budget. Between them those are
# the surfaces where a malformed pointer corrupts caller memory.
# Callers must pass
# `&var` where `var` is a Cyrius natural — i.e., declared as
# `var rows = 0;`. Passing a pointer to a smaller slot (e.g., a single
# byte inside a struct) will overflow that slot. The values themselves fit in u16 (kernel
# struct field width) and rarely exceed ~1000, but the slot width is
# i64, not u16.
#
# struct winsize layout (Linux):
#   off 0  u16 row     # rows of cells
#   off 2  u16 col     # cols of cells
#   off 4  u16 xpix    # pixel width  (rarely populated; ignored)
#   off 6  u16 ypix    # pixel height (rarely populated; ignored)
#
# v0.3.0 — added for chakshu M2 Slice D (dynamic resize). cyim's
# editor would also benefit if/when it grows resize-aware rendering;
# the cyim 1.7.1 dep bump brings the symbol in but doesn't yet call
# it.
fn tty_winsize(fd, out_rows, out_cols) {
    var ws[8];
    var rc = syscall(SYS_IOCTL, fd, TIOCGWINSZ, &ws);
    if (rc < 0) { return 0 - 1; }
    var rows = load8(&ws + 0) | (load8(&ws + 1) << 8);
    var cols = load8(&ws + 2) | (load8(&ws + 3) << 8);
    store64(out_rows, rows);
    store64(out_cols, cols);
    return 0;
}

# Is `fd` an open TTY? Returns 1 if yes, 0 otherwise — a strict 1/0
# predicate, never a leaked errno. Implemented as the cheapest
# TTY-property syscall: TIOCGWINSZ succeeds only on a TTY. This agrees
# with libc isatty(3) in practice on Linux, though it is NOT the same
# mechanism — glibc's isatty(3) probes via TCGETS (tcgetattr); both
# ioctls succeed exactly on TTYs, so the verdicts match. The 8-byte
# winsize buffer is stack-allocated and discarded; this fn does not
# read its contents (see `tty_winsize` for the variant on the same
# TIOCGWINSZ path that returns the dimensions).
#
# v0.5.3 — added for anuenue M6 color-mode negotiation, which
# previously overloaded `tty_winsize` with dummy out pointers as a
# stand-in (`_isatty_compat`). Same syscall, cleaner surface.
fn tty_isatty(fd) {
    var ws[8];
    var rc = syscall(SYS_IOCTL, fd, TIOCGWINSZ, &ws);
    if (rc < 0) { return 0; }
    return 1;
}

# Block the signals in `sigmask` on this thread and create a signalfd
# that delivers them. Returns the signalfd, or -1 on failure (caller
# should degrade gracefully — falling back to no-signal-handling is
# usually preferable to refusing to launch).
#
# A failed open leaves NO residue: if `signalfd(2)` fails after the
# block landed, the SIG_BLOCK is rolled back before returning, so the
# -1 path needs no caller cleanup. The failure return is always
# exactly -1, never a raw `-errno` (v0.9.3 — through v0.9.2 the
# `signalfd` result was returned unnormalized, so a failing call
# surfaced e.g. -24/EMFILE and left the signals blocked forever).
#
# "No residue" is exact as of v1.0.2, and the distinction matters: the
# rollback unblocks only the signals THIS call actually added to the
# thread mask (`sigmask & ~prev`), not the whole of `sigmask`. Through
# v1.0.1 it unblocked everything requested, so a failed open UNBLOCKED
# a signal the caller had already blocked — including one owned by an
# earlier, still-live darshana signalfd. That is the documented
# multi-signalfd pattern (chakshu holds an EXIT fd and a WINCH fd), and
# the consequence was that the first fd went deaf: with
# TTY_SIGMASK_EXIT the next Ctrl-C killed the process outright instead
# of waking the poll loop, so the consumer's teardown — alt-screen
# leave, cursor show, `tty_cooked()` — never ran and the user landed
# back in a raw, alt-screened shell. Reproduced under RLIMIT_NOFILE=3
# and covered by tests/darshana.tcyr.
#
# The rollback deliberately uses SIG_UNBLOCK of the added bits rather
# than SIG_SETMASK of the captured mask: `how` 0 and 1 are the only
# two values BOTH kernels implement explicitly (agnos/mirshi's
# sigprocmask#17 handles 0 and 1 by name and would treat 2 as a set-
# verbatim fall-through), and unblock-what-you-blocked is the same
# doctrine `tty_close_signalfd` follows.
#
# The SIG_BLOCK installed here persists on the thread until explicitly
# undone — closing the returned fd does NOT unblock the signals. Pair
# every successful call with `tty_close_signalfd(fd, sigmask)` on the
# teardown path (including the SIGINT/SIGTERM exit path) to close the
# fd and unblock the signals in `sigmask`.
#
# `sigmask` is a single u64 representing a Linux sigset_t (bit N set
# = signal N+1 in the mask). Common values are exposed as constants:
# TTY_SIGMASK_EXIT for HUP/INT/TERM cleanup, TTY_SIGMASK_WINCH for
# resize. Callers can OR them or build custom masks.
#
# Avoids the rt_sigaction x86_64 sa_restorer trampoline trap by
# routing signals to a regular fd instead of installing synchronous
# handlers — pure syscall, no inline assembly needed.
#
# v0.3.0 — promoted from chakshu's `_tui_open_exit_signalfd` after
# chakshu became the second consumer needing the same machinery
# (Slice D adds SIGWINCH handling — same pattern, different mask).
fn tty_open_signalfd(sigmask) {
    var mask[8];
    # `store64` writes all 8 bytes of `mask`, so no pre-zero loop is
    # needed (one shipped here through v0.9.2 and was pure dead store).
    store64(&mask, sigmask);
    # Capture the mask in force on entry (v1.0.2) so the failure path
    # can put back exactly what it changed. `prev` is pre-zeroed: on a
    # kernel that left oldset untouched we would rather compute an
    # empty prior mask (and unblock everything we asked for, the old
    # v1.0.1 behaviour) than read stack garbage.
    var prev[8];
    store64(&prev, 0);
    # SIG_BLOCK = 0 (the `how` arg to sigprocmask)
    var rc = sys_sigprocmask(0, &mask, &prev);
    if (rc < 0) { return 0 - 1; }
    # signalfd(fd=-1, mask, SFD_CLOEXEC) → new fd. CLOEXEC so the
    # signalfd does not leak across an execve — a consumer that takes
    # over the screen and later spawns a child (editor shelling out,
    # pager, $SHELL) must not hand this fd to it. SFD_CLOEXEC is the
    # stdlib SfdFlag enum value (0x80000); same CLOEXEC discipline the
    # stdlib's epoll/eventfd wrappers follow.
    var sfd = sys_signalfd(0 - 1, &mask, SFD_CLOEXEC);
    if (sfd < 0) {
        # SIG_UNBLOCK = 1. Roll the block back: the caller gets no fd,
        # so it has nothing to hand `tty_close_signalfd` and would
        # otherwise run with these signals blocked for the whole
        # process lifetime. This also normalizes the raw `-errno` the
        # bare syscall passthrough surfaces into the documented -1.
        #
        # Unblock ONLY what this call added (`sigmask & ~prev`), so a
        # signal the caller had already blocked — e.g. one an earlier
        # live signalfd owns — is left blocked. See the docstring.
        var added[8];
        store64(&added, sigmask & ~load64(&prev));
        sys_sigprocmask(1, &added, 0);
        return 0 - 1;
    }
    return sfd;
}

# Teardown counterpart to `tty_open_signalfd`: close `fd` and UNblock
# the signals in `sigmask`. Closing the fd alone is not enough — the
# SIG_BLOCK would otherwise persist and the consumer's signals stay
# silently blocked after its UI exits (e.g. a parent that resumes once
# the TUI returns). Pass the SAME `sigmask` that was passed to
# `tty_open_signalfd`.
#
# This UNBLOCKS; it does not RESTORE. `tty_open_signalfd` passes
# oldset = NULL, so the prior mask is never captured — a signal that
# was ALREADY blocked by the caller before the open is left UNBLOCKED
# after the matching close. That is deliberate, not an oversight:
# unblock-what-you-blocked composes when a consumer holds two
# signalfds at once (chakshu opens an EXIT one and a WINCH one), where
# a save-and-SIG_SETMASK restore would have the first close stomp the
# second one's blocks.
#
# The fd is closed unconditionally (best-effort); the return reflects
# the mask restore — 0 on success, exactly -1 if sigprocmask fails,
# never a raw `-errno`. v0.7.0 — added so the open primitive isn't
# frozen at v1.0 without its teardown counterpart (chakshu's
# signalfd-driven exit is the first consumer).
#
# The -1 normalization landed in v1.0.2. v0.9.3 normalized
# `tty_open_signalfd`'s sentinel and missed its teardown twin, which
# went on returning `sys_sigprocmask`'s bare syscall result — so a
# failure surfaced as e.g. -22/EINVAL where this docstring promised -1,
# and the AGNOS peer (whose kernel already normalizes) disagreed with
# the Linux one on a contract both claimed to share. Latent rather than
# live: `rt_sigprocmask(SIG_UNBLOCK, <valid stack ptr>, NULL, 8)` has no
# reachable failure mode here. Fixing the code to match the frozen
# docstring is a patch under ADR 0003, which names exactly this case.
fn tty_close_signalfd(fd, sigmask) {
    file_close(fd);
    var mask[8];
    store64(&mask, sigmask);
    # SIG_UNBLOCK = 1 (the `how` arg to sigprocmask)
    var rc = sys_sigprocmask(1, &mask, 0);
    if (rc < 0) { return 0 - 1; }
    return 0;
}

#endif

#ifdef CYRIUS_TARGET_AGNOS

# AGNOS terminal window size. agnos has no `ioctl(TIOCGWINSZ)` (its frozen
# syscall surface has no ioctl), so the kernel instead exposes the live
# framebuffer console grid directly via syscall #60 (`winsize`). It returns the
# two counts packed into one i64 — high 16 bits = cols, low 16 bits = rows — or
# -1 if the framebuffer isn't up. This is the agnos peer of the Linux
# `tty_winsize` above and preserves its contract EXACTLY: writes rows + cols
# through the caller's out-pointers (each an i64 via `store64`), returns 0 on
# success / -1 on failure. So consumers (kii / chakshu) call one `tty_winsize`
# and the platform branch is invisible to them — kii drops its
# `#ifndef CYRIUS_TARGET_AGNOS` gate and gets the real console grid on agnos,
# falling back to its 80×24 default only when this returns -1.
#
# `fd` is accepted for signature parity with the Linux variant but ignored: the
# console grid is a global property of the framebuffer, not a per-fd attribute.
#
# Raw `syscall(60, ...)` is correct here and needs no cyrius stdlib `sys_*`
# wrapper — this branch only compiles for agnos, where 60 unambiguously means
# `winsize` (the Linux↔agnos syscall-number-overlap hazard can't bite a number
# used inside its own target's `#ifdef`). The kernel ignores the argument; a
# dummy `0` is passed to satisfy the `syscall()` builtin's arg shape.
# Underscore-prefixed (v0.9.3): these are darshana INTERNALS, not public
# surface. They ship in `dist/darshana.cyr` like everything else, so the
# `_` keeps them out of the frozen `TIO_* / TIOC* / TTY_*` constant
# namespace and out of `scripts/smoke.sh`'s constant contract list. No
# consumer references them (verified across all five consumer trees).
var _AGNOS_SYS_WINSIZE = 60;

# AGNOS peer of `tty_winsize`. Writes rows + cols through the caller's
# out-pointers (each an i64 via `store64`) and returns 0 on success, -1 if
# the framebuffer console is not up — the Linux contract exactly. `fd` is
# accepted for signature parity and ignored: the console grid is a global
# framebuffer property, not a per-fd attribute. See the long-form rationale
# in the block above this constant.
#
# (This docstring is new in v1.0.2. The peer shipped from v0.8.0 with its
# rationale attached to `_AGNOS_SYS_WINSIZE` rather than to the function, so
# `scripts/smoke.sh`'s docstring audit — which reads the comment block
# immediately above each `fn` — saw nothing here. It did not fail, because
# that audit de-duplicated by symbol name and the Linux `tty_winsize` had
# already satisfied it; the de-dup is removed in the same release.)
fn tty_winsize(fd, out_rows, out_cols) {
    var packed = syscall(_AGNOS_SYS_WINSIZE, 0);
    if (packed < 0) { return 0 - 1; }
    var rows = packed & 0xFFFF;
    var cols = (packed >> 16) & 0xFFFF;
    store64(out_rows, rows);
    store64(out_cols, cols);
    return 0;
}

# AGNOS TTY predicate. agnos has no ioctl(TCGETS/TIOCGWINSZ), but the framebuffer
# console-grid syscall (#60, `winsize`) succeeds iff the console is up — the same
# "a window-size query succeeds only on a real terminal" mechanism the Linux
# `tty_isatty` above relies on (TIOCGWINSZ). So the agnos peer treats a
# successful `winsize` as "is a tty", preserving the Linux 1/0 verdict. `fd` is
# ignored: the console grid is a global framebuffer property, not per-fd.
#
# Returns 1 if the console is up, 0 otherwise — a strict 1/0 predicate, never
# a leaked errno, exactly as the Linux peer promises.
fn tty_isatty(fd) {
    if (syscall(_AGNOS_SYS_WINSIZE, 0) < 0) { return 0; }
    return 1;
}

# AGNOS raw-mode enter. agnos has no termios (no TCGETS/TCSETS), so there is no
# canonical/raw toggle to flip — the kernel console runs its own line discipline.
# Return -1, at parity with the Linux "couldn't enter raw" failure, so consumers
# take their designed fallback: a full-screen char-at-a-time TUI can't run on
# agnos yet, so thoth/chakshu drop to their line REPL when tty_raw returns < 0.
# When agnos grows a raw-input mechanism this becomes its real peer; until then
# -1 is the honest verdict — a silent success would strand the caller waiting on
# per-key input that never arrives.
fn tty_raw(fd) {
    return 0 - 1;
}

# AGNOS cooked-mode restore. The no-op counterpart to the agnos `tty_raw`: raw
# was never entered (no termios state to restore), so this is an idempotent
# success — matching the Linux `tty_cooked` "no-op when not raw" contract.
#
# Always returns 0; there is no failure mode on this arm.
fn tty_cooked() {
    return 0;
}

# AGNOS signal masks for `tty_open_signalfd`. agnos/mirshi represent a signal
# SET as `1 << sig` (bit N = signal N) — NOT Linux's `1 << (sig-1)` sigset_t
# layout — so these values DIFFER from the Linux branch above by one bit
# position per signal. mirshi's sigprocmask#17 / signalfd#18 store the mask
# verbatim and its delivery walk (`_sig_lowest`) tests bit `sig` directly
# (mirshi children.cyr: "the per-child … mask (agnos `1<<sig`)"). Copying the
# Linux 0x4003 / 0x08000000 here would silently watch the wrong signals.
#   TTY_SIGMASK_EXIT  = SIGHUP(1) | SIGINT(2) | SIGTERM(15) → bits 1,2,15 → 0x8006
#   TTY_SIGMASK_WINCH = SIGWINCH(28)                        → bit  28     → 0x10000000
var TTY_SIGMASK_EXIT  = 0x8006;
var TTY_SIGMASK_WINCH = 0x10000000;

# AGNOS syscall numbers for the signalfd path — mirshi supervisor-emulates both
# (#17 sigprocmask, #18 signalfd). Raw `syscall(N, ...)` inside this agnos-only
# branch is correct and needs no cyrius stdlib `sys_*` wrapper — same rationale
# as _AGNOS_SYS_WINSIZE above: the Linux↔agnos syscall-number-overlap hazard
# can't bite a number used inside its own target's `#ifdef`.
var _AGNOS_SYS_SIGPROCMASK = 17;   # sigprocmask(how, set_ptr, oldset_ptr) → 0/-1
var _AGNOS_SYS_SIGNALFD    = 18;   # signalfd(fd, mask_ptr, flags) → fd/-1
# SFD_CLOEXEC — carried for intent parity with the Linux peer's CLOEXEC
# discipline. mirshi's MVP signalfd is an opaque supervisor-side fd (no execve
# fd-inheritance across the ptrace boundary) and is always non-blocking, so it
# stores `flags` but does not act on them; the value is preserved for honesty.
var _AGNOS_SFD_CLOEXEC = 0x80000;

# AGNOS peer of `tty_open_signalfd`. Blocks the signals in `sigmask` on this
# thread (sigprocmask#17, SIG_BLOCK=0) then creates an emulated signalfd
# (signalfd#18, fd=-1 → allocate a new slot). Returns the emulated fd (>= 0) or
# -1 on failure. Preserves the Linux peer's contract EXACTLY so consumers call
# one `tty_open_signalfd` and the platform branch is invisible to them.
#
# mirshi's signalfd is edge-triggered + NON-BLOCKING: the caller polls it via
# epoll_wait#21 / read#5 rather than blocking on the fd — the same poll-driven
# usage the Linux peer's consumers already follow. `sigmask` is an agnos
# `1<<sig` set (see TTY_SIGMASK_* above), an 8-byte word like the Linux path.
fn tty_open_signalfd(sigmask) {
    var mask[8];
    store64(&mask, sigmask);
    # Capture the entry mask (v1.0.2) — mirshi's sigprocmask#17 honours
    # a non-NULL oldset_ptr (`if (arg3 != 0) { store64(arg3, old_mask); }`).
    # Pre-zeroed for the same reason as the Linux peer.
    var prev[8];
    store64(&prev, 0);
    # SIG_BLOCK = 0 (the `how` arg to sigprocmask)
    var rc = syscall(_AGNOS_SYS_SIGPROCMASK, 0, &mask, &prev);
    if (rc < 0) { return 0 - 1; }
    # signalfd(fd=-1, mask, SFD_CLOEXEC) → new emulated fd.
    var sfd = syscall(_AGNOS_SYS_SIGNALFD, 0 - 1, &mask, _AGNOS_SFD_CLOEXEC);
    if (sfd < 0) {
        # SIG_UNBLOCK = 1 — roll the block back, exactly as the Linux
        # peer does. mirshi already normalizes its failures to -1, so
        # only the rollback is substantive here; the shape is kept
        # identical so the two peers stay readable side by side.
        #
        # Unblock only the bits this call added, matching the Linux
        # peer (v1.0.2). mirshi implements how 0 and 1 by name, so this
        # needs no SIG_SETMASK — which mirshi would only honour as an
        # unnamed store-verbatim fall-through.
        var added[8];
        store64(&added, sigmask & ~load64(&prev));
        syscall(_AGNOS_SYS_SIGPROCMASK, 1, &added, 0);
        return 0 - 1;
    }
    return sfd;
}

# AGNOS peer of `tty_close_signalfd`: close `fd` and UNblock the signals in
# `sigmask` (sigprocmask#17, SIG_UNBLOCK=1). Closing the fd alone is not enough
# — the SIG_BLOCK would persist and the consumer's signals stay silently
# blocked after its UI exits. Like the Linux peer this UNBLOCKS rather than
# restoring a captured mask; see that docstring for why.
# Pass the SAME `sigmask` given to `tty_open_signalfd`. The fd is closed
# unconditionally (best-effort); the return reflects the mask restore — 0 on
# success, exactly -1 if sigprocmask fails. Mirrors the Linux peer above.
#
# mirshi already normalizes its own failures to -1, so the explicit clamp
# below is redundant TODAY. It is written anyway (v1.0.2) so the two peers
# are structurally identical: the Linux twin needed the clamp, and a peer
# that merely happens to agree because its kernel is well-behaved is one
# kernel change away from silently diverging on a frozen contract.
fn tty_close_signalfd(fd, sigmask) {
    file_close(fd);
    var mask[8];
    store64(&mask, sigmask);
    # SIG_UNBLOCK = 1 (the `how` arg to sigprocmask)
    var rc = syscall(_AGNOS_SYS_SIGPROCMASK, 1, &mask, 0);
    if (rc < 0) { return 0 - 1; }
    return 0;
}

#endif

# --- ansi.cyr ---

# ansi.cyr — vt100-compatible ANSI escape helpers.
#
# Donor port from cyim/src/tty.cyr — the alt-screen / clear / cursor-
# visibility helpers. These work on any modern terminal (xterm, kitty,
# wezterm, the Linux console) regardless of the host OS, so they're
# NOT inside the CYRIUS_TARGET_LINUX gate that termios.cyr uses.
#
# Each fixed-escape helper writes its sequence to fd 1 (stdout)
# directly via `syscall(1, ...)` and returns 0 unconditionally —
# best-effort: the write(2) result is not checked. A 3–8 byte escape
# to a TTY does not partial-write in practice, and a consumer mid-
# render has no meaningful recovery from a failed escape, so the
# emitters keep their call sites clean rather than thread an error.
# The `_buf` composers in this file (and `tty_dec_buf` in cursor.cyr)
# are the batching answer for frame-coalesced writes: compose into a
# caller buffer and issue one write(2) at frame end.

# Switch to the alt-screen buffer. CSI ?1049h. Saves the primary
# screen state; the consumer's UI lives on the alt-screen and the
# user's previous shell content is restored on tty_alt_leave().
# Returns 0 (the write(2) result is not checked — see this file's header).
fn tty_alt_enter() {
    syscall(1, 1, "\x1b[?1049h", 8);
    return 0;
}

# Leave the alt-screen buffer, restoring the primary. CSI ?1049l.
# Pair with tty_alt_enter() on every exit path including SIGINT/SIGTERM.
# Returns 0.
fn tty_alt_leave() {
    syscall(1, 1, "\x1b[?1049l", 8);
    return 0;
}

# Clear the entire visible screen. CSI 2J. Doesn't move the cursor —
# pair with tty_cursor_home() if you want top-left.
# Returns 0.
fn tty_clear() {
    syscall(1, 1, "\x1b[2J", 4);
    return 0;
}

# Clear from cursor to end of current line. CSI K. Used in render
# loops to wipe any leftover characters from a previous frame on the
# current row (e.g., a process row that was longer last tick).
# v0.3.0 — promoted from chakshu's _tui_clear_eol.
# Returns 0.
fn tty_clear_to_eol() {
    syscall(1, 1, "\x1b[K", 3);
    return 0;
}

# Clear from cursor to end of screen. CSI J. Used at the bottom of a
# frame to wipe rows that were populated last tick but not this one
# (e.g., process count dropped between frames).
#
# Named `_to_eos` (end-of-screen) to parallel `tty_clear_to_eol`
# (end-of-line) — the suffix names the extent at the call site, so a
# consumer can't misread a full-screen-tail wipe as a line wipe.
# v0.3.0 — promoted from chakshu's `_tui_clear_to_end`; renamed from
# `tty_clear_to_end` in v0.7.0 to remove that ambiguity before the
# v1.0 freeze (emitted bytes unchanged — still CSI J).
# Returns 0.
fn tty_clear_to_eos() {
    syscall(1, 1, "\x1b[J", 3);
    return 0;
}

# Hide the text cursor. CSI ?25l. Pair with tty_cursor_show() on exit
# or the user's shell prompt comes back without a visible cursor.
# Returns 0.
fn tty_cursor_hide() {
    syscall(1, 1, "\x1b[?25l", 6);
    return 0;
}

# Show the text cursor. CSI ?25h.
# Returns 0.
fn tty_cursor_show() {
    syscall(1, 1, "\x1b[?25h", 6);
    return 0;
}

# Move cursor to row 1, col 1. CSI H. Cheaper than tty_move(1, 1)
# because no decimal formatting / parameter encoding.
# Returns 0.
fn tty_cursor_home() {
    syscall(1, 1, "\x1b[H", 3);
    return 0;
}

# ---- SGR (Select Graphic Rendition) color helpers --------------------
#
# v0.3.5 — added for the bannermanor M5 (`bnrmr --color cyan TEXT`).
# 8/16 named ANSI foreground colors — the original figlet-equivalent
# banner-tinting case. The 256-color and 24-bit tiers landed later in
# this same file as consumers asked: truecolor v0.5.1, 256-color
# v0.5.3, both driven by anuenue (not chakshu/bannermanor, as this
# note predicted). See the sections below.
#
# Usage:
#     tty_sgr(TTY_FG_CYAN);        # set foreground to cyan
#     syscall(1, 1, "AGNOS", 5);   # write colored text
#     tty_sgr_reset();             # clear back to default
#
# Idempotency: consumers are responsible for emitting tty_sgr_reset()
# before the terminal returns to the shell prompt; darshana does not
# install an exit handler. Same discipline as tty_cursor_show().

# Foreground color SGR parameter values. 30–37 are the base 8;
# 90–97 are the "bright" / high-intensity variants. Module-level
# `var` declarations follow darshana's existing TIO_* / TTY_SIGMASK_*
# convention so the smoke.sh surface check picks them up.
var TTY_FG_BLACK   = 30;
var TTY_FG_RED     = 31;
var TTY_FG_GREEN   = 32;
var TTY_FG_YELLOW  = 33;
var TTY_FG_BLUE    = 34;
var TTY_FG_MAGENTA = 35;
var TTY_FG_CYAN    = 36;
var TTY_FG_WHITE   = 37;
var TTY_FG_BRIGHT_BLACK   = 90;
var TTY_FG_BRIGHT_RED     = 91;
var TTY_FG_BRIGHT_GREEN   = 92;
var TTY_FG_BRIGHT_YELLOW  = 93;
var TTY_FG_BRIGHT_BLUE    = 94;
var TTY_FG_BRIGHT_MAGENTA = 95;
var TTY_FG_BRIGHT_CYAN    = 96;
var TTY_FG_BRIGHT_WHITE   = 97;

# Reset all SGR attributes (color, bold, underline, etc.). CSI 0m.
# Cheaper than tty_sgr(0) — no decimal formatting.
# Returns 0.
fn tty_sgr_reset() {
    syscall(1, 1, "\x1b[0m", 4);
    return 0;
}

# ---- 24-bit (truecolor) SGR helpers ---------------------------------
#
# v0.5.1 — added for anuenue's M1 (the rainbow pipe-filter). anuenue's
# per-character HSV phase cycle needs `\x1b[38;2;R;G;Bm` directly;
# 8/16 named colors quantize the rainbow into ROYGBIV-with-banding,
# 256-color is the M6 fallback path.
#
# Why both "direct" and "_buf" variants:
# - Direct (`tty_fg_rgb` / `tty_bg_rgb`) is a one-shot — formats into
#   a stack buf and calls write(2) once. Same shape as `tty_sgr`.
# - `_buf` variants append into a caller-provided buffer and return
#   the new write position. Used by pipe filters that batch many
#   escapes + payload bytes into a single line-sized write to avoid
#   per-character syscall overhead. anuenue's M1 loop is the first
#   and so far only `_buf` consumer; chakshu's draw path still uses
#   the direct fd-1 emitters.
#
# Escape layout (foreground): `CSI 38;2;<R>;<G>;<B>m` — 19 bytes max
# (ESC[ + "38;2;" + "255" * 3 + ";" * 2 + "m"). Background swaps "38"
# for "48"; same length envelope. Stack buf[24] gives ~5 bytes
# headroom for safety; the _buf variants assume the caller sized for
# 19 per emission.
#
# Contract: r, g, b each in `[0, 255]`. Out-of-range channels return
# -1 (or -1 from the _buf variants — the new position is non-
# negative on success). Same fail-before-emit discipline as
# `tty_sgr`'s `[0, 999]` guard added in v0.4.0.

# ---- digit encoding in the composers (v1.1.0) -----------------------
#
# `_ansi_emit_u8` is GONE. It was darshana's second decimal emitter —
# `tty_dec_buf` (cursor.cyr) is the first — and v1.0.2 recorded that
# collapsing the two was a byte-identical refactor worth taking at the
# next minor. It was taken here, but NOT the obvious way, and the
# measurements are recorded because the obvious way is a trap.
#
# Delegating the five call sites to `tty_dec_buf` is byte-identical
# (proven exhaustively) and **44% SLOWER**: 20M `tty_fg_rgb_buf` calls
# went 983 ms -> 1418 ms, `tty_fg_256_buf` 468 -> 605, `tty_sgr_buf`
# 354 -> 511. `tty_dec_buf` is a general i64 formatter — it reverses
# digits through a 24-byte scratch array and copies them back — where
# these composers only ever emit 1-3 digits.
#
# So the duplication was removed by ELIMINATION instead: the 1-3 digit
# sequence is written inline at each of the five sites, and the shared
# helper is deleted. Nothing in the library now carries a second
# decimal-emitter FUNCTION, and every composer got faster.
#
# ⚠ This deliberately re-expands what v0.9.3 deduplicated, so the
# reason is recorded here to stop the next sweep re-collapsing it: the
# cost is the CALL, not the arithmetic. cycc's prologue unconditionally
# spills rbx/r12/r13/r14/r15 even in a leaf function that touches none
# of them, so `_ansi_rgb_buf` paid ~30 wasted memory ops per call for
# its three digit emissions. If cycc ever grows a leaf-function
# prologue optimization, re-collapsing these becomes free and correct —
# measure before assuming it still is.
#
# ⛔ Do NOT replace the divisions with reciprocal multiplication.
# `(val*41)>>12` for /100 and `(val*205)>>11` for /10 are exact over
# this domain and were measured SLOWER (1040 ms vs 1000 ms): the extra
# multiply/shift nodes cost more in cycc's stack machine than Zen3's
# idiv on small operands saves. anuenue's src/filter.cyr asserts the
# divides dominate here; that is wrong, and this note is the reply.
#
# Digit domain is `[0, 999]` — `tty_sgr_buf` feeds codes up to 999
# (its own frozen envelope). Every call site validates its own range
# and rejects `pos < 0` first, so a negative value is unreachable and
# is not defended against inline.

# Shared body for the fg/bg 24-bit composers. `layer` is the ASCII
# digit selecting the plane: 51 ('3') = foreground, 52 ('4') =
# background. Everything else about the two escapes is identical, so
# they differed by exactly one byte — parameterizing it (v0.9.3)
# collapses two 19-line verbatim copies into one body.
#
# Returns the new write position, or -1 on a rejected input. Bounds
# rejection is per-channel: the first out-of-range channel
# short-circuits, no partial write occurs. A negative incoming `pos`
# is rejected the same way.
#
# v1.1.0 rewrote the body for speed without moving a byte: the 7-byte
# fixed prefix is one store, and the three digit emissions are inline
# (see the section note above). 20M calls: 983 ms -> 698 ms, -29%.
fn _ansi_rgb_buf(buf, pos, layer, r, g, b) {
    if (pos < 0) { return 0 - 1; }
    if (r < 0 || r > 255) { return 0 - 1; }
    if (g < 0 || g > 255) { return 0 - 1; }
    if (b < 0 || b > 255) { return 0 - 1; }
    # `ESC [ <layer> 8 ; 2 ;` in one unaligned 8-byte store instead of
    # seven store8+increment pairs. The 8th byte is always overwritten
    # immediately by the first digit of R: the shortest escape this
    # composer can produce is 13 bytes, so [pos, pos+8) is strictly
    # inside it and nothing outside the result is touched.
    store64(buf + pos, 27 | (91 << 8) | (layer << 16) | (56 << 24)
                          | (59 << 32) | (50 << 40) | (59 << 48));
    pos = pos + 7;
    if (r >= 100) {
        store8(buf + pos, 48 + r / 100);          pos = pos + 1;
        store8(buf + pos, 48 + (r / 10) % 10);    pos = pos + 1;
        store8(buf + pos, 48 + r % 10);           pos = pos + 1;
    } else { if (r >= 10) {
            store8(buf + pos, 48 + r / 10);       pos = pos + 1;
            store8(buf + pos, 48 + r % 10);       pos = pos + 1;
        } else {
            store8(buf + pos, 48 + r);            pos = pos + 1;
        } }
    store8(buf + pos, 59);    pos = pos + 1;      # ';'
    if (g >= 100) {
        store8(buf + pos, 48 + g / 100);          pos = pos + 1;
        store8(buf + pos, 48 + (g / 10) % 10);    pos = pos + 1;
        store8(buf + pos, 48 + g % 10);           pos = pos + 1;
    } else { if (g >= 10) {
            store8(buf + pos, 48 + g / 10);       pos = pos + 1;
            store8(buf + pos, 48 + g % 10);       pos = pos + 1;
        } else {
            store8(buf + pos, 48 + g);            pos = pos + 1;
        } }
    store8(buf + pos, 59);    pos = pos + 1;      # ';'
    if (b >= 100) {
        store8(buf + pos, 48 + b / 100);          pos = pos + 1;
        store8(buf + pos, 48 + (b / 10) % 10);    pos = pos + 1;
        store8(buf + pos, 48 + b % 10);           pos = pos + 1;
    } else { if (b >= 10) {
            store8(buf + pos, 48 + b / 10);       pos = pos + 1;
            store8(buf + pos, 48 + b % 10);       pos = pos + 1;
        } else {
            store8(buf + pos, 48 + b);            pos = pos + 1;
        } }
    store8(buf + pos, 109);   pos = pos + 1;      # 'm'
    return pos;
}

# One-shot writer shared by `tty_fg_rgb` / `tty_bg_rgb`. Composes into
# a 24-byte stack buffer (19-byte worst case) and issues one write(2).
fn _ansi_rgb_write(layer, r, g, b) {
    var buf[24];
    var pos = _ansi_rgb_buf(&buf, 0, layer, r, g, b);
    if (pos < 0) { return 0 - 1; }
    syscall(1, 1, &buf, pos);
    return 0;
}

# Append `CSI 38;2;R;G;Bm` to `buf` at `pos` — set FOREGROUND to the
# 24-bit color (r, g, b). Returns the new write position, or -1 if any
# channel is outside [0, 255] or `pos` is negative. Byte budget: up to
# 19. Composes only; touches no fd. Use `tty_fg_rgb` for the one-shot.
fn tty_fg_rgb_buf(buf, pos, r, g, b) {
    return _ansi_rgb_buf(buf, pos, 51, r, g, b);      # '3' = foreground
}

# Append `CSI 48;2;R;G;Bm` to `buf` at `pos` — the BACKGROUND twin of
# `tty_fg_rgb_buf`. Same contract, same 19-byte budget: returns the new
# write position, or -1 on an out-of-range channel or negative `pos`.
fn tty_bg_rgb_buf(buf, pos, r, g, b) {
    return _ansi_rgb_buf(buf, pos, 52, r, g, b);      # '4' = background
}

# Append `CSI 0m` to `buf` at `pos`. Returns the new `pos`, or -1 if
# `pos` is negative (v0.9.3 — before that this composer had no
# failure mode at all, so a -1 handed in from an earlier link in the
# chain was laundered into a write below the caller's buffer).
# Byte budget: exactly 4. The buffer-targeting reset, for callers
# composing a frame that ends "...payload bytes... + reset".
# `tty_sgr_reset()` is the write-to-fd-1 variant.
fn tty_sgr_reset_buf(buf, pos) {
    if (pos < 0) { return 0 - 1; }
    # `ESC [ 0 m` in one unaligned 4-byte store. Unlike the two above
    # this writes EXACTLY the bytes it produces — no 8th-byte argument
    # is needed, because the escape is exactly 4 bytes long.
    store32(buf + pos, 27 | (91 << 8) | (48 << 16) | (109 << 24));
    return pos + 4;
}

# Append `CSI <code>m` to `buf` at `pos`. Returns new `pos`, or -1
# if `code` is outside [0, 999] or `pos` is negative. Byte budget:
# up to 6 (ESC [ + 3 digits + m). Buffer-targeting twin of `tty_sgr`
# — same [0, 999] envelope, same fail-before-emit discipline. Used
# by consumers that build frames into a stack buffer and write
# once at frame end (anuenue M6's `_PHASE_ESC_TABLE` builder is
# the first such consumer, emitting 16-color named SGR escapes
# `\x1b[91m` ... `\x1b[97m` per phase).
#
# v0.5.3 — added for anuenue M6 color-mode negotiation.
fn tty_sgr_buf(buf, pos, code) {
    if (pos < 0) { return 0 - 1; }
    if (code < 0 || code > 999) { return 0 - 1; }
    store8(buf + pos, 27); pos = pos + 1;        # ESC
    store8(buf + pos, 91); pos = pos + 1;        # '['
    if (code >= 100) {
        store8(buf + pos, 48 + code / 100);          pos = pos + 1;
        store8(buf + pos, 48 + (code / 10) % 10);    pos = pos + 1;
        store8(buf + pos, 48 + code % 10);           pos = pos + 1;
    } else { if (code >= 10) {
            store8(buf + pos, 48 + code / 10);       pos = pos + 1;
            store8(buf + pos, 48 + code % 10);       pos = pos + 1;
        } else {
            store8(buf + pos, 48 + code);            pos = pos + 1;
        } }
    store8(buf + pos, 109); pos = pos + 1;       # 'm'
    return pos;
}

# ---- 256-color (8-bit indexed) SGR helpers --------------------------
#
# v0.5.3 — added for anuenue's M6 (color-mode negotiation). The
# 256-color middle was the only gap left after v0.5.1's 24-bit
# truecolor helpers + the original 8/16 named-color set. anuenue's
# `TRUECOLOR` mode uses `tty_fg_rgb_buf`; the `MODE_256` fallback
# uses this helper to emit the same per-phase color table at lower
# fidelity.
#
# Escape layout: `CSI 38;5;<N>m` — 9 bytes ("\x1b[38;5;0m") at the
# short end, 11 bytes ("\x1b[38;5;255m") at the long end. Callers
# must budget 11 bytes per emission. (No one-shot `tty_fg_256`
# wrapper has shipped — this tier is buffer-composing only.)

# Append `CSI 38;5;Nm` to `buf` at `pos`. Returns new `pos`, or -1
# if `n` is outside [0, 255], or -1 if `pos` is negative.
# Buffer-targeting primitive (no fd 1 write); use it inside a frame
# builder. Byte budget: up to 11.
#
# The background twin (`tty_bg_256_buf`) is deferred — see roadmap.md
# §"Next, by bucket" (1.x.0) and CHANGELOG v0.5.3 — under the same
# extract-on-2nd-consumer discipline as v0.5.1's bg/fg split. kii
# carries a local `_emit_bg_256_buf` as consumer #1; lift it here
# when a second consumer needs it.
fn tty_fg_256_buf(buf, pos, n) {
    if (pos < 0) { return 0 - 1; }
    if (n < 0 || n > 255) { return 0 - 1; }
    # `ESC [ 3 8 ; 5 ;` in one unaligned 8-byte store. Same argument as
    # _ansi_rgb_buf: the shortest escape here is 9 bytes, so the 8th
    # byte is inside the result and is overwritten by the first digit.
    store64(buf + pos, 27 | (91 << 8) | (51 << 16) | (56 << 24)
                          | (59 << 32) | (53 << 40) | (59 << 48));
    pos = pos + 7;
    if (n >= 100) {
        store8(buf + pos, 48 + n / 100);          pos = pos + 1;
        store8(buf + pos, 48 + (n / 10) % 10);    pos = pos + 1;
        store8(buf + pos, 48 + n % 10);           pos = pos + 1;
    } else { if (n >= 10) {
            store8(buf + pos, 48 + n / 10);       pos = pos + 1;
            store8(buf + pos, 48 + n % 10);       pos = pos + 1;
        } else {
            store8(buf + pos, 48 + n);            pos = pos + 1;
        } }
    store8(buf + pos, 109); pos = pos + 1;        # 'm'
    return pos;
}

# Set foreground to 24-bit (r,g,b), writing the escape directly to
# fd 1. Convenience wrapper over `tty_fg_rgb_buf` over a stack buf.
# Returns 0 on success, -1 on out-of-range channel input.
fn tty_fg_rgb(r, g, b) {
    return _ansi_rgb_write(51, r, g, b);              # '3' = foreground
}

# Set BACKGROUND to 24-bit (r, g, b), writing the escape straight to
# fd 1 in one write(2). Background twin of `tty_fg_rgb`. Returns 0 on
# success, -1 if any channel is outside [0, 255] — rejected before any
# byte is emitted.
fn tty_bg_rgb(r, g, b) {
    return _ansi_rgb_write(52, r, g, b);              # '4' = background
}

# Emit `CSI <code>m` — the underlying SGR primitive. Most consumers
# pass a `TTY_FG_*` constant (30–37 / 90–97), but any 1–3 digit
# decimal code works; this is the door for future bold (1) /
# underline (4) / bg (40–47, 100–107) helpers without growing the
# fn surface.
#
# Contract: `code` must be in `[0, 999]`. Anything outside that range
# (negative, or >= 1000) is rejected with `-1` *before* any bytes
# reach fd 1 — an out-of-range code would otherwise emit a malformed
# CSI sequence the terminal may misinterpret. v0.4.0 added the guard;
# v0.3.5 accepted any 64-bit input.
#
# v0.9.3 — reduced to a one-shot wrapper over `tty_sgr_buf`, the same
# compose-then-write shape `tty_fg_rgb` / `tty_bg_rgb` already used.
# That is why it now lives here beside them rather than up beside the
# TTY_FG_* constants: `tty_sgr_buf` has to be defined first. Emitted
# bytes and return values are unchanged.
fn tty_sgr(code) {
    var buf[8];                  # max emit is ESC [ + 3 digits + m = 6
    var pos = tty_sgr_buf(&buf, 0, code);
    if (pos < 0) { return 0 - 1; }
    syscall(1, 1, &buf, pos);
    return 0;
}

# --- cursor.cyr ---

# cursor.cyr — cursor positioning via CSI row;colH.
#
# Donor port from cyim/src/tty.cyr. Split out from ansi.cyr because
# cursor positioning needs decimal formatting (the row/col integers
# encode into the escape) — different shape from the fixed-bytes
# escape helpers in ansi.cyr.
#
# tty_dec_buf (the decimal formatter) is a public member of the `_buf`
# family — consumers compose custom escapes with embedded integers
# through it (cyim's status line does). It lives here because the
# cursor escapes need it; its `_buf` naming and new-position return
# match tty_sgr_buf / tty_fg_rgb_buf in ansi.cyr.

# Write the decimal digits of `val` into `buf` at `pos`; return the new
# write position (`pos` + number of digits). A negative or zero `val`
# is written as a single '0'. Collects digits in reverse into a scratch
# buffer, then copies them back in order.
#
# Renamed from `tty_itoa` in v0.7.0 with the return harmonized from
# digit-count to new-position: the old name was a generic misnomer and
# the digit-count return was the lone odd-one-out in the `_buf` family
# (every other `_buf` helper returns the new position) — a documented
# footgun. `tmp` is sized 24: an i64 is at most 20 decimal digits, so
# 24 leaves headroom.
#
# Byte budget: 1 byte when `val <= 0`; up to 19 bytes for a positive
# i64 (i64 max is 19 decimal digits). There is no capacity argument,
# so the caller must guarantee `pos + 19 <= sizeof(buf)` unless it
# bounds `val` itself — `tty_move` does, via its [1, 65535] guard,
# which caps each field at 5 digits.
#
# A negative incoming `pos` returns -1 (v0.9.3); before that a -1
# handed in from an earlier link was laundered into a write below the
# caller's buffer plus a bogus non-negative return.
fn tty_dec_buf(buf, pos, val) {
    if (pos < 0) { return 0 - 1; }
    if (val <= 0) {
        store8(buf + pos, 0x30);
        return pos + 1;
    }
    var tmp[24];
    var d = 0;
    while (val > 0) {
        store8(&tmp + d, 0x30 + (val % 10));
        val = val / 10;
        d = d + 1;
    }
    var i = 0;
    while (i < d) {
        store8(buf + pos + i, load8(&tmp + d - 1 - i));
        i = i + 1;
    }
    return pos + d;
}

# Move cursor to (row, col), 1-indexed, via CSI row;colH. Returns 0
# on success, -1 if either coordinate is outside [1, 65535] — rejected
# *before* any byte reaches fd 1, matching the fail-before-emit
# discipline of tty_sgr ([0,999]) and tty_fg_rgb ([0,255]). The bound
# is the u16 winsize envelope every real caller draws from; an out-of-
# range coordinate would otherwise feed tty_dec_buf up to 20 digits and
# a malformed CSI to the terminal.
#
# Composes the escape into a stack buf and writes it in one syscall —
# no intermediate allocations, no flush concerns. buf is sized past the
# true worst case: ESC[ (2) + up to 19 digits + ';' (1) + up to 19
# digits + 'H' (1) = 42 bytes, so the compose cannot overrun the stack
# even if the [1,65535] guard above is ever loosened. The declared 44
# leaves 2 bytes spare; through v1.0.1 this comment said "20 digits"
# per coordinate and arithmetic'd to exactly 44, which overstated
# `tty_dec_buf`'s maximum — an i64 is at most 19 decimal digits, as
# that function's own byte budget says.
fn tty_move(row, col) {
    if (row < 1 || row > 65535) { return 0 - 1; }
    if (col < 1 || col > 65535) { return 0 - 1; }
    var buf[44];
    store8(&buf, 0x1b);          # ESC
    store8(&buf + 1, 0x5b);      # '['
    var pos = 2;
    pos = tty_dec_buf(&buf, pos, row);
    if (pos < 0) { return 0 - 1; }
    store8(&buf + pos, 0x3b);    # ';'
    pos = pos + 1;
    pos = tty_dec_buf(&buf, pos, col);
    if (pos < 0) { return 0 - 1; }
    store8(&buf + pos, 0x48);    # 'H'
    pos = pos + 1;
    syscall(1, 1, &buf, pos);
    return 0;
}

# Shared body for the two relative-cursor moves. `final` is the CSI
# terminator byte that picks the direction: 0x41 ('A') = up,
# 0x42 ('B') = down. The two public fns differed by exactly that byte
# — parameterizing it (v0.9.3) means the `n <= 0` guard and the buffer
# arithmetic below are derived once instead of twice, and the copy can
# no longer drift from the original (it already had: the `down` twin
# had lost its `# ESC` / `# '['` comments).
#
# buf[24] clears the true worst case: ESC[ (2) + up to 19 digits for
# an i64 (19) + terminator (1) = 22, with 2 bytes spare. (Through
# v1.0.1 the middle term was written "(1)", so the line summed to 22
# by luck rather than by arithmetic.)
fn _cursor_rel(n, final) {
    if (n <= 0) { return 0; }
    var buf[24];
    store8(&buf, 0x1b);          # ESC
    store8(&buf + 1, 0x5b);      # '['
    var pos = 2;
    pos = tty_dec_buf(&buf, pos, n);
    if (pos < 0) { return 0; }
    store8(&buf + pos, final);
    pos = pos + 1;
    syscall(1, 1, &buf, pos);
    return 0;
}

# Move the cursor up `n` rows, staying in the current column, via
# `CSI <n>A`. The relative analogue of `tty_move`'s absolute
# positioning — wanted by in-scrollback repainters (anuenue's M4
# animation re-anchors at the top of the buffered block each frame).
#
# Always returns 0; there is no failure mode. `n <= 0` is a documented
# NO-OP, not a rejection: xterm treats `CSI 0A` as "move 1 row", so
# guarding here lets callers pass an unchecked row count straight
# through without special-casing zero.
fn tty_cursor_up(n) {
    return _cursor_rel(n, 0x41);     # 'A'
}

# Move the cursor down `n` rows via `CSI <n>B`. Mirror of
# `tty_cursor_up` — same no-op-on-zero guard, same always-0 return.
fn tty_cursor_down(n) {
    return _cursor_rel(n, 0x42);     # 'B'
}
