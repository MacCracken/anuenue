include "lib/syscalls.cyr"
include "lib/io.cyr"

# --- termios.cyr ---

# =====================================================================
# darshana — public surface conventions (frozen at v1.0)
# =====================================================================
#
# This header leads `dist/darshana.cyr`, the single-file bundle consumers
# include. It documents the whole library surface, not just this module.
# Per-module and per-function detail follows each symbol below.
#
# Naming conventions (frozen at v1.0):
#   tty_*  public functions        tio_*  termios LE field codec
#   TIO_*  termios bit flags        TTY_*  darshana-defined constants
#   TIOC*  raw kernel ioctl nums    _*     private-by-convention
#                                          (in the bundle, not the API)
#
# Return conventions. Every public fn falls in exactly one of these
# five buckets. (Four through v1.0.1 — which left `tio_load32`,
# `tio_store32` and `tty_close_signalfd` in none of them while the
# sentence claimed all 29 were covered. The codec bucket is the fix.)
#   • validating side-effecting ops — tty_raw, tty_raw_nonblock,
#     tty_echo_off, tty_cooked, tty_flush_input, tty_winsize, tty_move,
#     tty_scroll_region, tty_sgr, tty_sgr_list, tty_fg_rgb, tty_bg_rgb,
#     tty_title, tty_clipboard_set — 0 on success, -1 on failure or
#     out-of-range reject (rejected before any byte reaches fd 1).
#   • unconditional ops — the emitters tty_alt_enter/leave, tty_clear,
#     tty_clear_to_eol/eos, tty_cursor_hide/show/home,
#     tty_cursor_save/restore, tty_sgr_reset, tty_cursor_up/down,
#     tty_scroll_region_reset, tty_mouse_enable/disable,
#     tty_paste_enable/disable, plus tty_winsize_or and tty_forget —
#     ALWAYS 0. The write(2) result is not checked (rationale in ansi.cyr's
#     header). `n <= 0` on tty_cursor_up/down is a documented no-op, not a
#     reject: these never return -1.
#   • `_buf` composers (tty_dec_buf, tty_sgr_buf, tty_sgr_list_buf,
#     tty_sgr_reset_buf, tty_fg_rgb_buf, tty_bg_rgb_buf, tty_fg_256_buf,
#     tty_bg_256_buf, tty_move_buf, tty_clear_to_eol_buf, tty_title_buf,
#     tty_clipboard_buf, tty_sanitize_buf) — the new write position, or -1
#     on out-of-range input OR on a negative incoming `pos` — so a -1 from
#     an earlier link poisons the rest of the chain rather than being
#     laundered into a write below the buffer. tty_dec_buf additionally
#     clamps `val <= 0` to a single '0'. Each composer documents its own
#     byte budget; none takes a capacity argument, so sizing the buffer is
#     the caller's job.
#   • predicates / fd openers / readers — tty_isatty returns 1/0;
#     tty_has_ctl 1/0, or -1 on bad arguments; tty_open_signalfd returns
#     an fd (>= 0) or exactly -1, never a raw -errno; tty_read_signal the
#     signal number, 0 when none is pending, or -1. tty_close_signalfd is
#     the teardown counterpart: 0 on success, exactly -1 on failure (also
#     never a raw -errno — normalized in v1.0.2; see its docstring).
#   • termios field codec — tio_load32 returns the zero-extended
#     32-bit field at `off` (never negative, never a failure code);
#     tio_store32 always returns 0. Neither bounds-checks: `buf` and
#     `off` are the caller's contract, deliberately (ADR 0003 records
#     this as knowingly frozen in). They are the only two public fns
#     with no failure mode at all.
#
# Modules in this bundle, by concern:
#   termios.cyr  — termios modes (raw, non-blocking raw, echo-off) and
#                  their restore, input flush, winsize, isatty, signalfd,
#                  TIO_*
#   ansi.cyr     — alt-screen / clear / cursor visibility and save /
#                  SGR color / mouse and paste modes / OSC title and
#                  clipboard
#   cursor.cyr   — tty_dec_buf (decimal formatter), cursor positioning,
#                  scroll region
#   sanitize.cyr — making untrusted bytes safe for the terminal (v1.2.0)
#
# Symbols prefixed `_` are private by convention — they ship in this
# bundle because it is one compilation unit, but they are NOT public
# surface and may change without a major bump. The authoritative public
# list is `scripts/smoke.sh` (`required_syms` / `required_flags`), which
# CI checks against this bundle in both directions.
#
# =====================================================================

# termios.cyr — Linux raw-mode TTY (TCGETS/TCSETS via ioctl).
#
# Donor port from cyim/src/tty.cyr — verbatim functional behavior, split
# into this file (termios) + ansi.cyr + cursor.cyr per darshana's M1 plan.
# Preserves cyim's public symbol names (tty_raw, tty_cooked, ...) so the
# Phase 4 cyim migration is just a manifest change, not a rename.
#
# Linux kernel termios layout. The kernel's `struct termios` is 36 bytes —
# exactly what TCGETS copies out and TCSETS reads in; darshana's 60-byte
# buffers match glibc's padded userspace struct and leave the tail as
# slack. x86_64 and aarch64 Linux share this layout via
# asm-generic/termbits.h:
#
#   off  0  c_iflag   i32   input modes
#   off  4  c_oflag   i32   output modes
#   off  8  c_cflag   i32   control modes
#   off 12  c_lflag   i32   local modes
#   off 16  c_line     u8   line discipline
#   off 17  c_cc[19]   u8   special chars (VTIME @ 22, VMIN @ 23)
#
# macOS (BSD) termios is a different struct and is deliberately out of
# scope (CLAUDE.md domain rules; roadmap.md §"Out of scope") — add it
# when a real consumer needs it, not before.
# The ioctl wrappers below gate to CYRIUS_TARGET_LINUX. ANSI / cursor
# helpers (in ansi.cyr / cursor.cyr) work on any vt100-compatible
# terminal, so the platform gate sits at the syscall boundary, not at
# darshana's surface.

# Termios bit flags (asm-generic/termbits.h; matches x86_64 and aarch64 Linux).
var TIO_ECHO   = 0x008;
var TIO_ICANON = 0x002;
var TIO_ISIG   = 0x001;
var TIO_IEXTEN = 0x8000;
var TIO_ICRNL  = 0x100;
var TIO_IXON   = 0x400;
var TIO_OPOST  = 0x001;
var TIO_CSIZE  = 0x030;
var TIO_CS8    = 0x030;
var TIO_BRKINT = 0x002;
var TIO_INPCK  = 0x010;
var TIO_ISTRIP = 0x020;

# Special-char indices into c_cc[] (relative to start of c_cc, which sits at offset 17).
var TIO_CC_BASE  = 17;
var TIO_VTIME    = 5;
var TIO_VMIN     = 6;

# Termios buffer size. The kernel struct is 36 bytes active, but the ioctl
# write tolerates any size >= 36; 60 covers the historically padded variants
# without straddling a stack red-zone.
#
# Exposed as the canonical name for callers ioctling TCGETS/TCSETS directly
# (e.g., a consumer that wants to read termios state without taking it raw).
# Cyrius requires array sizes to be literals or enum constants, not `var`
# constants, so the internal `_tty_saved[60]` and `work[60]` declarations
# below use the matching literal. If this value ever changes, all three
# sites (this constant and the two arrays) must move together. (`tty_raw`'s
# copy loop was a fourth literal `60` through v1.1.4; it reads this
# constant since v1.2.0.)
var TIO_BUF_SIZE = 60;

# Read the 32-bit little-endian field at byte offset `off` inside the
# termios buffer `buf`. Returns the field value as a non-negative
# integer in [0, 0xFFFFFFFF] — the four bytes are zero-extended, never
# sign-extended, so a flag word with the top bit set reads as a large
# positive number rather than a negative one.
#
# Public because a consumer may want to read termios state without
# taking the terminal raw: ioctl `TCGETS` into a `TIO_BUF_SIZE` buffer
# and pull fields out with this. Offsets are the kernel struct's —
# c_iflag 0, c_oflag 4, c_cflag 8, c_lflag 12 (layout table at the top
# of this file).
#
# NO bounds check: `buf` and `off` are the caller's contract. Reading at
# an `off` beyond the buffer reads adjacent memory.
fn tio_load32(buf, off) {
    var b0 = load8(buf + off);
    var b1 = load8(buf + off + 1);
    var b2 = load8(buf + off + 2);
    var b3 = load8(buf + off + 3);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

# Write `val` as a 32-bit little-endian field at byte offset `off`
# inside the termios buffer `buf`. Only the low 32 bits of `val` are
# stored; higher bits are discarded, not an error. Always returns 0 —
# there is no failure mode.
#
# Same caller contract as `tio_load32`: NO bounds check, so an `off`
# beyond the buffer corrupts adjacent memory. Pair it with `tio_load32`
# for a read-modify-write against a `TCGETS` snapshot.
fn tio_store32(buf, off, val) {
    store8(buf + off,     val & 0xFF);
    store8(buf + off + 1, (val >> 8) & 0xFF);
    store8(buf + off + 2, (val >> 16) & 0xFF);
    store8(buf + off + 3, (val >> 24) & 0xFF);
    return 0;
}

# Apply darshana's raw-mode flag mask in place to a 60-byte termios buffer.
# The bit-twiddling half of `tty_raw` extracted as a pure function so it
# can be unit-tested without owning a real TTY fd.
#
# Private (`_`-prefixed) — internal to `tty_raw`, NOT part of darshana's
# public surface. Privatized in v0.7.0: it bakes in darshana's specific
# raw-mode mask, so no consumer has a reason to call it directly, and a
# same-compilation-unit test can still reach it. The pure-function
# split exists for testability, not for the API.
#
# Cleared:
#   c_iflag: BRKINT | ICRNL | INPCK | ISTRIP | IXON
#   c_oflag: OPOST              (post-processing off — \n stays \n)
#   c_lflag: ECHO | ICANON | IEXTEN | ISIG    (key-by-key, no signals)
# Set:
#   c_cflag: CS8                 (8-bit chars; CSIZE cleared first)
#   c_cc[VMIN]  = 1              (read returns after one byte)
#   c_cc[VTIME] = 0              (no read timeout)
#
# ISIG is cleared so Ctrl-C / Ctrl-Z reach the consumer as bytes —
# matches vim convention. Consumers that want kernel signal handling
# (chakshu's render loop is not one of them yet) should clone the
# saved cooked-mode termios and patch c_lflag themselves.
fn _tty_apply_raw_flags(buf) {
    var iflag = tio_load32(buf, 0);
    iflag = iflag & ~(TIO_BRKINT | TIO_ICRNL | TIO_INPCK | TIO_ISTRIP | TIO_IXON);
    tio_store32(buf, 0, iflag);

    var oflag = tio_load32(buf, 4);
    oflag = oflag & ~TIO_OPOST;
    tio_store32(buf, 4, oflag);

    var cflag = tio_load32(buf, 8);
    cflag = (cflag & ~TIO_CSIZE) | TIO_CS8;
    tio_store32(buf, 8, cflag);

    var lflag = tio_load32(buf, 12);
    lflag = lflag & ~(TIO_ECHO | TIO_ICANON | TIO_IEXTEN | TIO_ISIG);
    tio_store32(buf, 12, lflag);

    store8(buf + TIO_CC_BASE + TIO_VMIN, 1);
    store8(buf + TIO_CC_BASE + TIO_VTIME, 0);
    return 0;
}

#ifdef CYRIUS_TARGET_LINUX

# `SYS_IOCTL` is deliberately NOT defined here. Since v1.2.0 darshana
# calls the stdlib's `sys_ioctl` wrapper (`lib/syscalls_linux_common.cyr`,
# filed by kybernet, whose own comment cites this file), which issues the
# stdlib's arch-aware `SYS_IOCTL`: 16 on x86_64, 29 on aarch64. This gate is `CYRIUS_TARGET_LINUX`, which is
# arch-BLIND, so a local `var SYS_IOCTL = 16` shadowed the stdlib's value
# on aarch64 (last definition wins) and every ioctl below issued 16 —
# which on aarch64-Linux is `fremovexattr`, not `ioctl`. Through cyrius
# 6.5.37 the ELF aarch64 backend's ESYSXLAT chain had no 16→29 row, and
# its "syscall not routed" warning is Mach-O-only, so the wrong number
# passed through silently. Fixed here in v0.9.2. cyrius 6.5.38 added a
# 16→29 row in response, but the backend translates only SOME x86_64
# numbers, so never rely on it: do not reintroduce a local definition.
#
# The ioctl *request* codes below stay local: they are arch-stable across
# both Linux targets (asm-generic/ioctls.h — x86_64's asm/ioctls.h is a
# bare include of it) and the stdlib does not define them.
# ioctl request codes for reading and writing termios. Public surface:
# a consumer that wants termios state without going raw does
# `sys_ioctl(fd, TCGETS, &buf)` with a `TIO_BUF_SIZE` buffer, and can
# write it back with `TCSETS`. Arch-stable across both Linux
# targets (asm-generic/ioctls.h).
#
# Writing termios yourself is outside darshana's state-restore model:
# `tty_cooked()` restores only what `tty_raw` saved, so a consumer that
# TCSETS behind darshana's back owns undoing it. See ADR 0002.
var TCGETS = 0x5401;
var TCSETS = 0x5402;

# Window-size query — `struct winsize { u16 row, u16 col, u16 xpix, u16 ypix } = 8 bytes`.
# v0.3.0 — added for chakshu's M2 Slice D dynamic resize.
var TIOCGWINSZ = 0x5413;

# Common signal masks for `tty_open_signalfd` — Linux sigset_t is one
# u64 with bit (signum - 1) set per signal in the mask.
#   TTY_SIGMASK_EXIT  = SIGHUP(1) | SIGINT(2) | SIGTERM(15) → bits 0,1,14 → 0x4003
#   TTY_SIGMASK_WINCH = SIGWINCH(28)                         → bit  27     → 0x08000000
#   TTY_SIGMASK_PIPE  = SIGPIPE(13)                          → bit  12     → 0x1000
# Callers can OR these or build custom masks; the primitive itself is
# mask-agnostic. v0.3.0 — promoted from chakshu's _tui_open_exit_signalfd.
#
# TTY_SIGMASK_PIPE (v1.3.0): a write to a pipe whose reader has gone raises
# SIGPIPE, whose default action kills the process mid-teardown (ADR 0002).
# Blocking it through a signalfd turns that into a readable event and the
# write into an EPIPE return. The three masks are disjoint, so each can have
# its own signalfd.
var TTY_SIGMASK_EXIT  = 0x4003;
var TTY_SIGMASK_WINCH = 0x08000000;
var TTY_SIGMASK_PIPE  = 0x1000;

# Saved cooked-mode termios. Populated on `tty_raw`; consumed by `tty_cooked`.
# Module-global rather than caller-owned so any exit path (including
# signal handlers and panic paths) can reach it for cleanup without
# threading state. The literal `60` mirrors `TIO_BUF_SIZE` — see that
# constant's docstring for why the duplication exists.
var _tty_saved[60];
var _tty_in_raw = 0;
# The fd `tty_raw` saved state for. There is exactly one saved-state
# slot (`_tty_saved`), so darshana tracks exactly one raw fd at a time;
# `tty_cooked()` restores onto this fd. v0.7.0 — added so `tty_cooked`
# could drop its (previously misleading) fd parameter.
var _tty_raw_fd = 0;

# 1 if `fd` is a value the kernel will read as THAT fd, 0 otherwise.
#
# Private (v1.1.4). Linux takes a file descriptor as an `unsigned int`, so
# the kernel reads only the low 32 bits of the i64 a caller passes. Through
# v1.1.3 the four fd-taking Linux peers forwarded any i64, so a value
# outside [0, 0x7FFFFFFF] silently ALIASED a different descriptor:
# `tty_isatty(fd + 2^32)` answered 1 for a number that is no open fd,
# `tty_raw(fd + 2^32)` took `fd` raw (and then refused `tty_raw(fd)` on the
# same terminal), and `tty_close_signalfd(fd + 2^32, mask)` closed an
# unrelated live `fd`. Every docstring promises a verdict about the fd the
# caller named, so rejecting the alias makes behaviour match the contract.
# The bound is INT_MAX: the kernel's fd table is indexed by int.
fn _tty_fd_ok(fd) {
    if (fd < 0 || fd > 0x7FFFFFFF) { return 0; }
    return 1;
}

# The mode the slot's fd is in while `_tty_in_raw` is 1 (v1.3.0; through
# 1.2.1 this was `_tty_raw_vmin`, the raw VMIN): raw with blocking reads
# (`tty_raw`), raw with reads that return at once (`tty_raw_nonblock`), or
# cooked with echo off (`tty_echo_off`). All three share the one save slot,
# so `tty_cooked()` restores whichever is on.
const _TTY_RAW    = 1;
const _TTY_RAW_NB = 2;
const _TTY_NOECHO = 3;
var _tty_mode = _TTY_RAW;

# ioctl requests and flags only the slot's modes and `tty_flush_input` use.
# Arch-stable across both Linux targets (asm-generic/ioctls.h, termbits.h).
const _TCSETSF    = 0x5404;    # TCSETS, discarding unread input first
const _TCFLSH     = 0x540B;
const _TCIFLUSH   = 0;         # TCFLSH argument: the input queue
const _TIO_ECHONL = 0x040;     # c_lflag: echo NL even when ECHO is off

# Shared body of `tty_raw`, `tty_raw_nonblock` and `tty_echo_off`.
# Private (v1.2.0 as `_tty_raw_mode`; v1.3.0 gained the echo-off mode).
# Enters a mode from cooked, saving the cooked termios; or, on the fd that
# already holds the slot, switches between modes by re-deriving from the
# SAVED cooked state, which it never overwrites — so `tty_cooked()`
# restores exactly, whichever mode is on. A same-fd call in the mode
# already applied is a no-op success, exactly as `tty_raw` has always
# been. Returns 0, or -1.
fn _tty_set_mode(fd, mode) {
    if (_tty_fd_ok(fd) == 0) { return 0 - 1; }
    if (_tty_in_raw == 1) {
        if (fd != _tty_raw_fd) { return 0 - 1; }
        if (mode == _tty_mode) { return 0; }
    } else {
        if (sys_ioctl(fd, TCGETS, &_tty_saved) < 0) { return 0 - 1; }
    }

    var work[60];                       # size mirrors TIO_BUF_SIZE
    var i = 0;
    while (i < TIO_BUF_SIZE) {
        store8(&work + i, load8(&_tty_saved + i));
        i = i + 1;
    }
    var req = TCSETS;
    if (mode == _TTY_NOECHO) {
        # Line editing stays on (ICANON); only what the user types is no
        # longer shown, including the newline that ends the line.
        tio_store32(&work, 12, tio_load32(&work, 12) & ~(TIO_ECHO | _TIO_ECHONL));
        req = _TCSETSF;
    } else {
        # _tty_apply_raw_flags sets VMIN = 1 / VTIME = 0: tty_raw's bytes.
        _tty_apply_raw_flags(&work);
        if (mode == _TTY_RAW_NB) { store8(&work + TIO_CC_BASE + TIO_VMIN, 0); }
    }

    if (sys_ioctl(fd, req, &work) < 0) { return 0 - 1; }
    _tty_raw_fd = fd;
    _tty_in_raw = 1;
    _tty_mode = mode;
    return 0;
}

# Enter raw mode on `fd`. Saves the current termios so `tty_cooked()`
# can restore it, and records `fd` as the owning raw fd. Returns 0 on
# success, -1 on ioctl failure (most often: fd is not a TTY).
#
# Single-raw-fd model: there is one saved-state slot, so only one fd
# can be raw at a time. A second call while already raw on the SAME fd
# is an idempotent no-op success; a call on a DIFFERENT fd while still
# raw is REFUSED with -1 (v0.7.0) rather than silently overwriting the
# saved state — overwriting would strand the first fd in raw mode with
# no way to restore it. Call `tty_cooked()` first to release the fd.
#
# v1.2.0: if the same fd was made raw by `tty_raw_nonblock`, this
# switches it back to blocking reads (VMIN = 1) and returns 0, without
# touching the saved cooked state. (No sequence before v1.2.0 could
# reach that case; every earlier one behaves exactly as it did.)
#
# An `fd` outside [0, 0x7FFFFFFF] is rejected with -1 before any syscall
# (v1.1.4) — the kernel would otherwise read its low 32 bits as a
# different descriptor. See `_tty_fd_ok`.
fn tty_raw(fd) {
    return _tty_set_mode(fd, _TTY_RAW);
}

# Enter raw mode on `fd` with reads that return at once: VMIN = 0 and
# VTIME = 0, so read(2) answers 0 immediately when no byte is waiting,
# instead of blocking for one. Everything else is `tty_raw`'s mask and
# `tty_raw`'s contract: the same single raw slot (a different fd while
# raw is refused with -1), the same saved cooked state, the same
# `tty_cooked()` restore. On the fd already raw via `tty_raw`, this
# switches it to non-blocking reads and returns 0; `tty_raw` switches
# back. Returns 0 on success, -1 on ioctl failure or an `fd` outside
# [0, 0x7FFFFFFF].
#
# v1.2.0. For poll and game loops that must not block on `read(0)`.
# thoth reached this by calling the private `_tty_apply_raw_flags` and
# patching VMIN / VTIME itself; five other AGNOS projects hand-roll the
# same termios edit without depending on darshana.
fn tty_raw_nonblock(fd) {
    return _tty_set_mode(fd, _TTY_RAW_NB);
}

# Turn echo off on `fd` for a password or passphrase prompt, keeping line
# editing: the user types a whole line, backspace works, and nothing they
# type is shown — not even the newline, so print one yourself once the
# line is read. Input already waiting on the terminal is discarded first
# (TCSETSF), so keys typed before the prompt cannot become the secret.
# `tty_cooked()` restores the terminal. Returns 0 on success, -1 on ioctl
# failure (most often: fd is not a TTY) or an `fd` outside [0, 0x7FFFFFFF].
#
# The same single slot as `tty_raw` (v1.3.0): a different fd while the
# slot is held is refused with -1, and on the fd that holds it this
# switches to echo-off from either raw mode — `tty_raw` switches back.
# The saved state is always the cooked one from before the first call.
fn tty_echo_off(fd) {
    return _tty_set_mode(fd, _TTY_NOECHO);
}

# Discard input the terminal on `fd` has received but nobody has read
# (TCFLSH, TCIFLUSH) — so keys pressed before a confirmation prompt cannot
# answer it. Output is untouched, and so is the slot: this works in any
# mode, raw or not. Returns 0 on success, -1 on ioctl failure (most
# often: fd is not a TTY) or an `fd` outside [0, 0x7FFFFFFF] (v1.3.0).
fn tty_flush_input(fd) {
    if (_tty_fd_ok(fd) == 0) { return 0 - 1; }
    if (sys_ioctl(fd, _TCFLSH, _TCIFLUSH) < 0) { return 0 - 1; }
    return 0;
}

# Restore cooked mode onto the fd `tty_raw` saved (`_tty_raw_fd`).
# Zero-arg as of v0.7.0: the previous `tty_cooked(fd)` signature
# implied a per-fd restore the single saved-state slot can't deliver
# (tty_raw(A) + tty_cooked(B) would have written A's state onto B), so
# the parameter was dropped. Idempotent: a no-op success when not raw.
#
# On TCSETS failure returns -1 and leaves `_tty_in_raw` set, so the
# caller may retry; until a restore succeeds the terminal is left in
# raw mode (state unspecified from the user's point of view).
#
# A PERMANENTLY failing restore (EBADF once the raw fd is closed, EIO
# after a hangup — measured on a pty whose master was closed) strands the
# slot: `_tty_in_raw` stays 1, so
# `tty_raw` on a DIFFERENT fd is refused for the rest of the process.
# No public reset exists, by design — every consumer's answer to a
# failed restore is to exit. Do NOT retry `tty_cooked()` after the
# original fd number has been closed and reissued: the retry would
# write the dead terminal's saved 60 bytes onto whatever now owns
# that descriptor.
fn tty_cooked() {
    if (_tty_in_raw == 0) { return 0; }
    var rc = sys_ioctl(_tty_raw_fd, TCSETS, &_tty_saved);
    if (rc < 0) { return 0 - 1; }
    _tty_in_raw = 0;
    return 0;
}

# Free the single raw slot WITHOUT restoring the terminal (v1.3.0).
#
# For the one case `tty_cooked()` cannot recover from: its TCSETS fails
# for good — the terminal hung up, the fd was closed underneath it — so
# the slot stays held and every later `tty_raw` / `tty_raw_nonblock` /
# `tty_echo_off` on any other fd is refused for the life of the process
# (architecture note 001). After `tty_forget()` the next mode call saves
# fresh state from its own fd.
#
# The terminal is left exactly as it is. Call `tty_cooked()` first, and
# `tty_forget()` only when that returned -1; on a live terminal, forgetting
# instead of restoring leaves the user's shell raw.
#
# Always returns 0. Idempotent; a no-op when nothing is held.
fn tty_forget() {
    _tty_in_raw = 0;
    return 0;
}

# Query terminal dimensions via TIOCGWINSZ. Writes rows + cols into
# the caller's out-pointers. Returns 0 on success, -1 on ioctl
# failure (most often: fd is not a TTY) or on an `fd` outside
# [0, 0x7FFFFFFF] (v1.1.4 — see `_tty_fd_ok`). On -1 the out-pointers
# are not written.
#
# ⚠ 0 does not promise a usable size. A pseudo-terminal whose size was
# never set — common under `script`, CI runners and some multiplexers
# before they resize — answers TIOCGWINSZ successfully with 0 rows and 0
# columns, so this returns 0 with both out-values 0. Callers that divide
# by, or lay out against, the size must treat a 0 dimension as unknown
# and fall back to their own default. (Four consumers each discovered
# this independently; v1.1.4 writes it down.)
#
# Out-pointer contract: `out_rows` and `out_cols` each receive an
# i64 (8 bytes) via `store64`. This is the only darshana primitive
# that writes a fixed-width value through an OUT-PARAMETER — a pointer
# whose only purpose is to receive a result. (`tio_store32` also writes
# a fixed width — 4 bytes — through a caller pointer, but that pointer
# is the termios buffer the caller is editing, not an out-param; the
# corrected wording lands in v1.0.2, which found the older "the only
# darshana primitive that writes a FIXED-WIDTH value through
# caller-supplied pointers" simply false.)
# The six `_buf` composers — tty_dec_buf (cursor.cyr) and tty_sgr_buf
# / tty_sgr_reset_buf / tty_fg_rgb_buf / tty_bg_rgb_buf /
# tty_fg_256_buf (ansi.cyr) — also write through a caller pointer, but
# a VARIABLE number of bytes at `buf + pos`, and none takes a capacity
# argument; each documents its own byte budget. Between them those are
# the surfaces where a malformed pointer corrupts caller memory.
# Callers must pass
# `&var` where `var` is a Cyrius natural — i.e., declared as
# `var rows = 0;`. Passing a pointer to a smaller slot (e.g., a single
# byte inside a struct) will overflow that slot. The values themselves fit in u16 (kernel
# struct field width) and rarely exceed ~1000, but the slot width is
# i64, not u16.
#
# struct winsize layout (Linux):
#   off 0  u16 row     # rows of cells
#   off 2  u16 col     # cols of cells
#   off 4  u16 xpix    # pixel width  (rarely populated; ignored)
#   off 6  u16 ypix    # pixel height (rarely populated; ignored)
#
# v0.3.0 — added for chakshu M2 Slice D (dynamic resize); cyim, kii and
# thoth have since adopted it.
fn tty_winsize(fd, out_rows, out_cols) {
    if (_tty_fd_ok(fd) == 0) { return 0 - 1; }       # v1.1.4 — see _tty_fd_ok
    var ws[8];
    var rc = sys_ioctl(fd, TIOCGWINSZ, &ws);
    if (rc < 0) { return 0 - 1; }
    var rows = load8(&ws + 0) | (load8(&ws + 1) << 8);
    var cols = load8(&ws + 2) | (load8(&ws + 3) << 8);
    store64(out_rows, rows);
    store64(out_cols, cols);
    return 0;
}

# Is `fd` an open TTY? Returns 1 if yes, 0 otherwise — a strict 1/0
# predicate, never a leaked errno. An `fd` outside [0, 0x7FFFFFFF] is 0
# without a syscall (v1.1.4 — see `_tty_fd_ok`). Implemented as the cheapest
# TTY-property syscall: TIOCGWINSZ succeeds only on a TTY. This agrees
# with libc isatty(3) in practice on Linux, though it is NOT the same
# mechanism — glibc's isatty(3) probes via TCGETS (tcgetattr); both
# ioctls succeed exactly on TTYs, so the verdicts match. The 8-byte
# winsize buffer is stack-allocated and discarded; this fn does not
# read its contents (see `tty_winsize` for the variant on the same
# TIOCGWINSZ path that returns the dimensions).
#
# v0.5.3 — added for anuenue M6 color-mode negotiation, which
# previously overloaded `tty_winsize` with dummy out pointers as a
# stand-in (`_isatty_compat`). Same syscall, cleaner surface.
fn tty_isatty(fd) {
    if (_tty_fd_ok(fd) == 0) { return 0; }           # v1.1.4 — see _tty_fd_ok
    var ws[8];
    var rc = sys_ioctl(fd, TIOCGWINSZ, &ws);
    if (rc < 0) { return 0; }
    return 1;
}

# Block the signals in `sigmask` on this thread and create a signalfd
# that delivers them. Returns the signalfd, or -1 on failure (caller
# should degrade gracefully — falling back to no-signal-handling is
# usually preferable to refusing to launch).
#
# A failed open leaves NO residue: if `signalfd(2)` fails after the
# block landed, the SIG_BLOCK is rolled back before returning, so the
# -1 path needs no caller cleanup. The failure return is always
# exactly -1, never a raw `-errno` (v0.9.3 — through v0.9.2 the
# `signalfd` result was returned unnormalized, so a failing call
# surfaced e.g. -24/EMFILE and left the signals blocked forever).
#
# "No residue" is exact as of v1.0.2, and the distinction matters: the
# rollback unblocks only the signals THIS call actually added to the
# thread mask (`sigmask & ~prev`), not the whole of `sigmask`. Through
# v1.0.1 it unblocked everything requested, so a failed open UNBLOCKED
# a signal the caller had already blocked — including one owned by an
# earlier, still-live darshana signalfd. That is the documented
# multi-signalfd pattern (chakshu holds an EXIT fd and a WINCH fd), and
# the consequence was that the first fd went deaf: with
# TTY_SIGMASK_EXIT the next Ctrl-C killed the process outright instead
# of waking the poll loop, so the consumer's teardown — alt-screen
# leave, cursor show, `tty_cooked()` — never ran and the user landed
# back in a raw, alt-screened shell. Reproduced under RLIMIT_NOFILE=3
# and covered by tests/darshana.tcyr.
#
# The rollback deliberately uses SIG_UNBLOCK of the added bits rather
# than SIG_SETMASK of the captured mask: `how` 0 and 1 are the only two
# values every target names explicitly. The AGNOS kernel's sigprocmask#17
# handles 0 and 1 by name and stores any other `how` verbatim; mirshi
# does name SIG_SETMASK, but the bare kernel does not. (Corrected v1.1.4:
# this used to attribute the fall-through to mirshi.)
#
# The SIG_BLOCK installed here persists on the thread until explicitly
# undone — closing the returned fd does NOT unblock the signals. Pair
# every successful call with `tty_close_signalfd(fd, sigmask)` on the
# teardown path (including the SIGINT/SIGTERM exit path) to close the
# fd and unblock the signals in `sigmask` — and make that the LAST step of
# the teardown (see `tty_close_signalfd` for why).
#
# Holding more than one at a time: give each live signalfd a DISJOINT
# mask. `tty_close_signalfd` unblocks every bit it is handed, so closing
# one of two signalfds that share a signal unblocks it for the other one
# too, and that fd goes deaf. Disjoint masks (chakshu's EXIT fd and WINCH
# fd) compose; overlapping ones do not.
#
# A non-blocking fd: call the stdlib's `fd_set_nonblocking(fd)` (cyrius
# 6.6.8+) on the returned fd. darshana needs no flag of its own for it.
#
# ⚠ The block is inherited by children. SIG_BLOCK survives fork() AND
# execve() (SFD_CLOEXEC below covers only the fd), so a pager, editor or
# shell spawned while the signalfd is live starts with these signals
# blocked: Ctrl-C and SIGTERM cannot stop it and it survives a hangup.
# Unblock `sigmask` in the child between fork and exec, or close the
# signalfd before spawning. (Measured v1.1.4: an exec'd child showed
# `SigBlk: 0000000000004003` under TTY_SIGMASK_EXIT.)
#
# `sigmask` is a single u64 representing a Linux sigset_t (bit N set
# = signal N+1 in the mask). Common values are exposed as constants:
# TTY_SIGMASK_EXIT for HUP/INT/TERM cleanup, TTY_SIGMASK_WINCH for
# resize. Callers can OR them or build custom masks.
#
# Avoids the rt_sigaction x86_64 sa_restorer trampoline trap by
# routing signals to a regular fd instead of installing synchronous
# handlers — pure syscall, no inline assembly needed.
#
# v0.3.0 — promoted from chakshu's `_tui_open_exit_signalfd` after
# chakshu became the second consumer needing the same machinery
# (Slice D adds SIGWINCH handling — same pattern, different mask).
fn tty_open_signalfd(sigmask) {
    var mask[8];
    # `store64` writes all 8 bytes of `mask`, so no pre-zero loop is
    # needed (one shipped here through v0.9.2 and was pure dead store).
    store64(&mask, sigmask);
    # Capture the mask in force on entry (v1.0.2) so the failure path
    # can put back exactly what it changed. `prev` is pre-zeroed: on a
    # kernel that left oldset untouched we would rather compute an
    # empty prior mask (and unblock everything we asked for, the old
    # v1.0.1 behaviour) than read stack garbage.
    var prev[8];
    store64(&prev, 0);
    var rc = sys_sigprocmask(SIG_BLOCK, &mask, &prev);
    if (rc < 0) { return 0 - 1; }
    # signalfd(fd=-1, mask, SFD_CLOEXEC) → new fd. CLOEXEC so the
    # signalfd does not leak across an execve — a consumer that takes
    # over the screen and later spawns a child (editor shelling out,
    # pager, $SHELL) must not hand this fd to it. SFD_CLOEXEC is the
    # stdlib SfdFlag enum value (0x80000); same CLOEXEC discipline the
    # stdlib's epoll wrapper follows. It covers the fd only — the signal
    # mask is inherited regardless (see the docstring).
    var sfd = sys_signalfd(0 - 1, &mask, SFD_CLOEXEC);
    if (sfd < 0) {
        # Roll the block back: the caller gets no fd,
        # so it has nothing to hand `tty_close_signalfd` and would
        # otherwise run with these signals blocked for the whole
        # process lifetime. This also normalizes the raw `-errno` the
        # bare syscall passthrough surfaces into the documented -1.
        #
        # Unblock ONLY what this call added (`sigmask & ~prev`), so a
        # signal the caller had already blocked — e.g. one an earlier
        # live signalfd owns — is left blocked. See the docstring.
        var added[8];
        store64(&added, sigmask & ~load64(&prev));
        sys_sigprocmask(SIG_UNBLOCK, &added, 0);
        return 0 - 1;
    }
    return sfd;
}

# Teardown counterpart to `tty_open_signalfd`: close `fd` and UNblock
# the signals in `sigmask`. Closing the fd alone is not enough — the
# SIG_BLOCK would otherwise persist and the consumer's signals stay
# silently blocked after its UI exits (e.g. a parent that resumes once
# the TUI returns). Pass the SAME `sigmask` that was passed to
# `tty_open_signalfd`.
#
# This UNBLOCKS every bit of `sigmask`; it does not RESTORE a saved
# mask. `tty_open_signalfd` captures the prior mask, but only to roll
# back its own failure — nothing keeps it, so close cannot put it back.
# A signal the caller had ALREADY blocked before the open is therefore
# left UNBLOCKED after the matching close. That is deliberate: a
# save-and-SIG_SETMASK restore would let the first of two closes stomp
# the second signalfd's blocks. The price is that live signalfds must
# have DISJOINT masks — closing one of two that share a signal unblocks
# it for both (see `tty_open_signalfd`). (Corrected v1.1.4: this used to
# say the open passes oldset = NULL, false since v1.0.2, and that the
# scheme "composes" without the disjointness condition.)
#
# ⚠ Make this the LAST step of a teardown — after `tty_cooked()` and
# the screen restore. Closing the fd does not discard a signal that
# arrived but was never read: it stays pending, and this unblock
# delivers it at once with its default action. For TTY_SIGMASK_EXIT
# that is SIGINT / SIGTERM / SIGHUP, whose default terminates the
# process — so a teardown that closes the signalfd first can be killed
# halfway, leaving the terminal raw on the alt screen. Done last, the
# same delivery is harmless: the terminal is already restored.
# (tests/darshana.tcyr proves the pending delivery, v1.1.4.)
#
# The fd is closed best-effort, except that an `fd` outside
# [0, 0x7FFFFFFF] is not closed at all (v1.1.4 — see `_tty_fd_ok`); the
# unblock runs either way. The return reflects the unblock — 0 on
# success, exactly -1 if sigprocmask fails, never a raw `-errno`.
# v0.7.0 — added so the open primitive isn't frozen at v1.0 without its
# teardown counterpart (chakshu's signalfd-driven exit is the first
# consumer).
#
# The -1 normalization landed in v1.0.2. v0.9.3 normalized
# `tty_open_signalfd`'s sentinel and missed its teardown twin, which
# went on returning `sys_sigprocmask`'s bare syscall result — so a
# failure surfaced as e.g. -22/EINVAL where this docstring promised -1,
# and the AGNOS peer (whose kernel already normalizes) disagreed with
# the Linux one on a contract both claimed to share. Latent rather than
# live: `rt_sigprocmask(SIG_UNBLOCK, <valid stack ptr>, NULL, 8)` has no
# reachable failure mode here. Fixing the code to match the frozen
# docstring is a patch under ADR 0003, which names exactly this case.
fn tty_close_signalfd(fd, sigmask) {
    # v1.1.4: an fd outside [0, 0x7FFFFFFF] is not closed — the kernel would
    # read its low 32 bits and close a DIFFERENT, live descriptor. The
    # unblock still runs, so the mask half of the contract is unchanged.
    if (_tty_fd_ok(fd) == 1) { file_close(fd); }
    var mask[8];
    store64(&mask, sigmask);
    var rc = sys_sigprocmask(SIG_UNBLOCK, &mask, 0);
    if (rc < 0) { return 0 - 1; }
    return 0;
}

# Read the next signal from a signalfd opened by `tty_open_signalfd`,
# consuming it. Returns the signal number (> 0); 0 if nothing is pending
# on a NON-blocking fd (see `tty_open_signalfd` for `fd_set_nonblocking`);
# or -1 on any other failure, including an `fd` outside [0, 0x7FFFFFFF]
# and a descriptor that is not a signalfd. On a blocking fd it waits for
# a signal, like read(2). Never a raw `-errno`.
#
# v1.2.0. Three consumers (chakshu, cyim, anuenue) each read the kernel's
# 128-byte `struct signalfd_siginfo` by hand to learn which signal woke
# them; the signal number is its first field, a u32 at offset 0. The
# number is the platform's own: SIGINT 2, SIGTERM 15, SIGWINCH 28 on both
# Linux arches and on AGNOS.
fn tty_read_signal(fd) {
    if (_tty_fd_ok(fd) == 0) { return 0 - 1; }
    var info[128];
    var n = sys_read(fd, &info, 128);
    if (n == 128) { return tio_load32(&info, 0); }
    if (n == 0 - EAGAIN) { return 0; }         # non-blocking, nothing pending
    return 0 - 1;
}

#endif

#ifdef CYRIUS_TARGET_AGNOS

# AGNOS terminal window size. agnos has no `ioctl(TIOCGWINSZ)` (its frozen
# syscall surface has no ioctl), so the kernel instead exposes the live
# framebuffer console grid directly via syscall #60 (`winsize`). It returns the
# two counts packed into one i64 — bits 16-31 = cols, bits 0-15 = rows — or
# -1 if the framebuffer isn't up. This is the agnos peer of the Linux
# `tty_winsize` above and preserves its contract EXACTLY: writes rows + cols
# through the caller's out-pointers (each an i64 via `store64`), returns 0 on
# success / -1 on failure. So consumers (kii / chakshu) call one `tty_winsize`
# and the platform branch is invisible to them — kii drops its
# `#ifndef CYRIUS_TARGET_AGNOS` gate and gets the real console grid on agnos,
# falling back to its 80×24 default only when this returns -1.
#
# `fd` is accepted for signature parity with the Linux variant but ignored: the
# console grid is a global property of the framebuffer, not a per-fd attribute.
#
# The call is the agnos stdlib's `sys_winsize()`, which owns the syscall
# number: this arm carries no copy of the kernel's ABI to keep in step.

# AGNOS peer of `tty_winsize`. Writes rows + cols through the caller's
# out-pointers (each an i64 via `store64`) and returns 0 on success, -1 if
# the framebuffer console is not up — the Linux contract exactly. `fd` is
# accepted for signature parity and ignored: the console grid is a global
# framebuffer property, not a per-fd attribute. See the long-form rationale
# in the block above.
fn tty_winsize(fd, out_rows, out_cols) {
    var packed = sys_winsize();
    if (packed < 0) { return 0 - 1; }
    return _agnos_winsize_unpack(packed, out_rows, out_cols);
}

# Decode winsize#60's packed reply — bits 0-15 rows, bits 16-31 cols —
# through the caller's out-pointers. Always returns 0.
#
# Private (v1.2.0), and pure, so tests/agnos.tcyr can exercise the AGNOS
# decode on a Linux host, where the syscall itself is uncallable (agnos 60
# is Linux `exit`). Through v1.1.4 the decode was inline in tty_winsize and
# had compile coverage only: swapping rows and cols survived every gate.
fn _agnos_winsize_unpack(packed, out_rows, out_cols) {
    store64(out_rows, packed & 0xFFFF);
    store64(out_cols, (packed >> 16) & 0xFFFF);
    return 0;
}

# AGNOS TTY predicate. agnos has no ioctl(TCGETS/TIOCGWINSZ), but the framebuffer
# console-grid syscall (#60, `winsize`) succeeds iff the console is up — the same
# "a window-size query succeeds only on a real terminal" mechanism the Linux
# `tty_isatty` above relies on (TIOCGWINSZ). So the agnos peer treats a
# successful `winsize` as "is a tty". `fd` is ignored: the console grid is a
# global framebuffer property, not per-fd.
#
# Returns 1 if the console is up, 0 otherwise — a strict 1/0 predicate, never
# a leaked errno. ⚠ The verdict is about the CONSOLE, not about `fd`: with the
# console up, a file or pipe on fd 1 also answers 1, so on AGNOS `prog > file`
# still receives escapes. The Linux peer's answer is per-fd; this one cannot
# be until agnos exposes a per-fd terminal property.
fn tty_isatty(fd) {
    if (sys_winsize() < 0) { return 0; }
    return 1;
}

# AGNOS raw-mode enter. agnos has no termios (no TCGETS/TCSETS), so there is no
# canonical/raw toggle to flip — the kernel console runs its own line discipline.
# Returns -1, at parity with the Linux "couldn't enter raw" failure, so consumers
# take their designed fallback (thoth/chakshu drop to their line REPL).
#
# -1 is the answer BY DESIGN, not a stopgap. Raw key input does exist on agnos —
# kbscan#42 delivers Set-1 scancodes, and chakshu and cyim decode them
# themselves — but decoding input is outside darshana's charter (owner ruling,
# 2026-10-12; roadmap.md § Out of scope). A consumer wanting raw keys on agnos
# reads kbscan itself. Only a kernel-side raw-mode switch on the agnos console
# would make this a real peer, as a termios-shaped wrapper rather than a
# decoder. A silent success here would strand the caller waiting on per-key
# input that never arrives.
fn tty_raw(fd) {
    return 0 - 1;
}

# AGNOS peer of `tty_raw_nonblock`. agnos has no termios, so there is no
# VMIN to set: returns -1, exactly like the AGNOS `tty_raw` and for the
# same reason (see its docstring).
fn tty_raw_nonblock(fd) {
    return 0 - 1;
}

# AGNOS peer of `tty_echo_off`. Returns -1, always. The agnos console echoes every
# printable key from the kernel's own line reader (ABI O1) and has no
# switch to stop it, so a password typed here is shown whatever this
# returns — and a silent 0 would tell the caller the opposite.
fn tty_echo_off(fd) {
    return 0 - 1;
}

# AGNOS peer of `tty_flush_input`. Returns -1, always: the kernel's
# keyboard buffer has no flush call, so pending keys cannot be discarded
# from ring 3.
fn tty_flush_input(fd) {
    return 0 - 1;
}

# AGNOS cooked-mode restore. The no-op counterpart to the agnos `tty_raw`: raw
# was never entered (no termios state to restore), so this is an idempotent
# success — matching the Linux `tty_cooked` "no-op when not raw" contract.
#
# Always returns 0; there is no failure mode on this arm.
fn tty_cooked() {
    return 0;
}

# AGNOS peer of `tty_forget`. There is no raw slot on this arm (`tty_raw`
# never succeeds), so there is nothing to free.
#
# Always returns 0.
fn tty_forget() {
    return 0;
}

# AGNOS signal masks for `tty_open_signalfd`. agnos/mirshi represent a signal
# SET as `1 << sig` (bit N = signal N) — NOT Linux's `1 << (sig-1)` sigset_t
# layout — so these values DIFFER from the Linux branch above by one bit
# position per signal. mirshi's sigprocmask#17 / signalfd#18 store the mask
# verbatim and its delivery walk (`_sig_lowest`) tests bit `sig` directly
# (mirshi children.cyr: "the per-child … mask (agnos `1<<sig`)"). Copying the
# Linux 0x4003 / 0x08000000 here would silently watch the wrong signals.
#   TTY_SIGMASK_EXIT  = SIGHUP(1) | SIGINT(2) | SIGTERM(15) → bits 1,2,15 → 0x8006
#   TTY_SIGMASK_WINCH = SIGWINCH(28)                        → bit  28     → 0x10000000
#   TTY_SIGMASK_PIPE  = SIGPIPE(13)                         → bit  13     → 0x2000
#
# ⚠ Nothing on agnos raises SIGWINCH today — neither the kernel nor mirshi
# generates it (checked 2026-10-12) — so a WINCH signalfd opens fine and never
# fires. Detect a console resize by polling `tty_winsize`. The value stays
# correct for the day agnos starts sending it.
#
# ⚠ agnos has no SIGPIPE: a write with no reader left returns its partial
# count or -1 instead (the stdlib's agnos `sys_write`). TTY_SIGMASK_PIPE is
# here so a consumer stays platform-blind; its signalfd never fires.
var TTY_SIGMASK_EXIT  = 0x8006;
var TTY_SIGMASK_WINCH = 0x10000000;
var TTY_SIGMASK_PIPE  = 0x2000;

# The signalfd path calls the agnos stdlib's `sys_sigprocmask` (#17) and
# `sys_signalfd` (#18), which own the syscall numbers — the same wrapper
# names the Linux arm calls, each resolving to its own target's syscall —
# and the stdlib's `SIG_BLOCK` / `SIG_UNBLOCK` / `SFD_CLOEXEC`, which have
# the same values on agnos as on Linux.
#
# SFD_CLOEXEC is passed for parity with the Linux peer's CLOEXEC
# discipline. mirshi's MVP signalfd is an opaque supervisor-side fd (no execve
# fd-inheritance across the ptrace boundary) and is always non-blocking, so it
# stores `flags` but does not act on them.

# AGNOS peer of `tty_open_signalfd`. Blocks the signals in `sigmask` on this
# thread (sigprocmask#17, SIG_BLOCK) then creates an emulated signalfd
# (signalfd#18, fd=-1 → allocate a new slot). Returns the emulated fd (>= 0) or
# -1 on failure. Preserves the Linux peer's contract EXACTLY so consumers call
# one `tty_open_signalfd` and the platform branch is invisible to them.
#
# mirshi's signalfd is edge-triggered + NON-BLOCKING: the caller polls it via
# epoll_wait#21 / read#5 rather than blocking on the fd — the same poll-driven
# usage the Linux peer's consumers already follow. `sigmask` is an agnos
# `1<<sig` set (see TTY_SIGMASK_* above), an 8-byte word like the Linux path.
#
# ⚠ Under mirshi (the agnos-on-Linux supervisor) this fd receives NOTHING
# today: mirshi delivers only signals that are pending AND unblocked through
# a signalfd, and this function — correctly, as on Linux and on the agnos
# kernel — blocks them first. A signal from the host (a terminal Ctrl-C, a
# host kill) also bypasses mirshi's agnos signal model and arrives as a real
# Linux signal with its default action. Both are filed in mirshi's roadmap
# (2026-10-12, confirmed by run); on the agnos kernel itself the fd works.
fn tty_open_signalfd(sigmask) {
    var mask[8];
    store64(&mask, sigmask);
    # Capture the entry mask (v1.0.2) — mirshi's sigprocmask#17 honours
    # a non-NULL oldset_ptr (`if (arg3 != 0) { store64(arg3, old_mask); }`).
    # Pre-zeroed for the same reason as the Linux peer.
    var prev[8];
    store64(&prev, 0);
    var rc = sys_sigprocmask(SIG_BLOCK, &mask, &prev);
    if (rc < 0) { return 0 - 1; }
    # signalfd(fd=-1, mask, SFD_CLOEXEC) → new emulated fd.
    var sfd = sys_signalfd(0 - 1, &mask, SFD_CLOEXEC);
    if (sfd < 0) {
        # Roll the block back, exactly as the Linux
        # peer does. mirshi already normalizes its failures to -1, so
        # only the rollback is substantive here; the shape is kept
        # identical so the two peers stay readable side by side.
        #
        # Unblock only the bits this call added, matching the Linux
        # peer (v1.0.2). Both the agnos kernel and mirshi name how 0 and
        # 1, so this needs no SIG_SETMASK — which the bare kernel would
        # only honour as an unnamed store-verbatim fall-through.
        var added[8];
        store64(&added, sigmask & ~load64(&prev));
        sys_sigprocmask(SIG_UNBLOCK, &added, 0);
        return 0 - 1;
    }
    return sfd;
}

# AGNOS peer of `tty_close_signalfd`: close `fd` and UNblock the signals in
# `sigmask` (sigprocmask#17, SIG_UNBLOCK). Closing the fd alone is not enough
# — the SIG_BLOCK would persist and the consumer's signals stay silently
# blocked after its UI exits. Like the Linux peer this UNBLOCKS rather than
# restoring a captured mask, needs DISJOINT masks across live signalfds, and
# belongs LAST in a teardown; see that docstring for why.
# Pass the SAME `sigmask` given to `tty_open_signalfd`. The fd is closed
# best-effort, except that a negative `fd` is never passed to close (v1.1.4):
# the stdlib's agnos `sys_close` treats any fd with bit 0x40000000 set as a
# tagged socket, and -1 has it, so `close(-1)` freed socket slot 7 — a live
# connection, if one was there. The unblock runs either way. The return
# reflects the unblock — 0 on success, exactly -1 if sigprocmask fails.
# Mirrors the Linux peer above.
#
# ⚠ Under mirshi a closed signalfd's slot is not freed (mirshi's documented
# v1.6.0 slot-leak limit; 8 slots per process), so after 8 open/close cycles
# every further `tty_open_signalfd` returns -1. The bare agnos kernel frees it.
#
# mirshi already normalizes its own failures to -1, so the explicit clamp
# below is redundant TODAY. It is written anyway (v1.0.2) so the two peers
# are structurally identical: the Linux twin needed the clamp, and a peer
# that merely happens to agree because its kernel is well-behaved is one
# kernel change away from silently diverging on a frozen contract.
fn tty_close_signalfd(fd, sigmask) {
    if (fd >= 0) { file_close(fd); }      # v1.1.4 — see the docstring
    var mask[8];
    store64(&mask, sigmask);
    var rc = sys_sigprocmask(SIG_UNBLOCK, &mask, 0);
    if (rc < 0) { return 0 - 1; }
    return 0;
}

# AGNOS peer of `tty_read_signal`: the next pending signal's number (> 0),
# consuming it; 0 if nothing is pending; -1 on failure or a negative `fd`.
# An agnos signalfd is always non-blocking, so this never waits.
#
# The kernel's `vfs_read_signalfd` answers a 4-byte signal number and 0
# when nothing is pending; mirshi answers an 8-byte one, and -1 when
# nothing is pending (filed in mirshi's roadmap, 2026-10-12). Reading the
# low 32 bits of a zeroed 8-byte buffer is right for both records. Under
# mirshi an empty read therefore returns -1, not 0 — and mirshi never
# delivers a blocked signal through a signalfd at all, so the call cannot
# yet see anything there.
fn tty_read_signal(fd) {
    if (fd < 0) { return 0 - 1; }
    var rec[8];
    store64(&rec, 0);
    var n = sys_read_nb(fd, &rec, 8);            # -2 = WOULD_BLOCK: nothing yet
    if (n > 0) { return tio_load32(&rec, 0); }
    if (n == 0 || n == 0 - 2) { return 0; }
    return 0 - 1;
}

#endif

# ---- platform-independent helpers over the peers above ---------------

# `tty_winsize`, but never 0 x 0: writes the terminal's rows and columns
# through the caller's out-pointers (each an i64 via `store64`), or the
# caller's `def_rows` / `def_cols` when the query fails OR answers a zero
# dimension. Always returns 0 — the out-pointers always receive a usable
# size, which is the point of the call.
#
# v1.2.0. A pty whose size was never set answers TIOCGWINSZ successfully
# with 0 x 0 (see `tty_winsize`), and four consumers each wrote this guard
# themselves (chakshu, cyim, kii, bannermanor). The defaults are the
# caller's because the consumers disagree on them (24x80 vs 80x24); any
# clamp — cyim's minimum 2x20, bannermanor's 4096 cap — stays in the
# consumer too. Both dimensions come from the same source: a 0 in either
# means the size is unknown, so both defaults are written.
fn tty_winsize_or(fd, out_rows, out_cols, def_rows, def_cols) {
    var r = 0;
    var c = 0;
    if (tty_winsize(fd, &r, &c) == 0) {
        if (r > 0 && c > 0) {
            store64(out_rows, r);
            store64(out_cols, c);
            return 0;
        }
    }
    store64(out_rows, def_rows);
    store64(out_cols, def_cols);
    return 0;
}

# --- ansi.cyr ---

# ansi.cyr — vt100-compatible ANSI escape helpers.
#
# Donor port from cyim/src/tty.cyr — the alt-screen / clear / cursor-
# visibility helpers. These work on any modern terminal (xterm, kitty,
# wezterm, the Linux console) regardless of the host OS, so they're
# NOT inside the CYRIUS_TARGET_LINUX gate that termios.cyr uses.
#
# Each fixed-escape helper writes its sequence to fd 1 (stdout)
# through the stdlib's `sys_write(1, ...)` and returns 0 unconditionally —
# best-effort: the write(2) result is not checked. A 3–8 byte escape
# to a TTY does not partial-write in practice, and a consumer mid-
# render has no meaningful recovery from a failed escape, so the
# emitters keep their call sites clean rather than thread an error.
#
# The wrapper, not a raw `syscall(1, ...)`: write is 1 on x86_64 but 64
# on aarch64, and a literal 1 reached the right call there only because
# the aarch64 backend rewrites it. The stdlib's `SYS_WRITE` is each
# target's own number.
#
# ⚠ One failure is not quiet: if fd 1 is a pipe whose reader has gone
# (`prog | head -c1`), the write raises SIGPIPE, whose default action
# kills the process on the spot. That is why a teardown restores the
# terminal with `tty_cooked()` BEFORE emitting any of these (ADR 0002,
# amended v1.1.4) — and why a consumer that may write to a pipe should
# ignore SIGPIPE. TTY_SIGMASK_EXIT does not include it.
# The `_buf` composers in this file (and `tty_dec_buf` in cursor.cyr)
# are the batching answer for frame-coalesced writes: compose into a
# caller buffer and issue one write(2) at frame end.

# Switch to the alt-screen buffer. CSI ?1049h. Saves the primary
# screen state; the consumer's UI lives on the alt-screen and the
# user's previous shell content is restored on tty_alt_leave().
# Returns 0 (the write(2) result is not checked — see this file's header).
fn tty_alt_enter() {
    sys_write(1, "\x1b[?1049h", 8);
    return 0;
}

# Leave the alt-screen buffer, restoring the primary. CSI ?1049l.
# Pair with tty_alt_enter() on every exit path including SIGINT/SIGTERM.
# Returns 0.
fn tty_alt_leave() {
    sys_write(1, "\x1b[?1049l", 8);
    return 0;
}

# Clear the entire visible screen. CSI 2J. Doesn't move the cursor —
# pair with tty_cursor_home() if you want top-left.
# Returns 0.
fn tty_clear() {
    sys_write(1, "\x1b[2J", 4);
    return 0;
}

# Clear from cursor to end of current line. CSI K. Used in render
# loops to wipe any leftover characters from a previous frame on the
# current row (e.g., a process row that was longer last tick).
# v0.3.0 — promoted from chakshu's _tui_clear_eol.
# Returns 0.
fn tty_clear_to_eol() {
    sys_write(1, "\x1b[K", 3);
    return 0;
}

# Append `CSI K` — clear from the cursor to the end of the line — to `buf`
# at `pos` (v1.3.0). The `_buf` form of `tty_clear_to_eol`, for a frame
# composed into one write. Returns the new write position, or -1 if `pos`
# is negative (a rejection writes nothing). Byte budget: 3.
fn tty_clear_to_eol_buf(buf, pos) {
    if (pos < 0) { return 0 - 1; }
    store16(buf + pos, 0x5B1B);         # ESC [
    store8(buf + pos + 2, 0x4B);        # 'K'
    return pos + 3;
}

# Clear from cursor to end of screen. CSI J. Used at the bottom of a
# frame to wipe rows that were populated last tick but not this one
# (e.g., process count dropped between frames).
#
# Named `_to_eos` (end-of-screen) to parallel `tty_clear_to_eol`
# (end-of-line) — the suffix names the extent at the call site, so a
# consumer can't misread a full-screen-tail wipe as a line wipe.
# v0.3.0 — promoted from chakshu's `_tui_clear_to_end`; renamed from
# `tty_clear_to_end` in v0.7.0 to remove that ambiguity before the
# v1.0 freeze (emitted bytes unchanged — still CSI J).
# Returns 0.
fn tty_clear_to_eos() {
    sys_write(1, "\x1b[J", 3);
    return 0;
}

# Hide the text cursor. CSI ?25l. Pair with tty_cursor_show() on exit
# or the user's shell prompt comes back without a visible cursor.
# Returns 0.
fn tty_cursor_hide() {
    sys_write(1, "\x1b[?25l", 6);
    return 0;
}

# Show the text cursor. CSI ?25h.
# Returns 0.
fn tty_cursor_show() {
    sys_write(1, "\x1b[?25h", 6);
    return 0;
}

# Move cursor to row 1, col 1. CSI H. Cheaper than tty_move(1, 1)
# because no decimal formatting / parameter encoding.
# Returns 0.
fn tty_cursor_home() {
    sys_write(1, "\x1b[H", 3);
    return 0;
}

# Save the cursor position and attributes (DECSC, `ESC 7`) so
# `tty_cursor_restore()` can put them back — for painting a status line or
# spinner elsewhere on the screen and returning (v1.3.0). The terminal keeps
# ONE saved position; a second save overwrites the first. `ESC 7` rather
# than `CSI s`, which some terminals read as a margin setting. Returns 0.
fn tty_cursor_save() {
    sys_write(1, "\x1b7", 2);
    return 0;
}

# Restore the position and attributes `tty_cursor_save()` saved (DECRC,
# `ESC 8`). Returns 0.
fn tty_cursor_restore() {
    sys_write(1, "\x1b8", 2);
    return 0;
}

# Turn mouse reporting on: button press and release (mode 1000) in SGR
# encoding (mode 1006, which has no 223-column limit) — `CSI ?1000h
# CSI ?1006h` (v1.3.0). The terminal then sends a report for every click
# as INPUT; decoding those reports is the consumer's (darshana does not
# decode input). Pair with `tty_mouse_disable()` on every exit path, or
# the user's shell receives the reports. Returns 0.
fn tty_mouse_enable() {
    sys_write(1, "\x1b[?1000h\x1b[?1006h", 16);
    return 0;
}

# Turn mouse reporting off — `CSI ?1006l CSI ?1000l`, the reverse of
# `tty_mouse_enable`. Returns 0.
fn tty_mouse_disable() {
    sys_write(1, "\x1b[?1006l\x1b[?1000l", 16);
    return 0;
}

# Turn bracketed paste on — `CSI ?2004h` (v1.3.0): the terminal wraps
# pasted text in `CSI 200~` ... `CSI 201~`, so a program can tell a paste
# from typing (and not run a pasted newline as Enter). Those markers arrive
# as INPUT; recognizing them is the consumer's. Pair with
# `tty_paste_disable()` on every exit path. Returns 0.
fn tty_paste_enable() {
    sys_write(1, "\x1b[?2004h", 8);
    return 0;
}

# Turn bracketed paste off — `CSI ?2004l`. Returns 0.
fn tty_paste_disable() {
    sys_write(1, "\x1b[?2004l", 8);
    return 0;
}

# ---- SGR (Select Graphic Rendition) color helpers --------------------
#
# v0.3.5 — added for the bannermanor M5 (`bnrmr --color cyan TEXT`).
# 8/16 named ANSI foreground colors — the original figlet-equivalent
# banner-tinting case. The 256-color and 24-bit tiers landed later in
# this same file as consumers asked: truecolor v0.5.1, 256-color
# v0.5.3, both driven by anuenue (not chakshu/bannermanor, as this
# note predicted). See the sections below.
#
# Usage:
#     tty_sgr(TTY_FG_CYAN);        # set foreground to cyan
#     sys_write(1, "AGNOS", 5);   # write colored text
#     tty_sgr_reset();             # clear back to default
#
# Idempotency: consumers are responsible for emitting tty_sgr_reset()
# before the terminal returns to the shell prompt; darshana does not
# install an exit handler. Same discipline as tty_cursor_show().

# Foreground color SGR parameter values. 30–37 are the base 8;
# 90–97 are the "bright" / high-intensity variants. Module-level
# `var` declarations follow darshana's existing TIO_* / TTY_SIGMASK_*
# convention so the smoke.sh surface check picks them up.
var TTY_FG_BLACK   = 30;
var TTY_FG_RED     = 31;
var TTY_FG_GREEN   = 32;
var TTY_FG_YELLOW  = 33;
var TTY_FG_BLUE    = 34;
var TTY_FG_MAGENTA = 35;
var TTY_FG_CYAN    = 36;
var TTY_FG_WHITE   = 37;
var TTY_FG_BRIGHT_BLACK   = 90;
var TTY_FG_BRIGHT_RED     = 91;
var TTY_FG_BRIGHT_GREEN   = 92;
var TTY_FG_BRIGHT_YELLOW  = 93;
var TTY_FG_BRIGHT_BLUE    = 94;
var TTY_FG_BRIGHT_MAGENTA = 95;
var TTY_FG_BRIGHT_CYAN    = 96;
var TTY_FG_BRIGHT_WHITE   = 97;

# Background color SGR parameter values (v1.3.0): the foreground set plus
# 10 — 40–47 base, 100–107 bright. Pass them to `tty_sgr` / `tty_sgr_buf`
# or `tty_sgr_list_buf`, like the TTY_FG_* codes.
var TTY_BG_BLACK   = 40;
var TTY_BG_RED     = 41;
var TTY_BG_GREEN   = 42;
var TTY_BG_YELLOW  = 43;
var TTY_BG_BLUE    = 44;
var TTY_BG_MAGENTA = 45;
var TTY_BG_CYAN    = 46;
var TTY_BG_WHITE   = 47;
var TTY_BG_BRIGHT_BLACK   = 100;
var TTY_BG_BRIGHT_RED     = 101;
var TTY_BG_BRIGHT_GREEN   = 102;
var TTY_BG_BRIGHT_YELLOW  = 103;
var TTY_BG_BRIGHT_BLUE    = 104;
var TTY_BG_BRIGHT_MAGENTA = 105;
var TTY_BG_BRIGHT_CYAN    = 106;
var TTY_BG_BRIGHT_WHITE   = 107;

# SGR attribute codes (v1.2.0) — pass them to `tty_sgr` / `tty_sgr_buf`,
# e.g. `tty_sgr(TTY_SGR_REVERSE)` for a selection highlight. Only the
# attributes consumers actually hand-wrote: bold and dim (chakshu,
# thoth), underline (thoth), reverse video (chakshu, cyim, thoth).
# `tty_sgr_reset()` clears all of them; there are no per-attribute "off"
# codes because no consumer uses one.
var TTY_SGR_BOLD      = 1;
var TTY_SGR_DIM       = 2;
var TTY_SGR_UNDERLINE = 4;
var TTY_SGR_REVERSE   = 7;

# Reset all SGR attributes (color, bold, underline, etc.). CSI 0m.
# Cheaper than tty_sgr(0) — no decimal formatting.
# Returns 0.
fn tty_sgr_reset() {
    sys_write(1, "\x1b[0m", 4);
    return 0;
}

# ---- 24-bit (truecolor) SGR helpers ---------------------------------
#
# v0.5.1 — added for anuenue's M1 (the rainbow pipe-filter). anuenue's
# per-character HSV phase cycle needs `\x1b[38;2;R;G;Bm` directly;
# 8/16 named colors quantize the rainbow into ROYGBIV-with-banding,
# 256-color is the M6 fallback path.
#
# Why both "direct" and "_buf" variants:
# - Direct (`tty_fg_rgb` / `tty_bg_rgb`) is a one-shot — formats into
#   a stack buf and calls write(2) once. Same shape as `tty_sgr`.
# - `_buf` variants append into a caller-provided buffer and return
#   the new write position. Used by pipe filters that batch many
#   escapes + payload bytes into a single line-sized write to avoid
#   per-character syscall overhead. anuenue's M1 loop was the first
#   `_buf` consumer; kii and agora have since joined it.
#
# Escape layout (foreground): `CSI 38;2;<R>;<G>;<B>m` — 19 bytes max
# (ESC[ + "38;2;" + "255" * 3 + ";" * 2 + "m"). Background swaps "38"
# for "48"; same length envelope. Stack buf[24] gives ~5 bytes
# headroom for safety; the _buf variants assume the caller sized for
# 19 per emission.
#
# Contract: r, g, b each in `[0, 255]`. Out-of-range channels return
# -1 (or -1 from the _buf variants — the new position is non-
# negative on success). Same fail-before-emit discipline as
# `tty_sgr`'s `[0, 999]` guard added in v0.4.0.

# ---- digit encoding in the composers (v1.1.0, rewritten v1.2.0) -----
#
# v1.2.0: every composer now writes its constant prefix as ONE literal
# store and each digit field — digits plus its ';' or 'm' — as exact-width
# packed stores (store32 for "ddd;", store16 + store8 for "dd;", store16
# for "d;") through a pointer cursor. Measured on the landed code against
# v1.1.4, 20M calls, whole process, median of 5: `tty_fg_rgb_buf`
# 758 -> 486 ms (-36%), `tty_fg_256_buf` 326 -> 191 (-41%), `tty_sgr_buf`
# 307 -> 201 (-35%). tests/identity.tcyr proves
# the bytes and returns identical over every input, on x86_64, qemu and a
# real Pi 4 (the new store16 and the data-dependent store32 offsets are
# unaligned; ARM was what licensed v1.1.0's store64 too).
#
# Why it was slower before: cycc 6.6.20 does NOT fold
# `27 | (91 << 8) | (layer << 16) | ...` — about 45 instructions per
# call built the "one store" v1.1.0 introduced. Write such constants as
# hex literals. And only body locals are register-allocated, never
# parameters, which is why a pointer cursor `p` beats `pos = pos + 1`.
#
# ⛔ Traps the 1.1.4 measurement recorded, so 1.2.0 did not retry them:
# a packed store must never write past the escape (a `store32` of "7m??"
# for the last field passes every length test; only identity.tcyr's
# whole-canvas check sees it); `((pos | r | g | b) >> 8)` wrongly rejects
# pos >= 256; and each composer keeps its own `pos < 0` guard even though
# internal callers pass constants — dropping it reopens v0.9.3's laundered
# -1. Flattening `tty_fg_rgb_buf` / `tty_bg_rgb_buf` into two copies of
# this body would save another ~4-5 ns per call and was deliberately not
# taken: two hand-maintained copies for a gain no consumer is bound by.
#
# The v1.1.0 history below still holds.
# `_ansi_emit_u8` is GONE. It was darshana's second decimal emitter —
# `tty_dec_buf` (cursor.cyr) is the first — and v1.0.2 recorded that
# collapsing the two was a byte-identical refactor worth taking at the
# next minor. It was taken here, but NOT the obvious way, and the
# measurements are recorded because the obvious way is a trap.
#
# Delegating the five call sites to `tty_dec_buf` is byte-identical
# (proven exhaustively) and 32-45% SLOWER: 20M `tty_fg_rgb_buf` calls
# went 990 ms -> 1418 ms, `tty_fg_256_buf` 458 -> 605, `tty_sgr_buf`
# 353 -> 511 (the CHANGELOG [1.1.0] table; median of 7). `tty_dec_buf`
# was a general i64 formatter — it reversed digits through a 24-byte
# scratch array and copied them back — where these composers only ever
# emit 1-3 digits. (v1.2.0 gave `tty_dec_buf` a 1-3 digit fast path, but
# the call itself is the cost, so delegation would still lose.)
#
# So the duplication was removed by ELIMINATION instead: the 1-3 digit
# sequence is written inline at each of the five sites, and the shared
# helper is deleted. Nothing in the library now carries a second
# decimal-emitter FUNCTION, and every composer got faster.
#
# ⚠ This deliberately re-expands what v0.9.3 deduplicated, so the
# reason is recorded here to stop the next sweep re-collapsing it: the
# cost is the CALL, not the arithmetic. cycc's prologue unconditionally
# spills rbx/r12/r13/r14/r15 even in a leaf function that touches none
# of them, so `_ansi_rgb_buf` paid ~30 wasted memory ops per call for
# its three digit emissions. If cycc ever grows a leaf-function
# prologue optimization, re-collapsing these becomes free and correct —
# measure before assuming it still is.
#
# ⛔ Do NOT replace the divisions with reciprocal multiplication.
# `(val*41)>>12` for /100 and `(val*205)>>11` for /10 are exact over
# this domain and were measured SLOWER (1040 ms vs 1000 ms): the extra
# multiply/shift nodes cost more in cycc's stack machine than Zen3's
# idiv on small operands saves. anuenue's src/filter.cyr asserts the
# divides dominate here; that is wrong, and this note is the reply.
#
# Digit domain is `[0, 999]` — `tty_sgr_buf` feeds codes up to 999
# (its own frozen envelope). Every call site validates its own range
# and rejects `pos < 0` first, so a negative value is unreachable and
# is not defended against inline.

# Shared body for the fg/bg 24-bit composers. `layer` is the ASCII
# digit selecting the plane: 51 ('3') = foreground, 52 ('4') =
# background. Everything else about the two escapes is identical, so
# they differed by exactly one byte — parameterizing it (v0.9.3)
# collapses two 19-line verbatim copies into one body.
#
# Returns the new write position, or -1 on a rejected input. Bounds
# rejection is per-channel: the first out-of-range channel
# short-circuits, no partial write occurs. A negative incoming `pos`
# is rejected the same way.
#
# v1.1.0 rewrote the body for speed without moving a byte (990 -> 696 ms
# per 20M calls); v1.2.0 rewrote it again — literal prefix, one range
# test, a pointer cursor and packed field stores (see the section note
# above): 758 -> 486 ms per 20M calls against v1.1.4, -36%.
fn _ansi_rgb_buf(buf, pos, layer, r, g, b) {
    if (pos < 0) { return 0 - 1; }
    # One test for all three channels: `>>` zero-fills in cycc, so a
    # negative channel has high bits set too. Exact over all of i64.
    if (((r | g | b) >> 8) != 0) { return 0 - 1; }
    var p = buf + pos;
    # `ESC [ <layer> 8 ; 2 ;` + one spare byte, as a single literal store.
    # The spare 8th byte is always overwritten by R's field, which starts
    # at p + 7 and is at least 2 bytes wide.
    store64(p, 0x003B323B38005B1B | (layer << 16));
    p = p + 7;
    var q = 0;
    # Each field is written with exact-width stores — digits plus its
    # terminator (';', or 'm' for B) — so nothing lands past the escape.
    if (r >= 100) {
        q = r / 10;
        store32(p, 0x3B303030 + r / 100 + ((q % 10) << 8) + ((r % 10) << 16)); p = p + 4;
    } else { if (r >= 10) {
            store16(p, 0x3030 + r / 10 + ((r % 10) << 8)); store8(p + 2, 59); p = p + 3;
        } else {
            store16(p, 0x3B30 + r); p = p + 2;
        } }
    if (g >= 100) {
        q = g / 10;
        store32(p, 0x3B303030 + g / 100 + ((q % 10) << 8) + ((g % 10) << 16)); p = p + 4;
    } else { if (g >= 10) {
            store16(p, 0x3030 + g / 10 + ((g % 10) << 8)); store8(p + 2, 59); p = p + 3;
        } else {
            store16(p, 0x3B30 + g); p = p + 2;
        } }
    if (b >= 100) {
        q = b / 10;
        store32(p, 0x6D303030 + b / 100 + ((q % 10) << 8) + ((b % 10) << 16)); p = p + 4;
    } else { if (b >= 10) {
            store16(p, 0x3030 + b / 10 + ((b % 10) << 8)); store8(p + 2, 109); p = p + 3;
        } else {
            store16(p, 0x6D30 + b); p = p + 2;
        } }
    return p - buf;
}

# One-shot writer shared by `tty_fg_rgb` / `tty_bg_rgb`. Composes into
# a 24-byte stack buffer (19-byte worst case) and issues one write(2).
fn _ansi_rgb_write(layer, r, g, b) {
    var buf[24];
    var pos = _ansi_rgb_buf(&buf, 0, layer, r, g, b);
    if (pos < 0) { return 0 - 1; }
    sys_write(1, &buf, pos);
    return 0;
}

# Append `CSI 38;2;R;G;Bm` to `buf` at `pos` — set FOREGROUND to the
# 24-bit color (r, g, b). Returns the new write position, or -1 if any
# channel is outside [0, 255] or `pos` is negative. Byte budget: up to
# 19. Composes only; touches no fd. Use `tty_fg_rgb` for the one-shot.
fn tty_fg_rgb_buf(buf, pos, r, g, b) {
    return _ansi_rgb_buf(buf, pos, 51, r, g, b);      # '3' = foreground
}

# Append `CSI 48;2;R;G;Bm` to `buf` at `pos` — the BACKGROUND twin of
# `tty_fg_rgb_buf`. Same contract, same 19-byte budget: returns the new
# write position, or -1 on an out-of-range channel or negative `pos`.
fn tty_bg_rgb_buf(buf, pos, r, g, b) {
    return _ansi_rgb_buf(buf, pos, 52, r, g, b);      # '4' = background
}

# Append `CSI 0m` to `buf` at `pos`. Returns the new `pos`, or -1 if
# `pos` is negative (v0.9.3 — before that this composer had no
# failure mode at all, so a -1 handed in from an earlier link in the
# chain was laundered into a write below the caller's buffer).
# Byte budget: exactly 4. The buffer-targeting reset, for callers
# composing a frame that ends "...payload bytes... + reset".
# `tty_sgr_reset()` is the write-to-fd-1 variant.
fn tty_sgr_reset_buf(buf, pos) {
    if (pos < 0) { return 0 - 1; }
    # `ESC [ 0 m` in one unaligned 4-byte store. Unlike the two above
    # this writes EXACTLY the bytes it produces — no 8th-byte argument
    # is needed, because the escape is exactly 4 bytes long.
    store32(buf + pos, 0x6D305B1B);      # ESC [ 0 m, as one literal (v1.2.0)
    return pos + 4;
}

# Append ONE SGR escape setting several attributes at once — `CSI a;b;c m`
# for the `n` codes in the i64 array `codes` (8 bytes per entry) — to `buf`
# at `pos` (v1.3.0). `codes` are SGR parameters as `tty_sgr` takes them:
# TTY_FG_*, TTY_BG_*, TTY_SGR_*, or any code in [0, 999], e.g. bold yellow
# on blue is { TTY_SGR_BOLD, TTY_FG_YELLOW, TTY_BG_BLUE } → `ESC[1;33;44m`.
# Returns the new write position, or -1 if `pos` is negative, `n` is outside
# [1, 16], or any code is outside [0, 999]; every code is checked before
# anything is written, so a rejection writes nothing. Byte budget: 2 + 4·n
# (66 at n = 16).
fn tty_sgr_list_buf(buf, pos, codes, n) {
    if (pos < 0 || n < 1 || n > 16) { return 0 - 1; }
    var i = 0;
    while (i < n) {
        var c = load64(codes + i * 8);
        if (c < 0 || c > 999) { return 0 - 1; }
        i = i + 1;
    }
    store16(buf + pos, 0x5B1B);         # ESC [
    var p = pos + 2;
    i = 0;
    while (i < n) {
        p = tty_dec_buf(buf, p, load64(codes + i * 8));
        store8(buf + p, 59);            # ';' — the last one becomes 'm'
        p = p + 1;
        i = i + 1;
    }
    store8(buf + p - 1, 0x6D);          # 'm'
    return p;
}

# Write the `tty_sgr_list_buf` escape for `n` codes to fd 1 in one write
# (v1.3.0). Returns 0, or -1 on the same rejections, before anything is
# written.
fn tty_sgr_list(codes, n) {
    var buf[66];
    var len = tty_sgr_list_buf(&buf, 0, codes, n);
    if (len < 0) { return 0 - 1; }
    sys_write(1, &buf, len);
    return 0;
}

# ---- OSC: window title and clipboard (v1.3.0) -----------------------
#
# Both are terminated with BEL rather than ST (`ESC \`): more terminals
# accept it, and thoth (their first user) chose it for that reason.

# Append an OSC 0 escape setting the window and icon title to the `len`
# bytes at `src` — `ESC ] 0 ; <title> BEL` — to `buf` at `pos`. The title is
# untrusted text by default, so it goes through `tty_sanitize_buf` in UTF-8
# mode with nothing kept: a BEL or ESC in it cannot end the sequence early
# and smuggle in another one. Returns the new write position, or -1 if
# `pos` or `len` is negative (a rejection writes nothing). Byte budget:
# `len` + 5.
fn tty_title_buf(buf, pos, src, len) {
    if (pos < 0 || len < 0) { return 0 - 1; }
    store32(buf + pos, 0x3B305D1B);     # ESC ] 0 ;
    var p = tty_sanitize_buf(buf, pos + 4, src, len, TTY_SANITIZE_UTF8, 0);
    store8(buf + p, 7);                 # BEL
    return p + 1;
}

# Set the window title to the `len` bytes at `src` (see `tty_title_buf`),
# in one write to fd 1. Returns 0, or -1 if `len` is negative or above 256
# — before anything is written. Longer titles: compose with
# `tty_title_buf` into your own buffer.
fn tty_title(src, len) {
    if (len < 0 || len > 256) { return 0 - 1; }
    var buf[261];
    var n = tty_title_buf(&buf, 0, src, len);
    sys_write(1, &buf, n);
    return 0;
}

# The RFC 4648 base64 alphabet, for OSC 52.
const _B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

# Append the standard base64 encoding (RFC 4648 §4, `=`-padded) of the
# `len` bytes at `src` to `buf` at `pos`; returns the new position. Writes
# 4 · ceil(len / 3) bytes.
fn _b64_buf(buf, pos, src, len) {
    var p = buf + pos;
    var i = 0;
    while (i + 3 <= len) {
        var v = (load8(src + i) << 16) | (load8(src + i + 1) << 8) | load8(src + i + 2);
        store8(p, load8(_B64 + ((v >> 18) & 63)));
        store8(p + 1, load8(_B64 + ((v >> 12) & 63)));
        store8(p + 2, load8(_B64 + ((v >> 6) & 63)));
        store8(p + 3, load8(_B64 + (v & 63)));
        p = p + 4;
        i = i + 3;
    }
    var r = len - i;
    if (r > 0) {
        var w = load8(src + i) << 16;
        if (r == 2) { w = w | (load8(src + i + 1) << 8); }
        store8(p, load8(_B64 + ((w >> 18) & 63)));
        store8(p + 1, load8(_B64 + ((w >> 12) & 63)));
        if (r == 2) { store8(p + 2, load8(_B64 + ((w >> 6) & 63))); }
        else { store8(p + 2, 61); }     # '='
        store8(p + 3, 61);              # '='
        p = p + 4;
    }
    return p - buf;
}

# Append an OSC 52 escape that puts the `len` bytes at `src` on the
# terminal's clipboard — `ESC ] 52 ; c ; <base64> BEL` — to `buf` at `pos`.
# Any bytes may be copied: base64 leaves nothing a terminal could read as a
# control. Terminals cap what they accept (often around 100 KB of base64)
# and many ask the user first or refuse OSC 52 outright; the escape says
# nothing back. Returns the new write position, or -1 if `pos` or `len` is
# negative (a rejection writes nothing). Byte budget: 8 + 4 · ceil(len / 3).
fn tty_clipboard_buf(buf, pos, src, len) {
    if (pos < 0 || len < 0) { return 0 - 1; }
    store32(buf + pos, 0x32355D1B);     # ESC ] 5 2
    store16(buf + pos + 4, 0x633B);     # ; c
    store8(buf + pos + 6, 59);          # ;
    var p = _b64_buf(buf, pos + 7, src, len);
    store8(buf + p, 7);                 # BEL
    return p + 1;
}

# Put the `len` bytes at `src` on the terminal's clipboard (see
# `tty_clipboard_buf`), writing to fd 1 in 64-byte pieces so no buffer
# needs to fit the whole payload. Returns 0, or -1 if `len` is negative —
# before anything is written.
fn tty_clipboard_set(src, len) {
    if (len < 0) { return 0 - 1; }
    sys_write(1, "\x1b]52;c;", 7);
    var chunk[64];
    var i = 0;
    while (i < len) {
        var n = len - i;
        if (n > 48) { n = 48; }         # 48 is a multiple of 3: only the last piece pads
        sys_write(1, &chunk, _b64_buf(&chunk, 0, src + i, n));
        i = i + n;
    }
    sys_write(1, "\x07", 1);
    return 0;
}

# Append `CSI <code>m` to `buf` at `pos`. Returns new `pos`, or -1
# if `code` is outside [0, 999] or `pos` is negative. Byte budget:
# up to 6 (ESC [ + 3 digits + m). Buffer-targeting twin of `tty_sgr`
# — same [0, 999] envelope, same fail-before-emit discipline. Used
# by consumers that build frames into a stack buffer and write
# once at frame end (anuenue M6's `_PHASE_ESC_TABLE` builder is
# the first such consumer, emitting 16-color named SGR escapes
# `\x1b[91m` ... `\x1b[97m` per phase).
#
# v0.5.3 — added for anuenue M6 color-mode negotiation.
fn tty_sgr_buf(buf, pos, code) {
    if (pos < 0) { return 0 - 1; }
    if (code < 0 || code > 999) { return 0 - 1; }
    var p = buf + pos;
    if (code >= 100) {
        var q = code / 10;
        store16(p, 0x5B1B);                                           # ESC [
        store32(p + 2, 0x6D303030 + code / 100 + ((q % 10) << 8) + ((code % 10) << 16));
        return pos + 6;
    }
    if (code >= 10) {
        store32(p, 0x30305B1B + ((code / 10) << 16) + ((code % 10) << 24));
        store8(p + 4, 109);                                           # 'm'
        return pos + 5;
    }
    store32(p, 0x6D305B1B + (code << 16));                            # ESC [ d m
    return pos + 4;
}

# ---- 256-color (8-bit indexed) SGR helpers --------------------------
#
# v0.5.3 — added for anuenue's M6 (color-mode negotiation). The
# 256-color middle was the only gap left after v0.5.1's 24-bit
# truecolor helpers + the original 8/16 named-color set. anuenue's
# `TRUECOLOR` mode uses `tty_fg_rgb_buf`; the `MODE_256` fallback
# uses this helper to emit the same per-phase color table at lower
# fidelity.
#
# Escape layout: `CSI 38;5;<N>m` — 9 bytes ("\x1b[38;5;0m") at the
# short end, 11 bytes ("\x1b[38;5;255m") at the long end. Callers
# must budget 11 bytes per emission. Background (`48;5;N`) has the
# same envelope. (No one-shot `tty_fg_256` wrapper has shipped — this
# tier is buffer-composing only.)

# Shared body for the 256-color composers (v1.2.0, when the background
# twin landed). `layer` is the ASCII digit selecting the plane — 51 ('3')
# foreground, 52 ('4') background — exactly as `_ansi_rgb_buf` does for
# the 24-bit pair: the two escapes differ by that one byte. Returns the
# new write position, or -1 if `n` is outside [0, 255] or `pos` is
# negative; a rejection writes nothing.
fn _ansi_256_buf(buf, pos, layer, n) {
    if (pos < 0) { return 0 - 1; }
    if ((n >> 8) != 0) { return 0 - 1; }         # n outside [0, 255], negatives included
    var p = buf + pos;
    # `ESC [ <layer> 8 ; 5 ;` + a spare byte; the index field starts at
    # p + 7 and is at least 2 bytes wide, so it always overwrites the spare.
    store64(p, 0x003B353B38005B1B | (layer << 16));
    if (n >= 100) {
        var q = n / 10;
        store32(p + 7, 0x6D303030 + n / 100 + ((q % 10) << 8) + ((n % 10) << 16));
        return pos + 11;
    }
    if (n >= 10) {
        store16(p + 7, 0x3030 + n / 10 + ((n % 10) << 8)); store8(p + 9, 109);
        return pos + 10;
    }
    store16(p + 7, 0x6D30 + n);
    return pos + 9;
}

# Append `CSI 38;5;Nm` to `buf` at `pos`. Returns new `pos`, or -1
# if `n` is outside [0, 255], or -1 if `pos` is negative.
# Buffer-targeting primitive (no fd 1 write); use it inside a frame
# builder. Byte budget: up to 11.
fn tty_fg_256_buf(buf, pos, n) {
    return _ansi_256_buf(buf, pos, 51, n);           # '3' = foreground
}

# Append `CSI 48;5;Nm` to `buf` at `pos` — the BACKGROUND twin of
# `tty_fg_256_buf`. Same contract, same budget: returns the new write
# position, or -1 if `n` is outside [0, 255] or `pos` is negative.
# Byte budget: up to 11.
#
# v1.2.0. Deferred since v0.5.3 under the extract-on-2nd-consumer rule:
# kii carried a local `_emit_bg_256_buf` as consumer #1, and its own
# comment named the trigger; thoth's `_ui_bg_escape` became the second.
fn tty_bg_256_buf(buf, pos, n) {
    return _ansi_256_buf(buf, pos, 52, n);           # '4' = background
}

# Set foreground to 24-bit (r,g,b), writing the escape directly to
# fd 1. Convenience wrapper over `tty_fg_rgb_buf` over a stack buf.
# Returns 0 on success, -1 on out-of-range channel input.
fn tty_fg_rgb(r, g, b) {
    return _ansi_rgb_write(51, r, g, b);              # '3' = foreground
}

# Set BACKGROUND to 24-bit (r, g, b), writing the escape straight to
# fd 1 in one write(2). Background twin of `tty_fg_rgb`. Returns 0 on
# success, -1 if any channel is outside [0, 255] — rejected before any
# byte is emitted.
fn tty_bg_rgb(r, g, b) {
    return _ansi_rgb_write(52, r, g, b);              # '4' = background
}

# Emit `CSI <code>m` — the underlying SGR primitive. Most consumers
# pass a `TTY_FG_*` constant (30–37 / 90–97), but any 1–3 digit
# decimal code works; this is the door for future bold (1) /
# underline (4) / bg (40–47, 100–107) helpers without growing the
# fn surface.
#
# Contract: `code` must be in `[0, 999]`. Anything outside that range
# (negative, or >= 1000) is rejected with `-1` *before* any bytes
# reach fd 1 — an out-of-range code would otherwise emit a malformed
# CSI sequence the terminal may misinterpret. v0.4.0 added the guard;
# v0.3.5 accepted any 64-bit input.
#
# v0.9.3 — reduced to a one-shot wrapper over `tty_sgr_buf`, the same
# compose-then-write shape `tty_fg_rgb` / `tty_bg_rgb` already used.
# That is why it now lives here beside them rather than up beside the
# TTY_FG_* constants: `tty_sgr_buf` has to be defined first. Emitted
# bytes and return values are unchanged.
fn tty_sgr(code) {
    var buf[8];                  # max emit is ESC [ + 3 digits + m = 6
    var pos = tty_sgr_buf(&buf, 0, code);
    if (pos < 0) { return 0 - 1; }
    sys_write(1, &buf, pos);
    return 0;
}

# --- cursor.cyr ---

# cursor.cyr — cursor positioning via CSI row;colH.
#
# Donor port from cyim/src/tty.cyr. Split out from ansi.cyr because
# cursor positioning needs decimal formatting (the row/col integers
# encode into the escape) — different shape from the fixed-bytes
# escape helpers in ansi.cyr.
#
# tty_dec_buf (the decimal formatter) is a public member of the `_buf`
# family — consumers compose custom escapes with embedded integers
# through it (cyim's status line does). It lives here because the
# cursor escapes need it; its `_buf` naming and new-position return
# match tty_sgr_buf / tty_fg_rgb_buf in ansi.cyr.

# Write the decimal digits of `val` into `buf` at `pos`; return the new
# write position (`pos` + number of digits). A negative or zero `val`
# is written as a single '0'. 1-3 digits are written inline; longer
# values are counted, then written right-to-left directly into `buf`
# (v1.2.0 — through v1.1.4 every value went through a 24-byte scratch
# array and a copy-back; 20M calls over 0-1023 went 380 -> 195 ms, -49%,
# emitted bytes identical).
#
# Renamed from `tty_itoa` in v0.7.0 with the return harmonized from
# digit-count to new-position: the old name was a generic misnomer and
# the digit-count return was the lone odd-one-out in the `_buf` family
# (every other `_buf` helper returns the new position) — a documented
#
# Byte budget: 1 byte when `val <= 0`; up to 19 bytes for a positive
# i64 (i64 max is 19 decimal digits). There is no capacity argument,
# so the caller must guarantee `pos + 19 <= sizeof(buf)` unless it
# bounds `val` itself — `tty_move` does, via its [1, 65535] guard,
# which caps each field at 5 digits.
#
# A negative incoming `pos` returns -1 (v0.9.3); before that a -1
# handed in from an earlier link was laundered into a write below the
# caller's buffer plus a bogus non-negative return.
fn tty_dec_buf(buf, pos, val) {
    if (pos < 0) { return 0 - 1; }
    var p = buf + pos;
    # 1-3 digits inline (v1.2.0) — every cursor coordinate a real
    # terminal produces lands here.
    if (val < 10) {
        if (val <= 0) { store8(p, 0x30); return pos + 1; }
        store8(p, 48 + val);
        return pos + 1;
    }
    if (val < 100) {
        store8(p, 48 + val / 10); store8(p + 1, 48 + val % 10);
        return pos + 2;
    }
    if (val < 1000) {
        store8(p, 48 + val / 100); store8(p + 1, 48 + (val / 10) % 10); store8(p + 2, 48 + val % 10);
        return pos + 3;
    }
    # 4+ digits: count them, then write right-to-left straight into `buf`.
    # The count stops at 19 (i64 max has 19 digits) BEFORE `lim` would
    # overflow — without that stop, `lim * 10` wraps at 10^19.
    var d = 4;
    var lim = 10000;
    while (val >= lim) {
        d = d + 1;
        if (d == 19) { break; }
        lim = lim * 10;
    }
    p = p + d;
    while (val > 0) {
        p = p - 1;
        var q = val / 10;
        store8(p, 48 + (val - q * 10));
        val = q;
    }
    return pos + d;
}

# Append `CSI row;col H` — move the cursor to (row, col), 1-indexed — to
# `buf` at `pos` (v1.3.0). Returns the new write position, or -1 if `pos`
# is negative or either coordinate is outside [1, 65535]; a rejection
# writes nothing. Byte budget: 14 (ESC [ + 5 digits + ';' + 5 digits + H).
# The `_buf` form of `tty_move`, which writes exactly these bytes.
fn tty_move_buf(buf, pos, row, col) {
    if (pos < 0) { return 0 - 1; }
    if (row < 1 || row > 65535) { return 0 - 1; }
    if (col < 1 || col > 65535) { return 0 - 1; }
    store16(buf + pos, 0x5B1B);          # ESC [
    var p = tty_dec_buf(buf, pos + 2, row);
    store8(buf + p, 0x3b);               # ';'
    p = tty_dec_buf(buf, p + 1, col);
    store8(buf + p, 0x48);               # 'H'
    return p + 1;
}

# Move cursor to (row, col), 1-indexed, via CSI row;colH. Returns 0
# on success, -1 if either coordinate is outside [1, 65535] — rejected
# *before* any byte reaches fd 1, matching the fail-before-emit
# discipline of tty_sgr ([0,999]) and tty_fg_rgb ([0,255]). The bound
# is the u16 winsize envelope every real caller draws from.
#
# Composes with `tty_move_buf` into a stack buffer sized to its 14-byte
# budget and writes it in one syscall.
fn tty_move(row, col) {
    var buf[14];
    var n = tty_move_buf(&buf, 0, row, col);
    if (n < 0) { return 0 - 1; }
    sys_write(1, &buf, n);
    return 0;
}

# Confine scrolling to rows `top` through `bot` (DECSTBM, `CSI top;bot r`),
# 1-indexed and inclusive — for a fixed header or status line above or below
# a scrolling area (v1.3.0). Text that reaches `bot` scrolls the region only.
# ⚠ The terminal also moves the cursor to row 1, column 1. Returns 0, or -1
# unless 1 <= top < bot <= 65535 — before anything is written. Undo it with
# `tty_scroll_region_reset()` before leaving the screen.
fn tty_scroll_region(top, bot) {
    if (top < 1 || bot > 65535 || top >= bot) { return 0 - 1; }
    var buf[14];
    store16(&buf, 0x5B1B);               # ESC [
    var p = tty_dec_buf(&buf, 2, top);
    store8(&buf + p, 0x3b);              # ';'
    p = tty_dec_buf(&buf, p + 1, bot);
    store8(&buf + p, 0x72);              # 'r'
    sys_write(1, &buf, p + 1);
    return 0;
}

# Scroll the whole screen again (`CSI r`, DECSTBM with no parameters),
# undoing `tty_scroll_region` (v1.3.0). Also moves the cursor to row 1,
# column 1. Returns 0.
fn tty_scroll_region_reset() {
    sys_write(1, "\x1b[r", 3);
    return 0;
}

# Shared body for the two relative-cursor moves. `final` is the CSI
# terminator byte that picks the direction: 0x41 ('A') = up,
# 0x42 ('B') = down. The two public fns differed by exactly that byte
# — parameterizing it (v0.9.3) means the `n <= 0` guard and the buffer
# arithmetic below are derived once instead of twice, and the copy can
# no longer drift from the original (it already had: the `down` twin
# had lost its `# ESC` / `# '['` comments).
#
# buf[24] clears the true worst case: ESC[ (2) + up to 19 digits for
# an i64 (19) + terminator (1) = 22, with 2 bytes spare. (Through
# v1.0.1 the middle term was written "(1)", so the line summed to 22
# by luck rather than by arithmetic.)
fn _cursor_rel(n, final) {
    if (n <= 0) { return 0; }
    var buf[24];
    store8(&buf, 0x1b);          # ESC
    store8(&buf + 1, 0x5b);      # '['
    var pos = 2;
    pos = tty_dec_buf(&buf, pos, n);
    if (pos < 0) { return 0; }
    store8(&buf + pos, final);
    pos = pos + 1;
    sys_write(1, &buf, pos);
    return 0;
}

# Move the cursor up `n` rows, staying in the current column, via
# `CSI <n>A`. The relative analogue of `tty_move`'s absolute
# positioning — wanted by in-scrollback repainters (anuenue's M4
# animation re-anchors at the top of the buffered block each frame).
#
# Always returns 0; there is no failure mode. `n <= 0` is a documented
# NO-OP, not a rejection: xterm treats `CSI 0A` as "move 1 row", so
# guarding here lets callers pass an unchecked row count straight
# through without special-casing zero.
#
# There is no upper bound: `n` up to i64 max is emitted as-is, a
# parameter of up to 19 digits (digits only, so nothing can be
# injected). Terminals clamp the move to the screen edge, but some cap
# the parameter itself; keep `n` within the window size. darshana does
# not clamp, because the emitted bytes are frozen (ADR 0003).
fn tty_cursor_up(n) {
    return _cursor_rel(n, 0x41);     # 'A'
}

# Move the cursor down `n` rows via `CSI <n>B`. Mirror of
# `tty_cursor_up` — same no-op-on-zero guard, same always-0 return.
fn tty_cursor_down(n) {
    return _cursor_rel(n, 0x42);     # 'B'
}

# --- sanitize.cyr ---

# sanitize.cyr — making untrusted bytes safe to put on the terminal (v1.2.0).
#
# A tool that prints text it did not write — a filename, a process's
# cmdline, a log line, a peer's chat message — hands the terminal whatever
# control sequences that text contains: a CSI that recolours or repaints
# the screen, an OSC that retitles the window or rewrites the clipboard, a
# DCS that some terminals act on. Neutralizing those bytes is the one
# output-safety primitive every screen-owning tool needs, and before v1.2.0
# seven darshana consumers and nine other AGNOS projects each wrote their
# own — four consumer rules read in full, all four different, two of them
# letting C1 controls through. It joined darshana's charter by owner ruling
# (2026-10-12); the design is recorded in docs/adr/0004.
#
# Pure: no syscall, no platform gate, no allocation.

# Sanitizing modes for `tty_sanitize_buf`. UTF8 keeps valid UTF-8 text
# byte-for-byte and neutralizes everything a terminal could read as a
# control, including C1 controls in their encoded form; LATIN1 treats the
# input as single-byte text and neutralizes every raw 0x80-0x9F byte, which
# a Latin-1 terminal reads as a C1 control — but which are also ordinary
# UTF-8 continuation bytes, so LATIN1 breaks UTF-8 text (`€` is E2 82 AC).
# Choose the mode for the terminal the output is going to, not the data.
var TTY_SANITIZE_UTF8   = 0;
var TTY_SANITIZE_LATIN1 = 1;

# `keep` bits for `tty_sanitize_buf`: C0 bytes the caller wants to pass
# through instead of neutralizing — TAB in a table cell, LF in multi-line
# text. Bit N keeps byte N, for N in 0..31; these two are the ones
# consumers keep. ESC (27) can never be kept, whatever `keep` says.
var TTY_KEEP_TAB = 0x200;               # 1 << 9
var TTY_KEEP_LF  = 0x400;               # 1 << 10

# The replacement for every neutralized byte or sequence: '?'.
const _SAN_REPL = 63;

# Append a sanitized copy of `len` bytes at `src` to `buf` at `pos`.
# Returns the new write position, or -1 if `pos` or `len` is negative or
# `mode` is neither TTY_SANITIZE_UTF8 nor TTY_SANITIZE_LATIN1; a rejection
# writes nothing. Byte budget: at most `len` — every neutralized input
# byte or sequence becomes ONE '?', so the output is never longer than the
# input, and `buf + pos == src` (sanitizing in place) is safe. Any other
# overlap of the two ranges is undefined.
#
# Neutralized, in both modes: every C0 control byte (0x00-0x1F) except the
# ones `keep` names — and never ESC (0x1B) — and DEL (0x7F).
#
# TTY_SANITIZE_UTF8 also neutralizes C1 controls written as UTF-8
# (U+0080-U+009F, C2 80-C2 9F) as one '?' each, and every byte that is not
# part of a well-formed UTF-8 sequence (RFC 3629: no overlong forms, no
# surrogates, nothing above U+10FFFF, no stray continuation byte, no
# sequence cut off by the end of the input). A malformed sequence is
# replaced one byte at a time: its first byte becomes '?' and decoding
# resumes at the next byte. Everything else — printable ASCII and every
# well-formed non-C1 code point — is copied unchanged, so text with
# nothing to neutralize comes out byte-for-byte identical.
#
# TTY_SANITIZE_LATIN1 also neutralizes every raw byte 0x80-0x9F, and
# copies 0xA0-0xFF unchanged; it is one byte in, one byte out.
#
# Output is idempotent: sanitizing it again with the same `mode` and
# `keep` changes nothing.
#
# Not neutralized: Unicode format characters such as bidirectional
# overrides (U+202A-U+202E, U+2066-U+2069). Terminals do not execute them
# as controls; reordering displayed text is a different threat.
fn tty_sanitize_buf(buf, pos, src, len, mode, keep) {
    if (pos < 0 || len < 0) { return 0 - 1; }
    if (mode != TTY_SANITIZE_UTF8 && mode != TTY_SANITIZE_LATIN1) { return 0 - 1; }
    var p = buf + pos;
    var i = 0;
    while (i < len) {
        var c = load8(src + i);
        if (c < 0x80) {
            if (c < 0x20) {
                if (c != 27 && ((keep >> c) & 1) == 1) { store8(p, c); }
                else { store8(p, _SAN_REPL); }
            } else {
                if (c == 0x7F) { store8(p, _SAN_REPL); } else { store8(p, c); }
            }
            p = p + 1;
            i = i + 1;
        } else {
            if (mode == TTY_SANITIZE_LATIN1) {
                if (c < 0xA0) { store8(p, _SAN_REPL); } else { store8(p, c); }
                p = p + 1;
                i = i + 1;
            } else {
                var n = _san_utf8_len(src + i, len - i);
                if (n == 0) {
                    store8(p, _SAN_REPL);          # malformed: neutralize one byte, resync
                    p = p + 1;
                    i = i + 1;
                } else {
                    if (n == 2 && c == 0xC2 && load8(src + i + 1) < 0xA0) {
                        store8(p, _SAN_REPL);      # encoded C1, U+0080-U+009F
                        p = p + 1;
                    } else {
                        var k = 0;
                        while (k < n) { store8(p + k, load8(src + i + k)); k = k + 1; }
                        p = p + n;
                    }
                    i = i + n;
                }
            }
        }
    }
    return p - buf;
}

# Returns 1 if the `len` bytes at `src` contain anything `tty_sanitize_buf`
# would neutralize with the same `mode` and `keep`, 0 if it would copy them
# unchanged, and -1 if `len` is negative or `mode` is neither
# TTY_SANITIZE_UTF8 nor TTY_SANITIZE_LATIN1 (v1.3.0).
#
# The reject-only form, for a caller that refuses a whole string rather
# than display a sanitized copy — a name, a key, a header value. Same rule
# as `tty_sanitize_buf`, byte for byte: it answers 1 exactly when
# sanitizing would change the input. Reads nothing past `src + len`, writes
# nothing, and stops at the first control it finds.
fn tty_has_ctl(src, len, mode, keep) {
    if (len < 0) { return 0 - 1; }
    if (mode != TTY_SANITIZE_UTF8 && mode != TTY_SANITIZE_LATIN1) { return 0 - 1; }
    var i = 0;
    while (i < len) {
        var c = load8(src + i);
        if (c < 0x80) {
            if (c < 0x20) {
                if (c == 27 || ((keep >> c) & 1) == 0) { return 1; }
            } else {
                if (c == 0x7F) { return 1; }
            }
            i = i + 1;
        } else {
            if (mode == TTY_SANITIZE_LATIN1) {
                if (c < 0xA0) { return 1; }
                i = i + 1;
            } else {
                var n = _san_utf8_len(src + i, len - i);
                if (n == 0) { return 1; }                   # malformed
                if (n == 2 && c == 0xC2 && load8(src + i + 1) < 0xA0) { return 1; }   # encoded C1
                i = i + n;
            }
        }
    }
    return 0;
}

# Length of the well-formed UTF-8 sequence starting at `s` (lead byte
# >= 0x80), with `avail` bytes available — 2, 3 or 4 — or 0 if the bytes
# there are not a well-formed sequence. The table is RFC 3629 §4: each
# lead byte fixes the sequence length AND the range of its second byte,
# which is what excludes overlong forms (E0 80-9F, F0 80-8F), surrogates
# (ED A0-BF) and code points above U+10FFFF (F4 90-BF, and F5-FF leads).
# C0 and C1 are never valid leads (they could only start overlong forms),
# and 80-BF are continuation bytes, never leads.
fn _san_utf8_len(s, avail) {
    var c = load8(s);
    var n = 0;
    var lo = 0x80;
    var hi = 0xBF;
    if (c >= 0xC2 && c <= 0xDF) { n = 2; }
    if (c == 0xE0) { n = 3; lo = 0xA0; }
    if (c >= 0xE1 && c <= 0xEC) { n = 3; }
    if (c == 0xED) { n = 3; hi = 0x9F; }
    if (c >= 0xEE && c <= 0xEF) { n = 3; }
    if (c == 0xF0) { n = 4; lo = 0x90; }
    if (c >= 0xF1 && c <= 0xF3) { n = 4; }
    if (c == 0xF4) { n = 4; hi = 0x8F; }
    if (n == 0 || n > avail) { return 0; }
    var c1 = load8(s + 1);
    if (c1 < lo || c1 > hi) { return 0; }
    var k = 2;
    while (k < n) {
        var ck = load8(s + k);
        if (ck < 0x80 || ck > 0xBF) { return 0; }
        k = k + 1;
    }
    return n;
}
