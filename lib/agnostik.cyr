# Write the ResourceLimits at `ptr` to str_builder `sb` as JSON, each field an i64 member:
#   {"max_memory":N,"max_cpu_time":N,"max_fds":N,"max_procs":N,"max_disk":N,"net_bw":N}
# The bytes the #derive(Serialize) code wrote through 1.12.2, one literal per member as it emitted
# them (ADR-008). Returns 0.
fn ResourceLimits_to_json(ptr, sb) {
    str_builder_add_cstr(sb, "{\"max_memory\":");
    str_builder_add_int(sb, load64(ptr));
    str_builder_add_cstr(sb, ",\"max_cpu_time\":");
    str_builder_add_int(sb, load64(ptr + 8));
    str_builder_add_cstr(sb, ",\"max_fds\":");
    str_builder_add_int(sb, load64(ptr + 16));
    str_builder_add_cstr(sb, ",\"max_procs\":");
    str_builder_add_int(sb, load64(ptr + 24));
    str_builder_add_cstr(sb, ",\"max_disk\":");
    str_builder_add_int(sb, load64(ptr + 32));
    str_builder_add_cstr(sb, ",\"net_bw\":");
    str_builder_add_int(sb, load64(ptr + 40));
    str_builder_add_cstr(sb, "}");
    return 0;
}
# A new ResourceLimits (48 bytes) from `pairs`, the vec bayan_json_parse returns; the first pair
# with a field's name gives its value. A missing member, or one that is not a number or is outside
# i64, reads 0 (since 1.12.3; the derived code wrapped out-of-range numbers and read "12abc" as 12).
fn ResourceLimits_from_json(pairs) {
    var p = _stik_alloc(48);
    store64(p, _stik_json_pair_int(pairs, "max_memory"));
    store64(p + 8, _stik_json_pair_int(pairs, "max_cpu_time"));
    store64(p + 16, _stik_json_pair_int(pairs, "max_fds"));
    store64(p + 24, _stik_json_pair_int(pairs, "max_procs"));
    store64(p + 32, _stik_json_pair_int(pairs, "max_disk"));
    store64(p + 40, _stik_json_pair_int(pairs, "net_bw"));
    return p;
}
