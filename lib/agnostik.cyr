# tag is a StopReason member and whose payload is a message Str, or 0 when
# there is none. Read it with stop_reason_kind / stop_reason_message.
fn stop_reason_new(kind, message: Str) {
    return tagged_new(kind, message);
}
# StopReason member, the box's tag.
fn stop_reason_kind(sr) { return boxed_tag(sr); }
# Message Str, the box's payload; 0 when stop_reason_new was given none.
fn stop_reason_message(sr) { return boxed_payload(sr); }
