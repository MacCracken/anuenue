# LabelOperator display name: "In", "NotIn", "Exists" or "DoesNotExist", and
# "Unknown" for a value outside the enum. label_operator_parse is the inverse.
# Spelling: the Kubernetes label-selector operator spelling.
fn label_operator_name(o) {
    if (o == LABEL_IN)               { return "In"; }
    elif (o == LABEL_NOT_IN)         { return "NotIn"; }
    elif (o == LABEL_EXISTS)         { return "Exists"; }
    elif (o == LABEL_DOES_NOT_EXIST) { return "DoesNotExist"; }
    return "Unknown";
}
# Parse a LabelOperator display name: exact, case-sensitive match. Returns
# Ok(member), or an invalid-argument Err for any other string.
fn label_operator_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "In") == 1) { return Ok(LABEL_IN); }
    elif (str_eq_cstr(s, "NotIn") == 1) { return Ok(LABEL_NOT_IN); }
    elif (str_eq_cstr(s, "Exists") == 1) { return Ok(LABEL_EXISTS); }
