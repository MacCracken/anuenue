# Serialize an AgentInfo as compact JSON: `{"id":"<uuid>","name":"<name>",
# "agent_type":"<AgentType name>","status":"<AgentStatus name>"}`. An id or
# name of 0 is written as null; the name is JSON-escaped (since 1.9.0), and
# since 2.0.0 invalid UTF-8 in it becomes U+FFFD, so the output is valid JSON.
# AgentInfo_from_json reads the output back.
fn AgentInfo_to_json(ptr, sb) {
    # ADR-002: compact byte format for library uniformity. Custom
    # field semantics (UUID stringification + enum-name lookup +
    # null-for-0 id and name) prevent derive adoption for this struct.
    #
    # F-024: an id of 0 is written as null. AgentInfo_from_json leaves 0
    # for a missing or unparseable id, and agent_id_to_str(0) used to
    # dereference it; a valid id serializes byte-for-byte as before.
    str_builder_add_cstr(sb, "{\"id\":");
    var id = load64(ptr);
    if (id != 0) {
        str_builder_putc(sb, '"');
        str_builder_add(sb, agent_id_to_str(id));
        str_builder_putc(sb, '"');
    } else {
        str_builder_add_cstr(sb, "null");
    }
    str_builder_add_cstr(sb, ",\"name\":");
    var name = load64(ptr + 8);
    if (name != 0) {
        # Escaped: a quote, backslash or control character in the name must
        # not end the string or inject keys; invalid UTF-8 becomes U+FFFD.
        _stik_json_text(sb, name);
    } else {
        str_builder_add_cstr(sb, "null");
    }
    str_builder_add_cstr(sb, ",\"agent_type\":\"");
    str_builder_add_cstr(sb, agent_type_name(load64(ptr + 16)));
    str_builder_add_cstr(sb, "\",\"status\":\"");
    str_builder_add_cstr(sb, agent_status_name(load64(ptr + 24)));
    str_builder_add_cstr(sb, "\"}");
    return 0;
}
# Parse an AgentInfo from JSON. Never fails. `agent_type` and `status` are read
# as the names AgentInfo_to_json writes, falling back to integer
# `agent_type_id` / `status_id` keys, the shape this fn read through 1.6.2. A
# missing or invalid id or name reads as 0; a missing or unrecognised type
# reads as AGENT_TYPE_USER, the default agent_config_new uses, and status as
# AGENT_PENDING. Through 1.12.2 a missing or bogus type read as 0, which is
# AGENT_TYPE_SYSTEM, the most privileged (F-039), and an out-of-range integer
# fallback was stored as given.
fn AgentInfo_from_json(src: Str) {
    var info = _stik_alloc(32);
    store64(info, 0);
    var id_str = _stik_json_str(src, str_from("id"));
    if (id_str != 0) {
        var parsed_t, parsed = agent_id_from_str(id_str);
        if (is_ok(parsed_t) == 1) { store64(info, parsed); }
    }
    store64(info + 8, _stik_json_str(src, str_from("name")));
    # AgentInfo_to_json writes agent_type / status as their *_name
    # strings, so read those. Through 1.6.2 this read integer
    # agent_type_id / status_id keys instead, and its own output parsed
    # back as type 0 / status 0. Those keys stay as the fallback when the
    # name is absent or unrecognised, so that shape still parses.
    var atype_t, atype = _stik_json_int(src, str_from("agent_type_id"));
    if (is_err_result(atype_t) == 1) { atype = AGENT_TYPE_USER; }
    if (atype < AGENT_TYPE_SYSTEM || atype > AGENT_TYPE_SERVICE) { atype = AGENT_TYPE_USER; }
    var tname = _stik_json_str(src, str_from("agent_type"));
    if (tname != 0) {
        var t_t, t = agent_type_parse(tname);
        if (is_ok(t_t) == 1) { atype = t; }
    }
    store64(info + 16, atype);
    var astatus_t, astatus = _stik_json_int(src, str_from("status_id"));
    if (is_err_result(astatus_t) == 1) { astatus = AGENT_PENDING; }
    if (astatus < AGENT_PENDING || astatus > AGENT_FAILED) { astatus = AGENT_PENDING; }
    var sname = _stik_json_str(src, str_from("status"));
    if (sname != 0) {
        var s_t, s = agent_status_parse(sname);
        if (is_ok(s_t) == 1) { astatus = s; }
    }
    store64(info + 24, astatus);
    return info;
}
# An AgentInfo: an agent's identity and state, the struct AgentInfo_to_json
# and AgentInfo_from_json read and write. 32 bytes, each stored as given:
#   +0 id (AgentId), +8 name (Str), +16 agent_type (AgentType),
#   +24 status (AgentStatus).
fn agent_info_new(id, name: Str, atype, status) {
    var info = _stik_alloc(32);
    store64(info, id);
    store64(info + 8, name);
    store64(info + 16, atype);
    store64(info + 24, status);
    return info;
}
# AgentStats's accessors AgentStats_<field>(p) and AgentStats_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   total_requests: Total request count, the total_requests field.
#   total_tokens: Total token count, the total_tokens field.
#   uptime_seconds: Uptime in seconds, the uptime_seconds field.
