# Inverse of log_severity_name. Exact match on what log_severity_name emits; an
# unrecognised string is an error rather than a silent default, so
# log_severity_parse(log_severity_name(v)) == v holds for every LogSeverity member.
fn log_severity_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "TRACE") == 1) { return Ok(LOG_TRACE); }
    elif (str_eq_cstr(s, "DEBUG") == 1) { return Ok(LOG_DEBUG); }
    elif (str_eq_cstr(s, "INFO") == 1) { return Ok(LOG_INFO); }
    elif (str_eq_cstr(s, "WARN") == 1) { return Ok(LOG_WARN); }
    elif (str_eq_cstr(s, "ERROR") == 1) { return Ok(LOG_ERROR); }
    elif (str_eq_cstr(s, "FATAL") == 1) { return Ok(LOG_FATAL); }
