# Cap on open file descriptors (default 256).
fn ResourceLimits_max_fds(r)              { return load64(r + 16); }
# Cap on processes (default 64).
fn ResourceLimits_max_procs(r)            { return load64(r + 24); }
# Disk-usage cap, the max_disk field (default 0).
fn ResourceLimits_max_disk(r)             { return load64(r + 32); }
# Network-bandwidth cap, the net_bw field (default 0).
fn ResourceLimits_net_bw(r)        { return load64(r + 40); }
