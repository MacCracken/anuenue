# unset (since 2.0.0).
fn CgroupLimits_cpuset_cpus(c) { return load64(c + 72); }
# Set cpuset_cpus (a Str); returns 0.
fn CgroupLimits_set_cpuset_cpus(c, v: Str) { store64(c + 72, v); return 0; }
# Memory nodes the cgroup may use (cpuset.mems, a Str), or 0 when unset (since
# 2.0.0).
fn CgroupLimits_cpuset_mems(c) { return load64(c + 80); }
# Set cpuset_mems (a Str); returns 0.
fn CgroupLimits_set_cpuset_mems(c, v: Str) { store64(c + 80, v); return 0; }
# A NamespaceConfig: one flag per Linux namespace type, nonzero to enable that
# namespace. 64 bytes, eight zeroed slots: +0 pid, +8 net, +16 mount, +24 user,
# +32 uts, +40 ipc, +48 cgroup, +56 time. Only pid, net, mount and user have
# setters.
fn namespace_config_new() {
    var n = _stik_alloc(64);
    var i = 0;
    while (i < 64) { store64(n + i, 0); i = i + 8; }
    return n;
}
# NamespaceConfig's accessors NamespaceConfig_<field>(p) and NamespaceConfig_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   pid: PID namespace flag; 0 in a fresh config.
#   net: Network namespace flag; 0 in a fresh config.
#   mount: Mount namespace flag; 0 in a fresh config.
#   user: User namespace flag; 0 in a fresh config.
#   uts: UTS namespace flag; 0 from namespace_config_new until NamespaceConfig_set_uts.
#   ipc: IPC namespace flag; 0 from namespace_config_new until NamespaceConfig_set_ipc.
#   cgroup: cgroup namespace flag; 0 from namespace_config_new until NamespaceConfig_set_cgroup.
#   time: Time namespace flag; 0 from namespace_config_new until NamespaceConfig_set_time.
#derive(accessors)
struct NamespaceConfig {
    pid;
    net;
    mount;
    user;
    uts;
    ipc;
    cgroup;
    time;
}
# A SandboxConfig: the isolation settings for a sandbox. 104 bytes, 13 8-byte
# slots: +0 fs_rules (vec, lazy), +8 net_access (NetworkAccess, default
# NET_LOCALHOST_ONLY), +16 seccomp (0 = none), +24 isolate_net (default 1),
# +32 network_policy (a NetworkPolicy, 0 = none), +40 AppArmor profile (Str),
# +48 SELinux label (Str), +56 encrypted_storage (an EncryptedStorage, 0 =
# none), +64 masked_paths (vec, lazy), +72 readonly_paths (vec, lazy),
# +80 sysctl (map, lazy), +88 rlimits (vec of Rlimit, lazy), +96 devices (vec
# of DeviceRule, lazy). The layout is the Rust original's: 2.0.0 gave
# network_policy and encrypted_storage accessors (the slots were reserved) and
# added rlimits and devices (88 -> 104 bytes).
fn sandbox_config_new() {
    # 104 bytes = 13 u64 slots. Unrolled: store the two live fields with
    # their values and zero the other eleven directly — no loop counter /
    # compare / branch per slot. The old `while (i<88) store64(0)` loop
    # zeroed all 11 then overwrote two; this is a hot constructor, so the
    # unroll gives the bench real headroom against runner noise (the
    # 6.3.x codegen shift left it hugging the regression floor).
    var s = _stik_alloc(104);
    store64(s + 0,  0);
    store64(s + 8,  NET_LOCALHOST_ONLY);
    store64(s + 16, 0);
    store64(s + 24, 1);
    store64(s + 32, 0);
    store64(s + 40, 0);
    store64(s + 48, 0);
    store64(s + 56, 0);
    store64(s + 64, 0);
    store64(s + 72, 0);
    store64(s + 80, 0);
    store64(s + 88, 0);
    store64(s + 96, 0);
    return s;
}
# Lazy-collection helper: return the vec held in the 8-byte slot at `ptr`,
# first creating an empty one with vec_new and storing it there if the slot is
# 0. Accessors in other modules use it too.
fn _stik_lazy_vec(ptr) {
    var v = load64(ptr);
    if (v == 0) { v = vec_new(); store64(ptr, v); }
    return v;
}
# Lazy-collection helper: return the map held in the 8-byte slot at `ptr`,
# first creating an empty one with map_new and storing it there if the slot is
# 0. Accessors in other modules use it too.
fn _stik_lazy_map(ptr) {
    var m = load64(ptr);
    if (m == 0) { m = map_new(); store64(ptr, m); }
    return m;
}
# vec of FilesystemRule (filesystem_rule_new); created empty on first access.
fn SandboxConfig_fs_rules(s)      { return _stik_lazy_vec(s); }
# Network access level, a NetworkAccess; NET_LOCALHOST_ONLY by default.
fn SandboxConfig_net_access(s)    { return load64(s + 8); }
# Seccomp slot: 0 (the default) means none. Meant to hold a SeccompProfile
# (seccomp_profile_new); nothing here checks what is stored.
fn SandboxConfig_seccomp(s)       { return load64(s + 16); }
# Network-isolation flag; 1 by default, set with SandboxConfig_set_isolate_net.
fn SandboxConfig_isolate_net(s)   { return load64(s + 24); }
# Set the value SandboxConfig_isolate_net reads, stored as given (not validated). Returns 0.
fn SandboxConfig_set_isolate_net(s, v) { store64(s + 24, v); return 0; }
# vec of paths to mask in the sandbox; created empty on first access.
fn SandboxConfig_masked_paths(s)  { return _stik_lazy_vec(s + 64); }
# vec of paths to make read-only in the sandbox; created empty on first access.
fn SandboxConfig_readonly_paths(s){ return _stik_lazy_vec(s + 72); }
# map of sysctl settings for the sandbox; created empty on first access.
fn SandboxConfig_sysctl(s)        { return _stik_lazy_map(s + 80); }
# Set the network access level (a NetworkAccess); returns 0.
fn SandboxConfig_set_net_access(s, v)   { store64(s + 8, v); return 0; }
# Set the seccomp slot (see SandboxConfig_seccomp); returns 0.
fn SandboxConfig_set_seccomp(s, v)      { store64(s + 16, v); return 0; }
# Set the AppArmor profile name (Str, slot +40); returns 0. SandboxConfig_apparmor reads it.
fn SandboxConfig_set_apparmor(s, v: Str) { store64(s + 40, v); return 0; }
# Set the SELinux label (Str, slot +48); returns 0. SandboxConfig_selinux reads it.
fn SandboxConfig_set_selinux(s, v: Str)  { store64(s + 48, v); return 0; }
# AppArmor profile name (Str) set with SandboxConfig_set_apparmor, or 0 when unset
# (added in v1.11.0; there was no getter).
fn SandboxConfig_apparmor(s) { return load64(s + 40); }
# SELinux label (Str) set with SandboxConfig_set_selinux, or 0 when unset (added in
# v1.11.0).
fn SandboxConfig_selinux(s) { return load64(s + 48); }
# The sandbox's NetworkPolicy (network_policy_new), or 0 for none (since 2.0.0).
fn SandboxConfig_network_policy(s) { return load64(s + 32); }
# Set the network policy (a NetworkPolicy, or 0 for none); returns 0.
fn SandboxConfig_set_network_policy(s, v) { store64(s + 32, v); return 0; }
# The sandbox's EncryptedStorage (encrypted_storage_new), or 0 for none (since
# 2.0.0).
fn SandboxConfig_encrypted_storage(s) { return load64(s + 56); }
# Set the encrypted storage (an EncryptedStorage, or 0 for none); returns 0.
fn SandboxConfig_set_encrypted_storage(s, v) { store64(s + 56, v); return 0; }
# vec of Rlimit (rlimit_new) applied in the sandbox; created empty on first
# access (since 2.0.0).
fn SandboxConfig_rlimits(s) { return _stik_lazy_vec(s + 88); }
# vec of DeviceRule (device_rule_new) for the sandbox; created empty on first
# access (since 2.0.0).
fn SandboxConfig_devices(s) { return _stik_lazy_vec(s + 96); }
# A SecurityContext: an agent's permissions, sandbox and process identity.
# 64 bytes: +0 agent_id (as given), +8 permissions (empty vec), +16 sandbox
# (a fresh sandbox_config_new), +24 run_as_user 0, +32 run_as_group 0,
# +40 readonly_root 0, +48 no_new_privs 1, +56 set flags 0 (bit 0 run_as_user,
# bit 1 run_as_group; since 2.0.0). The four scalars have SecurityContext_set_*
# setters since v1.11.0.
fn security_context_new(agent_id) {
    var ctx = _stik_alloc(64);
    store64(ctx, agent_id);
    store64(ctx + 8, vec_new());
    store64(ctx + 16, sandbox_config_new());
    store64(ctx + 24, 0);
    store64(ctx + 32, 0);
    store64(ctx + 40, 0);
    store64(ctx + 48, 1);
    store64(ctx + 56, 0);
    return ctx;
}
# The agent's AgentId, as passed to security_context_new.
fn SecurityContext_agent_id(c)        { return load64(c); }
# vec of the Permission values granted to the agent; starts empty.
fn SecurityContext_permissions(c)     { return load64(c + 8); }
# The agent's SandboxConfig; sandbox_config_new defaults until changed.
fn SecurityContext_sandbox(c)         { return load64(c + 16); }
# User ID to run the agent's process as; 0 until set. 0 is also root's uid, so
# read it only when SecurityContext_has_run_as_user is 1; otherwise the
# process inherits its launcher's uid.
fn SecurityContext_run_as_user(c)     { return load64(c + 24); }
# 1 once SecurityContext_set_run_as_user has stored a uid, else 0 (inherit;
# since 2.0.0). Through 1.12.x a stored 0 and "not set" were the same value.
fn SecurityContext_has_run_as_user(c) { return load64(c + 56) & 1; }
# Set the uid SecurityContext_run_as_user reads, stored as given (not
# validated), and mark it set. Returns 0.
fn SecurityContext_set_run_as_user(c, v) {
    store64(c + 24, v);
    store64(c + 56, load64(c + 56) | 1);
    return 0;
}
# Group ID to run the agent's process as; 0 until set. Read it only when
# SecurityContext_has_run_as_group is 1 (0 is also root's gid).
fn SecurityContext_run_as_group(c)    { return load64(c + 32); }
# 1 once SecurityContext_set_run_as_group has stored a gid, else 0 (inherit;
# since 2.0.0).
fn SecurityContext_has_run_as_group(c) { return (load64(c + 56) >> 1) & 1; }
# Set the gid SecurityContext_run_as_group reads, stored as given (not
# validated), and mark it set. Returns 0.
fn SecurityContext_set_run_as_group(c, v) {
    store64(c + 32, v);
    store64(c + 56, load64(c + 56) | 2);
    return 0;
}
# Read-only root filesystem flag; 0 in a fresh context.
fn SecurityContext_readonly_root(c)   { return load64(c + 40); }
# Set the value SecurityContext_readonly_root reads, stored as given (not validated). Returns 0.
fn SecurityContext_set_readonly_root(c, v) { store64(c + 40, v); return 0; }
# no_new_privs flag; 1 (on) in a fresh context.
fn SecurityContext_no_new_privs(c)    { return load64(c + 48); }
# Set the value SecurityContext_no_new_privs reads, stored as given (not validated). Returns 0.
fn SecurityContext_set_no_new_privs(c, v) { store64(c + 48, v); return 0; }
# A SecurityPolicy: a named rule applying `effect` to a set of permissions.
# 24 bytes: +0 name (Str), +8 effect (PolicyEffect), +16 permissions (empty vec).
fn security_policy_new(name: Str, effect) {
    var p = _stik_alloc(24);
    store64(p, name);
    store64(p + 8, effect);
    store64(p + 16, vec_new());
    return p;
}
# SecurityPolicy's accessors SecurityPolicy_<field>(p) and SecurityPolicy_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   name: Policy name (Str).
#   effect: What the policy does, a PolicyEffect: allow, deny or audit.
#   permissions: vec of the Permission values the policy covers; starts empty.
#derive(accessors)
struct SecurityPolicy {
    name;
    effect;
    permissions;
}
# A CapabilitySet: the five Linux capability sets of a process, each a vec of
# LinuxCapability values (kernel capability numbers). 40 bytes: +0 effective,
# +8 permitted, +16 inheritable, +24 bounding, +32 ambient; all start empty.
fn capability_set_new() {
    var c = _stik_alloc(40);
    store64(c, vec_new());
    store64(c + 8, vec_new());
    store64(c + 16, vec_new());
    store64(c + 24, vec_new());
    store64(c + 32, vec_new());
    return c;
}
# CapabilitySet's accessors CapabilitySet_<field>(p) and CapabilitySet_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   effective: vec of LinuxCapability values in the effective set.
#   permitted: vec of LinuxCapability values in the permitted set.
#   inheritable: vec of LinuxCapability values in the inheritable set.
#   bounding: vec of LinuxCapability values in the bounding set.
#   ambient: vec of LinuxCapability values in the ambient set.
#derive(accessors)
struct CapabilitySet {
    effective;
    permitted;
    inheritable;
    bounding;
    ambient;
}
# A SandboxCapabilities: which sandboxing features the host supports. 48 bytes,
# zeroed: +0 seccomp, +8 seccomp_mode (SeccompMode), +16 landlock, +24 Landlock
# ABI version, +32 cgroup v2, +40 namespaces, each set with its SandboxCapabilities_set_*
# setter (v1.11.0).
fn sandbox_capabilities_new() {
    var c = _stik_alloc(48);
    var i = 0;
    while (i < 48) { store64(c + i, 0); i = i + 8; }
    return c;
}
# SandboxCapabilities's accessors SandboxCapabilities_<field>(p) and SandboxCapabilities_set_<field>(p, v)
# are generated by #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   seccomp: Seccomp-available flag; 0 in a fresh struct.
#   seccomp_mode: Seccomp mode, a SeccompMode; 0 (SECCOMP_DISABLED) in a fresh struct.
#   landlock: Landlock-available flag; 0 in a fresh struct.
#   ll_abi: Landlock ABI version; 0 in a fresh struct.
#   cgroup_v2: cgroup v2 available flag; 0 in a fresh struct.
#   namespaces: Namespaces-available flag; 0 in a fresh struct.
#derive(accessors)
struct SandboxCapabilities {
    seccomp;
    seccomp_mode;
    landlock;
    ll_abi;
    cgroup_v2;
    namespaces;
}
# A SeccompArg: a condition on one syscall argument, used in a SeccompRule's
# args. 32 bytes: +0 index (which argument), +8 value, +16 value_two, +24 op
# (SeccompArgOp), all as given.
fn seccomp_arg_new(index, value, value_two, op) {
    var a = _stik_alloc(32);
    store64(a, index);
    store64(a + 8, value);
    store64(a + 16, value_two);
    store64(a + 24, op);
    return a;
}
# SeccompArg's accessors SeccompArg_<field>(p) and SeccompArg_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   index: Index of the syscall argument the condition tests.
#   value: Value the argument is compared against.
#   value_two: Second comparison value (value_two), as given to seccomp_arg_new.
#   op: Comparison operator, a SeccompArgOp.
#derive(accessors)
struct SeccompArg {
    index;
    value;
    value_two;
    op;
}
# A FilesystemRule: access and mount options for one path. 56 bytes: +0 path
# (Str), +8 access (FsAccess), +16 readonly 0, +24 noexec 0, +32 nosuid 0,
# +40 propagation (MountPropagation, MOUNT_PRIVATE), +48 nodev 0. nosuid and
# nodev are the Rust original's mount flags: 2.0.0 gave the reserved +32 slot
# its accessors and added nodev (48 -> 56 bytes).
fn filesystem_rule_new(path: Str, access) {
    var r = _stik_alloc(56);
    store64(r, path);
    store64(r + 8, access);
    store64(r + 16, 0);
    store64(r + 24, 0);
    store64(r + 32, 0);
    store64(r + 40, MOUNT_PRIVATE);
    store64(r + 48, 0);
    return r;
}
# Path the rule applies to (Str).
fn FilesystemRule_path(r)        { return load64(r); }
# Access level for the path, an FsAccess.
fn FilesystemRule_access(r)      { return load64(r + 8); }
# Read-only flag; 0 in a fresh rule.
fn FilesystemRule_readonly(r)    { return load64(r + 16); }
# noexec flag; 0 in a fresh rule.
fn FilesystemRule_noexec(r)      { return load64(r + 24); }
# Mount propagation, a MountPropagation; MOUNT_PRIVATE in a fresh rule.
fn FilesystemRule_propagation(r) { return load64(r + 40); }
# Set the value FilesystemRule_propagation reads, stored as given (not validated). Returns 0.
fn FilesystemRule_set_propagation(r, v) { store64(r + 40, v); return 0; }
# Set the read-only flag; returns 0.
fn FilesystemRule_set_readonly(r, v) { store64(r + 16, v); return 0; }
# Set the noexec flag; returns 0.
fn FilesystemRule_set_noexec(r, v)   { store64(r + 24, v); return 0; }
# nosuid mount flag (set-user-ID bits ignored); 0 in a fresh rule (since 2.0.0).
fn FilesystemRule_nosuid(r)          { return load64(r + 32); }
# Set the nosuid flag; returns 0.
fn FilesystemRule_set_nosuid(r, v)   { store64(r + 32, v); return 0; }
# nodev mount flag (device files not interpreted); 0 in a fresh rule (since
# 2.0.0).
fn FilesystemRule_nodev(r)           { return load64(r + 48); }
# Set the nodev flag; returns 0.
fn FilesystemRule_set_nodev(r, v)    { store64(r + 48, v); return 0; }
# A SeccompRule: an action applied to a set of syscalls, optionally gated on
# argument conditions. 24 bytes: +0 names (vec, lazy), +8 action (as given),
# +16 args (vec, lazy).
fn seccomp_rule_new(action) {
    var r = _stik_alloc(24);
    store64(r, 0);
    store64(r + 8, action);
    store64(r + 16, 0);
    return r;
