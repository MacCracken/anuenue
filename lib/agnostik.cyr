# A new ResourceLimits (48 bytes) from the JSON text at C string `json`, read in one pass up to its
# NUL terminator and never past it. 0 when `json` is 0 or the text is not a JSON object. A missing
# member, or one that is not a number or is outside i64, reads 0, and a repeated member gives its
# last value. Through 1.12.2 the derived scanner could read past the end of truncated text.
fn ResourceLimits_from_json_str(json) {
    if (_stik_json_is_obj_cstr(json) == 0) { return 0; }
    var p = _stik_alloc(48);
    store64(p, 0);
    store64(p + 8, 0);
    store64(p + 16, 0);
    store64(p + 24, 0);
    store64(p + 32, 0);
    store64(p + 40, 0);
