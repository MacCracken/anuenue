fn ResourceLimits_set_max_memory(r, v)    { store64(r, v); return 0; }
# Set the CPU-time cap (max_cpu_time), in seconds. Returns 0.
fn ResourceLimits_set_max_cpu_time(r, v)       { store64(r + 8, v); return 0; }
# Set the open-file-descriptor cap. Returns 0.
