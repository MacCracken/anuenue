    store64(m + 8, sender);
    store64(m + 16, receiver);
    store64(m + 24, 0);
    store64(m + 32, 0);
    store64(m + 40, payload_str);
    store64(m + 48, clock_epoch_ns());
    return m;
}
# AgentMessage's accessors AgentMessage_<field>(p) and AgentMessage_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   id: Message id: a fresh 16-byte UUID (agent_id_new) assigned at construction.
#   sender: Sending agent's id, as passed to agent_message_new.
#   receiver: Receiving agent's id, as passed to agent_message_new.
#   correlation_id: Correlation id Str pairing a request with its response, or 0 when unset.
#   reply_to: Reply-to Str, the id of the message this one answers, or 0 when unset.
#   payload: Payload Str, as passed to agent_message_new.
#   timestamp: Construction time from clock_epoch_ns(): Unix time in nanoseconds (wall clock; whole seconds on
#     agnos).
#derive(accessors)
struct AgentMessage {
    id;
    sender;
    receiver;
    correlation_id;
    reply_to;
    payload;
    timestamp;
}
# An AgentDependency: one agent's dependency on another. 24 bytes, each
# stored as given: +0 required_agent (Str, the agent's name),
# +8 min_version (Version), +16 required (1 = mandatory, 0 = optional).
fn agent_dependency_new(required_agent: Str, min_ver, required) {
    var d = _stik_alloc(24);
    store64(d, required_agent);
    store64(d + 8, min_ver);
    store64(d + 16, required);
    return d;
}
# AgentDependency's accessors AgentDependency_<field>(p) and AgentDependency_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   required_agent: Name Str of the agent depended on.
#   min_version: Minimum Version of the required agent, as passed; agnostik does not check it.
#   required: Required flag as passed: 1 when the dependency is mandatory, 0 when optional.
#derive(accessors)
struct AgentDependency {
    required_agent;
    min_version;
    required;
}
# A ResourceRequest: an agent asking the runtime for resources. 24 bytes:
#   +0 agent_id, +8 limits (the ResourceLimits requested), both as given,
#   +16 justification (Str, 0 until set).
fn resource_request_new(agent_id, limits) {
    var r = _stik_alloc(24);
    store64(r, agent_id);
    store64(r + 8, limits);
    store64(r + 16, 0);
    return r;
}
# ResourceRequest's accessors ResourceRequest_<field>(p) and ResourceRequest_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   agent_id: Id of the requesting agent.
#   limits: ResourceLimits pointer: the limits requested.
#   justification: Justification Str, or 0 until ResourceRequest_set_justification.
#derive(accessors)
struct ResourceRequest {
    agent_id;
    limits;
    justification;
}
# A ResourceGrant: the runtime's answer to a ResourceRequest. 32 bytes:
#   +0 agent_id, +8 limits (the ResourceLimits granted), +16 approved (flag),
#   all as given, +24 reason (Str, 0 until set).
fn resource_grant_new(agent_id, limits, approved) {
    var g = _stik_alloc(32);
    store64(g, agent_id);
    store64(g + 8, limits);
    store64(g + 16, approved);
    store64(g + 24, 0);
    return g;
}
# ResourceGrant's accessors ResourceGrant_<field>(p) and ResourceGrant_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   agent_id: Id of the agent the grant is for.
#   limits: ResourceLimits pointer: the limits granted.
#   approved: Approval flag, as passed to resource_grant_new: 1 approved, 0 denied.
#   reason: Reason Str, or 0 until ResourceGrant_set_reason.
#derive(accessors)
struct ResourceGrant {
    agent_id;
    limits;
    approved;
    reason;
}
# A RetryPolicy: exponential-backoff settings for retrying a failed operation.
# 40 bytes: +0 max_retries (3), +8 initial_delay (1000 ms), +16 backoff_mult
# (2000), +24 max_delay (30000 ms), +32 jitter (1). agnostik only stores the
# policy; the retrying code applies it. The RetryPolicy_set_* setters (v1.11.0)
# change the defaults.
fn retry_policy_new() {
    var p = _stik_alloc(40);
    store64(p, 3);
    store64(p + 8, 1000);
    store64(p + 16, 2000);
    store64(p + 24, 30000);
    store64(p + 32, 1);
    return p;
}
# RetryPolicy's accessors RetryPolicy_<field>(p) and RetryPolicy_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   max_retries: Maximum retry attempts (default 3).
#   initial_delay: Delay before the first retry, in ms (default 1000).
#   backoff_mult: Delay multiplier applied after each retry, in thousandths: the default 2000 is 2.0x, the fixed-
#     point form of the Rust original's float.
#   max_delay: Upper bound on the delay, in ms (default 30000).
#   jitter: Jitter flag: 1 to add random jitter to each delay (default 1).
#derive(accessors)
struct RetryPolicy {
    max_retries;
    initial_delay;
    backoff_mult;
    max_delay;
    jitter;
}
# A RestartBackoff: delay settings between restarts of an agent, the struct
# AgentConfig's restart_backoff slot points to. 32 bytes: +0 initial_delay
# (1000 ms), +8 multiplier (2000), +16 max_delay (60000 ms), +24 jitter (1).
fn restart_backoff_new() {
    var b = _stik_alloc(32);
    store64(b, 1000);
    store64(b + 8, 2000);
    store64(b + 16, 60000);
    store64(b + 24, 1);
    return b;
}
# RestartBackoff's accessors RestartBackoff_<field>(p) and RestartBackoff_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   initial_delay: Delay before the first restart, in ms (default 1000).
#   multiplier: Delay multiplier applied after each restart, in thousandths: the default 2000 is 2.0x, the fixed-
#     point form of the Rust original's float.
#   max_delay: Upper bound on the delay, in ms (default 60000).
#   jitter: Jitter flag: 1 to add random jitter to each delay (default 1).
#derive(accessors)
struct RestartBackoff {
    initial_delay;
    multiplier;
    max_delay;
    jitter;
}
# An AgentPool: a set of identical agents run from one AgentConfig template.
# 40 bytes: +0 name (Str), +8 config (AgentConfig), +16 replicas (1),
# +24 min_replicas (1), +32 max_replicas (10).
fn agent_pool_new(pool_name: Str, config) {
    var p = _stik_alloc(40);
    store64(p, pool_name);
    store64(p + 8, config);
    store64(p + 16, 1);
    store64(p + 24, 1);
    store64(p + 32, 10);
    return p;
}
# AgentPool's accessors AgentPool_<field>(p) and AgentPool_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   name: Pool name Str.
#   config: AgentConfig pointer: the template every member of the pool runs.
#   replicas: Desired replica count (default 1).
#   min_replicas: Minimum replica count (default 1).
#   max_replicas: Maximum replica count (default 10).
#derive(accessors)
struct AgentPool {
    name;
    config;
    replicas;
    min_replicas;
    max_replicas;
}
# An AgentCapabilities: what an agent advertises it can do. 32 bytes, all 0:
#   +0 skills, +8 input_types, +16 output_types (vecs, each created empty on
#   first access), +24 max_tasks (0).
fn agent_capabilities_new() {
    var c = _stik_alloc(32);
    store64(c, 0);
    store64(c + 8, 0);
    store64(c + 16, 0);
    store64(c + 24, 0);
    return c;
}
# vec of skill-name Strs the agent provides; created empty on first access.
fn AgentCapabilities_skills(c)      { return _stik_lazy_vec(c); }
# vec of input-type Strs the agent accepts; created empty on first access.
fn AgentCapabilities_input_types(c) { return _stik_lazy_vec(c + 8); }
# vec of output-type Strs the agent produces; created empty on first access.
fn AgentCapabilities_output_types(c){ return _stik_lazy_vec(c + 16); }
# Maximum concurrent tasks (default 0).
fn AgentCapabilities_max_tasks(c)   { return load64(c + 24); }
# Set the maximum concurrent tasks. Returns 0.
fn AgentCapabilities_set_max_tasks(c, v) { store64(c + 24, v); return 0; }
# A SchedulingConstraints: placement rules for an agent. 48 bytes, zeroed:
#   +0 node_affinity, +8 node_anti_affinity, +16 pod_affinity,
#   +24 pod_anti_affinity (vecs, each created empty on first access),
#   +32 priority (0), +40 preemptible (0).
fn scheduling_constraints_new() {
    var s = _stik_alloc(48);
    var i = 0;
    while (i < 48) { store64(s + i, 0); i = i + 8; }
    return s;
}
# vec of node-affinity LabelSelectors; created empty on first access.
fn SchedulingConstraints_node_affinity(s)      { return _stik_lazy_vec(s); }
# vec of node-anti-affinity LabelSelectors; created empty on first access.
fn SchedulingConstraints_node_anti_affinity(s) { return _stik_lazy_vec(s + 8); }
# vec of agents to co-locate with (pod affinity); created empty on first access.
fn SchedulingConstraints_pod_affinity(s)       { return _stik_lazy_vec(s + 16); }
# vec of agents not to co-locate with (pod anti-affinity); created empty on
# first access.
fn SchedulingConstraints_pod_anti_affinity(s)  { return _stik_lazy_vec(s + 24); }
# Scheduling priority (default 0).
fn SchedulingConstraints_priority(s)           { return load64(s + 32); }
# Preemptible flag at +40 (default 0), set with SchedulingConstraints_set_preemptible.
fn SchedulingConstraints_preemptible(s)        { return load64(s + 40); }
# Set the value SchedulingConstraints_preemptible reads, stored as given (not validated). Returns 0.
fn SchedulingConstraints_set_preemptible(s, v) { store64(s + 40, v); return 0; }
# Set the scheduling priority. Returns 0.
fn SchedulingConstraints_set_priority(s, v)    { store64(s + 32, v); return 0; }
# A LabelSelector: matches node labels by key. 24 bytes: +0 key (Str),
# +8 operator (LabelOperator), both as given, +16 values (vec, created empty
# on first access).
fn label_selector_new(key: Str, operator) {
    var l = _stik_alloc(24);
    store64(l, key);
    store64(l + 8, operator);
    store64(l + 16, 0);
    return l;
}
# Label key Str.
fn LabelSelector_key(l)      { return load64(l); }
# LabelOperator member.
fn LabelSelector_operator(l) { return load64(l + 8); }
# vec of the values the operator matches against; created empty on first access.
fn LabelSelector_values(l)   { return _stik_lazy_vec(l + 16); }
# A Topic: a named pub/sub channel. 24 bytes: +0 name (Str), +8 description
# (Str, default ""), +16 ttl (0).
fn topic_new(tname: Str) {
    var t = _stik_alloc(24);
    store64(t, tname);
    store64(t + 8, str_from(""));
    store64(t + 16, 0);
    return t;
}
# Topic's accessors Topic_<field>(p) and Topic_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   name: Topic name Str.
#   description: Description Str (default "").
#   ttl: Message TTL for the topic (default 0).
#derive(accessors)
struct Topic {
    name;
    description;
    ttl;
}
# A Subscription: one agent's subscription to a topic. 24 bytes:
#   +0 agent_id (the subscriber), +8 topic (Str, the topic's name),
#   +16 filter (Str, 0 for none).
fn subscription_new(agent_id, Topic_name: Str) {
    var s = _stik_alloc(24);
    store64(s, agent_id);
    store64(s + 8, Topic_name);
    store64(s + 16, 0);
    return s;
}
# Subscription's accessors Subscription_<field>(p) and Subscription_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   agent_id: Subscribing agent's id.
#   topic: Name Str of the subscribed topic.
#   filter: Filter expression Str, or 0 for none; agnostik does not parse it.
#derive(accessors)
struct Subscription {
    agent_id;
    topic;
    filter;
}
# A TopicMessage: one message published to a topic. 56 bytes:
#   +0 id (a fresh UUID from agent_id_new), +8 topic (Str), +16 publisher
#   (agent id), +24 payload (Str, default "{}"), +32 timestamp
#   (clock_epoch_ns at construction), +40 priority (0), +48 ttl (0).
fn topic_message_new(Topic_name: Str, publisher) {
    var m = _stik_alloc(56);
    store64(m, agent_id_new());
    store64(m + 8, Topic_name);
    store64(m + 16, publisher);
    store64(m + 24, str_from("{}"));
    store64(m + 32, clock_epoch_ns());
    store64(m + 40, 0);
    store64(m + 48, 0);
    return m;
}
# TopicMessage's accessors TopicMessage_<field>(p) and TopicMessage_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   id: Message id: a fresh 16-byte UUID (agent_id_new) assigned at construction.
#   topic: Name Str of the topic the message was published to.
#   publisher: Publishing agent's id.
#   payload: Payload Str; "{}" (an empty JSON object) until TopicMessage_set_payload.
#   timestamp: Construction time from clock_epoch_ns(): Unix time in nanoseconds (wall clock; whole seconds on
#     agnos).
#   priority: Message priority (default 0).
#   ttl: Message TTL (default 0).
#derive(accessors)
struct TopicMessage {
    id;
    topic;
    publisher;
    payload;
    timestamp;
    priority;
    ttl;
}

# --- security.cyr ---

enum Permission {
    PERM_FILE_READ;
    PERM_FILE_WRITE;
    PERM_NETWORK_ACCESS;
    PERM_PROCESS_SPAWN;
    PERM_LLM_INFERENCE;
    PERM_AUDIT_READ;
}
enum FsAccess { FS_NO_ACCESS; FS_READ_ONLY; FS_READ_WRITE; }
enum NetworkAccess { NET_NONE; NET_LOCALHOST_ONLY; NET_RESTRICTED; NET_FULL; }
enum SeccompAction { SECCOMP_ALLOW; SECCOMP_KILL; SECCOMP_KILL_PROCESS; SECCOMP_TRAP; SECCOMP_LOG; SECCOMP_NOTIFY; }
# SeccompAction Errno variant: a 16-byte tagged box (tag 100, payload
# errno_val) for an action that fails the syscall with that errno. The plain
# SeccompAction members are bare integers, so an action slot (SeccompRule_action,
# SeccompProfile_default_action) holds either form. Read a box only with boxed_tag /
# boxed_payload; seccomp_action_name does not recognise one ("Unknown").
fn seccomp_errno(errno_val) { return tagged_new(100, errno_val); }
# SeccompAction Trace variant: a 16-byte tagged box (tag 101, payload
# trace_val). Same representation and caveats as seccomp_errno.
fn seccomp_trace(trace_val) { return tagged_new(101, trace_val); }
enum SeccompArgOp {
    ARG_NOT_EQUAL;
    ARG_LESS_THAN;
    ARG_LESS_EQUAL;
    ARG_EQUAL;
    ARG_GREATER_EQUAL;
    ARG_GREATER_THAN;
    ARG_MASKED_EQUAL;
}
enum SeccompArch {
    ARCH_X86;
    ARCH_X86_64;
    ARCH_X32;
    ARCH_ARM;
    ARCH_AARCH64;
    ARCH_MIPS;
    ARCH_MIPS64;
    ARCH_MIPS64N32;
    ARCH_MIPSEL;
    ARCH_MIPSEL64;
    ARCH_MIPSEL64N32;
    ARCH_PPC;
    ARCH_PPC64;
    ARCH_PPC64LE;
    ARCH_S390;
    ARCH_S390X;
    ARCH_RISCV64;
}
enum MountPropagation { MOUNT_PRIVATE; MOUNT_SHARED; MOUNT_SLAVE; MOUNT_UNBINDABLE; }
enum PolicyEffect { POLICY_ALLOW; POLICY_DENY; POLICY_AUDIT; }
enum Role { ROLE_ADMIN; ROLE_OPERATOR; ROLE_AUDITOR; ROLE_VIEWER; ROLE_SERVICE; }
enum ConditionOperator { COND_EQ; COND_NEQ; COND_IN; COND_NIN; COND_GT; COND_GTE; COND_LT; COND_LTE; }
enum SeccompMode { SECCOMP_DISABLED; SECCOMP_STRICT; SECCOMP_FILTER; SECCOMP_UNSUPPORTED; }
enum SystemFeature { FEAT_LANDLOCK; FEAT_SECCOMP; FEAT_NAMESPACES; FEAT_CGROUPS; FEAT_TPM; FEAT_SECURE_BOOT; }
# Linux capability numbers, as the KERNEL defines them
# (include/uapi/linux/capability.h). The value IS the capability number, so
# an ordinal that does not match the kernel silently operates on a DIFFERENT
# capability. prctl(PR_CAPBSET_DROP) and similar take the number itself. A
# capset(2) mask (_LINUX_CAPABILITY_VERSION_3) is two 32-bit words: bit
# (cap % 32) of word (cap / 32). `1 << cap` is a 64-bit mask, so caps 32..40
# land in its high half, which capset reads as the second word only when the
# caller splits it.
#
# ⚠ Fixed at 1.4.1, and it was wrong in two ways. The list omitted
# CAP_MAC_OVERRIDE (32) and CAP_MAC_ADMIN (33) entirely, which shifted
# every capability above 31 down by two — CAP_SYSLOG resolved to 33
# (kernel: CAP_MAC_ADMIN), CAP_BPF to 36 (kernel: CAP_BLOCK_SUSPEND),
# CAP_CHECKPOINT_RESTORE to 37 (kernel: CAP_AUDIT_READ). And
# CAP_AUDIT_READ / CAP_AUDIT_CONTROL were transposed, so both were wrong
# even below the shift. Anything that dropped "all but CAP_SYSLOG" was
# really keeping CAP_MAC_ADMIN.
#
# Values are explicit rather than implicit ordinals precisely so a future
# insertion cannot silently renumber the tail again.
enum LinuxCapability {
    CAP_CHOWN = 0;
    CAP_DAC_OVERRIDE = 1;
    CAP_DAC_READ_SEARCH = 2;
    CAP_FOWNER = 3;
    CAP_FSETID = 4;
    CAP_KILL = 5;
    CAP_SETGID = 6;
    CAP_SETUID = 7;
    CAP_SETPCAP = 8;
    CAP_LINUX_IMMUTABLE = 9;
    CAP_NET_BIND_SERVICE = 10;
    CAP_NET_BROADCAST = 11;
    CAP_NET_ADMIN = 12;
    CAP_NET_RAW = 13;
    CAP_IPC_LOCK = 14;
    CAP_IPC_OWNER = 15;
    CAP_SYS_MODULE = 16;
    CAP_SYS_RAWIO = 17;
    CAP_SYS_CHROOT = 18;
    CAP_SYS_PTRACE = 19;
    CAP_SYS_PACCT = 20;
    CAP_SYS_ADMIN = 21;
    CAP_SYS_BOOT = 22;
    CAP_SYS_NICE = 23;
    CAP_SYS_RESOURCE = 24;
    CAP_SYS_TIME = 25;
    CAP_SYS_TTY_CONFIG = 26;
    CAP_MKNOD = 27;
    CAP_LEASE = 28;
    CAP_AUDIT_WRITE = 29;
    CAP_AUDIT_CONTROL = 30;
    CAP_SETFCAP = 31;
    CAP_MAC_OVERRIDE = 32;
    CAP_MAC_ADMIN = 33;
    CAP_SYSLOG = 34;
    CAP_WAKE_ALARM = 35;
    CAP_BLOCK_SUSPEND = 36;
    CAP_AUDIT_READ = 37;
    CAP_PERFMON = 38;
    CAP_BPF = 39;
    CAP_CHECKPOINT_RESTORE = 40;
    CAP_LAST_CAP = 40;
}
enum LandlockFsAccess {
    LL_EXECUTE;
    LL_WRITE_FILE;
    LL_READ_FILE;
    LL_READ_DIR;
    LL_REMOVE_DIR;
    LL_REMOVE_FILE;
    LL_MAKE_CHAR;
    LL_MAKE_DIR;
    LL_MAKE_REG;
    LL_MAKE_SOCK;
    LL_MAKE_FIFO;
    LL_MAKE_BLOCK;
    LL_MAKE_SYM;
    LL_REFER;
    LL_TRUNCATE;
    LL_IOCTL_DEV;
    LL_RESOLVE_UNIX;
}
enum LandlockNetAccess { LL_BIND_TCP; LL_CONNECT_TCP; LL_BIND_UDP; LL_CONNECT_SEND_UDP; }
enum LandlockScope { LL_SCOPE_ABSTRACT_UNIX; LL_SCOPE_SIGNAL; }
enum DeviceType { DEV_CHAR; DEV_BLOCK; DEV_ALL; }
enum RlimitType {
    RLIM_NOFILE;
    RLIM_NPROC;
    RLIM_ADDRESS_SPACE;
    RLIM_FILE_SIZE;
    RLIM_CORE;
    RLIM_DATA;
    RLIM_STACK;
    RLIM_MEMLOCK;
    RLIM_SIGPENDING;
    RLIM_MSGQUEUE;
}
# A NetworkPolicy: outbound port and host lists, an inbound port list and a NAT
# flag. 32 bytes, all 8-byte slots: +0 outbound ports, +8 outbound hosts,
# +16 inbound ports (three empty vecs), +24 enable_nat (0). The NAT flag is the
# Rust original's `enable_nat`; it had no accessor before 2.0.0.
fn network_policy_new() {
    var p = _stik_alloc(32);
    store64(p, vec_new());
    store64(p + 8, vec_new());
    store64(p + 16, vec_new());
    store64(p + 24, 0);
    return p;
}
# vec of outbound ports.
fn NetworkPolicy_outbound_ports(p) { return load64(p); }
# vec of outbound hosts.
fn NetworkPolicy_outbound_hosts(p) { return load64(p + 8); }
# vec of inbound ports.
fn NetworkPolicy_inbound_ports(p)  { return load64(p + 16); }
# 1 to masquerade the sandbox's outbound traffic (NAT), else 0; 0 in a fresh
# policy (since 2.0.0).
fn NetworkPolicy_enable_nat(p)     { return load64(p + 24); }
# Set the value NetworkPolicy_enable_nat reads. Returns 0.
fn NetworkPolicy_set_enable_nat(p, v) { store64(p + 24, v); return 0; }
# A CgroupLimits: resource limits for a cgroup v2. 104 bytes, zero-filled:
# +0 memory_max, +8 memory_high, +16 cpu_max, +24 cpu_period, +32 cpu_weight,
# +40 pids_max, +48 io_weight, +56 io_max_read_bps, +64 io_max_write_bps,
# +72 cpuset_cpus (Str), +80 cpuset_mems (Str), +88 memory_swap_max, and +96
# a set-flag word: bit off/8 is 1 once the numeric field at `off` was set. A
# limit reads 0 until set, and 0 is also a real limit (memory.max=0), so
# CgroupLimits_has_<field> tells "inherit" (never set) from a set 0. The Str
# fields need no flag: 0 is unset, an empty Str is a value. The field layout is
# the Rust original's, whose limits were Option<>; 2.0.0 added the flag word
# and the accessors for the last seven fields.
fn cgroup_limits_new() {
    var c = _stik_alloc(104);
    var i = 0;
    while (i < 104) { store64(c + i, 0); i = i + 8; }
    return c;
}
# Store `v` in the CgroupLimits slot at `off` and mark that field set (bit
# off/8 of the +96 flag word). Returns 0.
fn _stik_cglim_put(c, off, v) {
    store64(c + off, v);
    store64(c + 96, load64(c + 96) | (1 << (off / 8)));
    return 0;
}
# Maximum memory (memory.max), in bytes; 0 until set. Meaningful when
# CgroupLimits_has_memory_max is 1.
fn CgroupLimits_memory_max(c) { return load64(c); }
# 1 once CgroupLimits_set_memory_max has stored a value, else 0 (inherit).
fn CgroupLimits_has_memory_max(c) { return load64(c + 96) & 1; }
# Set memory_max and mark it set; returns 0.
fn CgroupLimits_set_memory_max(c, v) { return _stik_cglim_put(c, 0, v); }
# Memory throttling threshold (memory.high), in bytes; 0 until set. Meaningful
# when CgroupLimits_has_memory_high is 1.
fn CgroupLimits_memory_high(c) { return load64(c + 8); }
# 1 once CgroupLimits_set_memory_high has stored a value, else 0 (inherit).
fn CgroupLimits_has_memory_high(c) { return (load64(c + 96) >> 1) & 1; }
# Set memory_high and mark it set; returns 0.
fn CgroupLimits_set_memory_high(c, v) { return _stik_cglim_put(c, 8, v); }
# CPU quota for cpu.max's first field, stored as given (this module fixes no
# unit); 0 until set. Meaningful when CgroupLimits_has_cpu_max is 1.
fn CgroupLimits_cpu_max(c) { return load64(c + 16); }
# 1 once CgroupLimits_set_cpu_max has stored a value, else 0 (inherit).
fn CgroupLimits_has_cpu_max(c) { return (load64(c + 96) >> 2) & 1; }
# Set cpu_max and mark it set; returns 0.
fn CgroupLimits_set_cpu_max(c, v) { return _stik_cglim_put(c, 16, v); }
# CPU period for cpu.max's second field, in microseconds; 0 until set.
# Meaningful when CgroupLimits_has_cpu_period is 1.
fn CgroupLimits_cpu_period(c) { return load64(c + 24); }
# 1 once CgroupLimits_set_cpu_period has stored a value, else 0 (inherit) (since 2.0.0).
fn CgroupLimits_has_cpu_period(c) { return (load64(c + 96) >> 3) & 1; }
# Set cpu_period and mark it set; returns 0.
fn CgroupLimits_set_cpu_period(c, v) { return _stik_cglim_put(c, 24, v); }
# CPU weight (cpu.weight), stored as given; 0 until set. Meaningful when
# CgroupLimits_has_cpu_weight is 1.
fn CgroupLimits_cpu_weight(c) { return load64(c + 32); }
# 1 once CgroupLimits_set_cpu_weight has stored a value, else 0 (inherit).
fn CgroupLimits_has_cpu_weight(c) { return (load64(c + 96) >> 4) & 1; }
# Set cpu_weight and mark it set; returns 0.
fn CgroupLimits_set_cpu_weight(c, v) { return _stik_cglim_put(c, 32, v); }
# Maximum number of processes (pids.max); 0 until set. Meaningful when
# CgroupLimits_has_pids_max is 1.
fn CgroupLimits_pids_max(c) { return load64(c + 40); }
# 1 once CgroupLimits_set_pids_max has stored a value, else 0 (inherit).
fn CgroupLimits_has_pids_max(c) { return (load64(c + 96) >> 5) & 1; }
# Set pids_max and mark it set; returns 0.
fn CgroupLimits_set_pids_max(c, v) { return _stik_cglim_put(c, 40, v); }
# I/O weight (io.weight, 1..10000 in cgroup v2), stored as given; 0 until set.
# Meaningful when CgroupLimits_has_io_weight is 1.
fn CgroupLimits_io_weight(c) { return load64(c + 48); }
# 1 once CgroupLimits_set_io_weight has stored a value, else 0 (inherit) (since 2.0.0).
fn CgroupLimits_has_io_weight(c) { return (load64(c + 96) >> 6) & 1; }
# Set io_weight and mark it set; returns 0.
fn CgroupLimits_set_io_weight(c, v) { return _stik_cglim_put(c, 48, v); }
# Read bandwidth limit for io.max, in bytes per second; 0 until set. Meaningful
# when CgroupLimits_has_io_max_read_bps is 1.
fn CgroupLimits_io_max_read_bps(c) { return load64(c + 56); }
# 1 once CgroupLimits_set_io_max_read_bps has stored a value, else 0 (inherit) (since 2.0.0).
fn CgroupLimits_has_io_max_read_bps(c) { return (load64(c + 96) >> 7) & 1; }
# Set io_max_read_bps and mark it set; returns 0.
fn CgroupLimits_set_io_max_read_bps(c, v) { return _stik_cglim_put(c, 56, v); }
# Write bandwidth limit for io.max, in bytes per second; 0 until set. Meaningful
# when CgroupLimits_has_io_max_write_bps is 1.
fn CgroupLimits_io_max_write_bps(c) { return load64(c + 64); }
# 1 once CgroupLimits_set_io_max_write_bps has stored a value, else 0 (inherit) (since 2.0.0).
fn CgroupLimits_has_io_max_write_bps(c) { return (load64(c + 96) >> 8) & 1; }
# Set io_max_write_bps and mark it set; returns 0.
fn CgroupLimits_set_io_max_write_bps(c, v) { return _stik_cglim_put(c, 64, v); }
# Swap limit (memory.swap.max), in bytes; 0 until set. Meaningful when
# CgroupLimits_has_memory_swap_max is 1.
fn CgroupLimits_memory_swap_max(c) { return load64(c + 88); }
# 1 once CgroupLimits_set_memory_swap_max has stored a value, else 0 (inherit) (since 2.0.0).
fn CgroupLimits_has_memory_swap_max(c) { return (load64(c + 96) >> 11) & 1; }
# Set memory_swap_max and mark it set; returns 0.
fn CgroupLimits_set_memory_swap_max(c, v) { return _stik_cglim_put(c, 88, v); }
