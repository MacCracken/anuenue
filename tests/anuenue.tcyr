# anuenue test suite. M1 coverage: hsv_rainbow geometry (canonical
# hues + sector ramps + phase normalization), the buf-targeting
# escape-emission primitive borrowed from darshana 0.5.1, and the
# byte-cost arithmetic the filter loop's force-flush threshold
# (ANUENUE_FLUSH_RESERVE) is sized against. The stdin→stdout filter
# loop itself is exercised end-to-end via `scripts/smoke.sh` (added
# alongside M1) — Cyrius can't trivially redirect fd 0/1 inside a
# unit test, so the integration smoke owns the I/O surface.
#
# Stdlib + darshana auto-included via cyrius.cyml.

include "src/observe.cyr"
include "src/hsv.cyr"
include "src/color.cyr"
include "src/filter.cyr"
include "src/animate.cyr"
include "src/version_str.cyr"

# v1.4.3 — the escape word copy. Its own function rather than more of
# main(): appended to main(), these exact lines made the suite die with
# SIGSEGV in its third group, long before they run — on cyrius 6.7.9,
# 6.7.10 and 6.7.11 alike, while the same lines pass here. Not the local
# count, an array local or code size (each probed). Filed as cyrius
# issue 2026-10-14-anuenue-growing-a-large-fn-segfaults-an-earlier-call;
# v1.4.4 split the rest of main() the same way. Returns 0.
fn test_word_copy(): i64 {
    test_group("v1.4.3 — the escape word copy: footprint, scratch, geometry");
    # _emit_phase_esc writes [pos, pos + 24) whatever elen is, so every
    # caller needs 24 bytes of room — the reserve they already keep.
    assert_eq(ANUENUE_ESC_TABLE_ENTRY_SIZE - 8 <= ANUENUE_FLUSH_RESERVE, 1,
      "the 24-byte write footprint fits FLUSH_RESERVE");
    # The scratch past elen must be zero even after a rebuild IN PLACE from
    # a longer mode: truecolor (up to 17 bytes) then 16-colour (5). Without
    # init's zero-fill, bytes 5..16 of each entry would still hold the
    # truecolor escape.
    ANUENUE_COLOR_MODE = ANUENUE_COLOR_TRUE;
    _phase_esc_init();
    ANUENUE_COLOR_MODE = ANUENUE_COLOR_16;
    assert_eq(_phase_esc_init(), 0, "rebuild in place for 16-colour");
    var wc_dirty = 0;
    var wc_i = 0;
    while (wc_i < ANUENUE_PHASE_MOD) {
        var wc_entry = _PHASE_ESC_TABLE + wc_i * ANUENUE_ESC_TABLE_ENTRY_SIZE;
        var wc_k = load64(wc_entry);
        while (wc_k < 24) {
            if (load8(wc_entry + 8 + wc_k) != 0) { wc_dirty = wc_dirty + 1; }
            wc_k = wc_k + 1;
        }
        wc_i = wc_i + 1;
    }
    assert_eq(wc_dirty, 0, "every entry's payload past elen is zero after the rebuild");
    # The footprint at an unaligned pos: escape, zero scratch to pos + 24,
    # untouched after.
    var wc_buf[40];
    var wc_j = 0;
    while (wc_j < 40) { store8(&wc_buf + wc_j, 0xAA); wc_j = wc_j + 1; }
    var wc_end = _emit_phase_esc(&wc_buf, 3, 100);
    assert_eq(wc_end, 3 + 5, "16-colour: pos advances by elen (5), not 24");
    assert_eq(load8(&wc_buf + 3), 27, "the escape starts with ESC at pos");
    assert_eq(load8(&wc_buf + 2), 0xAA, "the byte before pos is untouched");
    var wc_zero = 1;
    wc_j = wc_end;
    while (wc_j < 3 + 24) {
        if (load8(&wc_buf + wc_j) != 0) { wc_zero = 0; }
        wc_j = wc_j + 1;
    }
    assert_eq(wc_zero, 1, "pos + elen .. pos + 24 is zero scratch");
    var wc_after = 1;
    wc_j = 3 + 24;
    while (wc_j < 40) {
        if (load8(&wc_buf + wc_j) != 0xAA) { wc_after = 0; }
        wc_j = wc_j + 1;
    }
    assert_eq(wc_after, 1, "nothing from pos + 24 on is touched");
    ANUENUE_COLOR_MODE = ANUENUE_COLOR_TRUE;
    _phase_esc_init();
    return 0;
}

# M1 (v0.2.0): smoke, hsv_rainbow geometry, filter line-buffer constants. Returns 0.
fn test_m1_hsv_geometry(): i64 {
    # ---- smoke ------------------------------------------------------
    test_group("smoke");
    assert(1, "true is true");
    assert_eq(1 + 1, 2, "math works");

    # ---- hsv_rainbow: canonical pure-hue sector boundaries ----------
    # Six exact integer points the rainbow geometry MUST hit, one per
    # sector boundary. If any of these regress the entire color model
    # is wrong.
    test_group("hsv_rainbow — canonical hues");
    var rgb[24];

    hsv_rainbow(0, &rgb);
    assert_eq(load64(&rgb + 0),  255, "phase 0    → R=255 (red)");
    assert_eq(load64(&rgb + 8),  0,   "phase 0    → G=0");
    assert_eq(load64(&rgb + 16), 0,   "phase 0    → B=0");

    hsv_rainbow(255, &rgb);
    assert_eq(load64(&rgb + 0),  255, "phase 255  → R=255 (yellow)");
    assert_eq(load64(&rgb + 8),  255, "phase 255  → G=255");
    assert_eq(load64(&rgb + 16), 0,   "phase 255  → B=0");

    hsv_rainbow(510, &rgb);
    assert_eq(load64(&rgb + 0),  0,   "phase 510  → R=0 (green)");
    assert_eq(load64(&rgb + 8),  255, "phase 510  → G=255");
    assert_eq(load64(&rgb + 16), 0,   "phase 510  → B=0");

    hsv_rainbow(765, &rgb);
    assert_eq(load64(&rgb + 0),  0,   "phase 765  → R=0 (cyan)");
    assert_eq(load64(&rgb + 8),  255, "phase 765  → G=255");
    assert_eq(load64(&rgb + 16), 255, "phase 765  → B=255");

    hsv_rainbow(1020, &rgb);
    assert_eq(load64(&rgb + 0),  0,   "phase 1020 → R=0 (blue)");
    assert_eq(load64(&rgb + 8),  0,   "phase 1020 → G=0");
    assert_eq(load64(&rgb + 16), 255, "phase 1020 → B=255");

    hsv_rainbow(1275, &rgb);
    assert_eq(load64(&rgb + 0),  255, "phase 1275 → R=255 (magenta)");
    assert_eq(load64(&rgb + 8),  0,   "phase 1275 → G=0");
    assert_eq(load64(&rgb + 16), 255, "phase 1275 → B=255");

    # phase = 1530 wraps to 0 — proves the modulus normalization path
    hsv_rainbow(1530, &rgb);
    assert_eq(load64(&rgb + 0),  255, "phase 1530 wraps → R=255 (red)");
    assert_eq(load64(&rgb + 8),  0,   "phase 1530 wraps → G=0");
    assert_eq(load64(&rgb + 16), 0,   "phase 1530 wraps → B=0");

    # ---- hsv_rainbow: sub-sector linear ramps -----------------------
    # Each sector has one channel running 0→255 (rising) or 255→0
    # (falling) over its 255 sub-steps. Sample mid-sector to catch
    # off-by-one in the ramp direction.
    test_group("hsv_rainbow — sector ramps");
    # Sector 0 mid (phase 128): R fixed at 255, G rising from 0, B=0.
    hsv_rainbow(128, &rgb);
    assert_eq(load64(&rgb + 0),  255, "sector 0 mid: R=255");
    assert_eq(load64(&rgb + 8),  128, "sector 0 mid: G=128 (rising)");
    assert_eq(load64(&rgb + 16), 0,   "sector 0 mid: B=0");
    # Sector 1 mid (phase 383 = 255+128): R falling 255→0, G fixed, B=0.
    hsv_rainbow(383, &rgb);
    assert_eq(load64(&rgb + 0),  127, "sector 1 mid: R=127 (falling 255-128)");
    assert_eq(load64(&rgb + 8),  255, "sector 1 mid: G=255");
    assert_eq(load64(&rgb + 16), 0,   "sector 1 mid: B=0");
    # Sector 3 mid (phase 893 = 765+128): R=0, G falling, B fixed.
    hsv_rainbow(893, &rgb);
    assert_eq(load64(&rgb + 0),  0,   "sector 3 mid: R=0");
    assert_eq(load64(&rgb + 8),  127, "sector 3 mid: G=127 (falling)");
    assert_eq(load64(&rgb + 16), 255, "sector 3 mid: B=255");
    # Sector 5 mid (phase 1403 = 1275+128): R fixed, G=0, B falling.
    hsv_rainbow(1403, &rgb);
    assert_eq(load64(&rgb + 0),  255, "sector 5 mid: R=255");
    assert_eq(load64(&rgb + 8),  0,   "sector 5 mid: G=0");
    assert_eq(load64(&rgb + 16), 127, "sector 5 mid: B=127 (falling)");

    # ---- hsv_rainbow: phase normalization (large + negative) --------
    # The modulus must wrap any phase value back into [0, 1530).
    # Negative input is not hypothetical: `-s` and `-F` (shipped at
    # M2 / v0.3.0) take arbitrary i64 from argv and are summed into
    # ANUENUE_PHASE_START, so `-F -1` reaches here directly. A large
    # `-p` also wraps the accumulator at i64. Either way the result
    # indexes _PHASE_ESC_TABLE, so the normalization is a bounds
    # guarantee, not a nicety.
    test_group("hsv_rainbow — phase normalization");
    hsv_rainbow(3060, &rgb);    # 2 * 1530 → wraps to 0
    assert_eq(load64(&rgb + 0),  255, "phase 3060 (2×mod) → red R");
    assert_eq(load64(&rgb + 8),  0,   "phase 3060 (2×mod) → red G");
    hsv_rainbow(0 - 255, &rgb); # -255 → wraps to 1275 (magenta start)
    assert_eq(load64(&rgb + 0),  255, "phase -255 → magenta R");
    assert_eq(load64(&rgb + 8),  0,   "phase -255 → magenta G");
    assert_eq(load64(&rgb + 16), 255, "phase -255 → magenta B");

    # ---- byte-cost arithmetic for the filter loop -------------------
    # docs/architecture/001. Every write loop checks AFTER an iteration:
    # `pos + FLUSH_RESERVE > LINE_BUF` flushes, appending a 4-byte SGR
    # reset first. So from the top of an iteration (pos <= LINE_BUF -
    # RESERVE) the widest reach is one escape (the 24-byte entry budget)
    # + one codepoint (4) + the reset (4) = 32: RESERVE must be at least
    # that. (v1.4.4 corrected this group, which still described the
    # v0.3.0 reserve of 22 and an 18-byte escape, and asserted
    # RESERVE >= 22.) The largest escape darshana can compose is 19
    # bytes, all three channels 3 digits; anuenue's rainbow never
    # reaches it — one channel is always 0 — and measures 17.
    test_group("filter geometry — flush reserve sizing");
    var ebuf[32];
    var ei = 0;
    while (ei < 32) { store8(&ebuf + ei, 0); ei = ei + 1; }
    var ep = tty_fg_rgb_buf(&ebuf, 0, 255, 255, 255);
    assert_eq(ep, 19, "max fg escape = 19 bytes (ESC[38;2;255;255;255m)");
    assert(ep <= ANUENUE_ESC_TABLE_ENTRY_SIZE - 8, "the largest composable escape fits the 24-byte budget");
    assert(ANUENUE_FLUSH_RESERVE >= (ANUENUE_ESC_TABLE_ENTRY_SIZE - 8) + 4 + 4,
      "reserve >= escape budget + codepoint + reset (24 + 4 + 4)");

    # ---- filter constants are sane ---------------------------------
    test_group("filter constants — sanity");
    assert(ANUENUE_PHASE_MOD == 1530, "PHASE_MOD = 6 × 255 = 1530");
    assert(ANUENUE_PHASE_STEP > 0, "PHASE_STEP positive");
    assert(ANUENUE_PHASE_STEP < ANUENUE_PHASE_MOD, "PHASE_STEP < PHASE_MOD (no per-byte wrap)");
    # LINE_BUF need not hold a full read-chunk's worst-case output —
    # the force-flush inside the loop drains incrementally. The real
    # invariant is "the flush-reserve guard is meaningful": the buf
    # is large enough that flushes amortize the per-flush syscall
    # cost over ≥100 characters. With reserve 32 and LINE_BUF 32768,
    # ~1 700 truecolor characters fit between flushes.
    assert(ANUENUE_LINE_BUF > ANUENUE_FLUSH_RESERVE * 100, "LINE_BUF amortizes ≥100 chars per flush");
    assert(ANUENUE_LINE_BUF > ANUENUE_FLUSH_RESERVE, "LINE_BUF > FLUSH_RESERVE (no underflow in guard)");
    return 0;
}

# M2 (v0.3.0): the flag surface through cmdit_parse_argv. Returns 0.
fn test_m2_flags(): i64 {
    # ---- v0.3.0 — M2 flag-parser coverage (migrated to cmdit) -------
    # Exercises `cmdit_parse_argv` over synthetic argv arrays. cmdit's
    # own parser contract is asserted in its tests/cmdit.tcyr; here we
    # verify anuenue's flag-set wiring: short/long forms, integer
    # extraction, the additive `-s` + `-F` accumulator, the auto -h / -V
    # short-circuits, and the error-variant dispatch. cmdit_new
    # auto-registers --help/-h + --version/-V, so anuenue registers only
    # freq/seed/offset and --help/--version surface as CMDIT_HELP /
    # CMDIT_VERSION return codes (not queried bools).
    test_group("M2 flags — --help short-circuits to CMDIT_HELP");
    var fs1 = cmdit_new("anuenue");
    var f_freq    = cmdit_int(fs1, 112, "freq",   7, "p");
    var f_seed    = cmdit_int(fs1, 115, "seed",   0, "s");
    var f_offset  = cmdit_int(fs1, 70,  "offset", 0, "F");
    # Argv: ["anuenue", "--help"]
    var argv1[16];                       # 2 pointers = 16 bytes (v1.5.1: was [8])
    store64(&argv1 + 0,  "anuenue");
    store64(&argv1 + 8,  "--help");
    assert_eq(cmdit_parse_argv(fs1, 2, &argv1), CMDIT_HELP, "--help → CMDIT_HELP");
    assert_eq(cmdit_get_int(fs1, f_freq), 7, "freq = default 7 (unset)");

    test_group("M2 flags — short -V short-circuits to CMDIT_VERSION");
    var fs2 = cmdit_new("anuenue");
    var argv2[16];                       # 2 pointers = 16 bytes (v1.5.1: was [8])
    store64(&argv2 + 0, "anuenue");
    store64(&argv2 + 8, "-V");
    assert_eq(cmdit_parse_argv(fs2, 2, &argv2), CMDIT_VERSION, "-V → CMDIT_VERSION");

    test_group("M2 flags — int -p / -s / -F");
    var fs3 = cmdit_new("anuenue");
    var f3_p = cmdit_int(fs3, 112, "freq",   7, "p");
    var f3_s = cmdit_int(fs3, 115, "seed",   0, "s");
    var f3_F = cmdit_int(fs3, 70,  "offset", 0, "F");
    # Argv: ["anuenue", "-p", "13", "-s", "42", "-F", "100"]
    var argv3[64];
    store64(&argv3 + 0,  "anuenue");
    store64(&argv3 + 8,  "-p");
    store64(&argv3 + 16, "13");
    store64(&argv3 + 24, "-s");
    store64(&argv3 + 32, "42");
    store64(&argv3 + 40, "-F");
    store64(&argv3 + 48, "100");
    assert_eq(cmdit_parse_argv(fs3, 7, &argv3), CMDIT_OK, "-p 13 -s 42 -F 100 parses clean");
    assert_eq(cmdit_get_int(fs3, f3_p), 13,  "-p value extracted");
    assert_eq(cmdit_get_int(fs3, f3_s), 42,  "-s value extracted");
    assert_eq(cmdit_get_int(fs3, f3_F), 100, "-F value extracted");

    test_group("M2 flags — long --freq=N attached syntax");
    var fs4 = cmdit_new("anuenue");
    var f4_p = cmdit_int(fs4, 112, "freq", 7, "p");
    var argv4[16];
    store64(&argv4 + 0, "anuenue");
    store64(&argv4 + 8, "--freq=99");
    assert_eq(cmdit_parse_argv(fs4, 2, &argv4), CMDIT_OK, "--freq=99 parses clean");
    assert_eq(cmdit_get_int(fs4, f4_p), 99, "--freq=99 value extracted");

    test_group("M2 flags — additive seed+offset semantics");
    # Verifies the main.cyr dispatch logic: PHASE_START = seed +
    # offset. -s 510 (green) + -F 510 (advance 2 sectors) = 1020 (blue).
    var fs5 = cmdit_new("anuenue");
    var f5_s = cmdit_int(fs5, 115, "seed",   0, "s");
    var f5_F = cmdit_int(fs5, 70,  "offset", 0, "F");
    var argv5[40];                       # 5 pointers = 40 bytes (v1.5.1: was [32])
    store64(&argv5 + 0,  "anuenue");
    store64(&argv5 + 8,  "-s");
    store64(&argv5 + 16, "510");
    store64(&argv5 + 24, "-F");
    store64(&argv5 + 32, "510");
    assert_eq(cmdit_parse_argv(fs5, 5, &argv5), CMDIT_OK, "-s 510 -F 510 parses clean");
    var combined = cmdit_get_int(fs5, f5_s) + cmdit_get_int(fs5, f5_F);
    assert_eq(combined, 1020, "seed + offset = 1020 (blue start)");
    # Confirm the resulting phase lands in sector 4 → blue at byte 0.
    var rgb5[24];
    hsv_rainbow(combined, &rgb5);
    assert_eq(load64(&rgb5 + 0),  0,   "combined phase 1020 → R=0");
    assert_eq(load64(&rgb5 + 16), 255, "combined phase 1020 → B=255 (blue)");

    test_group("M2 flags — error variants");
    # Unknown flag rejected (help is auto-registered, so --bogus is unknown).
    var fs6 = cmdit_new("anuenue");
    var argv6[16];
    store64(&argv6 + 0, "anuenue");
    store64(&argv6 + 8, "--bogus");
    assert_eq(cmdit_parse_argv(fs6, 2, &argv6), CMDIT_RESULT_ERR, "unknown flag rejected");
    assert_eq(cmdit_error(fs6), CMDIT_ERR_UNKNOWN, "error variant = UNKNOWN");

    # Missing value for int flag rejected.
    var fs7 = cmdit_new("anuenue");
    cmdit_int(fs7, 112, "freq", 7, "p");
    var argv7[16];
    store64(&argv7 + 0, "anuenue");
    store64(&argv7 + 8, "-p");                 # no value follows
    assert_eq(cmdit_parse_argv(fs7, 2, &argv7), CMDIT_RESULT_ERR, "-p without value rejected");
    assert_eq(cmdit_error(fs7), CMDIT_ERR_MISSING_VALUE, "error variant = MISSING_VALUE");

    # Bad integer value rejected.
    var fs8 = cmdit_new("anuenue");
    cmdit_int(fs8, 112, "freq", 7, "p");
    var argv8[32];
    store64(&argv8 + 0,  "anuenue");
    store64(&argv8 + 8,  "-p");
    store64(&argv8 + 16, "notanumber");
    assert_eq(cmdit_parse_argv(fs8, 3, &argv8), CMDIT_RESULT_ERR, "non-numeric -p value rejected");
    assert_eq(cmdit_error(fs8), CMDIT_ERR_BAD_INT, "error variant = BAD_INT");

    # ---- v0.4.0 — M3 UTF-8 sequence detection ---------------------
    # Synthetic byte buffers cover each path through utf8_seq_len
    # without touching stdin. The decode round-trip ensures the
    # codepoints emerge as expected at canonical samples.
    return 0;
}

# M3 (v0.4.0): UTF-8 sequence detection, decode, and the grapheme classifiers. Returns 0.
fn test_m3_utf8(): i64 {
    test_group("M3 utf8_seq_len — 1/2/3/4-byte detection");
    var u1[4];
    store8(&u1 + 0, 0x41);        # 'A' — ASCII
    assert_eq(utf8_seq_len(&u1, 0, 1), 1, "ASCII 'A' → 1");

    var u2[4];
    store8(&u2 + 0, 0xC3);        # leading of é (U+00E9 → C3 A9)
    store8(&u2 + 1, 0xA9);
    assert_eq(utf8_seq_len(&u2, 0, 2), 2, "2-byte é → 2");

    var u3[4];
    store8(&u3 + 0, 0xE6);        # 日 (U+65E5 → E6 97 A5)
    store8(&u3 + 1, 0x97);
    store8(&u3 + 2, 0xA5);
    assert_eq(utf8_seq_len(&u3, 0, 3), 3, "3-byte 日 → 3");

    var u4[4];
    store8(&u4 + 0, 0xF0);        # 🌈 (U+1F308 → F0 9F 8C 88)
    store8(&u4 + 1, 0x9F);
    store8(&u4 + 2, 0x8C);
    store8(&u4 + 3, 0x88);
    assert_eq(utf8_seq_len(&u4, 0, 4), 4, "4-byte 🌈 → 4");

    test_group("M3 utf8_seq_len — invalid + truncated");
    # 0x80 bare continuation byte (not a valid leading byte).
    var bad1[2];
    store8(&bad1 + 0, 0x80);
    store8(&bad1 + 1, 0x41);
    assert_eq(utf8_seq_len(&bad1, 0, 2), 1, "bare continuation → 1 (graceful)");

    # 0xF8 — 5-byte leader, disallowed by RFC 3629.
    var bad2[1];
    store8(&bad2 + 0, 0xF8);
    assert_eq(utf8_seq_len(&bad2, 0, 1), 1, "0xF8 leader → 1");

    # 3-byte leader, but only 2 bytes available — truncated.
    var trunc[2];
    store8(&trunc + 0, 0xE6);
    store8(&trunc + 1, 0x97);
    assert_eq(utf8_seq_len(&trunc, 0, 2), 0, "truncated 3-byte → 0 (carry signal)");

    # 2-byte leader followed by ASCII byte — invalid continuation.
    var badcont[2];
    store8(&badcont + 0, 0xC3);
    store8(&badcont + 1, 0x41);   # 'A' is NOT a valid continuation byte
    assert_eq(utf8_seq_len(&badcont, 0, 2), 1, "invalid continuation → 1");

    test_group("M3 utf8_decode — canonical codepoints");
    # é → U+00E9
    assert_eq(utf8_decode(&u2, 0, 2), 0x00E9, "é decodes to U+00E9");
    # 日 → U+65E5
    assert_eq(utf8_decode(&u3, 0, 3), 0x65E5, "日 decodes to U+65E5");
    # 🌈 → U+1F308
    assert_eq(utf8_decode(&u4, 0, 4), 0x1F308, "🌈 decodes to U+1F308");
    # ASCII passthrough
    assert_eq(utf8_decode(&u1, 0, 1), 0x41, "'A' decodes to 0x41");

    test_group("M3 cp_is_extending — combining marks");
    assert_eq(cp_is_extending(0x0301), 1, "U+0301 combining acute → extending");
    assert_eq(cp_is_extending(0x036F), 1, "U+036F end of Latin combining → extending");
    assert_eq(cp_is_extending(0x200D), 1, "ZWJ → extending");
    assert_eq(cp_is_extending(0xFE0F), 1, "VS-16 → extending");
    assert_eq(cp_is_extending(0xFE20), 1, "U+FE20 combining half mark → extending");
    assert_eq(cp_is_extending(0x064B), 1, "Arabic fatḥatan → extending");
    assert_eq(cp_is_extending(0xE0100), 1, "Variation Selector Supplement → extending");
    # Non-extending: ASCII, regular emoji, regular CJK
    assert_eq(cp_is_extending(0x41),    0, "'A' → not extending");
    assert_eq(cp_is_extending(0x65E5),  0, "日 → not extending");
    assert_eq(cp_is_extending(0x1F308), 0, "🌈 → not extending");
    # Boundary: 0x2FF is just below the Latin combining range
    assert_eq(cp_is_extending(0x02FF), 0, "U+02FF (one before combining) → not extending");
    assert_eq(cp_is_extending(0x0370), 0, "U+0370 (one after combining) → not extending");

    test_group("M3 cp_is_regional_indicator");
    assert_eq(cp_is_regional_indicator(0x1F1E6), 1, "RI A → yes");
    assert_eq(cp_is_regional_indicator(0x1F1FF), 1, "RI Z → yes");
    assert_eq(cp_is_regional_indicator(0x1F1FA), 1, "RI U (🇺) → yes");
    assert_eq(cp_is_regional_indicator(0x1F1E5), 0, "U+1F1E5 → no");
    assert_eq(cp_is_regional_indicator(0x1F200), 0, "U+1F200 → no");
    assert_eq(cp_is_regional_indicator(0x1F308), 0, "🌈 → no");
    return 0;
}

# M5 (v0.6.0): the phase-cached escape table. Returns 0.
fn test_m5_phase_cache(): i64 {
    # ---- v0.6.0 — M5 perf pass --------------------------------------
    # Phase-cached escape buffer. The fast path replaces
    # `hsv_rainbow + tty_fg_rgb_buf` per cluster with a memcpy from
    # _PHASE_ESC_TABLE[phase % MOD]. The unit-test contract: every
    # entry in the table is byte-identical to what the runtime path
    # would have produced. Build the table, then for each canonical
    # phase compare the cached entry against a fresh runtime emit.
    test_group("M5 perf — phase-cached escape table");
    assert_eq(_phase_esc_init(), 0, "_phase_esc_init returns 0 on success");
    assert(_PHASE_ESC_TABLE != 0, "table pointer non-null after init");
    # Idempotent: second call is a no-op (table already built).
    assert_eq(_phase_esc_init(), 0, "_phase_esc_init idempotent");

    # Per-entry round-trip: for each canonical hue boundary, the
    # cached escape's bytes match a freshly-computed tty_fg_rgb_buf
    # emission. Six canonical hues + the wraparound corner cover
    # 1/2/3-digit channel encodings.
    var pe_rgb[24];
    var pe_fresh[32];
    var pe_dst[32];
    var pe_phases[8];
    store64(&pe_phases + 0 * 8, 0);     # red
    store64(&pe_phases + 1 * 8, 255);   # yellow
    store64(&pe_phases + 2 * 8, 510);   # green
    store64(&pe_phases + 3 * 8, 765);   # cyan
    store64(&pe_phases + 4 * 8, 1020);  # blue
    store64(&pe_phases + 5 * 8, 1275);  # magenta
    store64(&pe_phases + 6 * 8, 1529);  # last entry before wrap
    store64(&pe_phases + 7 * 8, 7);     # default -p step value

    var pi = 0;
    while (pi < 8) {
        var phase = load64(&pe_phases + pi * 8);
        # Runtime path for comparison.
        hsv_rainbow(phase, &pe_rgb);
        var fresh_len = tty_fg_rgb_buf(&pe_fresh, 0,
          load64(&pe_rgb + 0),
          load64(&pe_rgb + 8),
          load64(&pe_rgb + 16));
        # Cached path: _emit_phase_esc writes elen bytes starting at
        # `pos` into the buffer and returns `pos + elen`.
        var cached_pos = _emit_phase_esc(&pe_dst, 0, phase);
        assert_eq(cached_pos, fresh_len, "cached length matches runtime length");
        var bi = 0;
        var bytes_ok = 1;
        while (bi < fresh_len) {
            if (load8(&pe_dst + bi) != load8(&pe_fresh + bi)) { bytes_ok = 0; }
            bi = bi + 1;
        }
        assert_eq(bytes_ok, 1, "cached escape bytes byte-identical to runtime");
        pi = pi + 1;
    }

    # Phase normalization: negative and >MOD phases should hit the
    # same cached entries as their canonical [0, MOD) representatives.
    var n_pos = _emit_phase_esc(&pe_dst, 0, 0);
    var n_neg = _emit_phase_esc(&pe_fresh, 0, 0 - ANUENUE_PHASE_MOD);
    assert_eq(n_pos, n_neg, "phase = -MOD == phase = 0 (same length)");
    var nb = 0;
    var n_match = 1;
    while (nb < n_pos) {
        if (load8(&pe_dst + nb) != load8(&pe_fresh + nb)) { n_match = 0; }
        nb = nb + 1;
    }
    assert_eq(n_match, 1, "phase = -MOD byte-identical to phase = 0");

    var w_canon = _emit_phase_esc(&pe_dst, 0, 7);
    var w_over  = _emit_phase_esc(&pe_fresh, 0, 7 + ANUENUE_PHASE_MOD * 3);
    assert_eq(w_canon, w_over, "phase = 7 + 3*MOD == phase = 7 (same length)");
    var wb = 0;
    var w_match = 1;
    while (wb < w_canon) {
        if (load8(&pe_dst + wb) != load8(&pe_fresh + wb)) { w_match = 0; }
        wb = wb + 1;
    }
    assert_eq(w_match, 1, "phase = 7 + 3*MOD byte-identical to phase = 7");

    # Table layout sanity: 32-byte stride matches the documented
    # cache-line discipline; entry length is always 13..19 (the
    # truecolor SGR envelope).
    assert_eq(ANUENUE_ESC_TABLE_ENTRY_SIZE, 32, "entry size = 32 bytes (cache line stride)");
    var len_min = 99;
    var len_max = 0;
    var li = 0;
    while (li < ANUENUE_PHASE_MOD) {
        var elen = load64(_PHASE_ESC_TABLE + li * ANUENUE_ESC_TABLE_ENTRY_SIZE);
        if (elen < len_min) { len_min = elen; }
        if (elen > len_max) { len_max = elen; }
        li = li + 1;
    }
    assert(len_min >= 13, "min entry length ≥ 13 (truecolor SGR floor)");
    assert(len_max <= 19, "max entry length ≤ 19 (truecolor SGR ceiling)");

    # ---- v0.7.0 — M6 color-mode negotiation -------------------------
    # Mode enum + override-string parser + RGB quantization. The
    # detect_color_mode dispatcher reads getenv + isatty so it
    # can't be unit-tested deterministically here — golden-check.sh
    # owns the NO_COLOR / --no-color / --color=none acceptance.
    return 0;
}

# M6 (v0.7.0): colour-mode parsing, RGB quantization, 256 / 16 escape framing. Returns 0.
fn test_m6_color(): i64 {
    test_group("M6 color — mode enum + override parser");
    assert_eq(ANUENUE_COLOR_MONO, 0, "MONO enum value");
    assert_eq(ANUENUE_COLOR_16,   1, "COLOR_16 enum value");
    assert_eq(ANUENUE_COLOR_256,  2, "COLOR_256 enum value");
    assert_eq(ANUENUE_COLOR_TRUE, 3, "TRUECOLOR enum value");

    # --color string → override enum
    assert_eq(_color_override_from_str("auto"),      ANUENUE_COLOR_OVERRIDE_AUTO, "auto → AUTO");
    assert_eq(_color_override_from_str("24bit"),     ANUENUE_COLOR_OVERRIDE_TRUE, "24bit → TRUE");
    assert_eq(_color_override_from_str("truecolor"), ANUENUE_COLOR_OVERRIDE_TRUE, "truecolor → TRUE");
    assert_eq(_color_override_from_str("256"),       ANUENUE_COLOR_OVERRIDE_256,  "256 → 256");
    assert_eq(_color_override_from_str("16"),        ANUENUE_COLOR_OVERRIDE_16,   "16 → 16");
    assert_eq(_color_override_from_str("none"),      ANUENUE_COLOR_OVERRIDE_NONE, "none → NONE");
    assert_eq(_color_override_from_str("off"),       ANUENUE_COLOR_OVERRIDE_NONE, "off → NONE");
    assert_eq(_color_override_from_str("never"),     ANUENUE_COLOR_OVERRIDE_NONE, "never → NONE");
    # CHANGED at v1.2.2 (audit A-04). This assertion used to expect
    # AUTO, on the reasoning that falling back "doesn't silently force
    # a mode the user didn't intend". The audit found the opposite is
    # true: AUTO *is* a mode, so `--color=trucolor` silently ran
    # detection while the user believed they had forced truecolor, and
    # nothing said otherwise. An unrecognised value is now a usage
    # error — the same rule --log-level already followed.
    assert_eq(_color_override_from_str("bogus"),     ANUENUE_COLOR_OVERRIDE_BAD, "unknown → BAD (usage error)");

    # Override → mode mapping
    assert_eq(_color_mode_from_override(ANUENUE_COLOR_OVERRIDE_TRUE), ANUENUE_COLOR_TRUE, "OVERRIDE_TRUE → TRUE");
    assert_eq(_color_mode_from_override(ANUENUE_COLOR_OVERRIDE_256),  ANUENUE_COLOR_256,  "OVERRIDE_256 → 256");
    assert_eq(_color_mode_from_override(ANUENUE_COLOR_OVERRIDE_16),   ANUENUE_COLOR_16,   "OVERRIDE_16 → 16");
    assert_eq(_color_mode_from_override(ANUENUE_COLOR_OVERRIDE_NONE), ANUENUE_COLOR_MONO, "OVERRIDE_NONE → MONO");

    test_group("M6 color — _channel_to_6 cube quantization");
    # Channel buckets: 0 → 0, 95 → 1, 135 → 2, 175 → 3, 215 → 4, 255 → 5.
    # Thresholds (midpoints): 48, 115, 155, 195, 235.
    assert_eq(_channel_to_6(0),   0, "0 → bucket 0");
    assert_eq(_channel_to_6(47),  0, "47 (last <48) → bucket 0");
    assert_eq(_channel_to_6(48),  1, "48 → bucket 1");
    assert_eq(_channel_to_6(95),  1, "95 → bucket 1");
    assert_eq(_channel_to_6(114), 1, "114 → bucket 1");
    assert_eq(_channel_to_6(115), 2, "115 → bucket 2");
    assert_eq(_channel_to_6(135), 2, "135 → bucket 2");
    assert_eq(_channel_to_6(155), 3, "155 → bucket 3");
    assert_eq(_channel_to_6(175), 3, "175 → bucket 3");
    assert_eq(_channel_to_6(195), 4, "195 → bucket 4");
    assert_eq(_channel_to_6(215), 4, "215 → bucket 4");
    assert_eq(_channel_to_6(235), 5, "235 → bucket 5");
    assert_eq(_channel_to_6(255), 5, "255 → bucket 5");

    test_group("M6 color — _rgb_to_256 canonical hues");
    # Each canonical hue corner of the HSV rainbow → a known 256
    # cube index. 16 + 36*r6 + 6*g6 + b6.
    assert_eq(_rgb_to_256(255, 0,   0),   196, "(255,0,0) red    → 16 + 36*5 = 196");
    assert_eq(_rgb_to_256(255, 255, 0),   226, "(255,255,0) yel  → 16 + 36*5 + 6*5 = 226");
    assert_eq(_rgb_to_256(0,   255, 0),   46,  "(0,255,0) grn   → 16 + 6*5 = 46");
    assert_eq(_rgb_to_256(0,   255, 255), 51,  "(0,255,255) cyan → 16 + 6*5 + 5 = 51");
    assert_eq(_rgb_to_256(0,   0,   255), 21,  "(0,0,255) blue  → 16 + 5 = 21");
    assert_eq(_rgb_to_256(255, 0,   255), 201, "(255,0,255) mag  → 16 + 36*5 + 5 = 201");
    # Pure white + pure black corners (defensive — not hit by the rainbow)
    assert_eq(_rgb_to_256(0,   0,   0),   16,  "(0,0,0) → 16 (cube base)");
    assert_eq(_rgb_to_256(255, 255, 255), 231, "(255,255,255) → 231 (cube tip)");

    test_group("M6 color — _rgb_to_16 bright-palette quantization");
    # The 6 canonical rainbow hue corners → 6 of the 8 bright codes.
    assert_eq(_rgb_to_16(255, 0,   0),   91, "red → bright red (91)");
    assert_eq(_rgb_to_16(255, 255, 0),   93, "yellow → bright yellow (93)");
    assert_eq(_rgb_to_16(0,   255, 0),   92, "green → bright green (92)");
    assert_eq(_rgb_to_16(0,   255, 255), 96, "cyan → bright cyan (96)");
    assert_eq(_rgb_to_16(0,   0,   255), 94, "blue → bright blue (94)");
    assert_eq(_rgb_to_16(255, 0,   255), 95, "magenta → bright magenta (95)");
    # Mid-ramp samples — the (≥128) thresholds bin them deterministically.
    assert_eq(_rgb_to_16(200, 150, 0),   93, "(200,150,0) red→yel ramp → yellow");
    assert_eq(_rgb_to_16(100, 200, 50),  92, "(100,200,50) green-dominant → green");
    # Edge case: all dimmed below 128 (rainbow never hits this; the
    # white fallback is the safe default rather than emitting nothing).
    assert_eq(_rgb_to_16(50,  50,  50),  97, "(50,50,50) all-dim → white fallback");

    test_group("M6 color — tty_fg_256_buf escape framing (darshana 0.5.3)");
    # \x1b[38;5;Nm shape: 7-byte prefix + 1-3 digits + 'm'.
    # Migrated from the v0.7.0-era `_fg_256_buf_compat` stand-in.
    var c256buf[16];
    assert_eq(tty_fg_256_buf(&c256buf, 0,   0), 9,  "N=0 → 9 bytes total");
    assert_eq(load8(&c256buf + 0), 0x1b, "byte 0 = ESC");
    assert_eq(load8(&c256buf + 1), 0x5b, "byte 1 = '['");
    assert_eq(load8(&c256buf + 5), 0x35, "byte 5 = '5' (palette selector)");
    assert_eq(load8(&c256buf + 7), 0x30, "byte 7 = '0' (N=0 single digit)");
    assert_eq(load8(&c256buf + 8), 0x6d, "byte 8 = 'm' (terminator)");
    assert_eq(tty_fg_256_buf(&c256buf, 0, 255), 11, "N=255 → 11 bytes total");
    assert_eq(load8(&c256buf + 7),  0x32, "byte 7 = '2'");
    assert_eq(load8(&c256buf + 8),  0x35, "byte 8 = '5'");
    assert_eq(load8(&c256buf + 9),  0x35, "byte 9 = '5'");
    assert_eq(load8(&c256buf + 10), 0x6d, "byte 10 = 'm'");
    # Bounds rejection
    assert_eq(tty_fg_256_buf(&c256buf, 0, 0 - 1), 0 - 1, "N=-1 rejected");
    assert_eq(tty_fg_256_buf(&c256buf, 0, 256),   0 - 1, "N=256 rejected");

    test_group("M6 color — tty_sgr_buf escape framing (darshana 0.5.3)");
    # \x1b[<code>m shape: 2-byte prefix + 1-3 digits + 'm'.
    # Migrated from the v0.7.0-era `_sgr_buf_compat` stand-in.
    var sgrbuf[16];
    assert_eq(tty_sgr_buf(&sgrbuf, 0, 91), 5, "code=91 → 5 bytes total");
    assert_eq(load8(&sgrbuf + 0), 0x1b, "byte 0 = ESC");
    assert_eq(load8(&sgrbuf + 2), 0x39, "byte 2 = '9'");
    assert_eq(load8(&sgrbuf + 3), 0x31, "byte 3 = '1'");
    assert_eq(load8(&sgrbuf + 4), 0x6d, "byte 4 = 'm'");
    assert_eq(tty_sgr_buf(&sgrbuf, 0, 0),  4,  "code=0 (reset) → 4 bytes");
    assert_eq(tty_sgr_buf(&sgrbuf, 0, 999), 6, "code=999 → 6 bytes");
    assert_eq(tty_sgr_buf(&sgrbuf, 0, 0 - 1), 0 - 1, "code=-1 rejected");
    assert_eq(tty_sgr_buf(&sgrbuf, 0, 1000),  0 - 1, "code=1000 rejected");

    # ---- v0.5.0 — M4 animation surface ------------------------------
    # Cluster pre-tagging and helper math. The frame loop, signalfd,
    # and sleep cadence resist unit-level testing — they go through
    # scripts/golden-check.sh (which gains an animation smoke at M4)
    # and the live SIGINT/duration smokes documented in the M4 cut
    # commit. What we *can* lock down here: the pure functions that
    # turn the buffered input into a cluster table the renderer
    # walks per frame.
    return 0;
}

# M4 (v0.5.0): animation constants, cluster pre-tagging, -a / -d / -S parsing. Returns 0.
fn test_m4_animate(): i64 {
    test_group("M4 animate — constants sanity");
    # Defaults the flag layer falls back to.
    assert(ANUENUE_DEFAULT_DURATION_S > 0, "default duration positive (0 reserved for 'until SIGINT')");
    assert(ANUENUE_DEFAULT_SPEED > 0, "default speed positive");
    assert(ANUENUE_FRAME_MS > 0, "frame interval positive");
    assert(ANUENUE_FRAME_MS <= 33, "frame interval ≤ 33ms (~30 fps floor)");
    # Buffer ceilings stay well clear of the cluster index sizing.
    assert(ANUENUE_ANIMATE_INPUT_MAX > 0, "input ceiling > 0");
    assert(ANUENUE_ANIMATE_CLUSTER_MAX > 0, "cluster ceiling > 0");
    # The teardown drain must be able to empty the fd: three exit
    # signals can be pending at once (standard signals do not queue).
    assert(ANUENUE_SIG_DRAIN_MAX >= 3, "signalfd drain covers HUP + INT + TERM pending together");

    test_group("M4 animate — _pretag_clusters ASCII");
    # Pre-tag "AGNOS\n" — six clusters, one per byte. ctab[i] holds
    # start offset; ctab[6] holds the byte count sentinel.
    var ab[16];
    store8(&ab + 0, 65);  # A
    store8(&ab + 1, 71);  # G
    store8(&ab + 2, 78);  # N
    store8(&ab + 3, 79);  # O
    store8(&ab + 4, 83);  # S
    store8(&ab + 5, 10);  # LF
    var ac[64];           # 8 slots × 8 bytes
    var n_ac = _pretag_clusters(&ab, 6, &ac, 7);
    assert_eq(n_ac, 6, "AGNOS\\n → 6 clusters");
    assert_eq(load64(&ac + 0 * 8), 0, "cluster 0 starts at byte 0");
    assert_eq(load64(&ac + 1 * 8), 1, "cluster 1 starts at byte 1");
    assert_eq(load64(&ac + 5 * 8), 5, "cluster 5 (LF) starts at byte 5");
    assert_eq(load64(&ac + 6 * 8), 6, "sentinel = total byte count");

    test_group("M4 animate — _pretag_clusters combining diacritic");
    # "é" = e (1 byte) + U+0301 combining acute (2 bytes, 0xCC 0x81)
    # → one cluster covering all 3 bytes. The cluster table records
    # only the base codepoint's start offset.
    var cb[8];
    store8(&cb + 0, 101);   # 'e'
    store8(&cb + 1, 0xCC);  # U+0301 leading byte
    store8(&cb + 2, 0x81);  # U+0301 continuation
    var cc[32];
    var n_cc = _pretag_clusters(&cb, 3, &cc, 3);
    assert_eq(n_cc, 1, "e + combining acute → 1 cluster");
    assert_eq(load64(&cc + 0), 0, "cluster 0 starts at byte 0");
    assert_eq(load64(&cc + 8), 3, "sentinel = 3 (cluster spans all 3 bytes)");

    test_group("M4 animate — _pretag_clusters CJK");
    # "日" = U+65E5 = 0xE6 0x97 0xA5 (3 bytes, 1 cluster), then 'A'
    # = 1 byte = 1 cluster. Two clusters, sentinel = 4.
    var jb[8];
    store8(&jb + 0, 0xE6);
    store8(&jb + 1, 0x97);
    store8(&jb + 2, 0xA5);
    store8(&jb + 3, 65);   # 'A'
    var jc[32];
    var n_jc = _pretag_clusters(&jb, 4, &jc, 3);
    assert_eq(n_jc, 2, "日A → 2 clusters");
    assert_eq(load64(&jc + 0), 0, "cluster 0 (日) starts at byte 0");
    assert_eq(load64(&jc + 8), 3, "cluster 1 (A) starts at byte 3");
    assert_eq(load64(&jc + 16), 4, "sentinel = 4");

    test_group("M4 animate — _pretag_clusters truncated UTF-8");
    # 0xE6 0x97 alone (truncated 3-byte sequence). Pre-tag converts
    # truncation to per-byte clusters (graceful degradation; no
    # next-chunk to wait for in animation mode).
    var tb[4];
    store8(&tb + 0, 0xE6);
    store8(&tb + 1, 0x97);
    var tc[32];
    var n_tc = _pretag_clusters(&tb, 2, &tc, 3);
    assert_eq(n_tc, 2, "truncated 3-byte seq → 2 singleton clusters");
    assert_eq(load64(&tc + 0), 0, "cluster 0 starts at byte 0");
    assert_eq(load64(&tc + 8), 1, "cluster 1 starts at byte 1");
    assert_eq(load64(&tc + 16), 2, "sentinel = 2");

    test_group("M4 animate — _pretag_clusters overflow cap");
    # max_clusters = 2 means stop after 2 clusters are recorded; the
    # remaining input is silently dropped. Sentinel reflects how far
    # we actually advanced.
    var ob[8];
    store8(&ob + 0, 65);
    store8(&ob + 1, 66);
    store8(&ob + 2, 67);
    store8(&ob + 3, 68);
    var oc[32];
    var n_oc = _pretag_clusters(&ob, 4, &oc, 2);
    assert_eq(n_oc, 2, "cap = 2 → exactly 2 clusters tagged");
    assert_eq(load64(&oc + 16), 2, "sentinel = 2 (only first 2 bytes consumed)");

    test_group("M4 animate — _count_lf_clusters");
    # Re-use the ASCII "AGNOS\n" tagged above (ac, n_ac).
    assert_eq(_count_lf_clusters(&ab, &ac, n_ac), 1, "AGNOS\\n → 1 LF cluster");
    # Two-line input: "A\nB\n" → 2 LF clusters.
    var lb[8];
    store8(&lb + 0, 65);
    store8(&lb + 1, 10);
    store8(&lb + 2, 66);
    store8(&lb + 3, 10);
    var lc[64];
    var n_lc = _pretag_clusters(&lb, 4, &lc, 7);
    assert_eq(n_lc, 4, "A\\nB\\n → 4 clusters");
    assert_eq(_count_lf_clusters(&lb, &lc, n_lc), 2, "A\\nB\\n → 2 LFs");

    test_group("M4 animate — _input_ends_with_lf");
    # Re-use AGNOS\n (ends with LF) and a no-LF variant.
    assert_eq(_input_ends_with_lf(&ab, &ac, n_ac), 1, "AGNOS\\n ends with LF");
    var nbuf[4];
    store8(&nbuf + 0, 65);  # A
    store8(&nbuf + 1, 66);  # B
    var nc[32];
    var n_nc = _pretag_clusters(&nbuf, 2, &nc, 3);
    assert_eq(_input_ends_with_lf(&nbuf, &nc, n_nc), 0, "AB → no trailing LF");
    # Empty cluster table → false (animate driver short-circuits, but
    # the helper must not crash on the zero case).
    assert_eq(_input_ends_with_lf(&nbuf, &nc, 0), 0, "0 clusters → false");

    test_group("M4 flags — -a / -d / -S parse");
    var fs_a = cmdit_new("anuenue");
    var f_a_animate  = cmdit_bool(fs_a, 97,  "animate",  "a");
    var f_a_duration = cmdit_int (fs_a, 100, "duration", ANUENUE_DEFAULT_DURATION_S, "d");
    var f_a_speed    = cmdit_int (fs_a, 83,  "speed",    ANUENUE_DEFAULT_SPEED, "S");
    var argv_a[40];
    store64(&argv_a + 0,  "anuenue");
    store64(&argv_a + 8,  "-a");
    store64(&argv_a + 16, "-d");
    store64(&argv_a + 24, "3");
    store64(&argv_a + 32, "-S");
    var argv_a_2[16];
    store64(&argv_a_2 + 0, "anuenue");
    store64(&argv_a_2 + 8, "-a");
    assert_eq(cmdit_parse_argv(fs_a, 2, &argv_a_2), CMDIT_OK, "-a alone parses clean");
    assert_eq(cmdit_get_bool(fs_a, f_a_animate), 1, "-a → animate true");
    assert_eq(cmdit_get_int(fs_a, f_a_duration), ANUENUE_DEFAULT_DURATION_S, "duration = default");
    assert_eq(cmdit_get_int(fs_a, f_a_speed), ANUENUE_DEFAULT_SPEED, "speed = default");

    var fs_b = cmdit_new("anuenue");
    var f_b_animate  = cmdit_bool(fs_b, 97,  "animate",  "a");
    var f_b_duration = cmdit_int (fs_b, 100, "duration", ANUENUE_DEFAULT_DURATION_S, "d");
    var f_b_speed    = cmdit_int (fs_b, 83,  "speed",    ANUENUE_DEFAULT_SPEED, "S");
    var argv_b[48];
    store64(&argv_b + 0,  "anuenue");
    store64(&argv_b + 8,  "-a");
    store64(&argv_b + 16, "-d");
    store64(&argv_b + 24, "12");
    store64(&argv_b + 32, "-S");
    store64(&argv_b + 40, "4");
    assert_eq(cmdit_parse_argv(fs_b, 6, &argv_b), CMDIT_OK, "-a -d 12 -S 4 parses clean");
    assert_eq(cmdit_get_bool(fs_b, f_b_animate), 1, "-a → animate true");
    assert_eq(cmdit_get_int(fs_b, f_b_duration), 12, "duration = 12");
    assert_eq(cmdit_get_int(fs_b, f_b_speed), 4, "speed = 4");

    # Long-form: --duration=N attached syntax (mirrors M2 --freq=N test).
    var fs_c = cmdit_new("anuenue");
    var f_c_animate  = cmdit_bool(fs_c, 97,  "animate",  "a");
    var f_c_duration = cmdit_int (fs_c, 100, "duration", ANUENUE_DEFAULT_DURATION_S, "d");
    var argv_c[24];
    store64(&argv_c + 0,  "anuenue");
    store64(&argv_c + 8,  "--animate");
    store64(&argv_c + 16, "--duration=0");
    assert_eq(cmdit_parse_argv(fs_c, 3, &argv_c), CMDIT_OK, "--animate --duration=0 parses clean");
    assert_eq(cmdit_get_bool(fs_c, f_c_animate), 1, "--animate → true");
    assert_eq(cmdit_get_int(fs_c, f_c_duration), 0, "duration = 0 ('until SIGINT' sentinel)");
    return 0;
}

# M8 (v0.8.0 audit): the unbounded long-combiner cluster. Returns 0.
fn test_m8_long_cluster(): i64 {
    test_group("M8 audit — _pretag_clusters long-combiner chain");
    # docs/audit/2026-05-22-audit.md § Finding 1: a base codepoint
    # followed by many combining marks is ONE cluster in the
    # practical-subset classifier — its byte length is unbounded,
    # which is what made the pre-M8 _render_frame heap-overflow on
    # animation. Lock the invariant here so any future change to
    # cp_is_extending (e.g. an upgrade to full UAX #29 — see ADR
    # 0003) that altered cluster grouping would trip a unit test
    # rather than waiting for the integration smoke.
    var lcb = alloc(1024);                       # 1 KB: 'A' + 511 combiners
    var lcc = alloc(64);                         # 8 cluster slots
    if (lcb != 0) {
        if (lcc != 0) {
            store8(lcb + 0, 65);                 # 'A' base codepoint
            var lci = 0;
            while (lci < 511) {
                # U+0301 combining acute → 0xCC 0x81 in UTF-8
                store8(lcb + 1 + lci * 2,     0xCC);
                store8(lcb + 1 + lci * 2 + 1, 0x81);
                lci = lci + 1;
            }
            var n_lcc = _pretag_clusters(lcb, 1 + 511 * 2, lcc, 7);
            assert_eq(n_lcc, 1, "A + 511 combiners → exactly 1 cluster");
            assert_eq(load64(lcc + 0), 0, "cluster 0 starts at byte 0");
            assert_eq(load64(lcc + 8), 1 + 511 * 2, "sentinel = total bytes (clen unbounded by design)");
            # The invariant that matters for the heap-overflow fix:
            # a single cluster's byte length can exceed LINE_BUF -
            # FLUSH_RESERVE - escape_size. The fix (mid-cluster
            # flush in _render_frame) is what keeps this safe.
            # Document the failure mode this guards against:
            var clen = load64(lcc + 8) - load64(lcc + 0);
            assert_eq(clen, 1023, "this single cluster spans 1023 bytes (would overrun a smaller line buffer pre-fix)");
        }
    }
    return 0;
}

# v1.0 GA: the --version literal matches VERSION. Returns 0.
fn test_version_literal(): i64 {
    test_group("M2 — version literal consistency");
    # _VERSION_STR_ANUENUE is auto-generated by scripts/version-
    # bump.sh; assert the literal format so a hand-edit (or a stale
    # version_str.cyr) trips the test before it can ship in a
    # release. Bytes: "anuenue " (8) + "X.Y.Z" + "\n".
    assert_eq(load8(_VERSION_STR_ANUENUE + 0), 97,  "byte 0 = 'a'");
    assert_eq(load8(_VERSION_STR_ANUENUE + 1), 110, "byte 1 = 'n'");
    assert_eq(load8(_VERSION_STR_ANUENUE + 7), 32,  "byte 7 = ' '");
    assert_eq(load8(_VERSION_STR_ANUENUE + _VERSION_LEN_ANUENUE - 1), 10, "last byte = LF");
    # Length matches strlen — guards against version-bump.sh writing
    # a mismatched LEN constant.
    assert_eq(strlen(_VERSION_STR_ANUENUE), _VERSION_LEN_ANUENUE, "strlen matches _VERSION_LEN_ANUENUE");

    # ---- v1.2.1 — observability wiring ----------------------------
    #
    # sakshi + agnostik were declared deps with zero call sites until
    # v1.2.1. These groups cover the pure, testable parts of the
    # wiring; the emitting parts (sakshi records themselves) are
    # covered end-to-end by scripts/observe-check.sh.
    return 0;
}

# v1.2.1: the sakshi / agnostik observability wiring. Returns 0.
fn test_v121_observe(): i64 {
    test_group("v1.2.1 observe — log-level parse");
    assert_eq(anuenue_log_parse("off"),   ANUENUE_LOG_P_OFF,   "\"off\" parses");
    assert_eq(anuenue_log_parse("fatal"), ANUENUE_LOG_P_FATAL, "\"fatal\" parses");
    assert_eq(anuenue_log_parse("error"), ANUENUE_LOG_P_ERROR, "\"error\" parses");
    assert_eq(anuenue_log_parse("warn"),  ANUENUE_LOG_P_WARN,  "\"warn\" parses");
    assert_eq(anuenue_log_parse("info"),  ANUENUE_LOG_P_INFO,  "\"info\" parses");
    assert_eq(anuenue_log_parse("debug"), ANUENUE_LOG_P_DEBUG, "\"debug\" parses");
    assert_eq(anuenue_log_parse("trace"), ANUENUE_LOG_P_TRACE, "\"trace\" parses");
    # Unknown names must NOT silently default — a user who asks for
    # debug output and gets none concludes the tool is broken.
    assert_eq(anuenue_log_parse("loud"),  ANUENUE_LOG_P_BAD,   "unknown name → BAD, not a default");
    assert_eq(anuenue_log_parse(""),      ANUENUE_LOG_P_BAD,   "empty string → BAD");
    assert_eq(anuenue_log_parse("DEBUG"), ANUENUE_LOG_P_BAD,   "parse is case-sensitive (lowercase only)");
    assert_eq(anuenue_log_parse(0),       ANUENUE_LOG_P_BAD,   "null pointer → BAD, no deref");

    test_group("v1.2.1 observe — parse value maps onto the sakshi scale");
    # The whole scheme rests on sakshi_level == parse_value - 1, so
    # OFF lands below SK_FATAL and _sk_log suppresses every level.
    assert_eq(ANUENUE_LOG_P_FATAL - 1, SK_FATAL, "FATAL-1 == SK_FATAL");
    assert_eq(ANUENUE_LOG_P_ERROR - 1, SK_ERROR, "ERROR-1 == SK_ERROR");
    assert_eq(ANUENUE_LOG_P_WARN  - 1, SK_WARN,  "WARN-1  == SK_WARN");
    assert_eq(ANUENUE_LOG_P_INFO  - 1, SK_INFO,  "INFO-1  == SK_INFO");
    assert_eq(ANUENUE_LOG_P_DEBUG - 1, SK_DEBUG, "DEBUG-1 == SK_DEBUG");
    assert_eq(ANUENUE_LOG_P_TRACE - 1, SK_TRACE, "TRACE-1 == SK_TRACE");
    # OFF must be strictly below FATAL or a fatal record would escape
    # a silent run.
    assert_eq(ANUENUE_LOG_P_OFF - 1 < SK_FATAL, 1, "OFF-1 is below SK_FATAL (total silence)");

    test_group("v1.2.1 observe — init resolves verbosity");
    # -v alone means debug.
    assert_eq(anuenue_observe_init(1, ANUENUE_LOG_P_OFF), ANUENUE_LOG_P_DEBUG, "-v alone → debug");
    assert_eq(ANUENUE_VERBOSE, 1, "-v sets ANUENUE_VERBOSE");
    assert_eq(sakshi_get_level(), SK_DEBUG, "-v sets the sakshi level to SK_DEBUG");
    # An explicit --log-level beats -v, in both directions.
    assert_eq(anuenue_observe_init(1, ANUENUE_LOG_P_TRACE), ANUENUE_LOG_P_TRACE, "--log-level=trace beats -v");
    assert_eq(sakshi_get_level(), SK_TRACE, "sakshi level follows to SK_TRACE");
    assert_eq(anuenue_observe_init(0, ANUENUE_LOG_P_ERROR), ANUENUE_LOG_P_ERROR, "--log-level=error without -v");
    assert_eq(sakshi_get_level(), SK_ERROR, "sakshi level follows to SK_ERROR");
    # Default: no flags at all → silent, and VERBOSE clears so the
    # span helpers stay quiet.
    assert_eq(anuenue_observe_init(0, ANUENUE_LOG_P_OFF), ANUENUE_LOG_P_OFF, "no flags → off");
    assert_eq(ANUENUE_VERBOSE, 0, "no flags → ANUENUE_VERBOSE cleared");
    assert_eq(sakshi_get_level() < SK_FATAL, 1, "no flags → sakshi level below SK_FATAL");

    test_group("v1.2.1 observe — colour-decision reason is recorded");
    # Every branch of anuenue_detect_color_mode must set a reason, so
    # `-v` can always answer "why this mode?". The v1.1.5 AGNOS bug
    # was a wrong branch here that no output could distinguish.
    # --color override (highest priority).
    var obs_m_ovr = anuenue_detect_color_mode(0, 0, ANUENUE_COLOR_OVERRIDE_256);
    assert_eq(obs_m_ovr, ANUENUE_COLOR_256, "--color=256 override → 256 mode");
    assert_eq(ANUENUE_COLOR_REASON, ANUENUE_CR_FLAG_COLOR, "override records CR_FLAG_COLOR");
    # --no-color beats the env/TTY chain below it.
    var obs_m_nc = anuenue_detect_color_mode(1, 0, ANUENUE_COLOR_OVERRIDE_AUTO);
    assert_eq(obs_m_nc, ANUENUE_COLOR_MONO, "--no-color → MONO");
    assert_eq(ANUENUE_COLOR_REASON, ANUENUE_CR_FLAG_NOCOLOR, "--no-color records CR_FLAG_NOCOLOR");
    # The reason must never be left UNSET after a detect call — that
    # is the invariant that keeps `-v` honest.
    assert_eq(ANUENUE_COLOR_REASON == ANUENUE_CR_UNSET, 0, "reason is never UNSET after detect");

    test_group("v1.2.1 observe — reason and mode names are total");
    # A name function that returns 0 for some enum value would crash
    # strlen inside the logger. Assert every value has a name.
    var obs_ri = 0;
    while (obs_ri <= ANUENUE_CR_FALLBACK_16) {
        assert_eq(strlen(anuenue_color_reason_name(obs_ri)) > 0, 1, "every colour reason has a name");
        obs_ri = obs_ri + 1;
    }
    assert_eq(strlen(anuenue_color_reason_name(9999)) > 0, 1, "out-of-range reason still names something");
    assert_eq(strlen(anuenue_color_mode_name(ANUENUE_COLOR_MONO)) > 0, 1, "MONO has a name");
    assert_eq(strlen(anuenue_color_mode_name(ANUENUE_COLOR_16)) > 0, 1, "16 has a name");
    assert_eq(strlen(anuenue_color_mode_name(ANUENUE_COLOR_256)) > 0, 1, "256 has a name");
    assert_eq(strlen(anuenue_color_mode_name(ANUENUE_COLOR_TRUE)) > 0, 1, "24bit has a name");
    assert_eq(strlen(anuenue_color_mode_name(9999)) > 0, 1, "out-of-range mode still names something");
    var obs_pi = 0;
    while (obs_pi <= ANUENUE_LOG_P_BAD) {
        assert_eq(strlen(anuenue_log_parse_name(obs_pi)) > 0, 1, "every log-parse value has a name");
        obs_pi = obs_pi + 1;
    }

    test_group("v1.2.1 observe — agnostik error kind → exit code");
    # The v1.x exit-code contract, now expressed through the agnostik
    # taxonomy: only INVALID_ARGUMENT is a usage error (2); every
    # other kind is a runtime error (1). anuenue_fail writes to
    # stderr, which the test runner tolerates; the return value is
    # what is asserted.
    assert_eq(anuenue_fail(STIK_ERR_INVALID_ARGUMENT, "test: invalid argument"),
      ANUENUE_EXIT_USAGE, "INVALID_ARGUMENT → exit 2");
    assert_eq(anuenue_fail(STIK_ERR_IO, "test: io"),
      ANUENUE_EXIT_RUN, "IO → exit 1");
    assert_eq(anuenue_fail(STIK_ERR_RESOURCE_EXHAUSTED, "test: exhausted"),
      ANUENUE_EXIT_RUN, "RESOURCE_EXHAUSTED → exit 1");
    assert_eq(anuenue_fail(STIK_ERR_INTERNAL, "test: internal"),
      ANUENUE_EXIT_RUN, "INTERNAL → exit 1");
    # And the agnostik codes those kinds carry are the stable
    # machine-readable identity a consumer would key on.
    var obs_e_io = agnostik_err_new(STIK_ERR_IO, str_new("x", 1));
    assert_eq(AgnostikError_code(obs_e_io), CODE_IO, "IO error carries CODE_IO");
    var obs_e_ia = agnostik_err_new(STIK_ERR_INVALID_ARGUMENT, str_new("x", 1));
    assert_eq(AgnostikError_code(obs_e_ia), CODE_INVALID_ARGUMENT, "usage error carries CODE_INVALID_ARGUMENT");

    test_group("v1.2.1 observe — exit codes unchanged from v1.x contract");
    assert_eq(ANUENUE_EXIT_OK,    0, "exit OK    == 0");
    assert_eq(ANUENUE_EXIT_RUN,   1, "exit RUN   == 1");
    assert_eq(ANUENUE_EXIT_USAGE, 2, "exit USAGE == 2");

    # ---- v1.2.2 — P-1 audit regressions ---------------------------
    #
    # One group per finding in docs/audit/2026-08-25-audit.md. Each
    # asserts the FIXED behaviour, so a revert fails here rather than
    # in the field.
    return 0;
}

# v1.2.2 P(-1) audit regressions (A-01 / A-02 / A-04 / A-05). Returns 0.
fn test_v122_audit(): i64 {
    test_group("v1.2.2 A-01 — cp_is_extending survives a failed table alloc");
    # The table is lazily built on first use. Assert it initialises and
    # that the classifier answers correctly on both sides of a range
    # boundary — the binary search over the table is what the null
    # deref would have corrupted.
    assert_eq(_cp_ext_init(), 0, "_cp_ext_init succeeds and reports success");
    assert_eq(_CP_EXT_TABLE == 0, 0, "table pointer is non-null after init");
    assert_eq(_CP_EXT_COUNT, 21, "table records its range count");
    # Re-entry must be a no-op, not a second allocation.
    var aud_t1 = _CP_EXT_TABLE;
    assert_eq(_cp_ext_init(), 0, "second _cp_ext_init is a no-op");
    assert_eq(_CP_EXT_TABLE, aud_t1, "second init does not reallocate");
    # Range boundaries the search must get right.
    assert_eq(cp_is_extending(0x0300), 1, "0x0300 is extending (first range, lo)");
    assert_eq(cp_is_extending(0x02FF), 0, "0x02FF is not (one below first range)");
    assert_eq(cp_is_extending(0xE01EF), 1, "0xE01EF is extending (last range, hi)");
    assert_eq(cp_is_extending(0xE01F0), 0, "0xE01F0 is not (one above last range)");
    assert_eq(cp_is_extending(0x200D), 1, "ZWJ is extending");

    test_group("v1.2.2 A-02 — animation duration cannot overflow to the past");
    # deadline_ns = start_ns + dur * 1e9. At i64::MAX the product wraps
    # to exactly -1e9, so the deadline landed one second BEFORE the
    # start and `-a -d <huge>` exited after a single frame. The clamp
    # is what keeps the multiply in range.
    assert_eq(ANUENUE_MAX_DURATION_S > 0, 1, "clamp is positive");
    # The clamped value times 1e9 must still be a positive i64.
    var aud_ns = ANUENUE_MAX_DURATION_S * 1000000000;
    assert_eq(aud_ns > 0, 1, "clamp * 1e9 does not overflow to negative");
    assert_eq(aud_ns / 1000000000, ANUENUE_MAX_DURATION_S, "clamp * 1e9 round-trips (no wrap)");
    # And it leaves headroom for the clock reading added on top —
    # enough for an epoch-relative clock (~1.79e18 ns in 2026), not
    # merely the boot-relative one the stdlib returns today.
    assert_eq(aud_ns < 5000000000000000000, 1, "clamp * 1e9 stays under 5e18");
    assert_eq(9223372036854775807 - aud_ns > 5000000000000000000, 1,
      "clamp leaves >5e18 ns of headroom — safe under an epoch-based clock too");
    # The unclamped value is exactly the trap: prove the wrap is real
    # so nobody "simplifies" the clamp away.
    assert_eq(9223372036854775807 * 1000000000 < 0, 1,
      "i64::MAX * 1e9 really does wrap negative (the A-02 trap)");
    # A sane duration is untouched by the clamp.
    assert_eq(ANUENUE_DEFAULT_DURATION_S < ANUENUE_MAX_DURATION_S, 1,
      "the default duration is well inside the clamp");

    test_group("v1.2.2 A-04 — unknown --color value is rejected, not guessed");
    assert_eq(_color_override_from_str("auto"),      ANUENUE_COLOR_OVERRIDE_AUTO, "auto parses");
    assert_eq(_color_override_from_str("24bit"),     ANUENUE_COLOR_OVERRIDE_TRUE, "24bit parses");
    assert_eq(_color_override_from_str("truecolor"), ANUENUE_COLOR_OVERRIDE_TRUE, "truecolor parses");
    assert_eq(_color_override_from_str("256"),       ANUENUE_COLOR_OVERRIDE_256,  "256 parses");
    assert_eq(_color_override_from_str("16"),        ANUENUE_COLOR_OVERRIDE_16,   "16 parses");
    assert_eq(_color_override_from_str("none"),      ANUENUE_COLOR_OVERRIDE_NONE, "none parses");
    assert_eq(_color_override_from_str("off"),       ANUENUE_COLOR_OVERRIDE_NONE, "off parses");
    assert_eq(_color_override_from_str("never"),     ANUENUE_COLOR_OVERRIDE_NONE, "never parses");
    # A-09: documented since M6, implemented at v1.2.2.
    assert_eq(_color_override_from_str("mono"),      ANUENUE_COLOR_OVERRIDE_NONE, "mono parses (A-09)");
    # The regression itself: a typo used to silently mean "auto".
    assert_eq(_color_override_from_str("trucolor"),  ANUENUE_COLOR_OVERRIDE_BAD, "typo → BAD, not auto");
    assert_eq(_color_override_from_str("24BIT"),     ANUENUE_COLOR_OVERRIDE_BAD, "parse is case-sensitive");
    assert_eq(_color_override_from_str("yes"),       ANUENUE_COLOR_OVERRIDE_BAD, "unknown word → BAD");
    assert_eq(_color_override_from_str("-1"),        ANUENUE_COLOR_OVERRIDE_BAD, "numeric junk → BAD");
    # Absent / empty stay AUTO — that is "flag not given", not "bad value".
    assert_eq(_color_override_from_str(0),           ANUENUE_COLOR_OVERRIDE_AUTO, "null → AUTO (flag absent)");
    assert_eq(_color_override_from_str(""),          ANUENUE_COLOR_OVERRIDE_AUTO, "empty → AUTO (flag absent)");
    # BAD must be distinct from every real mode or the check in main
    # would collide with a legitimate value.
    assert_eq(ANUENUE_COLOR_OVERRIDE_BAD == ANUENUE_COLOR_OVERRIDE_AUTO, 0, "BAD != AUTO");
    assert_eq(ANUENUE_COLOR_OVERRIDE_BAD == ANUENUE_COLOR_OVERRIDE_NONE, 0, "BAD != NONE");

    test_group("v1.2.2 A-05 — the animation caps are real limits, stated once");
    # The caps drop input rather than merely leaving it uncoloured
    # (_pretag_clusters writes its sentinel at the byte offset where it
    # stopped). Pin both so a change to either is deliberate, and pin
    # the truncation-detection condition the warning uses.
    assert_eq(ANUENUE_ANIMATE_INPUT_MAX, 65536, "byte cap is 64 KB");
    assert_eq(ANUENUE_ANIMATE_CLUSTER_MAX, 8192, "cluster cap is 8192");
    # Feed exactly cap+1 clusters of ASCII and confirm the tag walk
    # stops AT the cap — this is the condition `n_clusters >= cap`
    # that triggers the warning.
    var aud_n = ANUENUE_ANIMATE_CLUSTER_MAX + 16;
    var aud_buf = alloc(aud_n);
    var aud_ct = alloc((ANUENUE_ANIMATE_CLUSTER_MAX + 1) * 8);
    assert_eq(aud_buf == 0, 0, "audit fixture buffer allocated");
    assert_eq(aud_ct == 0, 0, "audit fixture cluster table allocated");
    var aud_i = 0;
    while (aud_i < aud_n) { store8(aud_buf + aud_i, 97); aud_i = aud_i + 1; }
    var aud_c = _pretag_clusters(aud_buf, aud_n, aud_ct, ANUENUE_ANIMATE_CLUSTER_MAX);
    assert_eq(aud_c, ANUENUE_ANIMATE_CLUSTER_MAX, "tag walk stops exactly at the cluster cap");
    # The sentinel is the truncation point, NOT the input length — this
    # is why the tail is dropped rather than rendered in one colour.
    assert_eq(load64(aud_ct + aud_c * 8), ANUENUE_ANIMATE_CLUSTER_MAX,
      "sentinel is the stop offset, so bytes past it are dropped");
    assert_eq(load64(aud_ct + aud_c * 8) < aud_n, 1, "sentinel is short of the input length");

    # ---- v1.3.0 — animation slot ----------------------------------
    return 0;
}

# v1.3.0 animation slot: sliced frame wait, -i bounds, the exit mask. Returns 0.
fn test_v130_animation(): i64 {
    test_group("v1.3.0 B-02 — frame wait is sliced, not one long sleep");
    # sleep_ms is poll(NULL, 0, ms) on Linux/macOS and poll(2)'s timeout
    # is a 32-bit int, so a large millisecond count truncates. Measured:
    #   2147483648 -> -2^31 -> blocks forever
    #   4294967296 ->     0 -> returns instantly (busy loop)
    # The tick bounds every individual sleep_ms call well inside int32,
    # which is what keeps signal latency and deadline accuracy
    # independent of -i.
    assert_eq(ANUENUE_TICK_MS > 0, 1, "tick is positive (a 0 tick would spin)");
    assert_eq(ANUENUE_TICK_MS <= ANUENUE_FRAME_MS, 1, "tick does not exceed the default frame interval");
    assert_eq(ANUENUE_TICK_MS < 2147483647, 1, "tick is inside poll(2)'s int32 timeout");

    test_group("v1.3.0 -i / --interval bounds");
    # Set at v1.3.0 as a correctness bound: through cyrius 6.6.19 every
    # value at or below it had to survive sleep_ms's int32 truncation
    # unchanged. The stdlib clamps since 6.6.20 (architecture 005); the
    # bound stays as behaviour, and these pins keep it inside int32.
    assert_eq(ANUENUE_MAX_INTERVAL_MS > 0, 1, "interval clamp is positive");
    assert_eq(ANUENUE_MAX_INTERVAL_MS < 2147483647, 1, "clamp is inside int32 positive range");
    # Truncating the clamp to 32 bits must be a no-op — that is the
    # whole point of choosing it.
    assert_eq(ANUENUE_MAX_INTERVAL_MS % 4294967296, ANUENUE_MAX_INTERVAL_MS,
      "clamp survives a 32-bit truncation unchanged");
    # The two values that motivated the bound, as int32 arithmetic.
    assert_eq(4294967296 % 4294967296, 0, "2^32 ms truncates to 0 in an int32 (a busy loop through cyrius 6.6.19)");
    assert_eq(2147483648 > 2147483647, 1, "2^31 ms exceeds int32 max (negative = blocked forever through 6.6.19)");
    # The default must sit inside the clamp or the default is unusable.
    assert_eq(ANUENUE_FRAME_MS <= ANUENUE_MAX_INTERVAL_MS, 1, "default interval is within the clamp");
    assert_eq(ANUENUE_FRAME_MS > 0, 1, "default interval is positive");

    test_group("v1.3.0 B-01 — signal mask constant");
    # _open_exit_signalfd blocks exactly these three and, on a failed
    # signalfd(2), must unblock exactly these three. The rollback is
    # verified end-to-end (including mutation-proof) by
    # scripts/signal-check.sh via tests/probes/sigmask-probe.cyr —
    # it needs a forced fd exhaustion, which a unit test cannot do.
    # What is pinned here is the constant that both halves share.
    assert_eq(TTY_SIGMASK_EXIT, 16387, "exit sigmask is 0x4003 = HUP(1) | INT(2) | TERM(15)");
    assert_eq(TTY_SIGMASK_EXIT & 1, 1, "SIGHUP bit set");
    assert_eq(TTY_SIGMASK_EXIT & 2, 2, "SIGINT bit set");
    assert_eq(TTY_SIGMASK_EXIT & 16384, 16384, "SIGTERM bit set");

    # ---- v1.3.3 — P-1 sweep regressions ---------------------------
    return 0;
}

# v1.3.3 sweep: the escape cache keyed on mode (E-02), every escape fits its entry. Returns 0.
fn test_v133_escape_cache(): i64 {
    test_group("v1.3.3 E-02 — the escape cache is keyed on colour mode");
    # The table's CONTENTS are mode-specific, so a cache keyed only on
    # "has a table been built" hands back stale escapes after a mode
    # change. Rebuild per mode and assert the escape lengths differ —
    # measured maxima are 16-colour 5, 256 11, truecolor 17.
    ANUENUE_COLOR_MODE = ANUENUE_COLOR_16;
    assert_eq(_phase_esc_init(), 0, "init succeeds for 16-colour");
    var esc_16 = load64(_PHASE_ESC_TABLE + 100 * ANUENUE_ESC_TABLE_ENTRY_SIZE);
    ANUENUE_COLOR_MODE = ANUENUE_COLOR_256;
    assert_eq(_phase_esc_init(), 0, "init succeeds after switching to 256");
    var esc_256 = load64(_PHASE_ESC_TABLE + 100 * ANUENUE_ESC_TABLE_ENTRY_SIZE);
    ANUENUE_COLOR_MODE = ANUENUE_COLOR_TRUE;
    assert_eq(_phase_esc_init(), 0, "init succeeds after switching to truecolor");
    var esc_true = load64(_PHASE_ESC_TABLE + 100 * ANUENUE_ESC_TABLE_ENTRY_SIZE);
    # The regression: before the fix all three read identically, because
    # the second and third calls returned the first mode's table.
    assert_eq(esc_16 == esc_256, 0, "16-colour and 256 escapes differ in length");
    assert_eq(esc_256 == esc_true, 0, "256 and truecolor escapes differ in length");
    # Same mode twice must still be idempotent — that is the hot-path
    # property the M5 perf pass depends on.
    var tbl_before = _PHASE_ESC_TABLE;
    assert_eq(_phase_esc_init(), 0, "re-init in the same mode succeeds");
    assert_eq(_PHASE_ESC_TABLE, tbl_before, "re-init in the same mode does not reallocate");

    test_group("v1.3.3 E-02 — every escape fits its table entry");
    # The payload region is ENTRY_SIZE - 8 (the length prefix). An
    # escape longer than that would run into the next entry.
    var esc_budget = ANUENUE_ESC_TABLE_ENTRY_SIZE - 8;
    var esc_mode = ANUENUE_COLOR_16;
    while (esc_mode <= ANUENUE_COLOR_TRUE) {
        ANUENUE_COLOR_MODE = esc_mode;
        _phase_esc_init();
        # Scan every one of the 1 530 entries but assert on the
        # AGGREGATE — asserting per entry would add ~9 000 assertions
        # per run and make the suite total incomparable across cuts
        # without covering anything the min/max does not.
        var esc_i = 0;
        var esc_max = 0;
        var esc_min = ANUENUE_ESC_TABLE_ENTRY_SIZE;
        while (esc_i < ANUENUE_PHASE_MOD) {
            var esc_e = load64(_PHASE_ESC_TABLE + esc_i * ANUENUE_ESC_TABLE_ENTRY_SIZE);
            if (esc_e > esc_max) { esc_max = esc_e; }
            if (esc_e < esc_min) { esc_min = esc_e; }
            esc_i = esc_i + 1;
        }
        assert_eq(esc_min >= 0, 1, "no entry has a negative escape length");
        assert_eq(esc_max <= esc_budget, 1, "the longest escape fits the entry payload");
        # Non-empty for every real colour mode, or the rainbow is blank.
        assert_eq(esc_min > 0, 1, "every phase in this mode produces a non-empty escape");
        esc_mode = esc_mode + 1;
    }
    # Restore the module default so later groups are unaffected.
    ANUENUE_COLOR_MODE = ANUENUE_COLOR_TRUE;
    _phase_esc_init();
    return 0;
}

# v1.3.4: EPIPE is a pipeline end, not a failure (E-03). Returns 0.
fn test_v134_epipe(): i64 {
    test_group("v1.3.4 E-03 — EPIPE is a normal pipeline end, not a failure");
    # Two outcomes share anuenue_write_all's -1 return and they are not
    # the same event. EPIPE means the consumer closed the pipe
    # (`anuenue | head -1`); everything else means the stream was lost.
    #
    # This distinction is only observable when SIGPIPE is IGNORED —
    # under the default disposition the kernel kills the process before
    # write(2) returns and the branch never runs. That is why the
    # v1.3.3 gate passed locally and failed in CI; the process-level
    # coverage lives in scripts/robustness-check.sh, which now runs
    # both dispositions. What is pinned here is the dispatch itself.
    ANUENUE_STDOUT_EPIPE = 0;
    assert_eq(anuenue_write_failed(), ANUENUE_EXIT_RUN,
      "a real write failure exits 1");
    ANUENUE_STDOUT_EPIPE = 1;
    assert_eq(anuenue_write_failed(), ANUENUE_EXIT_OK,
      "EPIPE exits 0 — the downstream is done, nothing is wrong");
    # The flag must be a clean two-state; anything else and the
    # dispatch above silently picks the error branch.
    assert_eq(ANUENUE_STDOUT_EPIPE, 1, "the EPIPE flag holds its value");
    ANUENUE_STDOUT_EPIPE = 0;
    assert_eq(anuenue_write_failed(), ANUENUE_EXIT_RUN,
      "clearing the flag restores the error path");

    # ---- v1.4.0 — darshana 1.3.0 ------------------------------------
    return 0;
}

# v1.4.0: the exit signalfd through darshana. Returns 0.
fn test_v140_signalfd(): i64 {
    test_group("v1.4.0 — the exit signalfd is darshana's, and gives back what it took");
    # The darshana consumer survey (2026-10-12) found two defects in the
    # hand-rolled v1.3.6 open, both reproduced against that code before
    # the swap: no CLOEXEC on the fd, and a failure rollback that
    # unblocked the WHOLE mask. The forced-failure half needs an fd limit
    # and lives in scripts/signal-check.sh (tests/probes/sigmask-probe.cyr);
    # this group drives the success path in-process, where the fd's flags
    # and the mask can be read back.
    #
    # ⚠ Two assertions below send this process real signals while they
    # are blocked. If the teardown failed to drain them, its unblock would
    # deliver one with its default action and KILL this test run — a loud
    # failure, which is the point.
    assert_eq(_signal_pending(0 - 1), 0, "the -1 fallback fd never reports a signal");
    assert_eq(_close_exit_signalfd(0 - 1), 0, "closing the -1 fallback fd is a no-op");
    var sfd_before = _sig_blocked_now() & TTY_SIGMASK_EXIT;
    var sfd = _open_exit_signalfd();
    assert_eq(sfd >= 0, 1, "the exit signalfd opens");
    assert_eq(sys_fcntl(sfd, F_GETFD, 0) & FD_CLOEXEC, FD_CLOEXEC,
      "the exit signalfd is close-on-exec (v1.3.6 passed SFD_NONBLOCK alone)");
    assert_eq((sys_fcntl(sfd, F_GETFL, 0) & SFD_NONBLOCK) != 0, 1,
      "the exit signalfd is non-blocking, so _signal_pending probes and never waits");
    assert_eq(_sig_blocked_now() & TTY_SIGMASK_EXIT, TTY_SIGMASK_EXIT,
      "HUP|INT|TERM are blocked while the fd is open");
    assert_eq(_ANUENUE_SIG_ADDED, TTY_SIGMASK_EXIT & ~sfd_before,
      "the open records exactly the bits it added");
    assert_eq(_signal_pending(sfd), 0, "nothing pending reads as 0, at once");
    sys_kill(sys_getpid(), SIGINT);
    assert_eq(_signal_pending(sfd), 1, "a pending SIGINT is reported");
    assert_eq(_signal_pending(sfd), 0, "and consumed by the probe");
    # Two pending at teardown: the frame loop would have read one of them
    # and stopped; the close must drain the other before it unblocks.
    sys_kill(sys_getpid(), SIGINT);
    sys_kill(sys_getpid(), SIGTERM);
    assert_eq(_close_exit_signalfd(sfd), 0, "the teardown drains, closes and unblocks — and this process survives it");
    assert_eq(_sig_blocked_now() & TTY_SIGMASK_EXIT, sfd_before,
      "the mask is back to what it was before the open");
    assert_eq(sys_fcntl(sfd, F_GETFD, 0) < 0, 1, "the fd is closed");
    assert_eq(_ANUENUE_SIG_ADDED, 0, "the close forgets what it unblocked");
    # A signal blocked BEFORE the open is not anuenue's to unblock — the
    # shape a parent with a live signalfd of its own hands a child.
    var sfd_hup[8];
    store64(&sfd_hup, 1);                    # SIGHUP = bit 0 of a Linux sigset_t
    sys_sigprocmask(SIG_BLOCK, &sfd_hup, 0);
    var sfd2 = _open_exit_signalfd();
    assert_eq(sfd2 >= 0, 1, "opens with SIGHUP already blocked");
    assert_eq(_ANUENUE_SIG_ADDED & 1, 0, "a pre-blocked SIGHUP is not counted as added");
    assert_eq(_close_exit_signalfd(sfd2), 0, "closes");
    assert_eq(_sig_blocked_now() & 1, 1, "SIGHUP is still blocked after the close");
    assert_eq(_sig_blocked_now() & TTY_SIGMASK_EXIT, sfd_before | 1,
      "and INT/TERM are back to their state before the open");
    if ((sfd_before & 1) == 0) { sys_sigprocmask(SIG_UNBLOCK, &sfd_hup, 0); }
    return 0;
}

# v1.4.1: cmdit 1.4.0's parse failures as main.cyr routes them. Returns 0.
fn test_v141_cmdit(): i64 {
    test_group("v1.4.1 — cmdit 1.4.0's parse failures, as main.cyr routes them");
    # A boolean given a value is an error, not ON. cmdit 1.2.4 stored 1 and
    # ignored the value, so `--no-color=0` disabled colour.
    var c141_fs = cmdit_new("anuenue");
    var c141_nc = cmdit_bool(c141_fs, 110, "no-color", "n");
    var c141_argv[16];
    store64(&c141_argv + 0, "anuenue");
    store64(&c141_argv + 8, "--no-color=0");
    assert_eq(cmdit_parse_argv(c141_fs, 2, &c141_argv), CMDIT_RESULT_ERR,
      "--no-color=0 is a parse error");
    assert_eq(cmdit_error(c141_fs), CMDIT_ERR_UNEXPECTED_VALUE,
      "--no-color=0 is UNEXPECTED_VALUE");
    assert_eq(cmdit_get_bool(c141_fs, c141_nc), 0, "and the flag is not set");
    # The NOMEM branch rests on cmdit's 0-handle contract: cmdit_new's OOM is
    # a 0 handle, which 1.2.4 dereferenced and 1.4.0 fails closed on. No
    # external limit reaches it (see main.cyr), so this pins the contract.
    assert_eq(cmdit_parse(0), CMDIT_RESULT_ERR, "cmdit_parse(0) fails closed");
    assert_eq(cmdit_error(0), CMDIT_ERR_NOMEM, "and cmdit_error(0) is NOMEM");
    # main.cyr names these codes by value; cmdit's taxonomy is append-only, so
    # a renumbering would be a cmdit major — and should fail here first.
    assert_eq(CMDIT_ERR_UNEXPECTED_VALUE, 11, "UNEXPECTED_VALUE == 11");
    assert_eq(CMDIT_ERR_NOMEM, 12, "NOMEM == 12");
    assert_eq(CMDIT_ERR_ARGV, 13, "ARGV == 13");
    return 0;
}

# v1.4.2: argv tokens echoed in diagnostics, bounded and sanitized. Returns 0.
fn test_v142_argv_echo(): i64 {
    test_group("v1.4.2 — argv tokens echoed in diagnostics are bounded and sanitized");
    assert_eq(ANUENUE_ERR_ARG_MAX, 64, "the cap matches anuenue_eprint_arg's 64-byte buffer");
    assert_eq(anuenue_arg_cut("--bogus", 7), 7, "a short token is echoed whole");
    # 100 x 'x': cut at the cap.
    var e142_long[104];
    var e142_i = 0;
    while (e142_i < 100) { store8(&e142_long + e142_i, 120); e142_i = e142_i + 1; }
    store8(&e142_long + 100, 0);
    assert_eq(anuenue_arg_cut(&e142_long, 100), 64, "a long ASCII token is cut at the cap");
    var e142_out[64];
    assert_eq(anuenue_arg_render(&e142_long, &e142_out), 64, "and renders exactly the cap");
    # 63 x 'x' + U+00E9 (C3 A9 at bytes 63-64): the cap falls inside it.
    store8(&e142_long + 63, 0xC3);
    store8(&e142_long + 64, 0xA9);
    assert_eq(anuenue_arg_cut(&e142_long, 100), 63, "the cut steps back over a split 2-byte char");
    # 62 x 'x' + U+20AC (E2 82 AC at bytes 62-64).
    store8(&e142_long + 62, 0xE2);
    store8(&e142_long + 63, 0x82);
    store8(&e142_long + 64, 0xAC);
    assert_eq(anuenue_arg_cut(&e142_long, 100), 62, "and over a split 3-byte char");
    # Bytes 61-64 all continuation bytes (malformed): at most three steps back.
    store8(&e142_long + 61, 0x80);
    store8(&e142_long + 62, 0x80);
    store8(&e142_long + 63, 0x80);
    store8(&e142_long + 64, 0x80);
    assert_eq(anuenue_arg_cut(&e142_long, 100), 61, "malformed input stops after three steps");
    # Controls: "a" ESC "[31m" BEL LF C1(C2 9B) "b" -> each control one '?'.
    var e142_ctl[16];
    store8(&e142_ctl + 0, 97);
    store8(&e142_ctl + 1, 27);
    store8(&e142_ctl + 2, 91);
    store8(&e142_ctl + 3, 51);
    store8(&e142_ctl + 4, 49);
    store8(&e142_ctl + 5, 109);
    store8(&e142_ctl + 6, 7);
    store8(&e142_ctl + 7, 10);
    store8(&e142_ctl + 8, 0xC2);
    store8(&e142_ctl + 9, 0x9B);
    store8(&e142_ctl + 10, 98);
    store8(&e142_ctl + 11, 0);
    var e142_n = anuenue_arg_render(&e142_ctl, &e142_out);
    assert_eq(e142_n, 10, "11 bytes in, 10 out: the 2-byte C1 control is one '?'");
    assert_eq(load8(&e142_out + 1), 63, "ESC becomes '?'");
    assert_eq(load8(&e142_out + 2), 91, "and the rest of the sequence is inert text");
    assert_eq(load8(&e142_out + 6), 63, "BEL becomes '?'");
    assert_eq(load8(&e142_out + 7), 63, "LF becomes '?' — a token cannot break the line");
    assert_eq(load8(&e142_out + 8), 63, "C1 CSI (C2 9B) becomes one '?'");
    assert_eq(load8(&e142_out + 9), 98, "text after the controls is kept");
    assert_eq(anuenue_arg_render(0, &e142_out), 0, "a 0 token renders nothing");
    assert_eq(anuenue_arg_attached("--freq=abc"), 1, "--freq=abc carries its value");
    assert_eq(anuenue_arg_attached("--animate="), 1, "--animate= carries an empty value");
    assert_eq(anuenue_arg_attached("-p"), 0, "-p does not");
    assert_eq(anuenue_arg_attached(0), 0, "a 0 token does not");
    return 0;
}

# Fill `buf` with `n` copies of byte `b` starting at `at`. Returns at + n.
fn _t_fill(buf, at, n, b): i64 {
    var k = 0;
    while (k < n) { store8(buf + at + k, b); k = k + 1; }
    return at + n;
}

# Pretag `n` bytes of `buf` into `ctab` and return _block_rows at `cols`.
fn _t_rows(buf, n, ctab, cols): i64 {
    var nc = _pretag_clusters(buf, n, ctab, 4096);
    return _block_rows(buf, ctab, nc, cols);
}

# v1.4.4 — H-01: animation climbs PHYSICAL rows (display width, wrapped
# at the terminal's columns), and the practical-subset width table behind
# it (ADR 0005). Returns 0.
fn test_v144_rows(): i64 {
    test_group("v1.4.4 H-01 — display columns of a cluster's base codepoint");
    assert_eq(anuenue_cp_cols(0x41), 1, "ASCII is 1 column");
    assert_eq(anuenue_cp_cols(0xE9), 1, "Latin-1 e-acute is 1");
    assert_eq(anuenue_cp_cols(0x4E2D), 2, "CJK ideograph is 2");
    assert_eq(anuenue_cp_cols(0x3042), 2, "Hiragana is 2");
    assert_eq(anuenue_cp_cols(0xAC00), 2, "Hangul syllable is 2");
    assert_eq(anuenue_cp_cols(0xFF21), 2, "fullwidth Latin is 2");
    assert_eq(anuenue_cp_cols(0x1F308), 2, "emoji pictograph is 2");
    assert_eq(anuenue_cp_cols(0x1F1EF), 2, "regional indicator is 2");
    assert_eq(anuenue_cp_cols(0x2603), 1, "text-presentation symbol stays 1");
    # The review's list: UAX #11 W in the BMP symbol blocks, which v1.4.4's
    # first, hand-written table called 1.
    assert_eq(anuenue_cp_cols(0x2705), 2, "U+2705 white heavy check mark is 2");
    assert_eq(anuenue_cp_cols(0x2728), 2, "U+2728 sparkles is 2");
    assert_eq(anuenue_cp_cols(0x26A1), 2, "U+26A1 high voltage is 2");
    assert_eq(anuenue_cp_cols(0x2B50), 2, "U+2B50 star is 2");
    assert_eq(anuenue_cp_cols(0x274C), 2, "U+274C cross mark is 2");
    assert_eq(anuenue_cp_cols(0x2615), 2, "U+2615 hot beverage is 2");
    assert_eq(anuenue_cp_cols(0x1F004), 2, "U+1F004 mahjong tile is 2");
    assert_eq(anuenue_cp_cols(0x1F321), 1, "U+1F321 thermometer is UAX #11 neutral: 1");
    assert_eq(anuenue_cp_cols(0x20000), 2, "CJK Extension B is 2");
    assert_eq(anuenue_cp_cols(0x10FFFF), 1, "the last codepoint is 1");
    assert_eq(anuenue_cp_cols(0x115F), 2, "range edge: U+115F inside");
    assert_eq(anuenue_cp_cols(0x1160), 1, "range edge: U+1160 outside");
    assert_eq(anuenue_cp_cols(0x303E), 2, "range edge: U+303E inside");
    assert_eq(anuenue_cp_cols(0x303F), 1, "range edge: U+303F outside");

    test_group("v1.4.4 H-01 — rows the renderer climbs, per terminal width");
    var rb = alloc(1024);
    var rt = alloc(4097 * 8);
    var n = 0;
    # "abc\n"
    n = _t_fill(rb, 0, 3, 97); store8(rb + n, 10); n = n + 1;
    assert_eq(_t_rows(rb, n, rt, 80), 1, "one short line: 1 row");
    assert_eq(_t_rows(rb, n, rt, 0), 1, "unknown width: the LF count");
    # 80 x + LF: exactly fills 80 columns — pending-wrap, still 1 row
    n = _t_fill(rb, 0, 80, 120); store8(rb + n, 10); n = n + 1;
    assert_eq(_t_rows(rb, n, rt, 80), 1, "a line of exactly 80 at 80 columns is 1 row");
    # 81 x + LF
    n = _t_fill(rb, 0, 81, 120); store8(rb + n, 10); n = n + 1;
    assert_eq(_t_rows(rb, n, rt, 80), 2, "81 columns wraps to 2 rows");
    assert_eq(_t_rows(rb, n, rt, 0), 1, "unknown width: still the LF count");
    # then "ab\n": 2 + 1
    store8(rb + n, 97); store8(rb + n + 1, 98); store8(rb + n + 2, 10); n = n + 3;
    assert_eq(_t_rows(rb, n, rt, 80), 3, "wrapped line + short line: 3 rows");
    # 100 x, no LF, at 40 columns: 3 rows, climb 2 (the CR stays on the last)
    n = _t_fill(rb, 0, 100, 120);
    assert_eq(_t_rows(rb, n, rt, 40), 2, "partial line over 3 rows climbs 2");
    n = _t_fill(rb, 0, 2, 97);
    assert_eq(_t_rows(rb, n, rt, 40), 0, "short partial line climbs 0");
    # 40 x U+4E2D (E4 B8 AD) + LF: 80 columns
    var ci = 0;
    n = 0;
    while (ci < 40) {
        store8(rb + n, 0xE4); store8(rb + n + 1, 0xB8); store8(rb + n + 2, 0xAD);
        n = n + 3;
        ci = ci + 1;
    }
    store8(rb + n, 10); n = n + 1;
    assert_eq(_t_rows(rb, n, rt, 80), 1, "40 wide ideographs fill 80 columns: 1 row");
    assert_eq(_t_rows(rb, n, rt, 79), 2, "at 79 the 40th cannot fit the last column: 2 rows");
    # ESC [31m + 80 x + ESC [0m + LF: the escapes take no columns
    n = 0;
    store8(rb + 0, 27); store8(rb + 1, 91); store8(rb + 2, 51); store8(rb + 3, 49); store8(rb + 4, 109);
    n = _t_fill(rb, 5, 80, 120);
    store8(rb + n, 27); store8(rb + n + 1, 91); store8(rb + n + 2, 48); store8(rb + n + 3, 109);
    store8(rb + n + 4, 10); n = n + 5;
    # The renderer's own escape cancels each input ESC, so "[31m" and
    # "[0m" print: 4 + 80 + 3 = 87 columns.
    assert_eq(_t_rows(rb, n, rt, 80), 2, "an input CSI's parameters print: 87 columns, 2 rows");
    # OSC 0;title BEL + 80 x + LF
    store8(rb + 0, 27); store8(rb + 1, 93); store8(rb + 2, 48); store8(rb + 3, 59);
    n = _t_fill(rb, 4, 30, 116);
    store8(rb + n, 7); n = n + 1;
    n = _t_fill(rb, n, 80, 120);
    store8(rb + n, 10); n = n + 1;
    # "]0;" + 30 + 80 = 113 printing columns (the BEL takes none).
    assert_eq(_t_rows(rb, n, rt, 80), 2, "an input OSC's body prints: 113 columns, 2 rows");
    # An ESC with nothing after it on the line must not swallow the LF —
    # v1.4.4's first cut lost every LF inside an unterminated sequence.
    store8(rb + 0, 97); store8(rb + 1, 27); store8(rb + 2, 10);
    store8(rb + 3, 98); store8(rb + 4, 27); store8(rb + 5, 10);
    assert_eq(_t_rows(rb, 6, rt, 80), 2, "a bare ESC before an LF still ends the line");
    store8(rb + 0, 27); store8(rb + 1, 93); store8(rb + 2, 48); store8(rb + 3, 59); store8(rb + 4, 10);
    store8(rb + 5, 120); store8(rb + 6, 10);
    assert_eq(_t_rows(rb, 7, rt, 80), 2, "an unterminated OSC does not swallow the LFs after it");
    # 12 TABs + LF: tabs stop at the last column, they do not wrap
    n = _t_fill(rb, 0, 12, 9); store8(rb + n, 10); n = n + 1;
    assert_eq(_t_rows(rb, n, rt, 80), 1, "TABs clamp at the last column: 1 row");
    # 80 x (e + U+0301): combining marks take no columns
    n = 0;
    ci = 0;
    while (ci < 80) {
        store8(rb + n, 101); store8(rb + n + 1, 0xCC); store8(rb + n + 2, 0x81);
        n = n + 3;
        ci = ci + 1;
    }
    store8(rb + n, 10); n = n + 1;
    assert_eq(_t_rows(rb, n, rt, 80), 1, "80 e-plus-combining clusters are 80 columns: 1 row");
    # CR mid-line returns to column 0: 60 x CR 60 x LF is 60 columns wide
    n = _t_fill(rb, 0, 60, 120); store8(rb + n, 13); n = n + 1;
    n = _t_fill(rb, n, 60, 120); store8(rb + n, 10); n = n + 1;
    assert_eq(_t_rows(rb, n, rt, 80), 1, "a CR mid-line returns to column 0");

    test_group("v1.4.4 H-05 — an extender with nothing to extend is its own cluster");
    # "a" LF U+0301 "b" LF: through v1.4.3 the U+0301 folded into the LF's
    # cluster, which renders as reset + LF only, and was dropped.
    store8(rb + 0, 97); store8(rb + 1, 10); store8(rb + 2, 0xCC); store8(rb + 3, 0x81);
    store8(rb + 4, 98); store8(rb + 5, 10);
    var h5n = _pretag_clusters(rb, 6, rt, 4096);
    assert_eq(h5n, 5, "a, LF, U+0301, b, LF: 5 clusters");
    assert_eq(load64(rt + 1 * 8), 1, "the LF cluster starts at byte 1");
    assert_eq(load64(rt + 2 * 8), 2, "and ends there: U+0301 opens cluster 2");
    # U+0301 "a" "b" LF: through v1.4.3 no cluster opened for the leading
    # mark, so rendering started at byte 2.
    store8(rb + 0, 0xCC); store8(rb + 1, 0x81); store8(rb + 2, 97); store8(rb + 3, 98);
    store8(rb + 4, 10);
    h5n = _pretag_clusters(rb, 5, rt, 4096);
    assert_eq(load64(rt), 0, "a leading extender is tagged: rendering starts at byte 0");
    assert_eq(h5n, 4, "U+0301, a, b, LF: 4 clusters");
    # An extender after a real base still folds into it.
    store8(rb + 0, 101); store8(rb + 1, 0xCC); store8(rb + 2, 0x81); store8(rb + 3, 10);
    assert_eq(_pretag_clusters(rb, 4, rt, 4096), 2, "e + U+0301 is still one cluster");
    return 0;
}

# Copy cstr `src` into `buf`, strip it with `final`, and return 1 when the
# result is exactly cstr `want` (and the held tail is `held`).
fn _t_sgr(buf, src, final, want, held): i64 {
    var n = strlen(src);
    var k = 0;
    while (k < n) { store8(buf + k, load8(src + k)); k = k + 1; }
    var hv[8];
    var m = anuenue_sgr_strip(buf, n, final, &hv);
    if (load64(&hv) != held) { return 0; }
    if (m != strlen(want)) { return 0; }
    k = 0;
    while (k < m) {
        if (load8(buf + k) != load8(want + k)) { return 0; }
        k = k + 1;
    }
    return 1;
}

# v1.4.5 — the input's colour codes are stripped on the colour routes
# (audit H-06). Returns 0.
fn test_v145_sgr(): i64 {
    test_group("v1.4.5 — input SGR colour codes are stripped, nothing else");
    var sb = alloc(512);
    assert_eq(_t_sgr(sb, "\x1b[31mred\x1b[0m", 1, "red", 0), 1, "a colour and a reset are stripped");
    assert_eq(_t_sgr(sb, "a\x1b[mb", 1, "ab", 0), 1, "ESC [ m (no parameters) is an SGR");
    assert_eq(_t_sgr(sb, "\x1b[01;34mdir", 1, "dir", 0), 1, "ls --color's bold-blue is stripped");
    assert_eq(_t_sgr(sb, "\x1b[38;2;255;0;10mX", 1, "X", 0), 1, "a truecolor SGR is stripped");
    assert_eq(_t_sgr(sb, "\x1b[38:2::255:0:10mX", 1, "X", 0), 1, "colon sub-parameters are SGR too");
    assert_eq(_t_sgr(sb, "no escapes at all", 1, "no escapes at all", 0), 1, "text without ESC is untouched");
    assert_eq(_t_sgr(sb, "\x1b[2Jx", 1, "\x1b[2Jx", 0), 1, "a non-SGR CSI (ED) passes");
    assert_eq(_t_sgr(sb, "\x1b[?25lx", 1, "\x1b[?25lx", 0), 1, "a private-mode CSI passes");
    assert_eq(_t_sgr(sb, "\x1b[>4;1mx", 1, "\x1b[>4;1mx", 0), 1, "ESC [ > ... m is not SGR (modifyOtherKeys)");
    assert_eq(_t_sgr(sb, "\x1b]0;t\x07x", 1, "\x1b]0;t\x07x", 0), 1, "an OSC passes");
    assert_eq(_t_sgr(sb, "a\x1b", 1, "a\x1b", 0), 1, "a lone ESC at the end of the input is kept (final)");
    assert_eq(_t_sgr(sb, "a\x1b[31", 1, "a\x1b[31", 0), 1, "an unfinished SGR at the end of the input is kept (final)");
    assert_eq(_t_sgr(sb, "a\x1b[31\nb", 1, "a\x1b[31\nb", 0), 1, "a broken SGR (LF inside) is kept");
    # Not final: an SGR still open at the end is held for the next read.
    assert_eq(_t_sgr(sb, "ab\x1b[3", 0, "ab", 3), 1, "an open SGR at a chunk end is held (ESC [ 3: 3 bytes)");
    assert_eq(load8(sb + 2), 27, "the held bytes sit just after the decided ones");
    assert_eq(_t_sgr(sb, "ab\x1b", 0, "ab", 1), 1, "a lone ESC at a chunk end is held");
    assert_eq(_t_sgr(sb, "ab\x1b[2J", 0, "ab\x1b[2J", 0), 1, "a decided non-SGR is not held");
    # The bound: 2 + 126 digits + 'm' is 129 bytes, one over ANUENUE_SGR_MAX.
    sb = alloc(512);
    var bk = 0;
    store8(sb, 27); store8(sb + 1, 91);
    while (bk < 126) { store8(sb + 2 + bk, 49); bk = bk + 1; }
    store8(sb + 128, 109);
    var bh[8];
    assert_eq(anuenue_sgr_strip(sb, 129, 1, &bh), 129, "a 129-byte SGR is over the bound: kept");
    store8(sb + 127, 109);
    assert_eq(anuenue_sgr_strip(sb, 128, 1, &bh), 0, "a 128-byte SGR is within it: stripped");
    store8(sb, 27); store8(sb + 1, 91);
    bk = 0;
    while (bk < 300) { store8(sb + 2 + bk, 49); bk = bk + 1; }
    assert_eq(anuenue_sgr_strip(sb, 302, 0, &bh), 302, "300 digits after ESC [ are never held");
    assert_eq(load64(&bh), 0, "and nothing is held for them");
    assert_eq(ANUENUE_SGR_MAX, 128, "the bound is 128 bytes, ESC through m");
    return 0;
}

# Copy cstr `src` into `buf` and return its length.
fn _t_put(buf, src): i64 {
    var n = strlen(src);
    var k = 0;
    while (k < n) { store8(buf + k, load8(src + k)); k = k + 1; }
    return n;
}

# 1 when `buf[0, n)` is exactly cstr `want`.
fn _t_is(buf, n, want): i64 {
    if (n != strlen(want)) { return 0; }
    var k = 0;
    while (k < n) {
        if (load8(buf + k) != load8(want + k)) { return 0; }
        k = k + 1;
    }
    return 1;
}

# v1.5.0 — producer-side no-colour spans, the APC marker pair (ADR 0006).
# Returns 0.
fn test_v150_markers(): i64 {
    test_group("v1.5.0 — the no-colour markers are recognised exactly");
    var mb = alloc(512);
    var n = _t_put(mb, "\x1b_anuenue:off\x1b\\x");
    assert_eq(_marker_at(mb, 0, n), ANUENUE_MK_OFF, "ESC _ anuenue:off ESC \\ is the off marker");
    n = _t_put(mb, "\x1b_anuenue:on\x1b\\x");
    assert_eq(_marker_at(mb, 0, n), ANUENUE_MK_ON, "ESC _ anuenue:on ESC \\ is the on marker");
    assert_eq(ANUENUE_MK_OFF_LEN, 15, "off is 15 bytes");
    assert_eq(ANUENUE_MK_ON_LEN, 14, "on is 14 bytes");
    n = _t_put(mb, "\x1b_anuenue:OFF\x1b\\");
    assert_eq(_marker_at(mb, 0, n), ANUENUE_MK_NONE, "upper case is not a marker");
    n = _t_put(mb, "\x1b_anuenue:off\x07");
    assert_eq(_marker_at(mb, 0, n), ANUENUE_MK_NONE, "a BEL terminator is not a marker (ST only)");
    n = _t_put(mb, "\x1b_Gf=100\x1b\\");
    assert_eq(_marker_at(mb, 0, n), ANUENUE_MK_NONE, "another application's APC (kitty graphics) is not");
    n = _t_put(mb, "\x1b[31m");
    assert_eq(_marker_at(mb, 0, n), ANUENUE_MK_NONE, "an SGR is not a marker");
    n = _t_put(mb, "\x1b_anuenue:o");
    assert_eq(_marker_at(mb, 0, n), 0 - 1, "a common prefix cut off is undecided");
    n = _t_put(mb, "\x1b");
    assert_eq(_marker_at(mb, 0, n), 0 - 1, "a lone ESC at the end is undecided");
    n = _t_put(mb, "\x1b_anuenue:of");
    assert_eq(_marker_at(mb, 0, n), 0 - 1, "an off prefix cut off is undecided");

    test_group("v1.5.0 — MONO consumes markers and keeps every other byte");
    n = _t_put(mb, "a\x1b_anuenue:off\x1b\\L\x1b[31mR\x1b_anuenue:on\x1b\\b\x1b_G\x1b\\");
    var hv[8];
    var w = anuenue_marker_strip(mb, n, 1, &hv);
    assert_eq(_t_is(mb, w, "aL\x1b[31mRb\x1b_G\x1b\\"), 1, "markers gone; colour codes and other APCs kept");
    n = _t_put(mb, "ab\x1b_anuenue:o");
    w = anuenue_marker_strip(mb, n, 0, &hv);
    assert_eq(w, 2, "an unfinished marker at a chunk end is held");
    assert_eq(load64(&hv), 11, "11 bytes held (ESC _ anuenue : o)");
    n = _t_put(mb, "ab\x1b_anuenue:o");
    w = anuenue_marker_strip(mb, n, 1, &hv);
    assert_eq(w, n, "at the end of the input it is ordinary bytes");

    test_group("v1.5.0 — animation's prepare pass: spans keep their colour codes");
    var sm = alloc(512);
    n = _t_put(mb, "\x1b[1ma\x1b_anuenue:off\x1b\\\x1b[31mR\x1b_anuenue:on\x1b\\\x1b[2mb");
    w = _anim_prepare(mb, n, sm);
    assert_eq(_t_is(mb, w, "a\x1b[31mRb"), 1, "SGR outside a span stripped, inside kept, markers gone");
    assert_eq(load8(sm + 0), 0, "a: outside the span");
    assert_eq(load8(sm + 1), 2, "the span's ESC: inside, and its first byte");
    assert_eq(load8(sm + 2), 1, "the next: inside");
    assert_eq(load8(sm + 6), 1, "R: inside");
    assert_eq(load8(sm + 7), 0, "b: outside again");
    n = _t_put(mb, "x\x1b_anuenue:off\x1b\\yz");
    w = _anim_prepare(mb, n, sm);
    assert_eq(_t_is(mb, w, "xyz"), 1, "an off with no on runs to the end");
    assert_eq(load8(sm + 2), 1, "z: still inside");

    test_group("v1.5.0 — span bytes are raw clusters, split at LF, closed to extenders");
    var ct = alloc(64 * 8);
    var cf = alloc(64);
    # "a" + span("XY" LF "Z") + U+0301 "b"
    n = _t_put(mb, "a\x1b_anuenue:off\x1b\\XY\nZ\x1b_anuenue:on\x1b\\\xcc\x81b");
    w = _anim_prepare(mb, n, sm);
    var nc = _pretag_spans(mb, w, ct, 64, sm, cf);
    assert_eq(nc, 6, "a | XY | LF | Z | U+0301 | b — six clusters");
    assert_eq(load8(cf + 0), 0, "a is ordinary");
    assert_eq(load8(cf + 1), ANUENUE_CF_RAW + ANUENUE_CF_OPEN, "XY is one raw cluster, and opens the span");
    assert_eq(load64(ct + 2 * 8) - load64(ct + 1 * 8), 2, "of two bytes");
    assert_eq(load8(cf + 2), ANUENUE_CF_RAW, "the LF inside the span is a raw cluster of its own");
    assert_eq(load8(cf + 3), ANUENUE_CF_RAW, "Z is a raw cluster");
    assert_eq(load8(cf + 4), ANUENUE_CF_JOIN + ANUENUE_CF_CONT,
      "an extender after a span continues the cluster before it");
    assert_eq(load8(cf + 5), 0, "b is ordinary");

    test_group("v1.5.0 — the row count inside a span: the producer's escapes are intact");
    # span(ESC[31m + 80 x + ESC[0m) LF at 80 columns: the codes reach the
    # terminal intact, so the line is 80 columns, one row.
    n = 0;
    store8(mb, 27); store8(mb + 1, 95);
    n = _t_put(mb, "\x1b_anuenue:off\x1b\\\x1b[31m");
    var xk = 0;
    while (xk < 80) { store8(mb + n + xk, 120); xk = xk + 1; }
    n = n + 80;
    store8(mb + n, 27); store8(mb + n + 1, 91); store8(mb + n + 2, 48); store8(mb + n + 3, 109);
    store8(mb + n + 4, 10);
    n = n + 5;
    w = _anim_prepare(mb, n, sm);
    nc = _pretag_spans(mb, w, ct, 64, sm, cf);
    assert_eq(_block_rows_f(mb, ct, cf, nc, 80), 1, "escapes inside a span take no columns: 1 row");
    assert_eq(_block_rows_f(mb, ct, cf, nc, 79), 2, "and 80 printing columns wrap at 79");
    # The same bytes clustered as ordinary text: anuenue's escape cancels
    # each ESC, so the codes' parameters print — 4 + 80 + 3 columns.
    var ct2 = alloc(256 * 8);
    var nc2 = _pretag_clusters(mb, w, ct2, 256);
    assert_eq(_block_rows(mb, ct2, nc2, 80), 2, "outside a span the parameters count: 2 rows");
    return 0;
}

# OFF + pre + `xs` x's + post + ON + LF into `buf`; returns the length.
fn _t_span(buf, pre, xs, post): i64 {
    var n = _t_put(buf, "\x1b_anuenue:off\x1b\\");
    n = n + _t_put(buf + n, pre);
    var k = 0;
    while (k < xs) { store8(buf + n + k, 120); k = k + 1; }
    n = n + xs;
    n = n + _t_put(buf + n, post);
    n = n + _t_put(buf + n, "\x1b_anuenue:on\x1b\\\n");
    return n;
}

# Rows climbed for `n` bytes of `buf` as animation would tag them.
fn _t_span_rows(buf, n, sm, ct, cf, cols): i64 {
    var w = _anim_prepare(buf, n, sm);
    var nc = _pretag_spans(buf, w, ct, 256, sm, cf);
    return _block_rows_f(buf, ct, cf, nc, cols);
}

# v1.5.0 review (V-07 to V-10): animation agrees with the filter at span
# edges — an extender after a span, an empty span, a UTF-8 sequence a span
# cuts — and the escape parser's intermediates.
fn test_v150_review(): i64 {
    var mb = alloc(512);
    var sm = alloc(512);
    var ct = alloc(257 * 8);
    var cf = alloc(257);

    test_group("v1.5.0 V-07 — an extender after a span continues the cluster before it");
    # e span(x) U+0301 b: the mark is CONT (no phase step, no columns).
    var n = _t_put(mb, "e\x1b_anuenue:off\x1b\\x\x1b_anuenue:on\x1b\\\xcc\x81b");
    var w = _anim_prepare(mb, n, sm);
    var nc = _pretag_spans(mb, w, ct, 256, sm, cf);
    assert_eq(nc, 4, "e | x | U+0301 | b");
    assert_eq(load8(cf + 2), ANUENUE_CF_JOIN + ANUENUE_CF_CONT, "the mark continues e");
    assert_eq(load8(cf + 3), 0, "b is ordinary");
    # After an LF, H-05's rule holds: the mark is a cluster of its own.
    n = _t_put(mb, "e\n\x1b_anuenue:off\x1b\\x\x1b_anuenue:on\x1b\\\xcc\x81b");
    w = _anim_prepare(mb, n, sm);
    nc = _pretag_spans(mb, w, ct, 256, sm, cf);
    assert_eq(load8(cf + 3), ANUENUE_CF_JOIN, "after an LF the mark joins the span but is not CONT");
    # The review's row count: 10 columns of span, then the mark, at 10 wide.
    n = _t_span(mb, "", 10, "");
    n = n - 1;                                          # drop the LF; add mark + LF
    n = n + _t_put(mb + n, "\xcc\x81\n");
    assert_eq(_t_span_rows(mb, n, sm, ct, cf, 10), 1, "the mark joins the span's last cell: 1 row");

    test_group("v1.5.0 V-08 — an empty span is seen: the latches reset, the cluster opens");
    n = _t_put(mb, "a\xe2\x80\x8d\x1b_anuenue:off\x1b\\\x1b_anuenue:on\x1b\\b");
    w = _anim_prepare(mb, n, sm);
    assert_eq(load8(sm + 4), 4, "b: the first byte after an empty span");
    nc = _pretag_spans(mb, w, ct, 256, sm, cf);
    assert_eq(nc, 2, "a+ZWJ | b: b does not join across the empty span");
    assert_eq(load8(cf + 1), ANUENUE_CF_OPEN, "and its cluster is reset before");
    n = _t_put(mb, "\xf0\x9f\x87\xba\x1b_anuenue:off\x1b\\\x1b_anuenue:on\x1b\\\xf0\x9f\x87\xb8b");
    w = _anim_prepare(mb, n, sm);
    nc = _pretag_spans(mb, w, ct, 256, sm, cf);
    assert_eq(nc, 3, "U+1F1FA | U+1F1F8 | b: no flag pair across an empty span");

    test_group("v1.5.0 V-09 — a UTF-8 sequence a span cuts stays cut");
    n = _t_put(mb, "a\xe4\x1b_anuenue:off\x1b\\\xb8\xad\x1b_anuenue:on\x1b\\x");
    w = _anim_prepare(mb, n, sm);
    nc = _pretag_spans(mb, w, ct, 256, sm, cf);
    assert_eq(nc, 4, "a | 0xE4 | span(0xB8 0xAD) | x");
    assert_eq(load64(ct + 2 * 8) - load64(ct + 8), 1, "the lead byte alone");
    assert_eq(load8(cf + 2), ANUENUE_CF_RAW + ANUENUE_CF_OPEN, "the tail is the span's");

    test_group("v1.5.0 — _find_esc: the ESC at every offset, eight bytes at a time");
    # Every length 0..72 (both word loops), an ESC at every offset or none, among bytes that
    # sit next to 0x1B: 0x1A, 0x1C, 0x9B, 0x3B. The word test must find the
    # first ESC exactly, and n when there is none.
    var fe_bad = 0;
    var fe_len = 0;
    while (fe_len <= 72) {
        var fe_at = 0 - 1;
        while (fe_at < fe_len) {
            var fe_k = 0;
            while (fe_k < fe_len) {
                var fe_b = 0x1A;
                if ((fe_k % 4) == 1) { fe_b = 0x1C; }
                if ((fe_k % 4) == 2) { fe_b = 0x9B; }
                if ((fe_k % 4) == 3) { fe_b = 0x3B; }
                store8(mb + 3 + fe_k, fe_b);
                fe_k = fe_k + 1;
            }
            var fe_want = fe_len;
            if (fe_at >= 0) {
                store8(mb + 3 + fe_at, 27);
                fe_want = fe_at;
                if (fe_at + 1 < fe_len) { store8(mb + 3 + fe_at + 1, 27); }   # a second one after
            }
            if (_find_esc(mb + 3, 0, fe_len) != fe_want) { fe_bad = fe_bad + 1; }
            fe_at = fe_at + 1;
        }
        fe_len = fe_len + 1;
    }
    assert_eq(fe_bad, 0, "the first ESC at every offset of every length to 72, unaligned");
    assert_eq(_find_esc(mb, 5, 5), 5, "an empty range is n");

    test_group("v1.5.0 V-10 — after an escape intermediate, [ ] P X ^ _ are final bytes");
    n = _t_span(mb, "\x1b(P", 30, "");
    assert_eq(_t_span_rows(mb, n, sm, ct, cf, 10), 3, "ESC ( P is one sequence: 30 columns, 3 rows at 10");
    n = _t_span(mb, "\x1b(B", 30, "");
    assert_eq(_t_span_rows(mb, n, sm, ct, cf, 10), 3, "ESC ( B likewise");
    return 0;
}

# v1.5.0 review: inside a span the row count parses the producer's escapes
# as the terminal's VT parser does (_span_vt), and each span's first
# cluster is flagged so the renderer resets there.
fn test_v150_vt(): i64 {
    test_group("v1.5.0 — _span_vt: one step of the terminal's escape parser");
    assert_eq(_span_vt(65, 0), 1, "text in ground: ground, acts");
    assert_eq(_span_vt(27, 0), 2, "ESC: escape state");
    assert_eq(_span_vt(27, 2), 2, "an ESC inside a CSI restarts");
    assert_eq(_span_vt(10, 2), 5, "an LF inside a CSI is still executed");
    assert_eq(_span_vt(10, 1), 3, "an LF after an ESC is still executed");
    assert_eq(_span_vt(0x18, 2), 0, "CAN aborts a CSI");
    assert_eq(_span_vt(0x1A, 3), 0, "SUB aborts an OSC");
    assert_eq(_span_vt(40, 1), 10, "an intermediate: escape-intermediate state (ESC ( B)");
    assert_eq(_span_vt(40, 5), 10, "more intermediates stay there");
    assert_eq(_span_vt(91, 5), 0, "after an intermediate, [ is a final byte, not a CSI");
    assert_eq(_span_vt(95, 5), 0, "and _ is one too, not an APC");
    assert_eq(_span_vt(10, 5), 11, "a C0 control still executes there");
    assert_eq(_span_vt(32, 2), 4, "an intermediate inside a CSI keeps the CSI");
    assert_eq(_span_vt(66, 1), 0, "a final byte ends it");
    assert_eq(_span_vt(91, 1), 4, "ESC [ : CSI");
    assert_eq(_span_vt(93, 1), 6, "ESC ] : OSC");
    assert_eq(_span_vt(95, 1), 8, "ESC _ : an APC string");
    assert_eq(_span_vt(80, 1), 8, "ESC P : a DCS string");
    assert_eq(_span_vt(10, 3), 6, "an LF inside an OSC is swallowed");
    assert_eq(_span_vt(7, 3), 0, "BEL ends an OSC");
    assert_eq(_span_vt(7, 4), 8, "BEL does not end an APC");
    assert_eq(_span_vt(0x7F, 2), 4, "DEL is ignored");
    assert_eq(_span_vt(0xC3, 2), 1, "a non-ASCII byte ends a CSI and is text");
    assert_eq(_span_vt(109, 2), 0, "m ends a CSI");
    assert_eq(_span_vt(59, 2), 4, "a parameter keeps it open");

    test_group("v1.5.0 — the row count follows the terminal inside a span");
    var mb = alloc(512);
    var sm = alloc(512);
    var ct = alloc(257 * 8);
    var cf = alloc(257);
    var n = _t_span(mb, "\x1b[3\x1b[1m", 80, "");
    assert_eq(_t_span_rows(mb, n, sm, ct, cf, 80), 1, "ESC inside a CSI restarts: 80 columns, 1 row");
    n = _t_span(mb, "\x1b[3\nab", 0, "");
    assert_eq(_t_span_rows(mb, n, sm, ct, cf, 80), 2, "an LF inside a CSI is a line feed: 2 rows");
    n = _t_span(mb, "\x1b_G", 80, "\x1b\\ab");
    assert_eq(_t_span_rows(mb, n, sm, ct, cf, 80), 1, "an APC's payload takes no columns");
    n = _t_span(mb, "\x1bP1$r", 80, "\x1b\\ab");
    assert_eq(_t_span_rows(mb, n, sm, ct, cf, 80), 1, "nor a DCS's");
    n = _t_span(mb, "\x1b(B", 80, "");
    assert_eq(_t_span_rows(mb, n, sm, ct, cf, 80), 1, "ESC ( B is one sequence: 80 columns");
    n = _t_span(mb, "\x1b]8;;http://x/\x1b\\", 80, "\x1b]8;;\x1b\\");
    assert_eq(_t_span_rows(mb, n, sm, ct, cf, 80), 1, "an OSC 8 hyperlink takes no columns");
    n = _t_span(mb, "\x1b[31\x18", 80, "");
    assert_eq(_t_span_rows(mb, n, sm, ct, cf, 79), 2, "CAN aborts a CSI: the 80 x's print, 2 rows at 79");

    test_group("v1.5.0 — each span's first cluster is flagged: adjacent spans reset");
    # span(unterminated OSC) span(abc LF): the renderer's reset before the
    # second span ends the OSC, so abc and its LF show.
    n = _t_put(mb, "\x1b_anuenue:off\x1b\\\x1b]0;t\x1b_anuenue:on\x1b\\\x1b_anuenue:off\x1b\\abc\n");
    var w = _anim_prepare(mb, n, sm);
    var nc = _pretag_spans(mb, w, ct, 256, sm, cf);
    assert_eq(nc, 3, "OSC | abc | LF");
    assert_eq(load8(cf + 0), ANUENUE_CF_RAW + ANUENUE_CF_OPEN, "the first span opens");
    assert_eq(load8(cf + 1), ANUENUE_CF_RAW + ANUENUE_CF_OPEN, "so does the adjacent one");
    assert_eq(load8(cf + 2), ANUENUE_CF_RAW, "the LF inside it does not");
    assert_eq(_block_rows_f(mb, ct, cf, nc, 80), 1, "the reset ends the OSC: abc and the LF count");
    # A nested `off` opens nothing.
    n = _t_put(mb, "\x1b_anuenue:off\x1b\\a\x1b_anuenue:off\x1b\\b\x1b_anuenue:on\x1b\\");
    w = _anim_prepare(mb, n, sm);
    nc = _pretag_spans(mb, w, ct, 256, sm, cf);
    assert_eq(nc, 1, "a nested off: one raw cluster");
    assert_eq(load64(ct + 8), 2, "of both bytes");
    return 0;
}

# Store the UTF-8 encoding of `cp` at `buf + at`. Returns the index after it.
fn _t_utf8(buf, at, cp): i64 {
    if (cp < 0x80) {
        store8(buf + at, cp);
        return at + 1;
    }
    if (cp < 0x800) {
        store8(buf + at, 0xC0 | (cp >> 6));
        store8(buf + at + 1, 0x80 | (cp & 0x3F));
        return at + 2;
    }
    if (cp < 0x10000) {
        store8(buf + at, 0xE0 | (cp >> 12));
        store8(buf + at + 1, 0x80 | ((cp >> 6) & 0x3F));
        store8(buf + at + 2, 0x80 | (cp & 0x3F));
        return at + 3;
    }
    store8(buf + at, 0xF0 | (cp >> 18));
    store8(buf + at + 1, 0x80 | ((cp >> 12) & 0x3F));
    store8(buf + at + 2, 0x80 | ((cp >> 6) & 0x3F));
    store8(buf + at + 3, 0x80 | (cp & 0x3F));
    return at + 4;
}

# v1.5.2 — V-11: a cluster that starts with an extender (at the start of
# the input, or after an LF) is as wide as its first codepoint that is not
# one. The phase half of V-11 is a process-level property, gated by
# robustness gate 12. Returns 0.
fn test_v152_ext_cols(): i64 {
    test_group("v1.5.2 V-11 — columns of a cluster that starts with an extender");
    var xb = alloc(64);
    var xn = _t_utf8(xb, 0, 0x0301);
    assert_eq(_cluster_cols_mb(xb, 0, xn), 0, "a lone combining mark takes no columns");
    xn = _t_utf8(xb, xn, 0x0302);
    assert_eq(_cluster_cols_mb(xb, 0, xn), 0, "two marks take none");
    xn = _t_utf8(xb, 0, 0xFE0F);
    assert_eq(_cluster_cols_mb(xb, 0, xn), 0, "a lone VS-16 takes none");
    xn = _t_utf8(xb, 0, 0x200D);
    xn = _t_utf8(xb, xn, 0x78);
    assert_eq(_cluster_cols_mb(xb, 0, xn), 1, "ZWJ x: the x's 1 column");
    xn = _t_utf8(xb, 0, 0x200D);
    xn = _t_utf8(xb, xn, 0x1F469);
    assert_eq(_cluster_cols_mb(xb, 0, xn), 2, "ZWJ + woman: the emoji's 2 columns");
    xn = _t_utf8(xb, 0, 0x200D);
    xn = _t_utf8(xb, xn, 0x0301);
    xn = _t_utf8(xb, xn, 0x4E2D);
    assert_eq(_cluster_cols_mb(xb, 0, xn), 2, "extenders are skipped to the first base: CJK is 2");
    xn = _t_utf8(xb, 0, 0x200D);
    xn = _t_utf8(xb, xn, 9);
    assert_eq(_cluster_cols_mb(xb, 0, xn), 0, "ZWJ + a control: no columns");
    xn = _t_utf8(xb, 0, 0x200D);
    xn = _t_utf8(xb, xn, 0x85);
    assert_eq(_cluster_cols_mb(xb, 0, xn), 0, "ZWJ + a C1 control: no columns");
    xn = _t_utf8(xb, 0, 0x200D);
    store8(xb + xn, 0xFF);
    xn = xn + 1;
    assert_eq(_cluster_cols_mb(xb, 0, xn), 1, "ZWJ + a malformed byte: one U+FFFD");
    xn = _t_utf8(xb, 0, 0x4E2D);
    assert_eq(_cluster_cols_mb(xb, 0, xn), 2, "a base that is no extender is measured as before");

    test_group("v1.5.2 V-11 — the climb for lines that start with an extender");
    var xr = alloc(512);
    var xt = alloc(4097 * 8);
    # mark + 80 x + LF: 80 columns, one row (it counted 81, two rows).
    xn = _t_utf8(xr, 0, 0x0301);
    xn = _t_fill(xr, xn, 80, 120);
    store8(xr + xn, 10);
    xn = xn + 1;
    assert_eq(_t_rows(xr, xn, xt, 80), 1, "a mark at the start + 80 columns is 1 row");
    # "a\n" + mark + 80 x + LF: the same after an LF.
    store8(xr, 97);
    store8(xr + 1, 10);
    xn = _t_utf8(xr, 2, 0x0301);
    xn = _t_fill(xr, xn, 80, 120);
    store8(xr + xn, 10);
    xn = xn + 1;
    assert_eq(_t_rows(xr, xn, xt, 80), 2, "after an LF: 1 + 1 rows");
    # "\n" + ZWJ + woman + 79 y + LF: 81 columns, two rows (it counted 80).
    store8(xr, 10);
    xn = _t_utf8(xr, 1, 0x200D);
    xn = _t_utf8(xr, xn, 0x1F469);
    xn = _t_fill(xr, xn, 79, 121);
    store8(xr + xn, 10);
    xn = xn + 1;
    assert_eq(_t_rows(xr, xn, xt, 80), 3, "ZWJ + woman + 79 columns after an LF: 1 + 2 rows");
    return 0;
}

# Unit-suite entry: runs every cut's groups in order and returns
# assert_summary() — the failure count, so a failed assertion fails `cyrius test`.
#
# One function per milestone or cut (v1.4.4). Through v1.4.3 every group
# since M1 lived in this one function; at v1.4.3 growing it by one more
# group made the suite die with SIGSEGV in an unrelated early group. It was
# filed as a cyrius miscompile; cyrius 6.7.14 traced it to three byte-sized
# argv arrays in test_m2_flags holding more pointers than bytes, fixed at
# v1.5.1. A new cut's groups go in a new function, called below in order.
fn main(): i64 {
    alloc_init();

    test_m1_hsv_geometry();
    test_m2_flags();
    test_m3_utf8();
    test_m5_phase_cache();
    test_m6_color();
    test_m4_animate();
    test_m8_long_cluster();
    test_version_literal();
    test_v121_observe();
    test_v122_audit();
    test_v130_animation();
    test_v133_escape_cache();
    test_v134_epipe();
    test_v140_signalfd();
    test_v141_cmdit();
    test_v142_argv_echo();
    test_word_copy();
    test_v144_rows();
    test_v145_sgr();
    test_v150_markers();
    test_v150_vt();
    test_v150_review();
    test_v152_ext_cols();

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
