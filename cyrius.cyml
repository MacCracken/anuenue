[package]
name = "anuenue"
version = "${file:VERSION}"
description = "anuenue — ānuenue (Hawaiian: rainbow). Stdin → stdout rainbow-tint pipe filter. Cyrius-native lolcat equivalent."
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/anuenue"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "build/anuenue"

# --- library surface (1.2.0) ---------------------------------------------------
# anuenue is primarily a pipe-filter binary, but its HSV phase model is a reusable
# domain: `cyrius distlib` concatenates these modules (in order) into dist/anuenue.cyr
# so a consumer can `include "lib/anuenue.cyr"` and tint text in-process (e.g. thoth's
# `/theme rainbow` TUI render mode) rather than shelling out to the binary. ONLY the
# pure HSV geometry is exported — hsv.cyr is standalone (one constant + hsv_rainbow,
# zero darshana/sakshi refs). The filter/animate/color/CLI machinery stays app-only.
[lib]
modules = ["src/hsv.cyr"]

[deps]
# "args" — AGNOS-canonical argv. The stdlib "flags" parser was DROPPED when CLI
# parsing moved to the [deps.cmdit] distlib: cmdit IS that parser productized +
# extended, and anuenue is its second worked migration (after kii). "args" stays
# (cmdit_argv/cmdit_parse call args_init/argc/argv); "io" stays (cmdit_parse
# references getenv via cmdit_finalize).
#
# "sakshi" — the canonical error/tracing crate per first-party-standards — is a
# stdlib module from v1.4.1, not a [deps.sakshi] git pin. The toolchain snapshot
# folds a sakshi release (6.7.9 shipped 2.5.8; 6.7.18 ships 2.5.10, folded at
# 6.7.11 — its buffers declared in bytes), and a git tag that disagreed with it
# was a `./lib/ shadows version-pinned` build warning, so the pin could only ever
# restate the snapshot's version. Now the `cyrius` pin above is the one source of
# truth for it: a toolchain bump moves sakshi, and there is no second number to
# keep in step. Re-check the `# Version:` header of lib/sakshi.cyr at each bump.
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "syscalls", "assert", "bench", "args", "chrono", "sakshi"]

# CLI / argument parsing — cmdit (the sovereign getopt-long lib; the stdlib flags
# parser productized + extended). Local sibling path + pinned tag, per AGNOS
# dep-lockin discipline. cmdit_help_flags (added 1.1.0) is the table-only renderer
# anuenue's rich help (brand intro + Examples block) wraps around the flag list.
# 1.4.0 (from 1.2.4) changes what anuenue's cmdit_error switch can see: three
# append-only codes are reachable — UNEXPECTED_VALUE (11, `--bool=value`, which
# 1.2.4 parsed as ON whatever the value), NOMEM (12, a 0 handle from an OOM
# cmdit_new, which 1.2.4 crashed on) and ARGV (13, a command line the stdlib could
# not read whole, which 1.2.4 parsed as a prefix). src/main.cyr names each one.
# cmdit_help_flags output is byte-identical; nothing else anuenue calls changed.
#
# 1.5.0 (from 1.4.0, at v1.5.1) changes nothing anuenue calls: no API or error
# code moved. 1.4.1 is cmdit's own toolchain refresh. 1.4.2 narrows its argv
# check from `len >= 2 MiB` to `len == 2 MiB`, because the stdlib's args_init
# reads /proc/self/cmdline to EOF from cyrius 6.7.12 — so a command line past
# 2 MiB now parses whole instead of being CMDIT_ERR_ARGV. 1.5.0 fixes the bash
# and fish completion scripts, which anuenue does not emit.
[deps.cmdit]
git = "https://github.com/MacCracken/cmdit.git"
path = "../cmdit"
tag = "1.5.0"
modules = ["dist/cmdit.cyr"]

# AGNOS first-party deps — pinned tags per `feedback_dep_lockin_sandhi_unlock`.
# darshana provides the ANSI escape primitives anuenue emits per character.
# agnostik provides the shared Result/Error shapes sakshi consumers use.
# (sakshi is a stdlib module — see the [deps] stdlib list above.)
#
# darshana: API frozen since 1.0.0, only additive since. anuenue calls twelve
# symbols, all frozen: the composers tty_fg_rgb_buf / tty_fg_256_buf /
# tty_sgr_buf / tty_sgr_reset_buf; the emitters tty_sgr_reset / tty_cursor_up /
# tty_cursor_hide / tty_cursor_show; tty_isatty; and, from v1.4.0, the
# exit-signal lifecycle tty_open_signalfd / tty_read_signal / tty_close_signalfd
# (src/animate.cyr used to hand-roll that fd). 1.3.0 needs cyrius >= 6.7.2 — its
# bundle declares private constants with `const` — which is what moved the pin.
#
# No `path` here (dropped at v1.4.0). It made `cyrius deps` vendor darshana's
# working tree instead of the tag: the uncommitted 2026-09-26 lib/ carried 1.1.2
# under `tag = "1.1.1"`, and once that tree reached 1.3.0 the next resolve under
# the old 6.6.2 pin would have failed to compile. From cyrius 6.7.6 a `path` beside
# git + tag is only a CYRIUS_LOCAL dev override, so the tag is what builds either
# way — and without the entry nobody has to know that.
#
# 1.6.0 (from 1.3.0, at v1.5.1) is additive only, and the Linux code anuenue
# calls is unchanged. 1.3.1 is darshana's toolchain refresh; 1.4.0 adds
# tty_sgr_len / tty_sgr_strip_buf, the input-side SGR scanner anuenue proposed
# from its own stand-in (anuenue_sgr_strip — not adopted here; a swap is its own
# change); 1.5.0 is the AGNOS arm only; 1.6.0 adds tty_isatty_is_per_fd.

[deps.darshana]
git = "https://github.com/MacCracken/darshana.git"
tag = "1.6.0"
modules = ["dist/darshana.cyr"]

# agnostik 1.12.0 (from 1.6.0): no change to anything anuenue calls —
# agnostik_err_new / _code / _print bodies, the STIK_ERR_* values and the
# "<kind name>[: <msg>]" stderr line are all as at 1.6.0 (CODE_IO is still 1010).
# 1.6.2 replaced the raw `syscall(318, ...)` that drew an aarch64 build warning
# with sys_getrandom; 1.7.0 moved every private helper under `_stik_`, so no
# vendored name can replace one of agnostik's. The bundle's sidecar now names
# `boxed` itself and drops `tagged`.
#
# agnostik 2.0.0 (from 1.12.0, at v1.5.1) is a major, and one of its renames
# reaches anuenue: every accessor takes its struct's name, so agnostik_err_code
# is AgnostikError_code (src/observe.cyr, tests/anuenue.tcyr). agnostik_err_new
# and agnostik_err_print are a constructor and an operation and keep their names.
# 1.12.3 closes anuenue's 2026-10-14 issue: agnostik_err_new never fails, and
# returns a static RESOURCE_EXHAUSTED "out of memory" error when its 24 bytes
# cannot be had, instead of writing through address 0.
[deps.agnostik]
git = "https://github.com/MacCracken/agnostik.git"
path = "../agnostik"
tag = "2.0.0"
modules = ["dist/agnostik.cyr"]
